{
  "name": "noi-that-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "dev:fe": "npm --prefix frontend run dev",
    "dev:be": "npm --prefix backend run dev",
    "build:fe": "npm --prefix frontend run build",
    "build:be": "npm --prefix backend run build",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  }
}