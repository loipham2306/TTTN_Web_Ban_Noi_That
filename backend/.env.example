PORT=4000
CORS_ORIGIN=http://localhost:4321
DATABASE_URL="mysql://root:@localhost:3306/web_ban_noi_that"
GEMINI_API_KEY=""
JWT_SECRET="your_jwt_secret_key_here"

# Cấu hình cổng thanh toán SePay (VietQR)
SEPAY_API_KEY="your_sepay_api_key"
SEPAY_BANK_ACCOUNT="your_bank_account_number"
SEPAY_BANK_NAME="MBBank"
SEPAY_ACCOUNT_NAME="CONG TY NOI THAT KTUFA"

# Cấu hình gửi Email qua SMTP (Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_digit_app_password"
SMTP_FROM="Nội Thất Cao Cấp <your_email@gmail.com>"

# Bật chế độ thử nghiệm OTP (in mã ra terminal backend khi chưa có App Password Gmail)
OTP_DEV_MODE=true
