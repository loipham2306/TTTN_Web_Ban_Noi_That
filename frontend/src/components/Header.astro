---
interface MenuLink {
  label: string;
  href: string;
}

interface MenuItem {
  label: string;
  href?: string;
  badge?: string;
  children?: MenuLink[];
}

interface AccountLink {
  label: string;
  href?: string;
  tab?: string;
  icon: string; // thuộc tính "d" của thẻ <path> (viewBox 24x24)
}

const menu: MenuItem[] = [
  { label: 'Trang chủ', href: '/' },
  {
    label: 'Sản phẩm',
    href: '/san-pham',
    children: [
      { label: 'Tất cả sản phẩm', href: '/san-pham' },
      { label: 'Sofa cao cấp', href: '/san-pham?danh-muc=sofa' },
      { label: 'Ghế & Bàn ăn', href: '/san-pham?danh-muc=ban-an' },
      { label: 'Giường & Tủ phòng ngủ', href: '/san-pham?danh-muc=giuong' },
      { label: 'Tủ & Kệ trang trí', href: '/san-pham?danh-muc=tu-ke' },
      { label: 'Hệ thống đèn nghệ thuật', href: '/san-pham?danh-muc=den' },
      { label: 'Đồ trang trí & Gương', href: '/san-pham?danh-muc=trang-tri' },
    ],
  },
  {
    label: 'Không gian',
    href: '/#mua-theo-khong-gian',
    children: [
      { label: 'Phòng khách sang trọng', href: '/san-pham?khong-gian=phong-khach' },
      { label: 'Phòng ăn ấm cúng', href: '/san-pham?khong-gian=phong-an' },
      { label: 'Phòng ngủ thư thái', href: '/san-pham?khong-gian=phong-ngu' },
      { label: 'Không gian làm việc VIP', href: '/san-pham?khong-gian=lam-viec' },
      { label: 'Khu vực ngoài trời & Sân vườn', href: '/san-pham?khong-gian=ngoai-troi' },
      { label: '✦ Dự án & Không gian thực tế', href: '/#du-an' },
    ],
  },
  { label: 'Phong thủy', href: '/phong-thuy' },
  {
    label: 'Về chúng tôi',
    href: '/#cau-chuyen',
    children: [
      { label: 'Câu chuyện thương hiệu', href: '/#cau-chuyen' },
      { label: 'Showroom & Liên hệ', href: '/#showroom' },
      { label: 'Hợp tác KTS & Dự án', href: '/#doi-tac' },
    ],
  },
];

// Icon (path "d") dùng chung cho menu tài khoản
const ICON = {
  user: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8c1-3.5 3.8-5 7-5s6 1.5 7 5',
  box: 'M4 8l8-4 8 4v8l-8 4-8-4V8Zm0 0 8 4m0 0 8-4m-8 4v8',
  heart: 'M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10Z',
  pin: 'M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10Zm0-8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
  login: 'M10 17l5-5-5-5M15 12H4m9-8h5a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-5',
  add: 'M12 5v14M5 12h14',
  star: 'M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6.0L12 16.5 6.6 19.5l1.2-6L3.3 9.3l6.1-.7L12 3Z',
  logout: 'M10 17l-5-5 5-5M5 12h11m-3-8h5a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-5',
  shield: 'M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z',
};

// Menu khi CHƯA đăng nhập
const guestMenu: AccountLink[] = [
  { label: 'Đăng nhập', href: '/dang-nhap', icon: ICON.login },
  { label: 'Đăng ký thành viên', href: '/dang-ky', icon: ICON.add },
  { label: 'Tư vấn phong thủy', href: '/phong-thuy', icon: ICON.star },
];

// Menu khi ĐÃ đăng nhập (bấm mở modal tương ứng trên trang, không chuyển sang /tai-khoan)
const userMenu: AccountLink[] = [
  { label: 'Tài khoản của tôi', tab: 'profile', icon: ICON.user },
  { label: 'Đơn hàng của tôi', tab: 'orders', icon: ICON.box },
  { label: 'Danh sách yêu thích', tab: 'wishlist', icon: ICON.heart },
  { label: 'Sổ địa chỉ giao hàng', tab: 'addresses', icon: ICON.pin },
];

const secondary: MenuLink[] = [
  { label: 'Hotline đặt lịch hẹn: 1900 636 884', href: 'tel:1900636884' },
];

const isHome = Astro.url.pathname === '/';
const currentPath = Astro.url.pathname;

const isItemActive = (item: MenuItem): boolean => {
  if (item.href === '/') {
    return currentPath === '/';
  }
  if (item.href && item.href !== '#' && !item.href.startsWith('/#')) {
    if (currentPath === item.href || currentPath.startsWith(item.href + '/')) {
      return true;
    }
  }
  if (item.children) {
    return item.children.some((child) => {
      if (child.href.startsWith('/#')) return false;
      const [path] = child.href.split('?');
      return currentPath === path || currentPath.startsWith(path + '/');
    });
  }
  return false;
};
---

<header
  id="site-header"
  data-overlay={isHome ? 'true' : 'false'}
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
  {/* TOP ANNOUNCEMENT BAR */}
  <div id="header-topbar" class="border-b border-white/10 bg-[#0f2418]/90 py-1.5 text-[11px] text-neutral-300 backdrop-blur-md transition-all duration-300">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-8">
      <div class="hidden items-center gap-5 md:flex">
        <span class="flex items-center gap-1.5">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-amber-400"></span>
          <span>Showroom Flagship: 615 Âu Cơ, TP. HCM</span>
        </span>
        <span class="text-white/20">|</span>
        <span class="text-neutral-400">Giờ mở cửa: 08:30 – 21:00</span>
      </div>

      <div class="mx-auto flex items-center gap-3 text-center md:mx-0 md:text-right">
        <span class="font-normal text-neutral-300">Miễn phí giao hàng & lắp đặt tận nơi</span>
        <span class="text-white/20">•</span>
        <span class="text-neutral-300">Hotline VIP: <a href="tel:1900636884" class="font-medium text-amber-300 transition hover:underline">1900 636 884</a></span>
      </div>
    </div>
  </div>

  {/* MAIN NAVBAR */}
  <div class="navbar-container transition-all duration-300">
    <div class="relative mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:h-20 sm:px-8">
      {/* KHỐI TRÁI: MOBILE MENU & LOGO */}
      <div class="flex items-center gap-4 sm:gap-8">
        <button
          id="menu-btn"
          type="button"
          class="icon-btn inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors hover:bg-white/10 lg:hidden"
          aria-label="Mở menu"
          aria-expanded="false"
          aria-controls="menu-panel"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
        </button>

        <a href="/" class="group flex flex-col">
          <span class="logo-mark font-sans text-lg font-semibold uppercase tracking-[0.35em] transition sm:text-2xl">
            Nội Thất
          </span>
          <span class="text-[9px] uppercase tracking-[0.45em] text-neutral-400 opacity-90 transition group-hover:text-amber-400">
            Luxury Living
          </span>
        </a>
      </div>

      {/* KHỐI GIỮA */}
      <nav class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-6 whitespace-nowrap lg:flex xl:gap-9" aria-label="Menu chính máy tính">
        {menu.map((item) => {
          const active = isItemActive(item);
          return (
            <div class:list={['nav-item group relative', active && 'is-active']}>
              <a
                href={item.href || '#'}
                class:list={[
                  'nav-link flex items-center gap-1.5 whitespace-nowrap py-2 text-[12px] font-medium uppercase tracking-[0.18em] transition-colors duration-200',
                  active ? 'text-amber-400 font-semibold is-active' : 'text-white/90 hover:text-amber-400',
                ]}
                aria-haspopup={item.children ? 'true' : undefined}
                aria-current={active ? 'page' : undefined}
              >
                <span class:list={['hover-line-center whitespace-nowrap', active && 'is-active']}>{item.label}</span>
                {item.children && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class:list={[
                      'h-3 w-3 shrink-0 transition-transform duration-200 group-hover:rotate-180',
                      active ? 'text-amber-400 opacity-90' : 'opacity-60',
                    ]}
                  >
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </a>

              {item.children && (
                <div class="dropdown-menu invisible absolute left-1/2 top-full -translate-x-1/2 pt-2 transition-all duration-200">
                  <div class="panel-card w-max min-w-[240px] rounded-xl p-2 shadow-2xl backdrop-blur-xl">
                    <ul>
                      {item.children.map((child) => {
                        const childActive = currentPath === child.href;
                        return (
                          <li>
                            <a
                              href={child.href}
                              class:list={[
                                'panel-link whitespace-nowrap',
                                childActive && 'panel-link--accent font-semibold bg-white/10 text-amber-400',
                              ]}
                            >
                              <span>{child.label}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </nav>

      {/* KHỐI PHẢI: TÌM KIẾM, TÀI KHOẢN, GIỎ HÀNG */}
      <div class="flex items-center gap-2 sm:gap-3">
        <button
          id="search-toggle-btn"
          type="button"
          class="icon-btn inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors hover:bg-white/10"
          aria-label="Tìm kiếm sản phẩm"
          aria-expanded="false"
          aria-controls="quick-search-bar"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
            <circle cx="11" cy="11" r="6" />
            <path d="M15.5 15.5 20 20" stroke-linecap="round" />
          </svg>
        </button>

        {/* TÀI KHOẢN (desktop): icon + tên khách + mũi tên, hover mở dropdown */}
        <div class="nav-item group relative hidden lg:block">
          <a
            href="/dang-nhap"
            data-account-link
            class="icon-btn account-trigger inline-flex h-10 items-center gap-2 rounded-full px-2.5 transition-colors hover:bg-white/10"
            aria-haspopup="true"
            aria-controls="account-menu-panel"
            title="Tài khoản"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5 shrink-0">
              <circle cx="12" cy="8" r="3.5" />
              <path d="M4.5 20c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5" stroke-linecap="round" />
            </svg>
            <span class="account-name max-w-[140px] truncate text-[13px] font-medium" data-user-name>Khách</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="account-caret h-3 w-3 shrink-0 opacity-60">
              <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <div
            id="account-menu-panel"
            class="dropdown-menu dropdown-menu--right invisible absolute right-0 top-full pt-2 transition-all duration-200"
          >
            <div class="panel-card w-max min-w-[260px] rounded-xl p-2 shadow-2xl backdrop-blur-xl">
              {/* Khách */}
              <div class="auth-guest">
                <p class="panel-muted px-3.5 pb-2 pt-2 text-xs">Xin chào, Khách</p>
                <ul>
                  {guestMenu.map((item) => (
                    <li>
                      <a href={item.href} class="panel-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 shrink-0" aria-hidden="true">
                          <path d={item.icon} stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>{item.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              {/* Đã đăng nhập */}
              <div class="auth-user">
                <div class="px-3.5 pb-2 pt-2">
                  <span class="panel-muted block text-[11px]">Xin chào</span>
                  <span class="panel-title block truncate text-sm font-semibold" data-user-name>Khách</span>
                </div>

                <div class="admin-only">
                  <a href="/admin" class="panel-link panel-link--accent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 shrink-0" aria-hidden="true">
                      <path d={ICON.shield} stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>Trang quản trị</span>
                  </a>
                  <div class="panel-divider" role="separator"></div>
                </div>

                <ul>
                  {userMenu.map((item) => (
                    <li>
                      <button type="button" data-open-profile={item.tab} class="panel-link w-full text-left cursor-pointer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 shrink-0" aria-hidden="true">
                          <path d={item.icon} stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>{item.label}</span>
                      </button>
                    </li>
                  ))}
                </ul>

                <div class="panel-divider" role="separator"></div>

                <button type="button" data-logout class="panel-link panel-link--danger w-full text-left">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 shrink-0" aria-hidden="true">
                    <path d={ICON.logout} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>Đăng xuất</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        {/* Tài khoản trên mobile: bấm là đi thẳng */}
        <a
          href="/dang-nhap"
          data-account-link
          class="icon-btn inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors hover:bg-white/10 lg:hidden"
          aria-label="Tài khoản"
          title="Tài khoản"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
            <circle cx="12" cy="8" r="3.5" />
            <path d="M4.5 20c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5" stroke-linecap="round" />
          </svg>
        </a>

        {/* Giỏ hàng */}
        <a
          href="/gio-hang"
          class="icon-btn relative inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors hover:bg-white/10"
          aria-label="Giỏ hàng"
          title="Giỏ hàng"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
            <path d="M5 8h14l-1.2 12H6.2L5 8Z" stroke-linejoin="round" />
            <path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke-linecap="round" />
          </svg>
          <span
            data-cart-count
            style="display:none"
            class="absolute right-1 top-1 flex h-4 min-w-[16px] items-center justify-center rounded-full bg-amber-400 px-1 text-[10px] font-bold text-neutral-950 shadow-sm"
          >0</span>
        </a>
      </div>
    </div>
  </div>

  {/* THANH TÌM KIẾM NHANH */}
  <div id="quick-search-bar" class="hidden border-b border-neutral-800 bg-[#173524]/95 px-4 py-4 shadow-xl backdrop-blur-xl sm:px-8">
    <div class="mx-auto max-w-3xl">
      <form data-desktop-search role="search" class="flex items-center gap-3 border-b border-white/20 pb-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5 text-neutral-400">
          <circle cx="11" cy="11" r="6" />
          <path d="M15.5 15.5 20 20" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          name="q"
          placeholder="Tìm sofa da, bàn ăn gỗ sồi, đèn trần nghệ thuật..."
          class="w-full bg-transparent text-sm text-white placeholder-neutral-500 outline-none"
        />
        <button type="submit" class="text-xs uppercase tracking-widest text-amber-300 transition hover:text-amber-200">Tìm kiếm</button>
        <button type="button" id="close-search-btn" class="ml-2 text-neutral-400 hover:text-white" aria-label="Đóng">✕</button>
      </form>
    </div>
  </div>
</header>

{/* MOBILE DRAWER MENU */}
<div id="menu-panel" class="pointer-events-none fixed inset-0 z-[60] opacity-0 transition-opacity duration-300">
  <div id="menu-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm" aria-hidden="true"></div>

  <aside
    class="absolute left-0 top-0 flex h-full w-full max-w-sm flex-col bg-[#173524] px-6 py-6 text-white shadow-2xl"
    aria-label="Menu chính trên điện thoại"
  >
    <div class="flex shrink-0 items-center justify-between border-b border-white/10 pb-4">
      <div class="flex flex-col">
        <span class="text-lg font-semibold uppercase tracking-[0.32em] text-white">Nội Thất</span>
        <span class="text-[9px] uppercase tracking-[0.4em] text-amber-400">Luxury Living</span>
      </div>
      <button
        id="menu-close"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-white/70 hover:bg-white/10 hover:text-white"
        aria-label="Đóng menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <form data-menu-search role="search" class="mt-6 flex shrink-0 items-center gap-3 border-b border-white/20 pb-2">
      <input
        type="search"
        name="q"
        placeholder="Tìm sofa, bàn ăn, đèn..."
        aria-label="Tìm sản phẩm"
        class="w-full bg-transparent text-sm text-white placeholder-neutral-500 outline-none"
      />
      <button type="submit" aria-label="Tìm" class="text-neutral-400 hover:text-white">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
          <circle cx="11" cy="11" r="6" />
          <path d="M15.5 15.5 20 20" stroke-linecap="round" />
        </svg>
      </button>
    </form>

    <nav class="mt-6 flex-1 overflow-y-auto" aria-label="Danh mục điện thoại">
      <ul class="flex flex-col">
        {menu.map((item) => {
          const active = isItemActive(item);
          return (
            <li class:list={['border-b border-white/10', active && 'bg-white/5']}>
              {item.children ? (
                <details class="menu-group" open={active}>
                  <summary class="flex cursor-pointer items-center justify-between gap-4 py-3.5">
                    <span class:list={['text-sm font-medium uppercase tracking-[0.15em]', active ? 'text-amber-400 font-bold' : 'text-white']}>
                      {item.label}
                    </span>
                    <span class="menu-plus text-lg leading-none text-neutral-400" aria-hidden="true">+</span>
                  </summary>
                  <ul class="flex flex-col gap-2.5 pb-4 pl-4 text-xs">
                    {item.children.map((child) => {
                      const childActive = currentPath === child.href;
                      return (
                        <li>
                          <a
                            href={child.href}
                            class:list={[
                              'transition-colors',
                              childActive ? 'text-amber-400 font-semibold' : 'text-neutral-400 hover:text-white',
                            ]}
                          >
                            {child.label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </details>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    'block py-3.5 text-sm font-medium uppercase tracking-[0.15em] transition-colors',
                    active ? 'text-amber-400 font-bold' : 'text-white hover:text-amber-300',
                  ]}
                >
                  {item.label}
                </a>
              )}
            </li>
          );
        })}
      </ul>

      {/* Khối tài khoản trên mobile */}
      <div class="mt-8 border-t border-white/10 pt-6 pb-10">
        <p class="text-[10px] uppercase tracking-[0.3em] text-neutral-500">
          <span class="auth-guest">Tài khoản</span>
          <span class="auth-user">Xin chào, <span data-user-name>Khách</span></span>
        </p>

        <div class="auth-guest">
          <ul class="mt-3 flex flex-col gap-3 text-xs text-neutral-300">
            {guestMenu.map((item) => (
              <li><a href={item.href} class="transition-colors hover:text-white">{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="auth-user">
          <ul class="mt-3 flex flex-col gap-3 text-xs text-neutral-300">
            <li class="admin-only"><a href="/admin" class="text-amber-300 transition-colors hover:text-amber-200">Trang quản trị</a></li>
            {userMenu.map((item) => (
              <li>
                <button type="button" data-open-profile={item.tab} class="transition-colors hover:text-white text-left w-full cursor-pointer py-0.5">
                  {item.label}
                </button>
              </li>
            ))}
            <li><button type="button" data-logout class="text-red-400 transition-colors hover:text-red-300">Đăng xuất</button></li>
          </ul>
        </div>

        <ul class="mt-6 flex flex-col gap-3 text-xs text-neutral-400">
          {secondary.map((item) => (
            <li><a href={item.href} class="transition-colors hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>
  </aside>
</div>

