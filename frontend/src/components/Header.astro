<style>
  /* ===== Biến màu: tối (overlay trang chủ) là mặc định ===== */
  #site-header {
    --line-color: #fbbf24;
    --panel-bg: rgba(23, 53, 36, 0.97);
    --panel-border: #24472f;
    --panel-text: #d4d4d4;
    --panel-text-hover: #ffffff;
    --panel-hover-bg: rgba(255, 255, 255, 0.1);
    --panel-muted: #8a8a8a;
    --panel-divider: rgba(255, 255, 255, 0.12);
    --panel-accent: #fbbf24;
    --panel-danger: #f87171;
    color: #ffffff;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }


  #site-header[data-overlay='true'] .navbar-container {
    background-color: transparent;
  }

  #site-header[data-overlay='true'].is-scrolled .navbar-container,
  #site-header[data-overlay='false'] .navbar-container {
    background-color: rgba(23, 53, 36, 0.97);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.25);
  }


  .nav-item:hover .nav-link,
  .nav-link:hover {
    color: var(--line-color, #fbbf24) !important;
  }

  /* Trạng thái tab đang hoạt động (active menu sáng đèn) */
  .nav-item.is-active .nav-link,
  .nav-link.is-active,
  .nav-link[aria-current='page'] {
    color: #fbbf24 !important;
  }

  .hover-line-center.is-active::after,
  .nav-item.is-active .hover-line-center::after {
    width: 100% !important;
    background-color: #fbbf24 !important;
  }

  .icon-btn {
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .icon-btn:hover {
    color: var(--line-color, #fbbf24);
  }

  /* ===== Dropdown: mở bằng hover (chuột) và focus-within (bàn phím) ===== */
  .nav-item .dropdown-menu > div {
    transform: translateY(6px);
    opacity: 0;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
  }
  .nav-item:hover .dropdown-menu,
  .nav-item:focus-within .dropdown-menu {
    visibility: visible;
  }
  .nav-item:hover .dropdown-menu > div,
  .nav-item:focus-within .dropdown-menu > div {
    transform: translateY(0);
    opacity: 1;
  }

  /* Panel tài khoản canh phải, không dùng translateX của dropdown mặc định */
  .dropdown-menu--right {
    left: auto;
    right: 0;
    transform: none;
  }

  /* ===== Giao diện panel (đọc màu từ biến ở trên) ===== */
  .panel-card {
    background-color: var(--panel-bg);
    border: 1px solid var(--panel-border);
  }
  .panel-title {
    color: var(--panel-text-hover);
  }
  .panel-muted {
    color: var(--panel-muted);
  }
  .panel-divider {
    height: 1px;
    margin: 0.35rem 0.5rem;
    background-color: var(--panel-divider);
  }
  .panel-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.875rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    color: var(--panel-text);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .panel-link:hover {
    color: var(--panel-text-hover);
    background-color: var(--panel-hover-bg);
  }
  .panel-link--accent {
    color: var(--panel-accent);
    font-weight: 600;
  }
  .panel-link--accent:hover {
    color: var(--panel-accent);
  }
  .panel-link--danger {
    color: var(--panel-danger);
  }
  .panel-link--danger:hover {
    color: var(--panel-danger);
  }

  /* ===== Trạng thái đăng nhập (JS gán data-auth / data-role lên header và drawer) ===== */
  .auth-user,
  .admin-only,
  .account-name,
  .account-caret {
    display: none;
  }
  [data-auth='user'] .auth-user {
    display: block;
  }
  [data-auth='user'] .auth-guest {
    display: none;
  }
  [data-auth='user'][data-role='admin'] .admin-only {
    display: block;
  }
  @media (min-width: 1280px) {
    [data-auth='user'] .account-name {
      display: inline-block;
    }
    [data-auth='user'] .account-caret {
      display: block;
    }
  }

  /* ===== Drawer mobile ===== */
  #menu-panel > aside {
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #menu-panel.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  #menu-panel.is-open > aside {
    transform: translateX(0);
  }
  .menu-group > summary {
    list-style: none;
  }
  .menu-group > summary::-webkit-details-marker {
    display: none;
  }
  .menu-plus {
    transition: transform 0.2s ease;
  }
  .menu-group[open] .menu-plus {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    #site-header *,
    #menu-panel > aside,
    .nav-item .dropdown-menu > div {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('menu-btn');
  const menuClose = document.getElementById('menu-close');
  const menuPanel = document.getElementById('menu-panel');
  const menuBackdrop = document.getElementById('menu-backdrop');
  const searchToggleBtn = document.getElementById('search-toggle-btn');
  const quickSearchBar = document.getElementById('quick-search-bar');
  const closeSearchBtn = document.getElementById('close-search-btn');

  // Header đổi màu khi cuộn
  const onScroll = (): void => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 40);
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Dọn dẹp key lưu trữ chung cũ trên trình duyệt để chuyển sang Database
  try {
    localStorage.removeItem('user_wishlist');
    localStorage.removeItem('user_wishlist_slugs');
  } catch {}

  // Mobile drawer
  const openMenu = (): void => {
    if (!menuPanel || !menuBtn) return;
    menuPanel.classList.add('is-open');
    menuBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = (): void => {
    if (!menuPanel || !menuBtn) return;
    menuPanel.classList.remove('is-open');
    menuBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  menuBtn?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);
  menuBackdrop?.addEventListener('click', closeMenu);

  menuPanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    closeMenu();
    quickSearchBar?.classList.add('hidden');
    searchToggleBtn?.setAttribute('aria-expanded', 'false');

    // Bỏ focus để dropdown mở bằng bàn phím cũng đóng lại
    const active = document.activeElement as HTMLElement | null;
    if (active && header?.contains(active)) active.blur();
  });

  // Thanh tìm kiếm nhanh
  searchToggleBtn?.addEventListener('click', () => {
    if (!quickSearchBar) return;
    const isHidden = quickSearchBar.classList.toggle('hidden');
    searchToggleBtn.setAttribute('aria-expanded', String(!isHidden));
    if (!isHidden) {
      quickSearchBar.querySelector<HTMLInputElement>('input[name="q"]')?.focus();
    }
  });

  closeSearchBtn?.addEventListener('click', () => {
    quickSearchBar?.classList.add('hidden');
    searchToggleBtn?.setAttribute('aria-expanded', 'false');
  });

  const handleSearchSubmit = (form: HTMLFormElement | null): void => {
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="q"]');
      const keyword = input?.value.trim() ?? '';
      window.location.href = keyword ? '/san-pham?q=' + encodeURIComponent(keyword) : '/san-pham';
    });
  };

  handleSearchSubmit(document.querySelector<HTMLFormElement>('[data-menu-search]'));
  handleSearchSubmit(document.querySelector<HTMLFormElement>('[data-desktop-search]'));
</script>

<script>
  import { readCart, countItems, CART_EVENT } from '../scripts/cart';
  import { readUser, clearUser, AUTH_EVENT } from '../scripts/auth';

  // ----- Badge giỏ hàng -----
  const badge = document.querySelector<HTMLElement>('[data-cart-count]');

  const syncBadge = (): void => {
    if (!badge) return;
    const count = countItems(readCart());
    badge.textContent = String(count);
    badge.style.display = count > 0 ? 'flex' : 'none';
  };

  syncBadge();
  window.addEventListener(CART_EVENT, syncBadge);
  window.addEventListener('storage', syncBadge);
  window.addEventListener(AUTH_EVENT, syncBadge);

  // ----- Trạng thái đăng nhập: hiện tên khách, đổi menu -----
  const authTargets = [
    document.getElementById('site-header'),
    document.getElementById('menu-panel'),
  ];

  const syncAuth = (): void => {
    const user = readUser();

    for (const el of authTargets) {
      if (!el) continue;
      if (user) {
        el.dataset.auth = 'user';
        el.dataset.role = user.role ?? 'customer';
      } else {
        delete el.dataset.auth;
        delete el.dataset.role;
      }
    }

    document.querySelectorAll<HTMLElement>('[data-user-name]').forEach((el) => {
      el.textContent = user?.name ?? 'Khách';
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-account-link]').forEach((a) => {
      if (user) {
        a.href = '#';
        a.setAttribute('aria-label', 'Tài khoản của ' + user.name);
      } else {
        a.href = '/dang-nhap';
        a.setAttribute('aria-label', 'Đăng nhập');
      }
    });
  };

  syncAuth();
  window.addEventListener(AUTH_EVENT, syncAuth);
  window.addEventListener('storage', syncAuth);

  // ===== XỬ LÝ MODAL HỒ SƠ & TÀI KHOẢN CÁ NHÂN =====
  const profileModal = document.getElementById('user-profile-modal');
  const btnCloseProfile = document.getElementById('btn-close-profile-modal');
  const btnCloseProfileFooter = document.getElementById('btn-close-profile-modal-footer');

  const closeProfileModal = () => profileModal?.classList.add('hidden');
  btnCloseProfile?.addEventListener('click', closeProfileModal);
  btnCloseProfileFooter?.addEventListener('click', closeProfileModal);
  profileModal?.addEventListener('click', (e) => {
    if (e.target === profileModal) closeProfileModal();
  });

  // Chuyển tab trong modal
  const switchProfileTab = (tabName: string) => {
    document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]').forEach((btn) => {
      const isActive = btn.dataset.tabBtn === tabName;
      btn.className = `profile-tab-button py-3.5 border-b-2 cursor-pointer transition-colors whitespace-nowrap ${
        isActive 
          ? 'border-clay-600 text-clay-700 font-bold' 
          : 'border-transparent text-walnut-800/70 hover:text-walnut-900'
      }`;
    });

    document.querySelectorAll<HTMLElement>('.tab-pane').forEach((pane) => {
      pane.classList.toggle('hidden', pane.id !== `tab-pane-${tabName}`);
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      switchProfileTab(btn.dataset.tabBtn || 'profile');
    });
  });

  // Mở modal và nạp thông tin người dùng
  const openProfileModal = (initialTab = 'profile') => {
    const user = readUser();
    if (!user) {
      window.location.href = '/dang-nhap';
      return;
    }

    // Đọc thông tin chi tiết từ current_user nếu có
    let fullUser: any = user;
    try {
      const raw = localStorage.getItem('current_user');
      if (raw) fullUser = JSON.parse(raw);
    } catch {}

    const name = fullUser.name || 'Khách';
    const email = fullUser.email || (user.role === 'admin' ? 'admin@noithat.vn' : 'khach@noithat.vn');
    const phone = fullUser.phone && fullUser.phone !== 'Đăng nhập Google' ? fullUser.phone : '0909 001 001';
    const tier = fullUser.tier || (user.role === 'admin' ? 'Quản Trị Viên' : 'Kim Cương (VIP)');
    const spent = fullUser.spent || '91.400.000 ₫';
    const orders = typeof fullUser.orders === 'number' ? `${fullUser.orders} đơn hàng` : '2 đơn hàng';
    const avatar = fullUser.avatar || '';

    // Cập nhật DOM Modal
    const modalName = document.getElementById('profile-modal-name');
    const modalEmail = document.getElementById('profile-modal-email');
    const modalTier = document.getElementById('profile-modal-tier');
    const modalAvatar = document.getElementById('profile-modal-avatar');
    const adminLink = document.getElementById('profile-admin-link');

    if (modalName) modalName.textContent = name;
    if (modalEmail) modalEmail.textContent = email;
    if (modalTier) modalTier.textContent = tier;
    
    if (modalAvatar) {
      if (avatar) {
        modalAvatar.innerHTML = `<img src="${avatar}" alt="${name}" class="h-full w-full object-cover rounded-full" />`;
      } else {
        const initials = name.split(' ').map((n: string) => n[0]).slice(-2).join('');
        modalAvatar.textContent = initials || 'KH';
      }
    }

    if (adminLink) {
      adminLink.classList.toggle('hidden', user.role !== 'admin' && user.role !== 'seller');
    }

    // Tab 1 Info
    const infoName = document.getElementById('profile-info-name');
    const infoEmail = document.getElementById('profile-info-email');
    const infoPhone = document.getElementById('profile-info-phone');
    const infoTier = document.getElementById('profile-info-tier');
    const infoSpent = document.getElementById('profile-info-spent');
    const infoOrders = document.getElementById('profile-info-orders');

    if (infoName) infoName.textContent = name;
    if (infoEmail) infoEmail.textContent = email;
    if (infoPhone) infoPhone.textContent = phone;
    if (infoTier) infoTier.textContent = tier;
    if (infoSpent) infoSpent.textContent = spent;
    if (infoOrders) infoOrders.textContent = orders;

    // Address Info
    const addrName = document.getElementById('address-recipient-name');
    const addrPhone = document.getElementById('address-recipient-phone');
    if (addrName) addrName.textContent = name;
    if (addrPhone) addrPhone.textContent = phone;

    // Wishlist Info (Đồng bộ trực tiếp từ Database API theo từng tài khoản)
    const wishlistContainer = document.getElementById('tab-pane-wishlist');
    const renderWishlistItems = async () => {
      if (!wishlistContainer) return;
      wishlistContainer.innerHTML = '<div class="text-center py-6 text-xs text-walnut-800/60">Đang tải danh sách yêu thích từ máy chủ...</div>';

      let wishItems: any[] = [];
      const token = localStorage.getItem('auth_token');

      if (token) {
        try {
          const res = await fetch('http://localhost:4000/api/wishlist', {
            headers: { Authorization: `Bearer ${token}` },
          });
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            wishItems = json.data;
          }
        } catch (err) {
          console.warn('Lỗi kết nối API Wishlist:', err);
        }
      } else {
        // Fallback khách vãng lai
        try {
          wishItems = JSON.parse(localStorage.getItem('user_wishlist_guest') || '[]');
        } catch {}
      }

      if (wishItems.length === 0) {
        wishlistContainer.innerHTML = `
          <div class="text-center py-8 text-xs text-walnut-800/70">
            <p class="text-3xl mb-2 text-walnut-900/30">♡</p>
            <p class="font-bold text-sm text-walnut-900">Danh sách yêu thích đang trống</p>
            <p class="mt-1 text-walnut-800/70">Hãy bấm vào biểu tượng trái tim ở các trang sản phẩm để lưu lại tại đây nhé.</p>
          </div>
        `;
      } else {
        wishlistContainer.innerHTML = wishItems.map((item: any) => `
          <div class="rounded-lg border border-walnut-900/10 bg-sand-100/50 p-3.5 flex items-center justify-between gap-4">
            <div>
              <h4 class="font-semibold text-xs text-walnut-900">${item.name}</h4>
              <p class="font-bold text-clay-700 text-xs mt-0.5">${new Intl.NumberFormat('vi-VN').format(item.price)} ₫</p>
            </div>
            <div class="flex items-center gap-3">
              <a href="/san-pham/${item.slug}" class="text-xs uppercase tracking-wider text-walnut-900 font-semibold hover:text-clay-600 underline">
                Xem sản phẩm →
              </a>
              <button type="button" data-remove-wishlist="${item.slug}" class="text-xs text-red-500 hover:text-red-700 p-1 cursor-pointer font-bold" title="Xóa khỏi yêu thích">
                ✕
              </button>
            </div>
          </div>
        `).join('');

        wishlistContainer.querySelectorAll<HTMLButtonElement>('[data-remove-wishlist]').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const slugToRemove = btn.dataset.removeWishlist;
            if (!slugToRemove) return;
            btn.disabled = true;

            if (token) {
              try {
                await fetch(`http://localhost:4000/api/wishlist/${slugToRemove}`, {
                  method: 'DELETE',
                  headers: { Authorization: `Bearer ${token}` },
                });
              } catch (e) {
                console.error(e);
              }
            } else {
              let guestList: any[] = [];
              try { guestList = JSON.parse(localStorage.getItem('user_wishlist_guest') || '[]'); } catch {}
              guestList = guestList.filter((i: any) => i.slug !== slugToRemove);
              localStorage.setItem('user_wishlist_guest', JSON.stringify(guestList));
            }

            window.dispatchEvent(new Event('wishlist:changed'));
            renderWishlistItems();
          });
        });
      }
    };

    renderWishlistItems();
    window.addEventListener('wishlist:changed', renderWishlistItems);

    switchProfileTab(initialTab);
    profileModal?.classList.remove('hidden');
  };

  // Bắt sự kiện click vào nút tài khoản (nếu đã đăng nhập thì mở modal, không chuyển trang)
  document.querySelectorAll<HTMLElement>('[data-account-link]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const user = readUser();
      if (user) {
        e.preventDefault();
        e.stopPropagation();
        openProfileModal('profile');
      }
    });
  });

  // Bắt sự kiện click vào các nút mục trong menu dropdown (Tài khoản, Đơn hàng, Yêu thích, Sổ địa chỉ)
  document.querySelectorAll<HTMLElement>('[data-open-profile]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const tab = btn.dataset.openProfile || 'profile';
      openProfileModal(tab);
    });
  });

  // Xử lý Đăng xuất
  document.querySelectorAll<HTMLElement>('[data-logout]').forEach((btn) => {
    btn.addEventListener('click', () => {
      clearUser();
      closeProfileModal();
      window.location.href = '/';
    });
  });
</script>