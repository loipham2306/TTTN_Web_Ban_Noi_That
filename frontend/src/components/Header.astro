<style>
  /* ===== Biến màu: tối (overlay trang chủ) là mặc định ===== */
  #site-header {
    --line-color: #fbbf24;
    --panel-bg: rgba(23, 53, 36, 0.97);
    --panel-border: #24472f;
    --panel-text: #d4d4d4;
    --panel-text-hover: #ffffff;
    --panel-hover-bg: rgba(255, 255, 255, 0.1);
    --panel-muted: #8a8a8a;
    --panel-divider: rgba(255, 255, 255, 0.12);
    --panel-accent: #fbbf24;
    --panel-danger: #f87171;
    color: #ffffff;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }


  /* Menu luôn đồng nhất màu xanh đặc (#173524) 100%, không bị nhìn xuyên thấu hay nhạt màu khi cuộn */
  #site-header,
  .navbar-container,
  #site-header[data-overlay='true'] .navbar-container,
  #site-header[data-overlay='true'].is-scrolled .navbar-container,
  #site-header[data-overlay='false'] .navbar-container {
    background-color: #173524 !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.35);
  }


  .nav-item:hover .nav-link,
  .nav-link:hover {
    color: var(--line-color, #fbbf24) !important;
  }

  /* Trạng thái tab đang hoạt động (active menu sáng đèn) */
  .nav-item.is-active .nav-link,
  .nav-link.is-active,
  .nav-link[aria-current='page'] {
    color: #fbbf24 !important;
  }

  .hover-line-center.is-active::after,
  .nav-item.is-active .hover-line-center::after {
    width: 100% !important;
    background-color: #fbbf24 !important;
  }

  .icon-btn {
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .icon-btn:hover {
    color: var(--line-color, #fbbf24);
  }

  /* ===== Dropdown: mở bằng hover (chuột) và focus-within (bàn phím) ===== */
  .nav-item .dropdown-menu > div {
    transform: translateY(6px);
    opacity: 0;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
  }
  .nav-item:hover .dropdown-menu,
  .nav-item:focus-within .dropdown-menu {
    visibility: visible;
  }
  .nav-item:hover .dropdown-menu > div,
  .nav-item:focus-within .dropdown-menu > div {
    transform: translateY(0);
    opacity: 1;
  }

  /* Panel tài khoản canh phải, không dùng translateX của dropdown mặc định */
  .dropdown-menu--right {
    left: auto;
    right: 0;
    transform: none;
  }

  /* ===== Giao diện panel (đọc màu từ biến ở trên) ===== */
  .panel-card {
    background-color: var(--panel-bg);
    border: 1px solid var(--panel-border);
  }
  .panel-title {
    color: var(--panel-text-hover);
  }
  .panel-muted {
    color: var(--panel-muted);
  }
  .panel-divider {
    height: 1px;
    margin: 0.35rem 0.5rem;
    background-color: var(--panel-divider);
  }
  .panel-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.875rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    color: var(--panel-text);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .panel-link:hover {
    color: var(--panel-text-hover);
    background-color: var(--panel-hover-bg);
  }
  .panel-link--accent {
    color: var(--panel-accent);
    font-weight: 600;
  }
  .panel-link--accent:hover {
    color: var(--panel-accent);
  }
  .panel-link--danger {
    color: var(--panel-danger);
  }
  .panel-link--danger:hover {
    color: var(--panel-danger);
  }

  /* ===== Trạng thái đăng nhập (JS gán data-auth / data-role lên header và drawer) ===== */
  .auth-user,
  .admin-only,
  .account-name,
  .account-caret {
    display: none;
  }
  [data-auth='user'] .auth-user {
    display: block;
  }
  [data-auth='user'] .auth-guest {
    display: none;
  }
  [data-auth='user'][data-role='admin'] .admin-only {
    display: block;
  }
  @media (min-width: 1280px) {
    [data-auth='user'] .account-name {
      display: inline-block;
    }
    [data-auth='user'] .account-caret {
      display: block;
    }
  }

  /* ===== Drawer mobile ===== */
  #menu-panel > aside {
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #menu-panel.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  #menu-panel.is-open > aside {
    transform: translateX(0);
  }
  .menu-group > summary {
    list-style: none;
  }
  .menu-group > summary::-webkit-details-marker {
    display: none;
  }
  .menu-plus {
    transition: transform 0.2s ease;
  }
  .menu-group[open] .menu-plus {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    #site-header *,
    #menu-panel > aside,
    .nav-item .dropdown-menu > div {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('menu-btn');
  const menuClose = document.getElementById('menu-close');
  const menuPanel = document.getElementById('menu-panel');
  const menuBackdrop = document.getElementById('menu-backdrop');
  const searchToggleBtn = document.getElementById('search-toggle-btn');
  const quickSearchBar = document.getElementById('quick-search-bar');
  const closeSearchBtn = document.getElementById('close-search-btn');

  // Header đổi màu khi cuộn
  const onScroll = (): void => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 40);
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Dọn dẹp key lưu trữ chung cũ trên trình duyệt để chuyển sang Database
  try {
    localStorage.removeItem('user_wishlist');
    localStorage.removeItem('user_wishlist_slugs');
  } catch {}

  // Mobile drawer
  const openMenu = (): void => {
    if (!menuPanel || !menuBtn) return;
    menuPanel.classList.add('is-open');
    menuBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = (): void => {
    if (!menuPanel || !menuBtn) return;
    menuPanel.classList.remove('is-open');
    menuBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  menuBtn?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);
  menuBackdrop?.addEventListener('click', closeMenu);

  menuPanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    closeMenu();
    quickSearchBar?.classList.add('hidden');
    searchToggleBtn?.setAttribute('aria-expanded', 'false');

    // Bỏ focus để dropdown mở bằng bàn phím cũng đóng lại
    const active = document.activeElement as HTMLElement | null;
    if (active && header?.contains(active)) active.blur();
  });

  // Thanh tìm kiếm nhanh trên Header (hoạt động ở các trang ngoài /san-pham)
  const headerSearchInput = document.getElementById('header-search-input') as HTMLInputElement | null;
  const headerSearchResults = document.getElementById('header-search-results');
  const desktopSearchForm = document.querySelector<HTMLFormElement>('[data-desktop-search]');
  const menuSearchForm = document.querySelector<HTMLFormElement>('[data-menu-search]');

  const openSearchBar = () => {
    if (!quickSearchBar) return;
    quickSearchBar.classList.remove('hidden');
    searchToggleBtn?.setAttribute('aria-expanded', 'true');
    setTimeout(() => headerSearchInput?.focus(), 100);
  };

  const closeSearchBar = () => {
    if (!quickSearchBar) return;
    quickSearchBar.classList.add('hidden');
    searchToggleBtn?.setAttribute('aria-expanded', 'false');
    if (headerSearchResults) {
      headerSearchResults.classList.add('hidden');
      headerSearchResults.innerHTML = '';
    }
  };

  searchToggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (quickSearchBar?.classList.contains('hidden')) {
      openSearchBar();
    } else {
      closeSearchBar();
    }
  });

  closeSearchBtn?.addEventListener('click', closeSearchBar);

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (quickSearchBar && !quickSearchBar.contains(target) && !searchToggleBtn?.contains(target)) {
      if (!quickSearchBar.classList.contains('hidden')) {
        closeSearchBar();
      }
    }
  });

  // Tìm kiếm tức thì với Debounce 250ms
  let searchDebounceTimer: any = null;
  headerSearchInput?.addEventListener('input', () => {
    clearTimeout(searchDebounceTimer);
    const query = headerSearchInput.value.trim();

    if (!query || query.length < 2) {
      if (headerSearchResults) {
        headerSearchResults.classList.add('hidden');
        headerSearchResults.innerHTML = '';
      }
      return;
    }

    searchDebounceTimer = setTimeout(async () => {
      try {
        const res = await fetch(`http://localhost:4000/api/products?search=${encodeURIComponent(query)}&limit=5`);
        if (!res.ok) return;
        const json = await res.json();
        const items = json.success && Array.isArray(json.data) ? json.data : [];

        if (!headerSearchResults) return;
        headerSearchResults.classList.remove('hidden');

        if (items.length === 0) {
          headerSearchResults.innerHTML = `
            <div class="p-4 text-center text-xs text-walnut-800/80">
              Không tìm thấy sản phẩm nào khớp với "<strong>${query}</strong>".
            </div>
          `;
          return;
        }

        const formatPrice = (p: number) => Number(p || 0).toLocaleString('vi-VN') + ' ₫';

        headerSearchResults.innerHTML = `
          <div class="p-2 border-b border-walnut-900/10 bg-sand-100/60 flex items-center justify-between text-[11px] font-bold text-walnut-800 uppercase tracking-wider">
            <span>Sản phẩm gợi ý (${items.length})</span>
            <span class="text-[#B88E28]">KTUFA Luxury</span>
          </div>
          <div class="divide-y divide-walnut-900/10">
            ${items.map((prod: any) => `
              <a
                href="/san-pham/${prod.slug}"
                class="flex items-center gap-3 p-3 hover:bg-white transition-colors group cursor-pointer"
              >
                <div class="h-12 w-12 shrink-0 aspect-square rounded-none bg-sand-200 overflow-hidden border border-walnut-900/10">
                  <img src="${prod.thumbnail || 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=200&q=80'}" alt="${prod.name}" class="h-full w-full object-cover group-hover:scale-105 transition-transform" />
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="text-xs font-bold text-walnut-900 truncate group-hover:text-[#B88E28] transition-colors">${prod.name}</h4>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-[11px] font-bold text-[#B88E28]">${formatPrice(prod.price)}</span>
                    ${prod.categoryLabel ? `<span class="text-[9px] uppercase px-1.5 py-0.2 bg-sand-200 text-walnut-800 font-semibold">${prod.categoryLabel}</span>` : ''}
                    ${prod.material ? `<span class="text-[9px] text-walnut-800/60 truncate">• ${prod.material}</span>` : ''}
                  </div>
                </div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-walnut-800/40 group-hover:text-walnut-900 group-hover:translate-x-0.5 transition-all shrink-0">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            `).join('')}
          </div>
          <a
            href="/san-pham?q=${encodeURIComponent(query)}"
            class="block p-3 text-center text-xs font-bold text-[#173524] bg-sand-100 hover:bg-sand-200 uppercase tracking-wider border-t border-walnut-900/10 transition-colors"
          >
            Xem tất cả kết quả cho "${query}" →
          </a>
        `;
      } catch (err) {
        console.warn('Lỗi tìm kiếm gợi ý:', err);
      }
    }, 250);
  });

  desktopSearchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = headerSearchInput?.value.trim() || '';
    if (q) window.location.href = `/san-pham?q=${encodeURIComponent(q)}`;
  });

  menuSearchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = menuSearchForm.querySelector('input[type="search"]') as HTMLInputElement | null;
    const q = input?.value.trim() || '';
    if (q) window.location.href = `/san-pham?q=${encodeURIComponent(q)}`;
  });
</script>

<script>
  import { readCart, countItems, CART_EVENT } from '../scripts/cart';
  import { readUser, clearUser, sanitizeUserName, AUTH_EVENT } from '../scripts/auth';

  // ----- Badge giỏ hàng -----
  const badge = document.querySelector<HTMLElement>('[data-cart-count]');

  const syncBadge = (): void => {
    if (!badge) return;
    const count = countItems(readCart());
    badge.textContent = String(count);
    badge.style.display = count > 0 ? 'flex' : 'none';
  };

  syncBadge();
  window.addEventListener(CART_EVENT, syncBadge);
  window.addEventListener('storage', syncBadge);
  window.addEventListener(AUTH_EVENT, syncBadge);

  // ----- Trạng thái đăng nhập: hiện tên khách, đổi menu -----
  const authTargets = [
    document.getElementById('site-header'),
    document.getElementById('menu-panel'),
  ];

  const syncAuth = (): void => {
    const user = readUser();

    for (const el of authTargets) {
      if (!el) continue;
      if (user) {
        el.dataset.auth = 'user';
        el.dataset.role = user.role ?? 'customer';
      } else {
        delete el.dataset.auth;
        delete el.dataset.role;
      }
    }

    const cleanName = sanitizeUserName(user?.name, user?.role);
    document.querySelectorAll<HTMLElement>('[data-user-name]').forEach((el) => {
      el.textContent = cleanName;
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-account-link]').forEach((a) => {
      if (user) {
        a.href = '/tai-khoan';
        a.setAttribute('aria-label', 'Tài khoản của ' + cleanName);
        a.title = cleanName;
      } else {
        a.href = '/dang-nhap';
        a.setAttribute('aria-label', 'Đăng nhập');
        a.title = 'Đăng nhập';
      }
    });
  };

  // Tự động kiểm tra và đồng bộ role & avatar mới nhất từ Database
  const refreshUserFromBackend = async () => {
    const token = localStorage.getItem('auth_token');
    if (!token) return;
    try {
      const res = await fetch('http://localhost:4000/api/auth/me', {
        headers: { Authorization: `Bearer ${token}` },
      });
      const data = await res.json();
      if (data.success && data.user) {
        let fullUser: any = readUser() || {};
        try {
          const raw = localStorage.getItem('current_user');
          if (raw) fullUser = JSON.parse(raw);
        } catch {}

        // Kiểm tra tính nhất quán giữa token và phiên đăng nhập hiện tại
        const currentEmail = (fullUser.email || '').toLowerCase().trim();
        const tokenEmail = (data.user.email || '').toLowerCase().trim();
        if (currentEmail && tokenEmail && currentEmail !== tokenEmail) {
          console.warn('[Header] Token auth không khớp với tài khoản hiện tại, hủy bỏ token cũ.');
          localStorage.removeItem('auth_token');
          return;
        }

        fullUser.avatar = data.user.avatar || fullUser.avatar || '';
        fullUser.role = data.user.role || 'customer';
        fullUser.name = sanitizeUserName(data.user.full_name || fullUser.name, fullUser.role);
        fullUser.email = data.user.email || fullUser.email;
        if (data.user.phone) fullUser.phone = data.user.phone;
        localStorage.setItem('current_user', JSON.stringify(fullUser));
        syncAuth();
      } else {
        localStorage.removeItem('auth_token');
      }
    } catch {}
  };

  syncAuth();
  refreshUserFromBackend();
  window.addEventListener(AUTH_EVENT, syncAuth);
  window.addEventListener('storage', syncAuth);

  // ===== XỬ LÝ MODAL HỒ SƠ & TÀI KHOẢN CÁ NHÂN =====
  const profileModal = document.getElementById('user-profile-modal');
  const btnCloseProfile = document.getElementById('btn-close-profile-modal');
  const btnCloseProfileFooter = document.getElementById('btn-close-profile-modal-footer');

  const closeProfileModal = () => profileModal?.classList.add('hidden');
  btnCloseProfile?.addEventListener('click', closeProfileModal);
  btnCloseProfileFooter?.addEventListener('click', closeProfileModal);
  profileModal?.addEventListener('click', (e) => {
    if (e.target === profileModal) closeProfileModal();
  });

  // Chuyển tab trong modal
  const switchProfileTab = (tabName: string) => {
    document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]').forEach((btn) => {
      const isActive = btn.dataset.tabBtn === tabName;
      btn.className = `profile-tab-button py-3.5 border-b-2 cursor-pointer transition-colors whitespace-nowrap ${
        isActive 
          ? 'border-[#173524] text-[#173524] font-bold' 
          : 'border-transparent text-walnut-800/70 hover:text-walnut-900'
      }`;
    });

    document.querySelectorAll<HTMLElement>('.tab-pane').forEach((pane) => {
      pane.classList.toggle('hidden', pane.id !== `tab-pane-${tabName}`);
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      switchProfileTab(btn.dataset.tabBtn || 'profile');
    });
  });

  // Mở modal và nạp thông tin người dùng
  const openProfileModal = async (initialTab = 'profile') => {
    const user = readUser();
    if (!user) {
      window.location.href = '/dang-nhap';
      return;
    }

    // Hiển thị modal và chuyển đúng tab ngay lập tức
    switchProfileTab(initialTab);
    profileModal?.classList.remove('hidden');

    // Đọc thông tin chi tiết từ current_user nếu có
    let fullUser: any = user;
    try {
      const raw = localStorage.getItem('current_user');
      if (raw) fullUser = JSON.parse(raw);
    } catch {}

    // Đồng bộ trực tiếp từ backend nếu có token
    const token = localStorage.getItem('auth_token');
    if (token) {
      try {
        const meRes = await fetch('http://localhost:4000/api/auth/me', {
          headers: { Authorization: `Bearer ${token}` },
        });
        const meData = await meRes.json();
        if (meData.success && meData.user) {
          const currentEmail = (fullUser.email || '').toLowerCase().trim();
          const tokenEmail = (meData.user.email || '').toLowerCase().trim();
          if (currentEmail && tokenEmail && currentEmail !== tokenEmail) {
            console.warn('[Header openProfileModal] Token không thuộc về tài khoản hiện tại, xóa token cũ.');
            localStorage.removeItem('auth_token');
          } else {
            if (meData.user.avatar) fullUser.avatar = meData.user.avatar;
            if (meData.user.role) fullUser.role = meData.user.role;
            if (meData.user.full_name) fullUser.name = meData.user.full_name;
            if (meData.user.email) fullUser.email = meData.user.email;
            localStorage.setItem('current_user', JSON.stringify(fullUser));
          }
        }
      } catch {}
    }

    const isAdmin = (fullUser.role === 'admin' || user.role === 'admin');
    const name = sanitizeUserName(fullUser.name || 'Khách', fullUser.role);
    const email = fullUser.email || user.email || (isAdmin ? 'admin@noithat.vn' : 'Chưa cập nhật');
    const phone = fullUser.phone && fullUser.phone !== 'Đăng nhập Google' ? fullUser.phone : 'Chưa cập nhật';
    const tier = fullUser.tier || (isAdmin ? 'Quản Trị Viên' : 'Hội Viên Thân Thiết');
    const spent = fullUser.spent || '0 ₫';
    const orders = typeof fullUser.orders === 'number' ? `${fullUser.orders} đơn hàng` : '0 đơn hàng';
    const avatar = fullUser.avatar || user.avatar || '';

    // Cập nhật DOM Modal
    const modalName = document.getElementById('profile-modal-name');
    const modalEmail = document.getElementById('profile-modal-email');
    const modalTier = document.getElementById('profile-modal-tier');
    const modalAvatar = document.getElementById('profile-modal-avatar');
    if (modalName) modalName.textContent = name;
    if (modalEmail) modalEmail.textContent = email;
    if (modalTier) modalTier.textContent = tier;
    
    // Hiển thị ảnh đại diện Google hoặc ảnh thật nếu có
    if (modalAvatar) {
      if (avatar) {
        modalAvatar.innerHTML = `<img src="${avatar}" alt="${name}" class="h-full w-full object-cover rounded-none" referrerpolicy="no-referrer" />`;
      } else {
        const initials = name.split(' ').map((n: string) => n[0]).slice(-2).join('');
        modalAvatar.textContent = initials || 'KH';
      }
    }

    // Phân quyền: CHỈ tài khoản Admin mới nhìn thấy nút Trang quản trị (Admin)
    const adminLink = document.getElementById('profile-admin-link');
    if (adminLink) {
      if (isAdmin) {
        adminLink.classList.remove('hidden');
        adminLink.classList.add('inline-flex');
      } else {
        adminLink.classList.add('hidden');
        adminLink.classList.remove('inline-flex');
      }
    }
    const infoName = document.getElementById('profile-info-name');
    const infoEmail = document.getElementById('profile-info-email');
    const infoPhone = document.getElementById('profile-info-phone');
    const infoTier = document.getElementById('profile-info-tier');
    const infoSpent = document.getElementById('profile-info-spent');
    const infoOrders = document.getElementById('profile-info-orders');

    if (infoName) infoName.textContent = name;
    if (infoEmail) infoEmail.textContent = email;
    if (infoPhone) infoPhone.textContent = phone;
    if (infoTier) infoTier.textContent = tier;
    if (infoSpent) infoSpent.textContent = spent;
    if (infoOrders) infoOrders.textContent = orders;

    // Address Info
    const addrName = document.getElementById('address-recipient-name');
    const addrPhone = document.getElementById('address-recipient-phone');
    if (addrName) addrName.textContent = name;
    if (addrPhone) addrPhone.textContent = phone;

    // Orders Info (Đồng bộ trực tiếp từ Database API theo từng tài khoản)
    const ordersContainer = document.getElementById('tab-pane-orders');
    const renderUserOrders = async () => {
      if (!ordersContainer) return;
      ordersContainer.innerHTML = '<div class="text-center py-6 text-xs text-walnut-800/60">Đang tải danh sách đơn hàng...</div>';

      let userOrders: any[] = [];
      const token = localStorage.getItem('auth_token');

      if (token) {
        try {
          const res = await fetch('http://localhost:4000/api/orders/my-orders', {
            headers: { Authorization: `Bearer ${token}` },
          });
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            userOrders = json.data;
            if (json.stats) {
              if (infoSpent) infoSpent.textContent = new Intl.NumberFormat('vi-VN').format(json.stats.totalSpent) + ' ₫';
              if (infoOrders) infoOrders.textContent = `${json.stats.completedCount} đơn hàng`;
            }
          }
        } catch (err) {
          console.warn('Lỗi kết nối API My Orders:', err);
        }
      }

      // Tải bổ sung các đơn hàng gần đây từ localStorage (đảm bảo đơn vừa đặt luôn xuất hiện)
      let recentCodes: string[] = [];
      try {
        recentCodes = JSON.parse(localStorage.getItem('my_recent_orders') || '[]');
      } catch {}

      for (const code of recentCodes) {
        if (!userOrders.some((o: any) => o.orderCode === code)) {
          try {
            const res = await fetch(`http://localhost:4000/api/orders/${encodeURIComponent(code)}`);
            const json = await res.json();
            if (json.success && json.data) {
              userOrders.unshift(json.data);
            }
          } catch (err) {
            console.warn('Lỗi tải chi tiết đơn gần đây:', code, err);
          }
        }
      }

      if (userOrders.length === 0) {
        ordersContainer.innerHTML = `
          <div class="text-center py-8 text-xs text-walnut-800/70">
            <p class="text-3xl mb-2 text-walnut-900/30">📦</p>
            <p class="font-bold text-sm text-walnut-900">Bạn chưa có đơn hàng nào</p>
            <p class="mt-1 text-walnut-800/70">Khi bạn đặt mua sản phẩm, tiến độ giao hàng sẽ xuất hiện tại đây.</p>
            <a href="/san-pham" class="mt-4 inline-block bg-clay-600 text-white px-5 py-2 rounded text-xs font-semibold hover:bg-clay-500 transition-colors">
              Khám phá sản phẩm ngay →
            </a>
          </div>
        `;
      } else {
        const ordersListHtml = userOrders.map((order: any) => {
          const dateStr = new Date(order.createdAt).toLocaleDateString('vi-VN');
          const isPaid = order.paymentStatus === 'paid';
          const isDelivered = order.orderStatus === 'completed' || order.orderStatus === 'delivered';
          const statusText = isDelivered ? 'Đã giao thành công' : (order.orderStatus === 'shipping' ? 'Đang giao hàng' : (isPaid ? 'Đã thanh toán (Chờ giao)' : 'Chờ xác nhận'));
          const statusClass = isDelivered ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : (isPaid ? 'bg-blue-100 text-blue-800 border-blue-300' : 'bg-amber-100 text-amber-800 border-amber-300');

          const itemsHtml = (order.items || []).map((it: any) => `
            <div class="flex justify-between items-center text-xs mt-1">
              <div>
                <p class="font-semibold text-walnut-900">${it.name} (x${it.qty})</p>
              </div>
              <span class="font-bold text-clay-700 text-xs">${new Intl.NumberFormat('vi-VN').format(it.total || (it.price * it.qty))} ₫</span>
            </div>
          `).join('');

          return `
            <div class="rounded-lg border border-walnut-900/10 bg-sand-100/50 p-4 space-y-2.5 hover:border-walnut-900/30 transition-all shadow-xs">
              <div class="flex items-center justify-between border-b border-walnut-900/10 pb-2">
                <div>
                  <span class="font-mono text-xs font-bold text-walnut-900">#${order.orderCode}</span>
                  <span class="text-[11px] text-walnut-800/60 ml-2">${dateStr}</span>
                </div>
                <span class="rounded border px-2.5 py-0.5 text-[10px] font-semibold ${statusClass}">
                  ${statusText}
                </span>
              </div>
              ${itemsHtml}
              <div class="border-t border-walnut-900/10 pt-2 flex items-center justify-between text-xs">
                <div>
                  <span class="text-walnut-800 text-[11px]">Tổng tiền:</span>
                  <span class="text-clay-700 text-sm font-bold ml-1">${new Intl.NumberFormat('vi-VN').format(order.total)} ₫</span>
                </div>
                <a href="/tai-khoan?tab=orders&highlight=${order.orderCode}" class="inline-flex items-center gap-1 bg-[#173524] text-[#E6CA85] hover:bg-[#204932] hover:text-white px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider transition-colors shadow-xs">
                  <span>Chi tiết</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          `;
        }).join('');

        ordersContainer.innerHTML = `
          <div class="space-y-3">
            ${ordersListHtml}
            <div class="pt-2 sticky bottom-0 bg-sand-50/95 pb-1 backdrop-blur-xs">
              <a href="/tai-khoan?tab=orders" class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-[#173524] hover:bg-[#204932] text-[#E6CA85] hover:text-white rounded text-xs font-bold uppercase tracking-widest transition-all shadow-md border border-[#D8B670]/40">
                <span>Xem toàn bộ lịch sử đơn hàng trang chi tiết</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          </div>
        `;
      }
    };
    renderUserOrders();

    // Wishlist Info (Đồng bộ trực tiếp từ Database API theo từng tài khoản)
    const wishlistContainer = document.getElementById('tab-pane-wishlist');
    const renderWishlistItems = async () => {
      if (!wishlistContainer) return;
      wishlistContainer.innerHTML = '<div class="text-center py-6 text-xs text-walnut-800/60">Đang tải danh sách yêu thích từ máy chủ...</div>';

      let wishItems: any[] = [];
      const token = localStorage.getItem('auth_token');

      if (token) {
        try {
          const res = await fetch('http://localhost:4000/api/wishlist', {
            headers: { Authorization: `Bearer ${token}` },
          });
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            wishItems = json.data;
          }
        } catch (err) {
          console.warn('Lỗi kết nối API Wishlist:', err);
        }
      } else {
        // Fallback khách vãng lai
        try {
          wishItems = JSON.parse(localStorage.getItem('user_wishlist_guest') || '[]');
        } catch {}
      }

      if (wishItems.length === 0) {
        wishlistContainer.innerHTML = `
          <div class="text-center py-8 text-xs text-walnut-800/70">
            <p class="text-3xl mb-2 text-walnut-900/30">♡</p>
            <p class="font-bold text-sm text-walnut-900">Danh sách yêu thích đang trống</p>
            <p class="mt-1 text-walnut-800/70">Hãy bấm vào biểu tượng trái tim ở các trang sản phẩm để lưu lại tại đây nhé.</p>
          </div>
        `;
      } else {
        wishlistContainer.innerHTML = wishItems.map((item: any) => `
          <div class="rounded-lg border border-walnut-900/10 bg-sand-100/50 p-3.5 flex items-center justify-between gap-4">
            <div>
              <h4 class="font-semibold text-xs text-walnut-900">${item.name}</h4>
              <p class="font-bold text-clay-700 text-xs mt-0.5">${new Intl.NumberFormat('vi-VN').format(item.price)} ₫</p>
            </div>
            <div class="flex items-center gap-3">
              <a href="/san-pham/${item.slug}" class="text-xs uppercase tracking-wider text-walnut-900 font-semibold hover:text-clay-600 underline">
                Xem sản phẩm →
              </a>
              <button type="button" data-remove-wishlist="${item.slug}" class="text-xs text-red-500 hover:text-red-700 p-1 cursor-pointer font-bold" title="Xóa khỏi yêu thích">
                ✕
              </button>
            </div>
          </div>
        `).join('');

        wishlistContainer.querySelectorAll<HTMLButtonElement>('[data-remove-wishlist]').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const slugToRemove = btn.dataset.removeWishlist;
            if (!slugToRemove) return;
            btn.disabled = true;

            if (token) {
              try {
                await fetch(`http://localhost:4000/api/wishlist/${slugToRemove}`, {
                  method: 'DELETE',
                  headers: { Authorization: `Bearer ${token}` },
                });
              } catch (e) {
                console.error(e);
              }
            } else {
              let guestList: any[] = [];
              try { guestList = JSON.parse(localStorage.getItem('user_wishlist_guest') || '[]'); } catch {}
              guestList = guestList.filter((i: any) => i.slug !== slugToRemove);
              localStorage.setItem('user_wishlist_guest', JSON.stringify(guestList));
            }

            window.dispatchEvent(new Event('wishlist:changed'));
            renderWishlistItems();
          });
        });
      }
    };

    renderWishlistItems();
    window.addEventListener('wishlist:changed', renderWishlistItems);
    window.addEventListener('orders:changed', renderUserOrders);

    switchProfileTab(initialTab);
    profileModal?.classList.remove('hidden');
  };

  // Bắt sự kiện click vào nút tài khoản: Nếu đã đăng nhập thì đi thẳng tới trang chi tiết tài khoản (/tai-khoan)
  document.querySelectorAll<HTMLElement>('[data-account-link]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const user = readUser();
      if (user) {
        // Cho phép chuyển thẳng tới trang tài khoản chi tiết (/tai-khoan)
        window.location.href = '/tai-khoan';
      }
    });
  });

  // Bắt sự kiện click vào các nút mục trong menu dropdown (Tài khoản, Đơn hàng, Yêu thích, Sổ địa chỉ)
  document.querySelectorAll<HTMLElement>('[data-open-profile]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const tab = btn.dataset.openProfile || 'profile';
      window.location.href = `/tai-khoan?tab=${tab}`;
    });
  });

  // Xử lý Đăng xuất
  document.querySelectorAll<HTMLElement>('[data-logout]').forEach((btn) => {
    btn.addEventListener('click', () => {
      clearUser();
      closeProfileModal();
      window.location.href = '/';
    });
  });
</script>