---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  position?: string;
  title: string;
  description: string;
  breadcrumbLabel: string;
  eyebrow: string;
  heroHeadingLines: string[];
  heroSubtitle: string;
  heroImage: string;
  heroCtaText?: string;
}

const {
  position = '',
  title,
  description,
  breadcrumbLabel,
  eyebrow,
  heroHeadingLines,
  heroSubtitle,
  heroImage,
  heroCtaText = 'Xem chi tiết chính sách',
} = Astro.props;

const splitHeadingLines = (rawTitle: string, fallbackLines: string[]) => {
  const trimmed = (rawTitle || '').trim();
  if (!trimmed) return fallbackLines;
  const parts = trimmed.split(/\r?\n|\s*\|\s*/).map((s) => s.trim()).filter(Boolean);
  return parts.length > 0 ? parts : fallbackLines;
};

let banner = {
  eyebrow,
  headingLines: heroHeadingLines,
  subtitle: heroSubtitle,
  imageUrl: heroImage,
  ctaText: heroCtaText,
  ctaHref: '#noi-dung',
};

if (position) {
  try {
    const res = await fetch(
      `http://localhost:4000/api/banners?position=${encodeURIComponent(position)}&activeOnly=true`,
      { signal: AbortSignal.timeout(5000) }
    );
    if (res.ok) {
      const json = await res.json();
      if (json.success && Array.isArray(json.data) && json.data.length > 0) {
        const top = json.data[0];
        banner = {
          eyebrow: top.subtitle || eyebrow,
          headingLines: splitHeadingLines(top.title, heroHeadingLines),
          subtitle: top.description || heroSubtitle,
          imageUrl: top.imageUrl || heroImage,
          ctaText: top.buttonText || heroCtaText,
          ctaHref: top.linkUrl || '#noi-dung',
        };
      }
    }
  } catch {
    // Dùng fallback mặc định khi backend chưa sẵn sàng
  }
}
---

<BaseLayout noPaddingTop={true} title={title} description={description}>
  <!-- 1. HERO CINEMATIC FULL MÀN HÌNH: ĐỒNG BỘ TỪ ADMIN BANNER -->
  <section
    data-policy-hero
    data-position={position}
    data-fallback-image={heroImage}
    class="relative w-full h-screen min-h-screen flex items-center justify-center overflow-hidden bg-walnut-900 text-sand-50"
  >
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img
        data-policy-img
        src={banner.imageUrl}
        alt={breadcrumbLabel}
        class="policy-hero-img h-full w-full object-cover opacity-50"
        loading="eager"
        onerror={`this.onerror=null;this.src='${heroImage}'`}
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/65"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center flex flex-col items-center pt-24 sm:pt-28 pb-20">
      <nav class="inline-flex items-center gap-2 text-[10px] sm:text-[11px] uppercase tracking-[0.25em] text-[#D8B670] mb-4" aria-label="Breadcrumb">
        <a href="/" class="text-sand-100/70 hover:text-white transition-colors">Trang chủ</a>
        <span class="text-sand-100/40">/</span>
        <span class="text-[#D8B670] font-semibold">{breadcrumbLabel}</span>
      </nav>

      <p data-policy-eyebrow class="text-[10px] sm:text-[11px] uppercase tracking-[0.42em] text-sand-50/80 font-sans">
        {banner.eyebrow}
      </p>

      <h1 data-policy-heading class="mt-5 font-display text-3xl sm:text-5xl lg:text-6xl font-medium uppercase tracking-[0.12em] leading-[1.2] text-sand-50">
        {banner.headingLines.map((line, idx) => (
          <>
            {idx > 0 && <br />}
            {line}
          </>
        ))}
      </h1>

      <p data-policy-subtitle class="mt-6 max-w-xl text-sm leading-relaxed text-sand-50/80">
        {banner.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          data-policy-cta
          href={banner.ctaHref}
          class="inline-block border border-sand-50/70 px-7 py-2.5 text-[11px] uppercase tracking-[0.22em] text-sand-50 transition-colors hover:bg-sand-50 hover:text-walnut-900"
        >
          {banner.ctaText}
        </a>
        <a
          href="tel:1900636884"
          class="policy-hotline-btn inline-block border border-[#D8B670]/70 bg-[#173524]/40 backdrop-blur-xs px-7 py-2.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#F3E5AB] transition-all duration-200 hover:bg-[#E6CA85] hover:border-[#E6CA85] hover:text-[#173524] hover:shadow-[0_0_24px_rgba(230,202,133,0.45)]"
        >
          Hotline: 1900 636 884
        </a>
      </div>
    </div>

    <a
      href="#noi-dung"
      class="absolute bottom-7 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2 text-[10px] uppercase tracking-[0.38em] text-sand-50/65 hover:text-sand-50 transition-colors"
    >
      <span>Cuộn xuống</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" class="animate-bounce">
        <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <!-- 2. NỘI DUNG CHÍNH PHẲNG, TỐI GIẢN, ÍT LỒNG CARD -->
  <section id="noi-dung" class="scroll-mt-24 sm:scroll-mt-28 bg-[#FAF8F5] py-14 sm:py-20 px-4">
    <div class="mx-auto max-w-4xl space-y-12">
      <slot />

      <!-- Chân trang hỗ trợ tối giản (không lồng card) -->
      <div class="pt-8 border-t border-walnut-900/15 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-walnut-800/80">
        <p>
          Cần hỗ trợ thêm? Gọi <a href="tel:1900636884" class="font-bold text-[#173524] underline underline-offset-4">1900 636 884</a> (08:30 – 21:00) hoặc ghé Showroom <strong>615 Âu Cơ, Q. Tân Phú, TP. HCM</strong>.
        </p>
        <a href="/san-pham" class="font-bold uppercase tracking-[0.18em] text-[11px] text-[#173524] hover:text-[#997734] transition-colors shrink-0">
          Khám phá bộ sưu tập →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes policySlowZoom {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  .policy-hero-img {
    animation: policySlowZoom 9s ease-out forwards;
  }

  .policy-hotline-btn:hover {
    background-color: #E6CA85;
    border-color: #E6CA85;
    color: #173524;
  }

  @media (prefers-reduced-motion: reduce) {
    .policy-hero-img {
      animation: none !important;
      transform: scale(1) !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const hero = document.querySelector<HTMLElement>('[data-policy-hero]');

    // Smooth scroll cho liên kết trỏ tới #noi-dung trên cùng trang
    hero?.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('a');
      if (!link) return;
      const href = link.getAttribute('href') || '';
      const isSamePageAnchor =
        href === '#noi-dung' ||
        (link.hash === '#noi-dung' && link.pathname.replace(/\/$/, '') === window.location.pathname.replace(/\/$/, ''));
      if (isSamePageAnchor) {
        const target = document.getElementById('noi-dung');
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });

    // Đồng bộ động từ Admin API để thay đổi ở /admin/banner áp dụng ngay
    const pos = hero?.dataset.position;
    if (!hero || !pos) return;

    try {
      const res = await fetch(
        `http://localhost:4000/api/banners?position=${encodeURIComponent(pos)}&activeOnly=true`
      );
      if (!res.ok) return;
      const json = await res.json();
      if (!json.success || !Array.isArray(json.data) || json.data.length === 0) return;

      const top = json.data[0];
      const imgEl = hero.querySelector<HTMLImageElement>('[data-policy-img]');
      const eyebrowEl = hero.querySelector<HTMLElement>('[data-policy-eyebrow]');
      const headingEl = hero.querySelector<HTMLElement>('[data-policy-heading]');
      const subtitleEl = hero.querySelector<HTMLElement>('[data-policy-subtitle]');
      const ctaEl = hero.querySelector<HTMLAnchorElement>('[data-policy-cta]');

      if (imgEl && top.imageUrl && imgEl.getAttribute('src') !== top.imageUrl) {
        imgEl.src = top.imageUrl;
      }
      if (eyebrowEl && top.subtitle) {
        eyebrowEl.textContent = top.subtitle;
      }
      if (headingEl && top.title) {
        const lines = String(top.title)
          .split(/\r?\n|\s*\|\s*/)
          .map((s) => s.trim())
          .filter(Boolean);
        if (lines.length > 0) {
          headingEl.textContent = '';
          lines.forEach((line, idx) => {
            if (idx > 0) headingEl.appendChild(document.createElement('br'));
            headingEl.appendChild(document.createTextNode(line));
          });
        }
      }
      if (subtitleEl && top.description) {
        subtitleEl.textContent = top.description;
      }
      if (ctaEl) {
        if (top.buttonText) ctaEl.textContent = top.buttonText;
        if (top.linkUrl) ctaEl.setAttribute('href', top.linkUrl);
      }
    } catch {
      // Giữ nguyên dữ liệu SSR/fallback khi offline
    }
  });
</script>
