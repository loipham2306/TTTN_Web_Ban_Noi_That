---
import AuthBannerShowcase from './AuthBannerShowcase.astro';

interface Props {
  initialMode: 'login' | 'register';
}

const { initialMode } = Astro.props;
const isLogin = initialMode === 'login';
---

<section
  id="auth-page-section"
  data-initial-mode={initialMode}
  class="relative min-h-[calc(100svh-6rem)] sm:min-h-[calc(100svh-7rem)] flex items-center justify-center py-4 sm:py-6 px-4 bg-[#FAF8F5] overflow-hidden"
>
  <!-- Hiệu ứng ánh sáng nền tinh tế -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(216,182,112,0.14),transparent_50%)]"></div>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(23,53,36,0.08),transparent_55%)]"></div>

  <div class="relative mx-auto max-w-6xl w-full">
    <div id="auth-portal-card" class="grid lg:grid-cols-12 lg:min-h-[552px] bg-white border border-walnut-900/15 shadow-[0_24px_64px_-16px_rgba(23,53,36,0.14)] overflow-hidden">

      <!-- CỘT TRÁI: BANNER ĐỘNG DÙNG CHUNG (GIỮ NGUYÊN 100% KHI CHUYỂN TAB) -->
      <div class="lg:col-span-6">
        <AuthBannerShowcase
          position="auth"
          fallbackTitle="Không gian sống đẳng cấp bắt đầu từ những lựa chọn chỉn chu."
          fallbackSubtitle="NỘI THẤT CAO CẤP KTUFA"
          fallbackDescription="Lưu sản phẩm yêu thích, theo dõi đơn hàng vận chuyển và nhận ưu đãi đặc quyền dành riêng cho thành viên."
          highlights={[
            'Bảo mật Enterprise',
            'Ưu đãi hội viên VIP',
            'Theo dõi đơn 24/7',
          ]}
        />
      </div>

      <!-- CỘT PHẢI: CHỨA CẢ PANE ĐĂNG NHẬP & ĐĂNG KÝ (CHỈ TRƯỢT NỘI DUNG BÊN TRONG) -->
      <div class="lg:col-span-6 relative p-6 sm:p-8 lg:px-10 lg:py-6 flex flex-col justify-center bg-white overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52] lg:hidden"></div>

        <!-- =======================================================
             PANE 1: ĐĂNG NHẬP
             ======================================================= -->
        <div id="auth-pane-login" class={`mx-auto w-full max-w-md auth-stagger ${isLogin ? '' : 'hidden'}`}>
          <div class="mb-1.5">
            <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.25em] text-[#997734]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#D8B670]"></span>
              Tài khoản thành viên KTUFA
            </span>
          </div>

          <h1 class="font-display text-3xl tracking-tight sm:text-4xl text-walnut-900 font-semibold">Đăng nhập</h1>
          <p class="mt-1.5 text-sm text-walnut-800/75">Nhập email và mật khẩu của bạn để tiếp tục trải nghiệm.</p>

          <!-- Nút Đăng nhập nhanh bằng Gmail -->
          <div class="mt-6 flex flex-col items-center justify-center min-h-[44px]">
            <div id="google-btn-official" class="w-full flex justify-center"></div>

            <button
              type="button"
              id="btn-google-login"
              class="flex w-full items-center justify-center gap-3 border border-walnut-900/20 bg-[#FAF8F5] py-3 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-900 transition-all duration-200 hover:bg-white hover:border-[#173524] hover:shadow-md cursor-pointer"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
              </svg>
              <span>Tiếp tục bằng Google</span>
            </button>
          </div>

          <div class="my-5 flex items-center gap-3">
            <div class="h-px flex-1 bg-walnut-900/15"></div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-walnut-800/55">HOẶC DÙNG TÀI KHOẢN</span>
            <div class="h-px flex-1 bg-walnut-900/15"></div>
          </div>

          <!-- CẢNH BÁO NỔI BẬT TRỰC TIẾP TRÊN FORM -->
          <div id="login-alert-banner" class="hidden mb-4 border border-red-300 bg-red-50 p-3.5 text-xs text-red-900 shadow-sm transition-all duration-300">
            <div class="flex items-start gap-3">
              <svg class="h-5 w-5 text-red-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1">
                <p id="alert-banner-title" class="font-bold text-red-950 uppercase tracking-wider text-[11px]">Yêu cầu quyền Quản trị viên</p>
                <p id="alert-banner-desc" class="mt-1 text-red-800 leading-relaxed text-xs">Khu vực Quản trị yêu cầu đăng nhập tài khoản Quản trị viên (Admin).</p>
              </div>
            </div>
          </div>

          <form id="login-form" novalidate class="flex flex-col gap-4">
            <div class="group">
              <label for="login-email" class="block text-[11px] font-semibold uppercase tracking-[0.2em] text-walnut-800">Email *</label>
              <div class="relative mt-1.5">
                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-walnut-800/45 transition-colors group-focus-within:text-[#173524]">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </span>
                <input
                  id="login-email"
                  name="email"
                  type="email"
                  required
                  placeholder="an.nguyen@gmail.com"
                  autocomplete="email"
                  class="w-full border border-walnut-900/20 bg-[#FAF8F5]/70 pl-10 pr-4 py-2.5 text-sm text-walnut-900 outline-none transition-all duration-200 focus:border-[#173524] focus:bg-white focus:ring-2 focus:ring-[#D8B670]/25"
                />
              </div>
            </div>

            <div class="group">
              <div class="flex items-center justify-between">
                <label for="login-password" class="block text-[11px] font-semibold uppercase tracking-[0.2em] text-walnut-800">Mật khẩu *</label>
                <a href="/quen-mat-khau" class="text-[11px] font-medium text-walnut-800/75 hover:underline transition-colors hover:text-[#173524]">Quên mật khẩu?</a>
              </div>
              <div class="relative mt-1.5">
                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-walnut-800/45 transition-colors group-focus-within:text-[#173524]">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                </span>
                <input
                  id="login-password"
                  name="password"
                  type="password"
                  required
                  autocomplete="current-password"
                  placeholder="Nhập mật khẩu"
                  class="w-full border border-walnut-900/20 bg-[#FAF8F5]/70 pl-10 pr-11 py-2.5 text-sm text-walnut-900 outline-none transition-all duration-200 focus:border-[#173524] focus:bg-white focus:ring-2 focus:ring-[#D8B670]/25"
                />
                <button
                  type="button"
                  id="toggle-login-password"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-walnut-800/50 hover:text-[#173524] transition-colors p-1 cursor-pointer focus:outline-none"
                  aria-label="Xem mật khẩu"
                  title="Xem hoặc ẩn mật khẩu"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                </button>
              </div>
            </div>

            <button
              type="submit"
              class="auth-cta-shimmer relative overflow-hidden mt-2 bg-[#173524] border border-[#D8B670]/50 px-8 py-3.5 text-xs uppercase tracking-[0.22em] font-bold text-[#E6CA85] transition-all duration-200 hover:bg-[#1f4730] hover:text-white shadow-md cursor-pointer"
            >
              <span class="relative z-10">Đăng nhập</span>
            </button>
          </form>

          <p class="mt-6 text-xs text-walnut-800/80 text-center">
            Chưa có tài khoản?
            <a
              href="/dang-ky"
              data-switch-auth="register"
              class="font-bold text-[#173524] underline underline-offset-4 transition-colors hover:text-[#997734]"
            >
              Đăng ký ngay
            </a>
          </p>
        </div>

        <!-- =======================================================
             PANE 2: ĐĂNG KÝ
             ======================================================= -->
        <div id="auth-pane-register" class={`mx-auto w-full max-w-lg auth-stagger ${isLogin ? 'hidden' : ''}`}>
          <div class="mb-1">
            <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.25em] text-[#997734]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#D8B670]"></span>
              Thành viên mới KTUFA
            </span>
          </div>

          <h1 class="font-display text-2xl tracking-tight sm:text-3xl text-walnut-900 font-semibold">Đăng ký thành viên</h1>
          <p class="mt-1 text-xs sm:text-sm text-walnut-800/75">Điền thông tin bên dưới để tạo tài khoản mới.</p>

          <!-- Nút Đăng ký nhanh bằng Gmail (Google OAuth) -->
          <div class="mt-3.5 flex flex-col items-center justify-center min-h-[42px]">
            <div id="google-btn-official-signup" class="w-full flex justify-center"></div>

            <button
              type="button"
              id="btn-google-signup"
              class="flex w-full items-center justify-center gap-3 border border-walnut-900/20 bg-[#FAF8F5] py-2 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-900 transition-all duration-200 hover:bg-white hover:border-[#173524] hover:shadow-md cursor-pointer"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
              </svg>
              <span>Đăng ký nhanh bằng Google</span>
            </button>
          </div>

          <div class="my-3 flex items-center gap-3">
            <div class="h-px flex-1 bg-walnut-900/15"></div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-walnut-800/55">HOẶC DÙNG EMAIL</span>
            <div class="h-px flex-1 bg-walnut-900/15"></div>
          </div>

          <!-- CẢNH BÁO NỔI BẬT TRỰC TIẾP TRÊN FORM -->
          <div id="register-alert-banner" class="hidden mb-3 border border-red-300 bg-red-50 p-3 text-xs text-red-900 shadow-sm transition-all duration-300">
            <div class="flex items-start gap-3">
              <svg id="reg-alert-banner-icon" class="h-5 w-5 text-red-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1">
                <p id="reg-alert-banner-title" class="font-bold text-red-950 uppercase tracking-wider text-[11px]">Cảnh báo</p>
                <div id="reg-alert-banner-desc" class="mt-1 text-red-800 leading-relaxed text-xs"></div>
              </div>
              <button type="button" id="btn-close-alert" class="text-red-400 hover:text-red-700 transition-colors p-0.5" aria-label="Đóng cảnh báo">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>

          <form id="register-form" novalidate class="flex flex-col gap-2.5">
            <!-- Hàng 1: Họ tên + SĐT -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="group">
                <label for="reg-name" class="block text-[10.5px] font-semibold uppercase tracking-[0.18em] text-walnut-800">Họ và tên *</label>
                <div class="relative mt-1">
                  <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-walnut-800/45 transition-colors group-focus-within:text-[#173524]">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                  </span>
                  <input
                    id="reg-name"
                    name="fullname"
                    type="text"
                    required
                    placeholder="Nguyễn Văn An"
                    autocomplete="name"
                    class="w-full border border-walnut-900/20 bg-[#FAF8F5]/70 pl-9 pr-3 py-2 text-sm text-walnut-900 outline-none transition-all duration-200 focus:border-[#173524] focus:bg-white focus:ring-2 focus:ring-[#D8B670]/25"
                  />
                </div>
                <p id="err-fullname" class="mt-0.5 hidden text-xs text-red-600 font-medium"></p>
              </div>

              <div class="group">
                <label for="reg-phone" class="block text-[10.5px] font-semibold uppercase tracking-[0.18em] text-walnut-800">Số điện thoại *</label>
                <div class="relative mt-1">
                  <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-walnut-800/45 transition-colors group-focus-within:text-[#173524]">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </span>
                  <input
                    id="reg-phone"
                    name="phone"
                    type="tel"
                    required
                    placeholder="0908 123 456"
                    autocomplete="tel"
                    class="w-full border border-walnut-900/20 bg-[#FAF8F5]/70 pl-9 pr-3 py-2 text-sm text-walnut-900 outline-none transition-all duration-200 focus:border-[#173524] focus:bg-white focus:ring-2 focus:ring-[#D8B670]/25"
                  />
                </div>
                <p id="err-phone" class="mt-0.5 hidden text-xs text-red-600 font-medium"></p>
              </div>
            </div>

            <!-- Hàng 2: Email -->
            <div class="group">
              <label for="reg-email" class="block text-[10.5px] font-semibold uppercase tracking-[0.18em] text-walnut-800">Email *</label>
              <div class="relative mt-1">
                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-walnut-800/45 transition-colors group-focus-within:text-[#173524]">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </span>
                <input
                  id="reg-email"
                  name="email"
                  type="email"
                  required
                  placeholder="an.nguyen@gmail.com"
                  autocomplete="email"
                  class="w-full border border-walnut-900/20 bg-[#FAF8F5]/70 pl-10 pr-4 py-2 text-sm text-walnut-900 outline-none transition-all duration-200 focus:border-[#173524] focus:bg-white focus:ring-2 focus:ring-[#D8B670]/25"
                />
              </div>
              <p id="err-email" class="mt-0.5 hidden text-xs text-red-600 font-medium"></p>
            </div>

            <!-- Hàng 3: Mật khẩu + Xác nhận mật khẩu -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="group">
                <label for="reg-password" class="block text-[10.5px] font-semibold uppercase tracking-[0.18em] text-walnut-800">Mật khẩu *</label>
                <div class="relative mt-1">
                  <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-walnut-800/45 transition-colors group-focus-within:text-[#173524]">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                  </span>
                  <input
                    id="reg-password"
                    name="password"
                    type="password"
                    required
                    autocomplete="new-password"
                    placeholder="Ít nhất 6 ký tự"
                    class="w-full border border-walnut-900/20 bg-[#FAF8F5]/70 pl-9 pr-10 py-2 text-sm text-walnut-900 outline-none transition-all duration-200 focus:border-[#173524] focus:bg-white focus:ring-2 focus:ring-[#D8B670]/25"
                  />
                  <button
                    type="button"
                    id="toggle-reg-password"
                    class="absolute right-2.5 top-1/2 -translate-y-1/2 text-walnut-800/50 hover:text-[#173524] transition-colors p-1 cursor-pointer focus:outline-none"
                    aria-label="Xem mật khẩu"
                    title="Xem hoặc ẩn mật khẩu"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                  </button>
                </div>
                <p id="err-password" class="mt-0.5 hidden text-xs text-red-600 font-medium"></p>
              </div>

              <div class="group">
                <label for="reg-confirm" class="block text-[10.5px] font-semibold uppercase tracking-[0.18em] text-walnut-800">Xác nhận *</label>
                <div class="relative mt-1">
                  <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-walnut-800/45 transition-colors group-focus-within:text-[#173524]">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  </span>
                  <input
                    id="reg-confirm"
                    name="confirm"
                    type="password"
                    required
                    autocomplete="new-password"
                    placeholder="Nhập lại mật khẩu"
                    class="w-full border border-walnut-900/20 bg-[#FAF8F5]/70 pl-9 pr-10 py-2 text-sm text-walnut-900 outline-none transition-all duration-200 focus:border-[#173524] focus:bg-white focus:ring-2 focus:ring-[#D8B670]/25"
                  />
                  <button
                    type="button"
                    id="toggle-reg-confirm"
                    class="absolute right-2.5 top-1/2 -translate-y-1/2 text-walnut-800/50 hover:text-[#173524] transition-colors p-1 cursor-pointer focus:outline-none"
                    aria-label="Xem mật khẩu xác nhận"
                    title="Xem hoặc ẩn mật khẩu"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                  </button>
                </div>
                <p id="err-confirm" class="mt-0.5 hidden text-xs text-red-600 font-medium"></p>
              </div>
            </div>

            <!-- THANH ĐO ĐỘ MẠNH MẬT KHẨU -->
            <div id="password-strength-container" class="hidden">
              <div class="flex items-center justify-between text-[11px] mb-1">
                <span class="text-walnut-800/70">Độ an toàn mật khẩu:</span>
                <span id="password-strength-text" class="font-bold text-red-600">Yếu</span>
              </div>
              <div class="h-1.5 w-full bg-sand-200 rounded-full overflow-hidden">
                <div id="password-strength-bar" class="h-full w-1/3 bg-red-500 transition-all duration-300"></div>
              </div>
            </div>

            <div class="flex items-start gap-2.5 mt-0.5">
              <input id="reg-terms" name="terms" type="checkbox" checked class="mt-0.5 h-4 w-4 accent-[#173524] cursor-pointer" />
              <label for="reg-terms" class="text-xs text-walnut-800/85 leading-normal cursor-pointer">
                Tôi đồng ý với <a href="#" class="underline hover:text-[#173524]">Điều khoản dịch vụ</a> và <a href="#" class="underline hover:text-[#173524]">Chính sách bảo mật</a> của KTUFA.
              </label>
            </div>

            <button
              type="submit"
              id="btn-submit"
              class="auth-cta-shimmer relative overflow-hidden mt-1 bg-[#173524] border border-[#D8B670]/50 px-8 py-3 text-xs uppercase tracking-[0.22em] font-bold text-[#E6CA85] transition-all duration-200 hover:bg-[#1f4730] hover:text-white shadow-md cursor-pointer flex items-center justify-center gap-2"
            >
              <span class="relative z-10">Đăng ký tài khoản</span>
            </button>
          </form>

          <p class="mt-3.5 text-xs text-walnut-800/80 text-center">
            Đã có tài khoản?
            <a
              href="/dang-nhap"
              data-switch-auth="login"
              class="font-bold text-[#173524] underline underline-offset-4 transition-colors hover:text-[#997734]"
            >
              Đăng nhập ngay
            </a>
          </p>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- TOAST THÔNG BÁO NỔI Ở PHÍA TRÊN BÊN PHẢI -->
<div id="auth-toast" class="fixed top-24 sm:top-28 right-4 sm:right-6 z-[99999] hidden -translate-y-4 rounded-xl bg-walnut-900 px-6 py-4 text-xs font-medium text-sand-50 shadow-2xl transition-all duration-300 border border-sand-50/20 max-w-sm backdrop-blur-md">
  <div class="flex items-start gap-3">
    <div id="toast-icon-wrap" class="shrink-0 mt-0.5">
      <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <div>
      <p id="toast-title" class="font-bold uppercase tracking-wider text-sand-50 mb-0.5">Thông báo</p>
      <p id="toast-body" class="text-sand-200 leading-relaxed">Thông báo</p>
    </div>
  </div>
</div>

<style is:global>
  #site-header,
  main,
  #auth-page-section {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  @keyframes authFadeSlideUp {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .auth-stagger:not(.hidden) > * {
    animation: authFadeSlideUp 0.42s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .auth-stagger:not(.hidden) > *:nth-child(1) { animation-delay: 0.03s; }
  .auth-stagger:not(.hidden) > *:nth-child(2) { animation-delay: 0.06s; }
  .auth-stagger:not(.hidden) > *:nth-child(3) { animation-delay: 0.09s; }
  .auth-stagger:not(.hidden) > *:nth-child(4) { animation-delay: 0.12s; }
  .auth-stagger:not(.hidden) > *:nth-child(5) { animation-delay: 0.15s; }
  .auth-stagger:not(.hidden) > *:nth-child(6) { animation-delay: 0.18s; }

  .auth-cta-shimmer::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, rgba(243, 229, 171, 0.24), transparent);
    transition: transform 0.65s ease;
  }
  .auth-cta-shimmer:hover::after {
    transform: translateX(100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .auth-stagger:not(.hidden) > * {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .auth-cta-shimmer::after {
      display: none;
    }
  }
</style>

<!-- Tải thư viện Google Identity Services (GSI) -->
<script is:inline src="https://accounts.google.com/gsi/client" async defer></script>

<script>
  import { mergeGuestCartIntoUser, mergeGuestCartOnLogin } from '../scripts/cart';

  const MANUAL_CLIENT_ID = "288589640244-4uhsc02mcfqitebqct2nhpgghpu70cv9.apps.googleusercontent.com";
  const ENV_CLIENT_ID = (import.meta as any).env?.PUBLIC_GOOGLE_CLIENT_ID;
  const GOOGLE_CLIENT_ID =
    MANUAL_CLIENT_ID && MANUAL_CLIENT_ID.trim() !== ""
      ? MANUAL_CLIENT_ID.trim()
      : (ENV_CLIENT_ID && !ENV_CLIENT_ID.includes("DÁN_") ? ENV_CLIENT_ID.trim() : "");

  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('auth-page-section');
    const paneLogin = document.getElementById('auth-pane-login');
    const paneRegister = document.getElementById('auth-pane-register');
    let currentMode: 'login' | 'register' =
      (section?.dataset.initialMode as 'login' | 'register') ||
      (window.location.pathname.includes('dang-ky') ? 'register' : 'login');

    const switchAuthMode = (targetMode: 'login' | 'register', pushHistory = true) => {
      if (targetMode === currentMode) return;
      const portalCard = document.getElementById('auth-portal-card');
      if (portalCard && window.innerWidth >= 1024) {
        const lockedHeight = Math.max(552, portalCard.offsetHeight);
        portalCard.style.minHeight = `${lockedHeight}px`;
      }
      currentMode = targetMode;

      if (targetMode === 'login') {
        paneRegister?.classList.add('hidden');
        paneLogin?.classList.remove('hidden');
        document.title = 'Đăng nhập tài khoản | Nội Thất';
        if (pushHistory) history.pushState({ authMode: 'login' }, '', '/dang-nhap');
      } else {
        paneLogin?.classList.add('hidden');
        paneRegister?.classList.remove('hidden');
        document.title = 'Đăng ký tài khoản | Nội Thất';
        if (pushHistory) history.pushState({ authMode: 'register' }, '', '/dang-ky');
      }
    };

    document.querySelectorAll<HTMLElement>('[data-switch-auth]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const mode = link.dataset.switchAuth as 'login' | 'register';
        if (mode === 'login' || mode === 'register') {
          e.preventDefault();
          switchAuthMode(mode, true);
        }
      });
    });

    window.addEventListener('popstate', (e) => {
      const stateMode = (e.state as any)?.authMode;
      if (stateMode === 'login' || stateMode === 'register') {
        switchAuthMode(stateMode, false);
      } else {
        switchAuthMode(window.location.pathname.includes('dang-ky') ? 'register' : 'login', false);
      }
    });

    // =========================================================================
    // TOAST & HELPERS
    // =========================================================================
    const toast = document.getElementById('auth-toast') as HTMLElement;
    const toastBody = document.getElementById('toast-body') as HTMLElement;
    const toastTitle = document.getElementById('toast-title') as HTMLElement;
    const iconWrap = document.getElementById('toast-icon-wrap') as HTMLElement;

    const showToast = (msg: string, isError = false) => {
      if (toastBody) toastBody.textContent = msg;
      if (toastTitle) toastTitle.textContent = isError ? 'Cảnh báo bảo mật' : 'Thông báo';
      if (iconWrap) {
        iconWrap.innerHTML = isError
          ? `<svg class="h-4 w-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`
          : `<svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`;
      }
      if (toast) {
        toast.className = `fixed top-24 sm:top-28 right-4 sm:right-6 z-[99999] rounded-xl px-6 py-4 text-xs font-medium shadow-2xl transition-all duration-300 border max-w-sm backdrop-blur-md ${
          isError ? 'bg-red-950/95 border-red-500 shadow-red-950/50 text-red-50' : 'bg-walnut-900/95 border-emerald-500/50 shadow-walnut-950/50 text-sand-50'
        }`;
        toast.classList.remove('hidden');
        requestAnimationFrame(() => toast.classList.remove('-translate-y-4'));
        setTimeout(() => {
          toast.classList.add('-translate-y-4');
          setTimeout(() => toast.classList.add('hidden'), 300);
        }, 4500);
      }
    };

    const eyeOpenSvg = `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`;
    const eyeClosedSvg = `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>`;

    const bindPasswordToggle = (btnId: string, inputId: string) => {
      const btn = document.getElementById(btnId) as HTMLButtonElement | null;
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      btn?.addEventListener('click', () => {
        if (!input) return;
        if (input.type === 'password') {
          input.type = 'text';
          btn.innerHTML = eyeClosedSvg;
          btn.setAttribute('aria-label', 'Ẩn mật khẩu');
        } else {
          input.type = 'password';
          btn.innerHTML = eyeOpenSvg;
          btn.setAttribute('aria-label', 'Xem mật khẩu');
        }
      });
    };

    bindPasswordToggle('toggle-login-password', 'login-password');
    bindPasswordToggle('toggle-reg-password', 'reg-password');
    bindPasswordToggle('toggle-reg-confirm', 'reg-confirm');

    function parseJwt(token: string) {
      try {
        const base64Url = token.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        const jsonPayload = decodeURIComponent(
          atob(base64)
            .split('')
            .map((c) => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2))
            .join('')
        );
        return JSON.parse(jsonPayload);
      } catch (err) {
        console.error('Lỗi giải mã token Google:', err);
        return null;
      }
    }

    async function handleGoogleAuthSuccess(response: any) {
      if (!response || !response.credential) {
        showToast('Không nhận được dữ liệu xác thực từ Google.', true);
        return;
      }
      const payload = parseJwt(response.credential);
      if (!payload || !payload.email) {
        showToast('Lỗi đọc thông tin từ tài khoản Google.', true);
        return;
      }

      const googleUser: any = {
        name: payload.name || payload.email.split('@')[0],
        email: payload.email,
        avatar: payload.picture || '',
        phone: currentMode === 'register' ? 'Đăng ký Google' : 'Đăng nhập Google',
        role: 'customer',
        tier: 'Vàng',
        spent: '0 ₫',
        orders: 0,
        date: new Date().toLocaleDateString('vi-VN'),
        status: 'Hoạt động',
      };

      try {
        const res = await fetch('http://localhost:4000/api/auth/google', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: googleUser.email,
            fullname: googleUser.name,
            avatar_url: googleUser.avatar,
          }),
        });

        const data = await res.json();
        const isStaff = data.user && (data.user.role === 'admin' || data.user.role === 'seller');

        if (data.success && data.token) {
          if (data.user) {
            googleUser.id = data.user.id;
            googleUser.role = data.user.role || 'customer';
            if (data.user.full_name) googleUser.name = data.user.full_name;
            if (data.user.phone) googleUser.phone = data.user.phone;
            if (data.user.avatar) googleUser.avatar = data.user.avatar;
          }

          if (isStaff) {
            localStorage.setItem('admin_token', data.token);
            localStorage.setItem('admin_user', JSON.stringify(googleUser));
            const urlParams = new URLSearchParams(window.location.search);
            const redirect = urlParams.get('redirect');
            if (!redirect || redirect !== '/admin') {
              localStorage.setItem('auth_token', data.token);
              localStorage.setItem('current_user', JSON.stringify(googleUser));
              try { mergeGuestCartIntoUser(); } catch {}
              try { mergeGuestCartOnLogin(); } catch {}
              window.dispatchEvent(new Event('auth:changed'));
            }
          } else {
            localStorage.setItem('auth_token', data.token);
            localStorage.setItem('current_user', JSON.stringify(googleUser));
            try { mergeGuestCartIntoUser(); } catch {}
            try { mergeGuestCartOnLogin(); } catch {}
            window.dispatchEvent(new Event('auth:changed'));
          }
        }
      } catch (e) {
        console.warn('Lỗi kết nối Backend Google Auth:', e);
      }

      showToast(`Xin chào ${googleUser.name}! ${currentMode === 'register' ? 'Đăng ký' : 'Đăng nhập'} Google thành công.`);
      setTimeout(() => {
        const urlParams = new URLSearchParams(window.location.search);
        const redirect = urlParams.get('redirect');
        if (redirect) {
          window.location.href = redirect;
        } else if (googleUser.role === 'admin' || googleUser.role === 'seller') {
          window.location.href = '/admin';
        } else {
          window.location.href = '/';
        }
      }, 900);
    }

    const btnGoogleLogin = document.getElementById('btn-google-login') as HTMLButtonElement | null;
    const btnGoogleSignup = document.getElementById('btn-google-signup') as HTMLButtonElement | null;
    const googleOfficialLogin = document.getElementById('google-btn-official') as HTMLElement | null;
    const googleOfficialSignup = document.getElementById('google-btn-official-signup') as HTMLElement | null;

    function setupGoogleButtons() {
      const google = (window as any).google;
      if (!google || !google.accounts || !GOOGLE_CLIENT_ID) return;

      google.accounts.id.initialize({
        client_id: GOOGLE_CLIENT_ID,
        callback: handleGoogleAuthSuccess,
        auto_select: false,
        cancel_on_tap_outside: true,
      });

      if (googleOfficialLogin) {
        google.accounts.id.renderButton(googleOfficialLogin, {
          theme: 'outline',
          size: 'large',
          width: 380,
          text: 'continue_with',
          locale: 'vi',
          shape: 'rectangular',
        });
        if (btnGoogleLogin) btnGoogleLogin.style.display = 'none';
      }

      if (googleOfficialSignup) {
        google.accounts.id.renderButton(googleOfficialSignup, {
          theme: 'outline',
          size: 'large',
          width: 380,
          text: 'signup_with',
          locale: 'vi',
          shape: 'rectangular',
        });
        if (btnGoogleSignup) btnGoogleSignup.style.display = 'none';
      }
    }

    let attempts = 0;
    const interval = setInterval(() => {
      attempts++;
      if ((window as any).google?.accounts?.id) {
        clearInterval(interval);
        setupGoogleButtons();
      } else if (attempts >= 25) {
        clearInterval(interval);
      }
    }, 200);

    [btnGoogleLogin, btnGoogleSignup].forEach((btn) => {
      btn?.addEventListener('click', () => {
        const google = (window as any).google;
        if (GOOGLE_CLIENT_ID && google?.accounts?.id) {
          google.accounts.id.prompt();
        } else {
          showToast('Vui lòng sử dụng biểu mẫu bên dưới.');
        }
      });
    });

    // =========================================================================
    // LOGIN LOGIC
    // =========================================================================
    const loginForm = document.getElementById('login-form') as HTMLFormElement | null;
    const loginEmailInput = document.getElementById('login-email') as HTMLInputElement;
    const loginPassInput = document.getElementById('login-password') as HTMLInputElement;
    const loginAlertBanner = document.getElementById('login-alert-banner') as HTMLElement;
    const loginAlertTitle = document.getElementById('alert-banner-title') as HTMLElement;
    const loginAlertDesc = document.getElementById('alert-banner-desc') as HTMLElement;

    const showLoginAlertBanner = (title: string, desc: string) => {
      if (loginAlertBanner && loginAlertTitle && loginAlertDesc) {
        loginAlertTitle.textContent = title;
        loginAlertDesc.textContent = desc;
        loginAlertBanner.classList.remove('hidden');
      }
    };

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('error') === 'admin_required') {
      showLoginAlertBanner(
        'Yêu cầu quyền Quản trị viên',
        'Khu vực Quản trị yêu cầu đăng nhập tài khoản Quản trị viên (Admin).'
      );
      showToast('Khu vực Quản trị yêu cầu đăng nhập tài khoản Quản trị viên (Admin).', true);
    } else if (urlParams.get('registered') === '1') {
      showToast('Đăng ký tài khoản thành công! Vui lòng đăng nhập.');
    }

    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = loginEmailInput.value.trim();
      const password = loginPassInput.value;

      if (!email || !password) {
        showLoginAlertBanner('Thiếu thông tin đăng nhập', 'Vui lòng nhập đầy đủ email và mật khẩu.');
        showToast('Vui lòng nhập đầy đủ email và mật khẩu.', true);
        return;
      }

      const submitBtn = loginForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang xác thực...';
      }

      try {
        const res = await fetch('http://localhost:4000/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          const errMsg = data.message || 'Email hoặc mật khẩu không chính xác.';
          showLoginAlertBanner('Đăng nhập không thành công', errMsg);
          showToast(errMsg, true);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Đăng nhập';
          }
          return;
        }

        const isAdminOrSeller = data.user.role === 'admin' || data.user.role === 'seller';
        const loggedInUser = {
          id: data.user.id,
          name: data.user.full_name || email.split('@')[0],
          email: data.user.email,
          phone: data.user.phone || 'Chưa cập nhật',
          role: data.user.role || 'customer',
          avatar: data.user.avatar || null,
        };

        if (isAdminOrSeller) {
          if (data.token) localStorage.setItem('admin_token', data.token);
          localStorage.setItem('admin_user', JSON.stringify(loggedInUser));

          const redirect = urlParams.get('redirect');
          if (!redirect || redirect !== '/admin') {
            if (data.token) localStorage.setItem('auth_token', data.token);
            localStorage.setItem('current_user', JSON.stringify(loggedInUser));
            try { mergeGuestCartIntoUser(); } catch {}
            try { mergeGuestCartOnLogin(); } catch {}
            window.dispatchEvent(new Event('auth:changed'));
          }
        } else {
          if (data.token) localStorage.setItem('auth_token', data.token);
          localStorage.setItem('current_user', JSON.stringify(loggedInUser));
          try { mergeGuestCartIntoUser(); } catch {}
          try { mergeGuestCartOnLogin(); } catch {}
          window.dispatchEvent(new Event('auth:changed'));
        }

        showToast(`Đăng nhập thành công! Xin chào ${loggedInUser.name}`);

        setTimeout(() => {
          const redirect = urlParams.get('redirect');
          if (redirect) {
            window.location.href = redirect;
          } else if (loggedInUser.role === 'admin' || loggedInUser.role === 'seller') {
            window.location.href = '/admin';
          } else {
            window.location.href = '/';
          }
        }, 800);
      } catch (err) {
        console.error('Lỗi khi đăng nhập:', err);
        showToast('Không thể kết nối đến máy chủ Backend. Vui lòng thử lại sau.', true);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Đăng nhập';
        }
      }
    });

    // =========================================================================
    // REGISTER LOGIC
    // =========================================================================
    const regForm = document.getElementById('register-form') as HTMLFormElement | null;
    const nameInput = document.getElementById('reg-name') as HTMLInputElement;
    const regEmailInput = document.getElementById('reg-email') as HTMLInputElement;
    const phoneInput = document.getElementById('reg-phone') as HTMLInputElement;
    const regPassInput = document.getElementById('reg-password') as HTMLInputElement;
    const confirmInput = document.getElementById('reg-confirm') as HTMLInputElement;
    const termsInput = document.getElementById('reg-terms') as HTMLInputElement;

    const errFullname = document.getElementById('err-fullname') as HTMLElement;
    const errEmail = document.getElementById('err-email') as HTMLElement;
    const errPhone = document.getElementById('err-phone') as HTMLElement;
    const errPassword = document.getElementById('err-password') as HTMLElement;
    const errConfirm = document.getElementById('err-confirm') as HTMLElement;

    const strengthContainer = document.getElementById('password-strength-container') as HTMLElement;
    const strengthText = document.getElementById('password-strength-text') as HTMLElement;
    const strengthBar = document.getElementById('password-strength-bar') as HTMLElement;

    const clearFieldErrors = () => {
      [errFullname, errEmail, errPhone, errPassword, errConfirm].forEach((el) => {
        if (el) {
          el.textContent = '';
          el.classList.add('hidden');
        }
      });
      [nameInput, regEmailInput, phoneInput, regPassInput, confirmInput].forEach((inp) => {
        if (inp) {
          inp.classList.remove('border-red-500', 'bg-red-50/20');
          inp.classList.add('border-walnut-900/20');
        }
      });
    };

    const setFieldError = (field: string, msg: string, isHtml = false) => {
      let targetErr: HTMLElement | null = null;
      let targetInput: HTMLInputElement | null = null;

      if (field === 'fullname') { targetErr = errFullname; targetInput = nameInput; }
      else if (field === 'email') { targetErr = errEmail; targetInput = regEmailInput; }
      else if (field === 'phone') { targetErr = errPhone; targetInput = phoneInput; }
      else if (field === 'password') { targetErr = errPassword; targetInput = regPassInput; }
      else if (field === 'confirm') { targetErr = errConfirm; targetInput = confirmInput; }

      if (targetErr) {
        if (isHtml) targetErr.innerHTML = msg;
        else targetErr.textContent = msg;
        targetErr.classList.remove('hidden');
      }
      if (targetInput) {
        targetInput.classList.remove('border-walnut-900/20');
        targetInput.classList.add('border-red-500', 'bg-red-50/20');
        targetInput.focus();
      }
    };

    [
      { input: nameInput, err: errFullname },
      { input: regEmailInput, err: errEmail },
      { input: phoneInput, err: errPhone },
      { input: regPassInput, err: errPassword },
      { input: confirmInput, err: errConfirm },
    ].forEach(({ input, err }) => {
      input?.addEventListener('input', () => {
        if (err) {
          err.textContent = '';
          err.classList.add('hidden');
        }
        input.classList.remove('border-red-500', 'bg-red-50/20');
        input.classList.add('border-walnut-900/20');
      });
    });

    regPassInput?.addEventListener('input', () => {
      const val = regPassInput.value;
      if (!val) {
        strengthContainer?.classList.add('hidden');
        return;
      }
      strengthContainer?.classList.remove('hidden');

      const hasLetters = /[a-zA-Z]/.test(val);
      const hasNumbers = /[0-9]/.test(val);
      const hasSpecial = /[^a-zA-Z0-9]/.test(val);
      const isLongEnough = val.length >= 8;

      if (val.length < 6) {
        strengthText.textContent = 'Mật khẩu yếu (Cần ít nhất 6 ký tự)';
        strengthText.className = 'font-bold text-red-600';
        strengthBar.className = 'h-full w-1/4 bg-red-500 transition-all duration-300';
      } else if (isLongEnough && hasLetters && hasNumbers && hasSpecial) {
        strengthText.textContent = 'Mật khẩu mạnh (An toàn cao)';
        strengthText.className = 'font-bold text-emerald-600';
        strengthBar.className = 'h-full w-full bg-emerald-500 transition-all duration-300';
      } else if (hasLetters && hasNumbers) {
        strengthText.textContent = 'Mật khẩu trung bình';
        strengthText.className = 'font-bold text-amber-600';
        strengthBar.className = 'h-full w-2/3 bg-amber-500 transition-all duration-300';
      } else {
        strengthText.textContent = 'Mật khẩu yếu';
        strengthText.className = 'font-bold text-red-600';
        strengthBar.className = 'h-full w-1/3 bg-red-500 transition-all duration-300';
      }
    });

    regForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearFieldErrors();

      const fullname = nameInput.value.trim();
      const email = regEmailInput.value.trim();
      const phone = phoneInput.value.trim();
      const password = regPassInput.value;
      const confirm = confirmInput.value;

      if (!fullname) {
        setFieldError('fullname', 'Vui lòng nhập họ và tên của bạn.');
        showToast('Vui lòng điền họ và tên.', true);
        return;
      }
      if (!email) {
        setFieldError('email', 'Vui lòng nhập địa chỉ email.');
        showToast('Vui lòng điền email.', true);
        return;
      }
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        setFieldError('email', 'Địa chỉ email không đúng định dạng.');
        showToast('Địa chỉ email không đúng định dạng.', true);
        return;
      }
      const cleanPhone = phone.replace(/\s+/g, '');
      if (cleanPhone && !/^(0|\+84)[1-9][0-9]{8}$/.test(cleanPhone)) {
        setFieldError('phone', 'Số điện thoại không hợp lệ (cần 10 chữ số, bắt đầu bằng 0 hoặc +84).');
        showToast('Số điện thoại không hợp lệ.', true);
        return;
      }
      if (!password) {
        setFieldError('password', 'Vui lòng nhập mật khẩu.');
        showToast('Vui lòng nhập mật khẩu.', true);
        return;
      }
      if (password.length < 6) {
        setFieldError('password', 'Mật khẩu phải chứa ít nhất 6 ký tự để bảo mật.');
        showToast('Mật khẩu phải chứa ít nhất 6 ký tự.', true);
        return;
      }
      if (password !== confirm) {
        setFieldError('confirm', 'Mật khẩu xác nhận không khớp.');
        showToast('Mật khẩu xác nhận không khớp.', true);
        return;
      }
      if (!termsInput.checked) {
        showToast('Bạn cần đồng ý với điều khoản sử dụng.', true);
        return;
      }

      const submitBtn = regForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang xử lý đăng ký...';
      }

      try {
        const res = await fetch('http://localhost:4000/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fullname, email, phone: cleanPhone, password }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          if (data.field === 'email' || (data.message && data.message.toLowerCase().includes('email'))) {
            setFieldError(
              'email',
              `<span>${data.message || 'Email này đã được sử dụng.'}</span>`,
              true
            );
          } else if (data.field === 'phone' || (data.message && data.message.toLowerCase().includes('điện thoại'))) {
            setFieldError('phone', data.message || 'Số điện thoại này đã được đăng ký.');
          } else if (data.field === 'password') {
            setFieldError('password', data.message);
          }

          showToast(data.message || 'Đăng ký tài khoản không thành công.', true);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Đăng ký tài khoản';
          }
          return;
        }

        showToast('Đăng ký tài khoản thành công! Vui lòng đăng nhập.');
        if (loginEmailInput) loginEmailInput.value = email;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Đăng ký tài khoản';
        }
        setTimeout(() => {
          switchAuthMode('login', true);
        }, 700);
      } catch (err) {
        showToast('Không thể kết nối đến máy chủ Backend. Vui lòng thử lại sau.', true);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Đăng ký tài khoản';
        }
      }
    });
  });
</script>

