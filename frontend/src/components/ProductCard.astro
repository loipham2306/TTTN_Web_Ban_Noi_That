---
import type { Product } from '../data/products';
import { formatVnd } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article
  class="group"
  data-product={product.slug}
  data-name={product.name}
  data-category={product.category}
  data-space={product.space}
  data-price={product.price}
>
  <a href={`/san-pham/${product.slug}`} class="block">
    <span class="relative block aspect-[3/4] w-full overflow-hidden bg-sand-200 transition duration-500 group-hover:opacity-90">
      {product.isNew && (
        <span class="absolute left-3 top-3 bg-sand-50/90 px-2 py-1 text-[10px] uppercase tracking-[0.2em] text-walnut-900">
          Mới
        </span>
      )}
    </span>

    <div class="mt-4">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">{product.categoryLabel}</p>
      <h3 class="mt-1 text-sm text-walnut-900">{product.name}</h3>
      <p class="mt-1 text-sm text-walnut-900">{formatVnd(product.price)}</p>
    </div>
  </a>
</article>
