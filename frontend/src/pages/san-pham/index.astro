---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, categories, spaces, priceRanges, productsPerPage } from '../../data/products';
---

<BaseLayout title="Sản phẩm | Nội Thất" description="Danh sách sản phẩm nội thất: lọc theo danh mục, không gian và khoảng giá.">

  <section class="border-b border-walnut-900/10 bg-sand-100">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:py-14">
      <nav class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">
        <a href="/" class="transition-colors hover:text-clay-600">Trang chủ</a>
        <span class="mx-2">/</span>
        <span class="text-walnut-900">Sản phẩm</span>
      </nav>
      <h1 class="mt-4 font-display text-3xl tracking-tight sm:text-4xl">Tất cả sản phẩm</h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-walnut-800">
        Tuyển chọn nội thất cho phòng khách, phòng ngủ, phòng ăn và không gian làm việc. Lọc theo danh mục, không gian và khoảng giá để tìm đúng món bạn cần.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:py-14">
    <div class="flex flex-col gap-10 lg:flex-row lg:gap-12">

      <aside class="lg:w-64 lg:shrink-0">
        <button
          type="button"
          data-filter-toggle
          class="inline-flex items-center gap-2 border border-walnut-900/20 px-5 py-3 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:border-walnut-900 lg:hidden"
          aria-expanded="false"
          aria-controls="filter-panel"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
            <path d="M4 6h16M7 12h10M10 18h4" stroke-linecap="round" />
          </svg>
          Bộ lọc
        </button>

        <div id="filter-panel" data-filter-panel class="mt-4 hidden lg:mt-0 lg:block">
          <fieldset class="border-t border-walnut-900/10 py-5">
            <legend class="text-[11px] uppercase tracking-[0.25em] text-walnut-900">Danh mục</legend>
            <div class="mt-4 flex flex-col gap-2.5">
              {categories.map((item) => (
                <label class="flex cursor-pointer items-center gap-3 text-sm text-walnut-800 transition-colors hover:text-walnut-900">
                  <input type="checkbox" data-filter="category" value={item.key} class="h-4 w-4 accent-[#333333]" />
                  <span>{item.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="border-t border-walnut-900/10 py-5">
            <legend class="text-[11px] uppercase tracking-[0.25em] text-walnut-900">Không gian</legend>
            <div class="mt-4 flex flex-col gap-2.5">
              {spaces.map((item) => (
                <label class="flex cursor-pointer items-center gap-3 text-sm text-walnut-800 transition-colors hover:text-walnut-900">
                  <input type="checkbox" data-filter="space" value={item.key} class="h-4 w-4 accent-[#333333]" />
                  <span>{item.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="border-y border-walnut-900/10 py-5">
            <legend class="text-[11px] uppercase tracking-[0.25em] text-walnut-900">Khoảng giá</legend>
            <div class="mt-4 flex flex-col gap-2.5">
              <label class="flex cursor-pointer items-center gap-3 text-sm text-walnut-800 transition-colors hover:text-walnut-900">
                <input type="radio" name="price" data-filter="price" value="" checked class="h-4 w-4 accent-[#333333]" />
                <span>Tất cả</span>
              </label>
              {priceRanges.map((item) => (
                <label class="flex cursor-pointer items-center gap-3 text-sm text-walnut-800 transition-colors hover:text-walnut-900">
                  <input type="radio" name="price" data-filter="price" value={item.key} class="h-4 w-4 accent-[#333333]" />
                  <span>{item.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <button
            type="button"
            data-filter-reset
            class="mt-5 text-xs uppercase tracking-[0.2em] text-walnut-800 underline underline-offset-4 transition-colors hover:text-clay-600"
          >
            Xoá bộ lọc
          </button>
        </div>
      </aside>

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-walnut-900/10 pb-4">
          <p data-result-count class="text-xs uppercase tracking-[0.2em] text-walnut-800"></p>
          <label class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-walnut-800">
            <span class="hidden sm:inline">Sắp xếp</span>
            <select
              data-sort
              class="border border-walnut-900/20 bg-transparent px-3 py-2 text-xs tracking-normal text-walnut-900 outline-none transition-colors focus:border-clay-600"
            >
              <option value="default">Mặc định</option>
              <option value="price-asc">Giá: thấp → cao</option>
              <option value="price-desc">Giá: cao → thấp</option>
              <option value="name-asc">Tên: A → Z</option>
            </select>
          </label>
        </div>

        <div
          data-product-grid
          data-page-size={productsPerPage}
          class="mt-8 grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
        >
          {products.map((product) => <ProductCard product={product} />)}
        </div>

        <p data-empty class="mt-16 hidden text-center text-sm text-walnut-800">
          Không tìm thấy sản phẩm phù hợp. Hãy thử bỏ vài bộ lọc.
        </p>

        <nav data-pagination aria-label="Phân trang" class="mt-14 flex flex-wrap items-center justify-center gap-2"></nav>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  const grid = document.querySelector<HTMLElement>('[data-product-grid]');

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-product]'));
    const pageSize = Number(grid.dataset.pageSize) || 8;
    const countEl = document.querySelector<HTMLElement>('[data-result-count]');
    const paginationEl = document.querySelector<HTMLElement>('[data-pagination]');
    const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
    const sortEl = document.querySelector<HTMLSelectElement>('[data-sort]');
    const panelEl = document.querySelector<HTMLElement>('[data-filter-panel]');
    const toggleEl = document.querySelector<HTMLButtonElement>('[data-filter-toggle]');

    const BASE_BTN = 'h-10 min-w-10 border px-3 text-sm transition-colors';
    const IDLE_BTN = BASE_BTN + ' border-walnut-900/20 text-walnut-900 hover:border-walnut-900';
    const ACTIVE_BTN = BASE_BTN + ' border-walnut-900 bg-walnut-900 text-sand-50';
    const OFF_BTN = BASE_BTN + ' border-walnut-900/10 text-walnut-900/30';

    let page = 1;
    let sort = 'default';
    let priceRange: [number, number] | null = null;
    let keyword = '';

    const checkedValues = (name: string) =>
      Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter="' + name + '"]:checked')).map((el) => el.value);

    const readPriceRange = () => {
      const checked = document.querySelector<HTMLInputElement>('[data-filter="price"]:checked');
      if (!checked || !checked.value) {
        priceRange = null;
        return;
      }
      const parts = checked.value.split('-');
      priceRange = [Number(parts[0]), parts[1] ? Number(parts[1]) : Infinity];
    };

    const matches = (card: HTMLElement) => {
      const pickedCategories = checkedValues('category');
      const pickedSpaces = checkedValues('space');

      if (pickedCategories.length && !pickedCategories.includes(card.dataset.category ?? '')) return false;
      if (pickedSpaces.length && !pickedSpaces.includes(card.dataset.space ?? '')) return false;
      if (keyword && !String(card.dataset.name ?? '').toLowerCase().includes(keyword)) return false;

      if (priceRange) {
        const price = Number(card.dataset.price);
        if (price < priceRange[0] || price > priceRange[1]) return false;
      }
      return true;
    };

    const sortList = (list: HTMLElement[]) => {
      const arr = list.slice();
      if (sort === 'price-asc') arr.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
      else if (sort === 'price-desc') arr.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
      else if (sort === 'name-asc') arr.sort((a, b) => (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'vi'));
      return arr;
    };

    const makePageButton = (label: string, target: number, options: { active?: boolean; disabled?: boolean }) => {
      if (!paginationEl) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      btn.className = options.active ? ACTIVE_BTN : options.disabled ? OFF_BTN : IDLE_BTN;
      btn.disabled = Boolean(options.disabled || options.active);
      btn.addEventListener('click', () => {
        page = target;
        render();
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      paginationEl.appendChild(btn);
    };

    const renderPagination = (totalPages: number) => {
      if (!paginationEl) return;
      paginationEl.innerHTML = '';
      if (totalPages <= 1) return;

      makePageButton('Trước', page - 1, { disabled: page === 1 });
      for (let i = 1; i <= totalPages; i++) {
        makePageButton(String(i), i, { active: i === page });
      }
      makePageButton('Sau', page + 1, { disabled: page === totalPages });
    };

    const render = () => {
      const filtered = sortList(cards.filter(matches));

      filtered.forEach((card) => grid.appendChild(card));

      const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
      if (page > totalPages) page = totalPages;

      const start = (page - 1) * pageSize;
      const pageItems = filtered.slice(start, start + pageSize);

      cards.forEach((card) => card.classList.add('hidden'));
      pageItems.forEach((card) => card.classList.remove('hidden'));

      if (countEl) {
        countEl.textContent = filtered.length
          ? (keyword ? 'Từ khoá "' + keyword + '" · ' : '') +
            'Hiển thị ' + (start + 1) + '–' + (start + pageItems.length) + ' trên ' + filtered.length + ' sản phẩm'
          : 'Không có sản phẩm phù hợp';
      }

      if (emptyEl) emptyEl.classList.toggle('hidden', filtered.length !== 0);

      renderPagination(totalPages);
    };

    document.querySelectorAll<HTMLInputElement>('[data-filter]').forEach((input) => {
      input.addEventListener('change', () => {
        page = 1;
        readPriceRange();
        render();
      });
    });

    sortEl?.addEventListener('change', (event) => {
      sort = (event.target as HTMLSelectElement).value;
      page = 1;
      render();
    });

    document.querySelectorAll<HTMLButtonElement>('[data-filter-reset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll<HTMLInputElement>('[data-filter="category"], [data-filter="space"]').forEach((el) => {
          el.checked = false;
        });
        const all = document.querySelector<HTMLInputElement>('[data-filter="price"][value=""]');
        if (all) all.checked = true;

        if (sortEl) sortEl.value = 'default';
        sort = 'default';
        page = 1;
        readPriceRange();
        render();
      });
    });

    toggleEl?.addEventListener('click', () => {
      if (!panelEl) return;
      const isHidden = panelEl.classList.toggle('hidden');
      toggleEl.setAttribute('aria-expanded', String(!isHidden));
    });

    const params = new URLSearchParams(window.location.search);

    const keywordParam = (params.get('q') ?? '').trim().toLowerCase();
    if (keywordParam) keyword = keywordParam;

    const categoryParams = (params.get('danh-muc') ?? '').split(',').filter(Boolean);
    const spaceParams = (params.get('khong-gian') ?? '').split(',').filter(Boolean);

    categoryParams.forEach((value) => {
      const box = document.querySelector<HTMLInputElement>('[data-filter="category"][value="' + value + '"]');
      if (box) box.checked = true;
    });

    spaceParams.forEach((value) => {
      const box = document.querySelector<HTMLInputElement>('[data-filter="space"][value="' + value + '"]');
      if (box) box.checked = true;
    });

    readPriceRange();
    render();
  }
</script>
