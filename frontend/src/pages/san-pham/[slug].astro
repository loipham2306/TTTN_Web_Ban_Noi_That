---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products }        from '../../data/products';
import { productDetails }  from '../../data/product-details';
import { formatVnd }       from '../../scripts/cart';

export async function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;

const product = products.find((p) => p.slug === slug);
if (!product) {
  return Astro.redirect('/san-pham');
}

const detail = productDetails[slug] ?? {
  description: product.description,
  dimensions: 'Tiêu chuẩn',
  warranty: '2 năm',
  origin: 'Việt Nam',
  gallery: [],
};

// Try fetching live data from backend API
let apiProduct: any = null;
try {
  const res = await fetch(`http://localhost:4000/api/products/${slug}`, {
    signal: AbortSignal.timeout(1500),
  });
  if (res.ok) {
    const json = await res.json();
    if (json.success) apiProduct = json.data;
  }
} catch {
  // API not available - use static data
}

const name         = apiProduct?.name       ?? product.name;
const price        = apiProduct?.variants?.[0]?.price ?? product.price;
const comparePrice = apiProduct?.variants?.[0]?.comparePrice ?? null;
const material     = apiProduct?.variants?.[0]?.material ?? product.material;
const catLabel     = apiProduct?.category?.name ?? product.categoryLabel;
const catSlug      = apiProduct?.category?.slug ?? product.category;
const thumbnail    = apiProduct?.images?.find((i: any) => i.isThumbnail)?.url ?? null;
const description  = apiProduct?.shortDescription ?? detail.description;
const dimensions   = apiProduct?.variants?.[0]?.dimensions ?? detail.dimensions;
const warranty     = detail.warranty;
const brand        = apiProduct?.brand ?? null;
const stock        = apiProduct?.variants?.[0]?.stock ?? 10;
---

<BaseLayout
  title={`${name} | Nội Thất Cao Cấp`}
  description={description}
>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

    <!-- BREADCRUMB -->
    <nav class="mb-8 flex items-center gap-2 text-xs text-walnut-800/70">
      <a href="/" class="hover:text-walnut-900 transition-colors">Trang chủ</a>
      <span>/</span>
      <a href="/san-pham" class="hover:text-walnut-900 transition-colors">Sản phẩm</a>
      <span>/</span>
      <a href={`/san-pham?danh-muc=${catSlug}`} class="hover:text-walnut-900 transition-colors">{catLabel}</a>
      <span>/</span>
      <span class="text-walnut-900">{name}</span>
    </nav>

    <!-- PRODUCT DETAIL -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">

      <!-- LEFT: IMAGES -->
      <div class="space-y-4">
        <div class="aspect-square w-full overflow-hidden bg-sand-100 rounded-lg border border-walnut-900/10 shadow-sm">
          {thumbnail ? (
            <img
              src={thumbnail}
              alt={name}
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
              loading="eager"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-sand-100">
              <svg class="h-24 w-24 text-walnut-900/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          )}
        </div>
      </div>

      <!-- RIGHT: INFO -->
      <div class="flex flex-col">

        <!-- Category & Brand -->
        <div class="flex items-center gap-3">
          <a
            href={`/san-pham?danh-muc=${catSlug}`}
            class="text-[11px] uppercase tracking-[0.25em] text-walnut-800 hover:text-clay-600 transition-colors"
          >
            {catLabel}
          </a>
          {brand && (
            <span class="text-walnut-800/40">|</span>
            <span class="text-[11px] uppercase tracking-[0.2em] text-walnut-800/60">{brand}</span>
          )}
        </div>

        <!-- Name -->
        <h1 class="mt-3 font-display text-3xl tracking-tight text-walnut-900 sm:text-4xl">
          {name}
        </h1>

        <!-- Price -->
        <div class="mt-6 flex items-baseline gap-4">
          <span class="font-display text-2xl text-clay-600 font-semibold">{formatVnd(price)}</span>
          {comparePrice && (
            <span class="text-sm text-walnut-800/50 line-through">{formatVnd(comparePrice)}</span>
          )}
        </div>

        <!-- Stock Status -->
        <div class="mt-3">
          {stock > 0 ? (
            <span class="inline-flex items-center gap-1.5 text-xs text-emerald-700">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Còn hàng ({stock} sản phẩm sẵn có)
            </span>
          ) : (
            <span class="inline-flex items-center gap-1.5 text-xs text-red-600">
              <span class="h-2 w-2 rounded-full bg-red-500"></span>
              Hết hàng - liên hệ đặt trước
            </span>
          )}
        </div>

        <!-- Description -->
        <p class="mt-6 text-sm leading-relaxed text-walnut-800">{description}</p>

        <!-- Specs -->
        <dl class="mt-8 space-y-3 border-t border-walnut-900/10 pt-6">
          <div class="flex justify-between text-sm">
            <dt class="text-walnut-800/70 uppercase tracking-wider text-[11px]">Chất liệu</dt>
            <dd class="text-walnut-900 font-medium">{material}</dd>
          </div>
          <div class="flex justify-between text-sm">
            <dt class="text-walnut-800/70 uppercase tracking-wider text-[11px]">Kích thước</dt>
            <dd class="text-walnut-900 font-medium">{dimensions}</dd>
          </div>
          <div class="flex justify-between text-sm">
            <dt class="text-walnut-800/70 uppercase tracking-wider text-[11px]">Bảo hành</dt>
            <dd class="text-walnut-900 font-medium">{warranty}</dd>
          </div>
        </dl>

        <!-- QUANTITY SELECTOR -->
        <div class="mt-8 flex items-center gap-4">
          <span class="text-xs uppercase tracking-wider text-walnut-800">Số lượng:</span>
          <div class="inline-flex items-center border border-walnut-900/20 bg-sand-50 rounded">
            <button
              type="button"
              id="btn-qty-minus"
              class="px-3 py-1.5 text-walnut-900 transition-colors hover:bg-walnut-900/10 text-base"
              aria-label="Giảm số lượng"
            >-</button>
            <input
              type="number"
              id="input-qty"
              min="1"
              max={stock || 99}
              value="1"
              class="w-12 border-x border-walnut-900/20 bg-transparent py-1.5 text-center text-sm font-medium text-walnut-900 outline-none"
            />
            <button
              type="button"
              id="btn-qty-plus"
              class="px-3 py-1.5 text-walnut-900 transition-colors hover:bg-walnut-900/10 text-base"
              aria-label="Tăng số lượng"
            >+</button>
          </div>
        </div>

        <!-- CTA BUTTONS -->
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <button
            id="btn-add-to-cart"
            type="button"
            data-slug={slug}
            data-name={name}
            data-price={price}
            data-thumbnail={thumbnail ?? ''}
            data-category={catLabel}
            class="flex-1 bg-clay-600 px-8 py-4 text-xs uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 active:scale-95 cursor-pointer font-medium rounded-sm shadow-sm"
            disabled={stock === 0}
          >
            {stock > 0 ? 'Thêm vào giỏ hàng' : 'Hết hàng'}
          </button>
          <button
            id="btn-buy-now"
            type="button"
            data-slug={slug}
            data-name={name}
            data-price={price}
            data-thumbnail={thumbnail ?? ''}
            data-category={catLabel}
            class="flex-1 border-2 border-walnut-900 px-8 py-4 text-center text-xs uppercase tracking-[0.2em] text-walnut-900 transition-all hover:bg-walnut-900 hover:text-sand-50 active:scale-95 cursor-pointer font-medium rounded-sm"
            disabled={stock === 0}
          >
            Mua ngay
          </button>
        </div>

        <!-- Notes -->
        <p class="mt-6 text-xs text-walnut-800/60 leading-relaxed">
          * Miễn phí vận chuyển nội thành cho đơn hàng từ 2.000.000 đ.<br/>
          * Đổi trả miễn phí trong 7 ngày nếu có lỗi kỹ thuật từ nhà sản xuất.
        </p>

      </div>
    </div>

  </main>
</BaseLayout>

<script>
  import { addToCart, showCartToast } from '../../scripts/cart';

  const btnAdd = document.getElementById('btn-add-to-cart') as HTMLButtonElement | null;
  const btnBuy = document.getElementById('btn-buy-now') as HTMLButtonElement | null;
  const inputQty = document.getElementById('input-qty') as HTMLInputElement | null;
  const btnMinus = document.getElementById('btn-qty-minus') as HTMLButtonElement | null;
  const btnPlus = document.getElementById('btn-qty-plus') as HTMLButtonElement | null;

  const getQty = (): number => {
    const val = Number(inputQty?.value || 1);
    return Math.max(1, Math.min(99, val));
  };

  btnMinus?.addEventListener('click', () => {
    if (inputQty) {
      inputQty.value = String(Math.max(1, getQty() - 1));
    }
  });

  btnPlus?.addEventListener('click', () => {
    if (inputQty) {
      inputQty.value = String(getQty() + 1);
    }
  });

  const getItemPayload = (btnEl: HTMLButtonElement) => ({
    slug: btnEl.dataset.slug || '',
    name: btnEl.dataset.name || '',
    price: Number(btnEl.dataset.price || 0),
    thumbnail: btnEl.dataset.thumbnail || undefined,
    category: btnEl.dataset.category || undefined,
  });

  if (btnAdd && !btnAdd.disabled) {
    btnAdd.addEventListener('click', () => {
      const payload = getItemPayload(btnAdd);
      const qty = getQty();
      addToCart(payload, qty);
      showCartToast(`Đã thêm ${qty} x "${payload.name}" vào giỏ hàng!`);
    });
  }

  if (btnBuy && !btnBuy.disabled) {
    btnBuy.addEventListener('click', () => {
      const payload = getItemPayload(btnBuy);
      const qty = getQty();
      addToCart(payload, qty);
      window.location.href = '/thanh-toan';
    });
  }
</script>