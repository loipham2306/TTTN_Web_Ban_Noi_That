---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products }        from '../../data/products';
import { productDetails }  from '../../data/product-details';
import { formatVnd }       from '../../scripts/cart';
import ProductCard         from '../../components/ProductCard.astro';

export async function getStaticPaths() {
  const slugs = new Set(products.map((p) => p.slug));
  try {
    const res = await fetch('http://localhost:4000/api/products?limit=100', {
      signal: AbortSignal.timeout(2000),
    });
    if (res.ok) {
      const json = await res.json();
      if (json.success && Array.isArray(json.data)) {
        json.data.forEach((p: any) => slugs.add(p.slug));
      }
    }
  } catch {}

  return Array.from(slugs).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;

// Try fetching live data from backend API
let apiProduct: any = null;
try {
  const res = await fetch(`http://localhost:4000/api/products/${slug}`, {
    signal: AbortSignal.timeout(2000),
  });
  if (res.ok) {
    const json = await res.json();
    if (json.success) apiProduct = json.data;
  }
} catch {
  // API not available - use static data
}

const staticProduct = products.find((p) => p.slug === slug);
const product = staticProduct || (apiProduct ? {
  slug: apiProduct.slug,
  name: apiProduct.name,
  category: apiProduct.category?.slug || 'sofa',
  categoryLabel: apiProduct.category?.name || 'Nội thất',
  space: 'phong-khach',
  spaceLabel: 'Phòng khách',
  price: apiProduct.variants?.[0]?.price || 0,
  material: apiProduct.variants?.[0]?.material || '',
  thumbnail: apiProduct.images?.[0]?.url || null,
} : null);

if (!product) {
  return Astro.redirect('/san-pham');
}

const detail = productDetails[slug as string] ?? {
  description: apiProduct?.shortDescription || apiProduct?.content || 'Sản phẩm nội thất thiết kế cao cấp.',
  dimensions: apiProduct?.variants?.[0]?.dimensions || 'Kích thước tiêu chuẩn',
  warranty: '24 tháng',
  origin: 'Việt Nam',
  gallery: apiProduct?.images?.map((img: any) => img.url) || [],
};

const name         = apiProduct?.name       ?? product.name;
const price        = apiProduct?.variants?.[0]?.price ?? product.price;
const comparePrice = apiProduct?.variants?.[0]?.comparePrice ?? null;
const material     = apiProduct?.variants?.[0]?.material ?? product.material;
const catLabel     = apiProduct?.category?.name ?? product.categoryLabel;
const catSlug      = apiProduct?.category?.slug ?? product.category;
const thumbnail    = apiProduct?.images?.find((i: any) => i.isThumbnail)?.url || apiProduct?.images?.[0]?.url || (product as any)?.image || (product as any)?.thumbnail || null;
const description  = apiProduct?.shortDescription ?? detail.description;
const dimensions   = apiProduct?.variants?.[0]?.dimensions ?? detail.dimensions;
const warranty     = detail.warranty;
const brand        = apiProduct?.brand ?? null;
const stock        = apiProduct?.variants?.[0]?.stock ?? 10;

// BỘ SƯU TẬP ẢNH GÓC CHỤP (ẢNH CHÍNH + ẢNH CHI TIẾT)
let galleryImages: string[] = [];
if (thumbnail) {
  galleryImages.push(thumbnail);
}
if (apiProduct?.images && Array.isArray(apiProduct.images)) {
  apiProduct.images.forEach((img: any) => {
    if (img?.url && !galleryImages.includes(img.url)) {
      galleryImages.push(img.url);
    }
  });
}
if (detail.gallery && Array.isArray(detail.gallery)) {
  detail.gallery.forEach((url: string) => {
    if (url && !galleryImages.includes(url)) {
      galleryImages.push(url);
    }
  });
}

// Bổ sung các góc chụp phối cảnh đa dạng nếu sản phẩm chỉ mới có 1 ảnh
if (galleryImages.length === 1) {
  const CATEGORY_PREVIEWS: Record<string, string[]> = {
    'sofa': [
      'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=800&q=80',
      'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=800&q=80',
      'https://images.unsplash.com/photo-1540574163026-643ea20ade25?auto=format&fit=crop&w=800&q=80',
    ],
    'ban-an': [
      'https://images.unsplash.com/photo-1617806118233-18e1de247200?auto=format&fit=crop&w=800&q=80',
      'https://images.unsplash.com/photo-1577140917170-285929fb55b7?auto=format&fit=crop&w=800&q=80',
    ],
    'ghe': [
      'https://images.unsplash.com/photo-1580481077198-c847ad43616b?auto=format&fit=crop&w=800&q=80',
      'https://images.unsplash.com/photo-1503602642458-232111445657?auto=format&fit=crop&w=800&q=80',
    ],
    'giuong': [
      'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=80',
      'https://images.unsplash.com/photo-1540518614846-7ede433c4ef9?auto=format&fit=crop&w=800&q=80',
    ],
    'tu-ke': [
      'https://images.unsplash.com/photo-1595428774223-ef52624120d2?auto=format&fit=crop&w=800&q=80',
    ],
    'den': [
      'https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=800&q=80',
    ],
  };
  const extra = CATEGORY_PREVIEWS[catSlug] || CATEGORY_PREVIEWS['sofa'];
  extra.forEach((url) => {
    if (!galleryImages.includes(url)) galleryImages.push(url);
  });
}

// RELATED PRODUCTS: Same category or space, excluding current product
const sameCategory = products.filter((p) => p.slug !== slug && p.category === product.category);
const sameSpace = products.filter((p) => p.slug !== slug && p.space === product.space && p.category !== product.category);
const otherProducts = products.filter((p) => p.slug !== slug && p.category !== product.category && p.space !== product.space);
const relatedProducts = [...sameCategory, ...sameSpace, ...otherProducts].slice(0, 4);

// REVIEWS FROM MYSQL BACKEND
interface ReviewItem {
  id: number;
  name: string;
  rating: number;
  date: string;
  verified: boolean;
  comment: string;
  reply: string;
}

let reviews: ReviewItem[] = [];
try {
  const revRes = await fetch(`http://localhost:4000/api/reviews?productSlug=${slug}`, {
    signal: AbortSignal.timeout(2000),
  });
  if (revRes.ok) {
    const revJson = await revRes.json();
    if (revJson.success && Array.isArray(revJson.data)) {
      reviews = revJson.data.map((r: any) => ({
        id: r.id,
        name: r.userName || 'Khách hàng',
        rating: r.rating || 5,
        date: new Date(r.createdAt).toLocaleDateString('vi-VN'),
        verified: true,
        comment: r.comment || '',
        reply: r.adminReply || '',
      }));
    }
  }
} catch {
  reviews = [];
}

const totalReviews = reviews.length;
const avgScore = totalReviews > 0 ? (reviews.reduce((acc, r) => acc + r.rating, 0) / totalReviews).toFixed(1) : '5.0';
const fiveStarCount = reviews.filter((r) => r.rating === 5).length;
const fourStarCount = reviews.filter((r) => r.rating === 4).length;
const fiveStarPct = totalReviews > 0 ? Math.round((fiveStarCount / totalReviews) * 100) : 0;
const fourStarPct = totalReviews > 0 ? Math.round((fourStarCount / totalReviews) * 100) : 0;
---

<BaseLayout
  title={`${name} | Nội Thất Cao Cấp`}
  description={description}
>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

    <!-- BREADCRUMB -->
    <nav class="mb-8 flex items-center gap-2 text-xs text-walnut-800/70">
      <a href="/" class="hover:text-walnut-900 transition-colors">Trang chủ</a>
      <span>/</span>
      <a href="/san-pham" class="hover:text-walnut-900 transition-colors">Sản phẩm</a>
      <span>/</span>
      <a href={`/san-pham?danh-muc=${catSlug}`} class="hover:text-walnut-900 transition-colors">{catLabel}</a>
      <span>/</span>
      <span class="text-walnut-900 font-medium">{name}</span>
    </nav>

    <!-- PRODUCT DETAIL -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">

      <!-- LEFT: IMAGES & THUMBNAILS GALLERY -->
      <div class="space-y-4">
        <!-- Main Large Image -->
        <div class="aspect-square w-full overflow-hidden bg-sand-100 rounded-lg border border-walnut-900/10 shadow-sm relative group">
          {thumbnail ? (
            <img
              id="main-product-image"
              src={thumbnail}
              alt={name}
              class="h-full w-full object-cover transition-all duration-300 group-hover:scale-105"
              loading="eager"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=800&q=80';"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-sand-200/50">
              <svg class="h-24 w-24 text-walnut-900/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          )}
        </div>

        <!-- BỘ SƯU TẬP ẢNH GÓC CHỤP CHI TIẾT (TO RA KHỚP 100% CHIỀU RỘNG ẢNH TRÊN) -->
        {galleryImages.length > 0 && (
          <div class="mt-3">
            <div 
              class="grid gap-3 sm:gap-4 w-full"
              style={`grid-template-columns: repeat(${Math.min(galleryImages.length, 5)}, minmax(0, 1fr));`}
            >
              {galleryImages.map((imgUrl, idx) => (
                <button
                  type="button"
                  data-gallery-thumb
                  data-img-src={imgUrl}
                  class:list={[
                    'relative aspect-square w-full overflow-hidden rounded-lg border-2 transition-all cursor-pointer bg-sand-50 hover:opacity-100 group shadow-sm',
                    idx === 0 ? 'border-clay-600 ring-2 ring-clay-600/30' : 'border-walnut-900/15 opacity-70 hover:border-walnut-900/50 hover:opacity-100'
                  ]}
                  title={`Xem ảnh ${idx + 1}`}
                  aria-label={`Xem ảnh ${idx + 1}`}
                >
                  <img
                    src={imgUrl}
                    alt={`${name} - Góc chụp ${idx + 1}`}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
                    loading="lazy"
                    onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=400&q=80';"
                  />
                </button>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- RIGHT: INFO -->
      <div class="flex flex-col">

        <!-- Category & Brand -->
        <div class="flex items-center gap-3">
          <a
            href={`/san-pham?danh-muc=${catSlug}`}
            class="text-[11px] uppercase tracking-[0.25em] text-walnut-800 hover:text-clay-600 transition-colors"
          >
            {catLabel}
          </a>
          {brand && (
            <span class="text-walnut-800/40">|</span>
            <span class="text-[11px] uppercase tracking-[0.2em] text-walnut-800/60">{brand}</span>
          )}
        </div>

        <!-- Name -->
        <h1 class="mt-3 font-display text-3xl tracking-tight text-walnut-900 sm:text-4xl">
          {name}
        </h1>

        <!-- Rating overview badge -->
        <div class="mt-3 flex items-center gap-2">
          <div class="flex text-amber-500 text-sm">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <span class="text-xs font-semibold text-walnut-900">4.9 / 5.0</span>
          <span class="text-xs text-walnut-800/50">({reviews.length} đánh giá thực tế)</span>
        </div>

        <!-- Price -->
        <div class="mt-5 flex items-baseline gap-4">
          <span class="font-display text-2xl text-clay-600 font-semibold">{formatVnd(price)}</span>
          {comparePrice && (
            <span class="text-sm text-walnut-800/50 line-through">{formatVnd(comparePrice)}</span>
          )}
        </div>

        <!-- Stock Status -->
        <div class="mt-3">
          {stock > 0 ? (
            <span class="inline-flex items-center gap-1.5 text-xs text-emerald-700">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Còn hàng ({stock} sản phẩm sẵn có)
            </span>
          ) : (
            <span class="inline-flex items-center gap-1.5 text-xs text-red-600">
              <span class="h-2 w-2 rounded-full bg-red-500"></span>
              Hết hàng - liên hệ đặt trước
            </span>
          )}
        </div>

        <!-- Description -->
        <p class="mt-6 text-sm leading-relaxed text-walnut-800">{description}</p>

        <!-- Specs -->
        <dl class="mt-8 space-y-3 border-t border-walnut-900/10 pt-6">
          <div class="flex justify-between text-sm">
            <dt class="text-walnut-800/70 uppercase tracking-wider text-[11px]">Chất liệu</dt>
            <dd class="text-walnut-900 font-medium">{material}</dd>
          </div>
          <div class="flex justify-between text-sm">
            <dt class="text-walnut-800/70 uppercase tracking-wider text-[11px]">Kích thước</dt>
            <dd class="text-walnut-900 font-medium">{dimensions}</dd>
          </div>
          <div class="flex justify-between text-sm">
            <dt class="text-walnut-800/70 uppercase tracking-wider text-[11px]">Bảo hành</dt>
            <dd class="text-walnut-900 font-medium">{warranty}</dd>
          </div>
        </dl>

        <!-- QUANTITY SELECTOR -->
        <div class="mt-8 flex items-center gap-4">
          <span class="text-xs uppercase tracking-wider text-walnut-800">Số lượng:</span>
          <div class="inline-flex items-center border border-walnut-900/20 bg-sand-50 rounded">
            <button
              type="button"
              id="btn-qty-minus"
              class="px-3 py-1.5 text-walnut-900 transition-colors hover:bg-walnut-900/10 text-base cursor-pointer"
              aria-label="Giảm số lượng"
            >-</button>
            <input
              type="number"
              id="input-qty"
              min="1"
              max={stock || 99}
              value="1"
              class="w-12 border-x border-walnut-900/20 bg-transparent py-1.5 text-center text-sm font-medium text-walnut-900 outline-none"
            />
            <button
              type="button"
              id="btn-qty-plus"
              class="px-3 py-1.5 text-walnut-900 transition-colors hover:bg-walnut-900/10 text-base cursor-pointer"
              aria-label="Tăng số lượng"
            >+</button>
          </div>
        </div>

        <!-- CTA BUTTONS -->
        <div class="mt-8 flex items-center gap-3">
          <!-- NÚT TRÁI TIM YÊU THÍCH (BÊN TRÁI THÊM VÀO GIỎ HÀNG) -->
          <button
            id="btn-toggle-wishlist"
            type="button"
            data-slug={slug}
            data-name={name}
            data-price={price}
            class="group flex h-12 w-12 shrink-0 items-center justify-center rounded border-2 border-walnut-900/20 bg-sand-50 text-walnut-900 transition-all hover:border-red-500 hover:text-red-500 hover:scale-105 active:scale-95 cursor-pointer shadow-sm"
            title="Thêm vào danh sách yêu thích"
            aria-label="Yêu thích sản phẩm"
          >
            <svg 
              id="wishlist-icon"
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="1.8" 
              class="h-6 w-6 transition-all duration-300 group-hover:scale-110"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </button>

          <button
            id="btn-add-to-cart"
            type="button"
            data-slug={slug}
            data-name={name}
            data-price={price}
            data-thumbnail={thumbnail ?? ''}
            data-category={catLabel}
            class="flex-1 bg-clay-600 px-6 py-3.5 text-xs uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 active:scale-95 cursor-pointer font-medium rounded shadow-sm h-12 flex items-center justify-center"
            disabled={stock === 0}
          >
            {stock > 0 ? 'Thêm vào giỏ hàng' : 'Hết hàng'}
          </button>
          <button
            id="btn-buy-now"
            type="button"
            data-slug={slug}
            data-name={name}
            data-price={price}
            data-thumbnail={thumbnail ?? ''}
            data-category={catLabel}
            class="flex-1 border-2 border-walnut-900 px-6 py-3.5 text-center text-xs uppercase tracking-[0.2em] text-walnut-900 transition-all hover:bg-walnut-900 hover:text-sand-50 active:scale-95 cursor-pointer font-medium rounded h-12 flex items-center justify-center"
            disabled={stock === 0}
          >
            Mua ngay
          </button>
        </div>

        <!-- Notes -->
        <p class="mt-6 text-xs text-walnut-800/60 leading-relaxed">
          * Miễn phí vận chuyển nội thành cho đơn hàng từ 2.000.000 đ.<br/>
          * Đổi trả miễn phí trong 7 ngày nếu có lỗi kỹ thuật từ nhà sản xuất.
        </p>

      </div>
    </div>

    <!-- ============================================================== -->
    <!-- SECTION 1: ĐÁNH GIÁ TỪ KHÁCH HÀNG (CUSTOMER REVIEWS & RATINGS) -->
    <!-- ============================================================== -->
    <section id="reviews-section" class="mt-20 border-t border-walnut-900/10 pt-16">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.25em] text-clay-600">Đánh giá & Trải nghiệm</span>
          <h2 class="mt-2 font-display text-2xl sm:text-3xl text-walnut-900 font-bold">Khách Hàng Nói Gì Về Sản Phẩm?</h2>
          <p class="mt-1 text-sm text-walnut-800/80">Tổng hợp những cảm nhận chân thực nhất từ gia chủ đã trực tiếp sở hữu và sử dụng.</p>
        </div>

        <button 
          type="button" 
          id="btn-open-review-modal"
          class="inline-flex items-center gap-2 bg-walnut-900 px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 hover:bg-clay-600 transition-colors shadow-sm cursor-pointer font-medium rounded-sm self-start sm:self-auto"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span>Viết đánh giá của bạn</span>
        </button>
      </div>

      <!-- Rating Breakdown Box -->
      <div class="rounded-lg border border-walnut-900/10 bg-sand-100/70 p-6 sm:p-8 grid grid-cols-1 md:grid-cols-3 gap-8 items-center shadow-sm">
        
        <!-- Score summary -->
        <div class="text-center md:text-left border-b md:border-b-0 md:border-r border-walnut-900/10 pb-6 md:pb-0 md:pr-8">
          <p class="text-xs uppercase tracking-wider text-walnut-800/70 font-medium">Điểm trung bình</p>
          <div class="mt-2 flex items-baseline justify-center md:justify-start gap-2">
            <span class="text-4xl sm:text-5xl font-bold font-display text-walnut-900">{avgScore}</span>
            <span class="text-sm text-walnut-800/60 font-semibold">/ 5.0</span>
          </div>
          <div class="mt-2 flex items-center justify-center md:justify-start text-amber-500 text-lg">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <p class="mt-2 text-xs text-emerald-800 font-medium">
            {totalReviews > 0 ? `✓ ${totalReviews} Khách hàng đánh giá hài lòng` : 'Chưa có lượt đánh giá nào'}
          </p>
        </div>

        <!-- Rating Progress bars -->
        <div class="space-y-2.5">
          <div class="flex items-center gap-3 text-xs">
            <span class="w-12 text-walnut-900 font-semibold">5 sao</span>
            <div class="flex-1 h-2 rounded-full bg-sand-200 overflow-hidden">
              <div class="h-full bg-clay-600 rounded-full" style={`width: ${fiveStarPct}%`}></div>
            </div>
            <span class="w-8 text-right text-walnut-800/70">{fiveStarPct}%</span>
          </div>
          <div class="flex items-center gap-3 text-xs">
            <span class="w-12 text-walnut-900 font-semibold">4 sao</span>
            <div class="flex-1 h-2 rounded-full bg-sand-200 overflow-hidden">
              <div class="h-full bg-clay-600 rounded-full" style={`width: ${fourStarPct}%`}></div>
            </div>
            <span class="w-8 text-right text-walnut-800/70">{fourStarPct}%</span>
          </div>
          <div class="flex items-center gap-3 text-xs">
            <span class="w-12 text-walnut-900 font-semibold">3 sao</span>
            <div class="flex-1 h-2 rounded-full bg-sand-200 overflow-hidden">
              <div class="h-full bg-clay-600 rounded-full" style="width: 0%"></div>
            </div>
            <span class="w-8 text-right text-walnut-800/70">0%</span>
          </div>
          <div class="flex items-center gap-3 text-xs">
            <span class="w-12 text-walnut-900 font-semibold">2 sao</span>
            <div class="flex-1 h-2 rounded-full bg-sand-200 overflow-hidden">
              <div class="h-full bg-clay-600 rounded-full" style="width: 0%"></div>
            </div>
            <span class="w-8 text-right text-walnut-800/70">0%</span>
          </div>
          <div class="flex items-center gap-3 text-xs">
            <span class="w-12 text-walnut-900 font-semibold">1 sao</span>
            <div class="flex-1 h-2 rounded-full bg-sand-200 overflow-hidden">
              <div class="h-full bg-clay-600 rounded-full" style="width: 0%"></div>
            </div>
            <span class="w-8 text-right text-walnut-800/70">0%</span>
          </div>
        </div>

        <!-- Policy & Voucher Incentive -->
        <div class="bg-sand-50 p-5 rounded border border-walnut-900/10 text-xs space-y-2 text-walnut-900">
          <p class="font-bold uppercase tracking-wider text-[11px] text-clay-700 flex items-center gap-1.5">
            <span>🎁</span> Nhận Voucher Khuyến Mãi
          </p>
          <p class="text-walnut-800 leading-relaxed">
            Đánh giá kèm cảm nhận thực tế sau khi mua sắm để nhận ngay mã giảm giá <strong class="text-clay-600 font-semibold">100.000 ₫</strong> cho đơn hàng kế tiếp.
          </p>
          <div class="pt-2 text-[11px] text-walnut-800/60 border-t border-walnut-900/10">
            Mọi đánh giá đều được xác minh danh tính và kiểm duyệt công khai.
          </div>
        </div>

      </div>

      <!-- Filter Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-2" id="review-filters">
        <button type="button" data-filter="all" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-walnut-900 text-sand-50 cursor-pointer transition-colors">Tất cả ({totalReviews})</button>
        <button type="button" data-filter="5" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-sand-200/80 text-walnut-900 hover:bg-sand-200 cursor-pointer transition-colors">5 Sao ({fiveStarCount})</button>
        <button type="button" data-filter="4" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-sand-200/80 text-walnut-900 hover:bg-sand-200 cursor-pointer transition-colors">4 Sao ({fourStarCount})</button>
        <button type="button" data-filter="has-reply" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-sand-200/80 text-walnut-900 hover:bg-sand-200 cursor-pointer transition-colors">Có phản hồi từ Store</button>
      </div>

      <!-- Customer Reviews List -->
      <div class="mt-6 space-y-4" id="review-list">
        {reviews.length === 0 ? (
          <div class="rounded-lg border border-dashed border-walnut-900/20 bg-sand-50/50 p-8 text-center text-sm text-walnut-800">
            Chưa có đánh giá nào cho sản phẩm này. Hãy là khách hàng đầu tiên chia sẻ trải nghiệm của bạn!
          </div>
        ) : (
          reviews.map((r) => (
            <div 
              class="rounded-lg border border-walnut-900/10 bg-sand-50 p-5 sm:p-6 transition-all hover:border-walnut-900/20"
              data-review-item
              data-rating={r.rating}
              data-has-reply={r.reply ? 'true' : 'false'}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="h-10 w-10 rounded-full bg-walnut-900 text-sand-50 font-bold flex items-center justify-center text-xs">
                    {r.name.split(' ').map((n: string) => n[0]).slice(-2).join('')}
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="font-bold text-sm text-walnut-900">{r.name}</h3>
                      {r.verified && (
                        <span class="inline-flex items-center gap-1 rounded bg-emerald-100 text-emerald-800 border border-emerald-300 px-1.5 py-0.5 text-[10px] font-semibold">
                          <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                          </svg>
                          Đã mua hàng chính hãng
                        </span>
                      )}
                    </div>
                    <p class="text-[11px] text-walnut-800/60 mt-0.5">{r.date}</p>
                  </div>
                </div>

                <div class="flex text-amber-500 text-sm">
                  {Array.from({ length: r.rating }).map(() => (
                    <span>★</span>
                  ))}
                  {Array.from({ length: 5 - r.rating }).map(() => (
                    <span class="text-walnut-900/20">★</span>
                  ))}
                </div>
              </div>

              <p class="mt-3.5 text-sm leading-relaxed text-walnut-900 font-normal">
                {r.comment}
              </p>

              {r.reply && (
                <div class="mt-4 rounded border-l-2 border-clay-600 bg-sand-100/70 p-3.5 text-xs text-walnut-800 space-y-1">
                  <div class="flex items-center gap-1.5 font-bold text-clay-700 uppercase tracking-wider text-[10px]">
                    <span>💬 Phản hồi từ Quản trị viên Nội Thất:</span>
                  </div>
                  <p class="leading-relaxed">{r.reply}</p>
                </div>
              )}
            </div>
          ))
        )}
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- SECTION 2: SẢN PHẨM LIÊN QUAN (RELATED PRODUCTS SECTION)       -->
    <!-- ============================================================== -->
    <section class="mt-24 border-t border-walnut-900/10 pt-16">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.25em] text-clay-600">Bộ Sưu Tập Gợi Ý</span>
          <h2 class="mt-2 font-display text-2xl sm:text-3xl text-walnut-900 font-bold">Sản Phẩm Cùng Phong Cách</h2>
          <p class="mt-1 text-sm text-walnut-800/80">Những thiết kế đồng điệu về vật liệu và cảm hứng thẩm mỹ để bạn dễ dàng hoàn thiện không gian sống.</p>
        </div>

        <a 
          href={`/san-pham?danh-muc=${catSlug}`}
          class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.15em] text-walnut-900 hover:text-clay-600 transition-colors group cursor-pointer"
        >
          <span>Xem tất cả {catLabel}</span>
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <!-- Related Products Grid -->
      <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {relatedProducts.map((rp) => (
          <ProductCard product={rp} />
        ))}
      </div>
    </section>

  </main>

  <!-- MODAL: VIẾT ĐÁNH GIÁ SẢN PHẨM -->
  <div id="write-review-modal" class="fixed inset-0 z-50 hidden bg-walnut-900/60 backdrop-blur-sm overflow-y-auto p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/20 w-full max-w-lg p-6 sm:p-8 shadow-xl relative my-8">
      <div class="flex items-center justify-between border-b border-walnut-900/10 pb-4">
        <div>
          <p class="text-[10px] uppercase tracking-[0.2em] text-walnut-800">Đánh giá sản phẩm</p>
          <h2 class="text-xl font-bold text-walnut-900 mt-1">Cảm Nhận Của Bạn</h2>
          <p class="text-xs text-clay-600 font-medium truncate max-w-sm mt-0.5">{name}</p>
        </div>
        <button type="button" id="btn-close-review-modal" class="text-walnut-800 hover:text-danger-600 p-1 cursor-pointer">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="write-review-form" class="mt-6 flex flex-col gap-4">
        <div>
          <label class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium mb-1.5">Mức độ hài lòng của bạn *</label>
          <div class="flex items-center gap-2 cursor-pointer text-2xl text-amber-500" id="star-picker">
            <span data-star="1" class="transition-transform hover:scale-125">★</span>
            <span data-star="2" class="transition-transform hover:scale-125">★</span>
            <span data-star="3" class="transition-transform hover:scale-125">★</span>
            <span data-star="4" class="transition-transform hover:scale-125">★</span>
            <span data-star="5" class="transition-transform hover:scale-125">★</span>
            <span id="star-desc" class="text-xs text-walnut-900 font-semibold ml-2">5 sao - Rất tuyệt vời</span>
          </div>
          <input type="hidden" id="review-stars-input" value="5" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="review-author-name" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Họ và tên *</label>
            <input 
              type="text" 
              id="review-author-name" 
              required 
              placeholder="VD: Hoàng Minh Trí" 
              class="mt-1.5 w-full border border-walnut-900/20 bg-sand-100/50 px-3.5 py-2 text-xs outline-none focus:border-clay-600 focus:bg-sand-50"
            />
          </div>
          <div>
            <label for="review-author-phone" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Số điện thoại xác thực *</label>
            <input 
              type="text" 
              id="review-author-phone" 
              required 
              placeholder="0909 xxx xxx" 
              class="mt-1.5 w-full border border-walnut-900/20 bg-sand-100/50 px-3.5 py-2 text-xs outline-none focus:border-clay-600 focus:bg-sand-50"
            />
          </div>
        </div>

        <div>
          <label for="review-comment-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Chia sẻ chi tiết trải nghiệm của bạn *</label>
          <textarea 
            id="review-comment-input" 
            required 
            rows="4" 
            placeholder="Bạn thấy chất lượng gia công, độ êm ái, màu sắc thực tế và dịch vụ giao hàng như thế nào?..." 
            class="mt-1.5 w-full border border-walnut-900/20 bg-sand-100/50 p-3 text-xs outline-none focus:border-clay-600 focus:bg-sand-50 leading-relaxed"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-walnut-900/10 pt-4 mt-2">
          <button 
            type="button" 
            id="btn-cancel-review-modal" 
            class="border border-walnut-900/20 px-5 py-2 text-xs uppercase tracking-[0.15em] text-walnut-800 hover:border-walnut-900 cursor-pointer"
          >
            Hủy
          </button>
          <button 
            type="submit" 
            class="bg-clay-600 px-6 py-2 text-xs uppercase tracking-[0.15em] text-sand-50 hover:bg-clay-500 shadow-sm cursor-pointer font-medium"
          >
            Gửi đánh giá
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOAST THÔNG BÁO -->
  <div id="review-user-toast" class="fixed bottom-6 right-6 z-50 hidden translate-y-4 rounded bg-walnut-900 px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300 border border-emerald-500/40">
    <span id="review-user-toast-msg">Đã gửi đánh giá thành công!</span>
  </div>

</BaseLayout>

<script>
  import { addToCart, showCartToast } from '../../scripts/cart';

  // CART & QUANTITY
  const btnAdd = document.getElementById('btn-add-to-cart') as HTMLButtonElement | null;
  const btnBuy = document.getElementById('btn-buy-now') as HTMLButtonElement | null;
  const inputQty = document.getElementById('input-qty') as HTMLInputElement | null;
  const btnMinus = document.getElementById('btn-qty-minus') as HTMLButtonElement | null;
  const btnPlus = document.getElementById('btn-qty-plus') as HTMLButtonElement | null;

  const getQty = (): number => {
    const val = Number(inputQty?.value || 1);
    return Math.max(1, Math.min(99, val));
  };

  btnMinus?.addEventListener('click', () => {
    if (inputQty) inputQty.value = String(Math.max(1, getQty() - 1));
  });

  btnPlus?.addEventListener('click', () => {
    if (inputQty) inputQty.value = String(getQty() + 1);
  });

  const getItemPayload = (btnEl: HTMLButtonElement) => ({
    slug: btnEl.dataset.slug || '',
    name: btnEl.dataset.name || '',
    price: Number(btnEl.dataset.price || 0),
    thumbnail: btnEl.dataset.thumbnail || undefined,
    category: btnEl.dataset.category || undefined,
  });

  if (btnAdd && !btnAdd.disabled) {
    btnAdd.addEventListener('click', () => {
      const payload = getItemPayload(btnAdd);
      const qty = getQty();
      addToCart(payload, qty);
      showCartToast(`Đã thêm ${qty} x "${payload.name}" vào giỏ hàng!`);
    });
  }

  if (btnBuy && !btnBuy.disabled) {
    btnBuy.addEventListener('click', () => {
      const payload = getItemPayload(btnBuy);
      const qty = getQty();
      addToCart(payload, qty);
      window.location.href = '/thanh-toan';
    });
  }

  // ==============================================================
  // WISHLIST HEART TOGGLE
  // ==============================================================
  const btnWishlist = document.getElementById('btn-toggle-wishlist') as HTMLButtonElement | null;
  const iconWishlist = document.getElementById('wishlist-icon') as SVGElement | null;

  const currentSlug = btnWishlist?.dataset.slug || '';
  const currentName = btnWishlist?.dataset.name || '';
  const currentPrice = Number(btnWishlist?.dataset.price || 0);

  const updateWishlistUI = (isSaved: boolean) => {
    if (!btnWishlist || !iconWishlist) return;
    if (isSaved) {
      btnWishlist.classList.add('border-red-500', 'text-red-500', 'bg-red-50');
      btnWishlist.classList.remove('border-walnut-900/20', 'text-walnut-900', 'bg-sand-50');
      iconWishlist.setAttribute('fill', 'currentColor');
    } else {
      btnWishlist.classList.remove('border-red-500', 'text-red-500', 'bg-red-50');
      btnWishlist.classList.add('border-walnut-900/20', 'text-walnut-900', 'bg-sand-50');
      iconWishlist.setAttribute('fill', 'none');
    }
  };

  // Check state on load
  const getWishlist = (): any[] => {
    try {
      return JSON.parse(localStorage.getItem('user_wishlist') || '[]');
    } catch {
      return [];
    }
  };

  const isFavorited = (slugStr: string): boolean => {
    return getWishlist().some((item: any) => item.slug === slugStr);
  };

  if (currentSlug) {
    updateWishlistUI(isFavorited(currentSlug));
  }

  btnWishlist?.addEventListener('click', () => {
    const list = getWishlist();
    const index = list.findIndex((item: any) => item.slug === currentSlug);
    if (index > -1) {
      list.splice(index, 1);
      localStorage.setItem('user_wishlist', JSON.stringify(list));
      localStorage.setItem('user_wishlist_slugs', JSON.stringify(list.map((i: any) => i.slug)));
      window.dispatchEvent(new Event('wishlist:changed'));
      updateWishlistUI(false);
      showToast(`Đã bỏ "${currentName}" khỏi danh sách yêu thích!`);
    } else {
      list.unshift({
        slug: currentSlug,
        name: currentName,
        price: currentPrice,
      });
      localStorage.setItem('user_wishlist', JSON.stringify(list));
      localStorage.setItem('user_wishlist_slugs', JSON.stringify(list.map((i: any) => i.slug)));
      window.dispatchEvent(new Event('wishlist:changed'));
      updateWishlistUI(true);
      showToast(`Đã thêm "${currentName}" vào danh sách yêu thích! ❤️`);
    }
  });

  // ==============================================================
  // REVIEW INTERACTION & FILTERING
  // ==============================================================
  const modal = document.getElementById('write-review-modal') as HTMLElement | null;
  const btnOpenModal = document.getElementById('btn-open-review-modal') as HTMLButtonElement | null;
  const btnCloseModal = document.getElementById('btn-close-review-modal') as HTMLButtonElement | null;
  const btnCancelModal = document.getElementById('btn-cancel-review-modal') as HTMLButtonElement | null;
  const form = document.getElementById('write-review-form') as HTMLFormElement | null;
  const reviewList = document.getElementById('review-list') as HTMLElement | null;
  const starPicker = document.getElementById('star-picker') as HTMLElement | null;
  const starInput = document.getElementById('review-stars-input') as HTMLInputElement | null;
  const starDesc = document.getElementById('star-desc') as HTMLElement | null;

  // Toast
  const toast = document.getElementById('review-user-toast') as HTMLElement | null;
  const toastMsg = document.getElementById('review-user-toast-msg') as HTMLElement | null;

  const showToast = (msg: string) => {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    toast.classList.remove('hidden');
    requestAnimationFrame(() => toast.classList.remove('translate-y-4'));
    setTimeout(() => {
      toast.classList.add('translate-y-4');
      setTimeout(() => toast.classList.add('hidden'), 300);
    }, 3500);
  };

  const closeModal = () => modal?.classList.add('hidden');
  btnOpenModal?.addEventListener('click', () => {
    form?.reset();
    modal?.classList.remove('hidden');
  });
  btnCloseModal?.addEventListener('click', closeModal);
  btnCancelModal?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Star Picker
  const starLabels: Record<number, string> = {
    1: '1 sao - Kém hài lòng',
    2: '2 sao - Chưa ưng ý',
    3: '3 sao - Tạm ổn',
    4: '4 sao - Tốt & Hài lòng',
    5: '5 sao - Rất tuyệt vời',
  };

  starPicker?.querySelectorAll<HTMLSpanElement>('[data-star]').forEach((starEl) => {
    starEl.addEventListener('click', () => {
      const rating = Number(starEl.dataset.star || '5');
      if (starInput) starInput.value = String(rating);
      if (starDesc) starDesc.textContent = starLabels[rating] || '';

      starPicker.querySelectorAll<HTMLSpanElement>('[data-star]').forEach((s) => {
        const val = Number(s.dataset.star || '0');
        if (val <= rating) {
          s.classList.remove('text-walnut-900/20');
          s.classList.add('text-amber-500');
        } else {
          s.classList.remove('text-amber-500');
          s.classList.add('text-walnut-900/20');
        }
      });
    });
  });

  // Filter Reviews
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('#review-filters [data-filter]');
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.className = 'px-3.5 py-1.5 rounded-full text-xs font-semibold bg-sand-200/80 text-walnut-900 hover:bg-sand-200 cursor-pointer transition-colors';
      });
      btn.className = 'px-3.5 py-1.5 rounded-full text-xs font-semibold bg-walnut-900 text-sand-50 cursor-pointer transition-colors';

      const filter = btn.dataset.filter;
      const items = reviewList?.querySelectorAll<HTMLElement>('[data-review-item]');
      items?.forEach((item) => {
        const rating = item.dataset.rating;
        const hasReply = item.dataset.hasReply === 'true';

        if (filter === 'all') {
          item.classList.remove('hidden');
        } else if (filter === 'has-reply') {
          item.classList.toggle('hidden', !hasReply);
        } else {
          item.classList.toggle('hidden', rating !== filter);
        }
      });
    });
  });

  // Submit Review Form
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('review-author-name') as HTMLInputElement)?.value.trim();
    const comment = (document.getElementById('review-comment-input') as HTMLTextAreaElement)?.value.trim();
    const rating = Number(starInput?.value || '5');

    if (!name || !comment || !reviewList) return;

    const initials = name.split(' ').map((n) => n[0]).slice(-2).join('');
    const newDiv = document.createElement('div');
    newDiv.className = 'rounded-lg border border-walnut-900/10 bg-sand-50 p-5 sm:p-6 transition-all hover:border-walnut-900/20 bg-emerald-50/20';
    newDiv.setAttribute('data-review-item', '');
    newDiv.dataset.rating = String(rating);
    newDiv.dataset.hasReply = 'false';

    const starsHtml = Array.from({ length: rating }).map(() => '<span>★</span>').join('') +
      Array.from({ length: 5 - rating }).map(() => '<span class="text-walnut-900/20">★</span>').join('');

    newDiv.innerHTML = `
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-full bg-emerald-800 text-sand-50 font-bold flex items-center justify-center text-xs">
            ${initials}
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-sm text-walnut-900">${name}</h3>
              <span class="inline-flex items-center gap-1 rounded bg-emerald-100 text-emerald-800 border border-emerald-300 px-1.5 py-0.5 text-[10px] font-semibold">
                ✓ Đã mua hàng chính hãng
              </span>
            </div>
            <p class="text-[11px] text-walnut-800/60 mt-0.5">Vừa xong</p>
          </div>
        </div>
        <div class="flex text-amber-500 text-sm">
          ${starsHtml}
        </div>
      </div>
      <p class="mt-3.5 text-sm leading-relaxed text-walnut-900 font-normal">
        ${comment}
      </p>
    `;

    reviewList.prepend(newDiv);
    closeModal();
    showToast('Cảm ơn bạn! Đánh giá của bạn đã được ghi nhận thành công.');
  });

  // GALLERY THUMBNAIL INTERACTION
  const mainProductImg = document.getElementById('main-product-image') as HTMLImageElement | null;
  const galleryThumbs = document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');

  galleryThumbs.forEach((thumbBtn) => {
    thumbBtn.addEventListener('click', () => {
      const newSrc = thumbBtn.dataset.imgSrc;
      if (mainProductImg && newSrc) {
        mainProductImg.style.transition = 'opacity 0.2s ease';
        mainProductImg.style.opacity = '0.3';
        setTimeout(() => {
          mainProductImg.src = newSrc;
          mainProductImg.style.opacity = '1';
        }, 150);
      }

      galleryThumbs.forEach((btn) => {
        btn.classList.remove('border-clay-600', 'ring-2', 'ring-clay-600/30');
        btn.classList.add('border-walnut-900/15', 'opacity-70');
      });

      thumbBtn.classList.add('border-clay-600', 'ring-2', 'ring-clay-600/30');
      thumbBtn.classList.remove('border-walnut-900/15', 'opacity-70');
    });
  });
</script>