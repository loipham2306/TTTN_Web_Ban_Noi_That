---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroSlider from '../components/HeroSlider.astro'; 
import { products as fallbackProducts } from '../data/products';
import { CONTACT } from '../data/contact';

// 1. Dữ liệu tĩnh dự phòng cho "Mua theo không gian" (nếu Admin chưa có)
const defaultSpaces = [
  { name: 'Phòng khách', href: '/san-pham?khong-gian=phong-khach', image: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80' },
  { name: 'Phòng ăn', href: '/san-pham?khong-gian=phong-an', image: 'https://images.unsplash.com/photo-1617806118233-18e1de247200?auto=format&fit=crop&w=800&q=80' },
  { name: 'Phòng ngủ', href: '/san-pham?khong-gian=phong-ngu', image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=80' },
  { name: 'Làm việc', href: '/san-pham?khong-gian=lam-viec', image: 'https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=800&q=80' },
  { name: 'Chiếu sáng', href: '/san-pham?khong-gian=chieu-sang', image: 'https://images.unsplash.com/photo-1513506003901-1e6a229e2d15?auto=format&fit=crop&w=800&q=80' },
  { name: 'Ngoài trời', href: '/san-pham?khong-gian=ngoai-troi', image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80' },
];

// 2. Dữ liệu tĩnh dự phòng cho "Không gian thực tế" (nếu Admin chưa có)
const defaultProjects = [
  { title: 'Căn hộ trung tâm', image: 'https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=800&q=80' },
  { title: 'Nhà phố hiện đại', image: 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=800&q=80' },
  { title: 'Biệt thự ven sông', image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=800&q=80' },
  { title: 'Khách sạn boutique', image: 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80' },
];

let spaces = defaultSpaces;
let projects = defaultProjects;
let liveProducts = fallbackProducts;

try {
  // Gọi API lấy dữ liệu Không gian từ bảng banners (position = 'space')
  const resSpace = await fetch('http://localhost:4000/api/banners?position=space&activeOnly=true', { signal: AbortSignal.timeout(2000) });
  if (resSpace.ok) {
    const json = await resSpace.json();
    if (json.success && Array.isArray(json.data) && json.data.length > 0) {
      spaces = json.data.map((b: any) => ({
        name: b.title,
        href: b.linkUrl || '/san-pham',
        image: b.imageUrl,
      }));
    }
  }
} catch {}

try {
  // Gọi API lấy dữ liệu Không gian thực tế từ bảng banners (position = 'showcase')
  const resShowcase = await fetch('http://localhost:4000/api/banners?position=showcase&activeOnly=true', { signal: AbortSignal.timeout(2000) });
  if (resShowcase.ok) {
    const json = await resShowcase.json();
    if (json.success && Array.isArray(json.data) && json.data.length > 0) {
      projects = json.data.map((b: any) => ({
        title: b.title,
        image: b.imageUrl,
      }));
    }
  }
} catch {}

try {
  const res = await fetch('http://localhost:4000/api/products?limit=8', { signal: AbortSignal.timeout(2000) });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data) && json.data.length > 0) {
      liveProducts = json.data.map((p: any) => ({
        id: p.id,
        slug: p.slug,
        name: p.name,
        category: p.category,
        categoryLabel: p.categoryLabel,
        space: p.space || 'phong-khach',
        spaceLabel: p.spaceLabel || 'Phòng khách',
        price: p.price,
        comparePrice: p.comparePrice ? Number(p.comparePrice) : null,
        material: p.material || '',
        thumbnail: p.thumbnail,
        image: p.thumbnail,
        isNew: true,
      }));
    }
  }
} catch {}

const featured = liveProducts.slice(0, 8);
---
<BaseLayout title="Nội Thất Cao Cấp - Trang chủ">

  {/* HERO SLIDER - Banner trượt tự động */}
  <HeroSlider />

  {/* MUA THEO KHÔNG GIAN (Lấy động từ position = 'space') */}
  <section id="mua-theo-khong-gian" class="mx-auto max-w-7xl px-4 py-16 sm:py-24 scroll-mt-24">
    <p class="text-center text-xs uppercase tracking-[0.3em] text-walnut-800">Mua theo không gian</p>
    <h2 class="mt-3 text-center font-display text-2xl tracking-tight sm:text-3xl text-walnut-900">Không gian nào bạn đang hoàn thiện?</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {spaces.map((s) => (
        <a href={s.href} class="group relative block overflow-hidden rounded border border-walnut-900/10 shadow-sm">
          <img src={s.image} alt={s.name} class="block aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
          <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
          <span class="absolute inset-0 flex items-center justify-center">
            <span class="bg-sand-50/95 px-6 py-2.5 text-xs font-medium uppercase tracking-[0.2em] text-walnut-900 shadow-sm backdrop-blur rounded-sm group-hover:bg-walnut-900 group-hover:text-sand-50 transition-colors">
              {s.name}
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  {/* SẢN PHẨM NỔI BẬT */}
  <section class="bg-sand-100">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:py-24">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-walnut-800/80">Bộ sưu tập tiêu biểu</p>
          <h2 class="mt-1 font-display text-2xl tracking-tight sm:text-3xl text-walnut-900">Sản phẩm nổi bật</h2>
        </div>
        <a href="/san-pham" class="text-xs uppercase tracking-[0.2em] text-walnut-800 transition hover:text-clay-600 font-medium">
          Xem tất cả →
        </a>
      </div>
      
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4 md:gap-6 lg:gap-8">
        {featured.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  {/* CÂU CHUYỆN THƯƠNG HIỆU */}
  <section id="cau-chuyen" class="mx-auto grid max-w-7xl scroll-mt-20 items-center gap-10 px-4 py-16 sm:py-24 lg:grid-cols-2">
    <div class="aspect-[4/3] w-full bg-sand-200 lg:aspect-[4/5] rounded border border-walnut-900/10 flex items-center justify-center text-walnut-900/20">
      <svg width="64" height="64" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-walnut-800">Câu chuyện thương hiệu</p>
      <h2 class="mt-4 font-display text-2xl leading-snug tracking-tight sm:text-3xl text-walnut-900">
        Mỗi sản phẩm là một cam kết về chất lượng và thẩm mỹ
      </h2>
      <p class="mt-5 max-w-md text-sm leading-relaxed text-walnut-800">
        Chúng tôi làm việc trực tiếp với các xưởng chế tác thủ công, chọn lọc những thiết kế bền vững và trường tồn theo thời gian.
      </p>
      <a href="/san-pham" class="mt-8 inline-block border-b-2 border-walnut-900 pb-1 text-xs uppercase tracking-[0.2em] text-walnut-900 transition hover:border-clay-600 hover:text-clay-600 font-semibold">
        Tìm hiểu thêm
      </a>
    </div>
  </section>

  {/* DỰ ÁN & KHÔNG GIAN THỰC TẾ (Lấy động từ position = 'showcase') */}
  <section id="du-an" class="scroll-mt-20 bg-walnut-900 text-sand-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:py-24">
      <p class="text-xs uppercase tracking-[0.3em] text-sand-200/70">Không gian thực tế</p>
      <h2 class="mt-3 font-display text-2xl tracking-tight sm:text-3xl text-sand-50">Được bài trí cùng chúng tôi</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {projects.map((p) => (
          <div class="group block overflow-hidden rounded bg-white/5 border border-white/10 p-4 transition-all hover:bg-white/10">
            <img src={p.image} alt={p.title} class="block aspect-square w-full object-cover rounded mb-3" />
            <span class="block text-xs uppercase tracking-[0.2em] text-sand-200 font-medium">{p.title}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ĐỐI TÁC + NHẬN TIN */}
  <section id="doi-tac" class="mx-auto max-w-7xl scroll-mt-20 px-4 py-16 sm:py-24">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="border border-walnut-900/10 bg-sand-50 p-8 sm:p-12 rounded shadow-sm">
        <p class="text-xs uppercase tracking-[0.3em] text-walnut-800">Dành cho đối tác</p>
        <h2 class="mt-4 font-display text-2xl tracking-tight text-walnut-900">Kiến trúc sư và nhà thiết kế</h2>
        <p class="mt-4 text-sm leading-relaxed text-walnut-800">Chính sách giá ưu đãi và hỗ trợ riêng cho các dự án nội thất chuyên nghiệp.</p>
        <a href="/san-pham" class="mt-8 inline-block bg-clay-600 px-7 py-3 text-xs uppercase tracking-[0.2em] text-sand-50 transition hover:bg-clay-500 rounded-sm">
          Đăng ký đối tác
        </a>
      </div>
      <div class="border border-walnut-900/10 bg-sand-50 p-8 sm:p-12 rounded shadow-sm">
        <p class="text-xs uppercase tracking-[0.3em] text-walnut-800">Nhận bản tin</p>
        <h2 class="mt-4 font-display text-2xl tracking-tight text-walnut-900">Bộ sưu tập mới và ưu đãi</h2>
        <form class="mt-8 flex flex-col gap-3 sm:flex-row" onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã đăng ký nhận tin!');">
          <input type="email" required placeholder="Nhập địa chỉ email của bạn" class="w-full border-b border-walnut-900/30 bg-transparent px-1 py-3 text-sm outline-none transition focus:border-clay-600" />
          <button type="submit" class="border border-walnut-900 px-7 py-3 text-xs uppercase tracking-[0.2em] text-walnut-900 transition hover:bg-walnut-900 hover:text-sand-50 rounded-sm cursor-pointer">
            Gửi
          </button>
        </form>
      </div>
    </div>
  </section>

  {/* SHOWROOM */}
  <section id="showroom" class="scroll-mt-20 border-t border-walnut-900/10 bg-sand-100 text-walnut-900">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-walnut-800/80">Ghé thăm showroom</p>
        <p class="mt-2 font-display text-xl sm:text-2xl text-walnut-900">615 Âu Cơ, TP. Hồ Chí Minh</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`tel:${CONTACT.phone}`} class="border border-walnut-900/30 px-6 py-2.5 text-xs uppercase tracking-[0.2em] text-walnut-900 transition hover:border-clay-600 hover:bg-clay-600 hover:text-sand-50 rounded-sm">Hotline</a>
          <a href={CONTACT.zalo} target="_blank" rel="noopener noreferrer" class="border border-walnut-900/30 px-6 py-2.5 text-xs uppercase tracking-[0.2em] text-walnut-900 transition hover:border-clay-600 hover:bg-clay-600 hover:text-sand-50 rounded-sm">Zalo</a>
          <a href={CONTACT.messenger} target="_blank" rel="noopener noreferrer" class="border border-walnut-900/30 px-6 py-2.5 text-xs uppercase tracking-[0.2em] text-walnut-900 transition hover:border-clay-600 hover:bg-clay-600 hover:text-sand-50 rounded-sm">Messenger</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-lg border border-walnut-900/10">
        <iframe
          title="Bản đồ showroom 615 Âu Cơ"
          src="https://maps.google.com/maps?q=615%20%C3%82u%20C%C6%A1&z=16&output=embed"
          class="h-72 w-full border-0 lg:h-80"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

</BaseLayout>