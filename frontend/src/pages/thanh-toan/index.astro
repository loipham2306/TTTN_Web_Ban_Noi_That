---
import BaseLayout from '../../layouts/BaseLayout.astro';

const provinces = [
  'Hà Nội',
  'TP. Hồ Chí Minh',
  'Đà Nẵng',
  'Hải Phòng',
  'Cần Thơ',
  'Bình Dương',
  'Đồng Nai',
  'Khánh Hòa',
  'Quảng Ninh',
  'Tỉnh/thành khác',
];
---

<BaseLayout title="Thanh toán & Đặt hàng | Nội Thất" description="Hoàn tất đơn hàng: thông tin giao hàng, phương thức thanh toán và xác nhận đặt hàng.">

  <div class="border-b border-walnut-900/10 bg-sand-100">
    <div class="mx-auto max-w-7xl px-4 py-2.5 sm:py-3.5">
      <nav class="text-[10px] uppercase tracking-[0.2em] text-walnut-800">
        <a href="/" class="transition-colors hover:text-clay-600">Trang chủ</a>
        <span class="mx-1.5">/</span>
        <a href="/gio-hang" class="transition-colors hover:text-clay-600">Giỏ hàng</a>
        <span class="mx-1.5">/</span>
        <span class="text-walnut-900 font-medium">Đặt hàng</span>
      </nav>
      <h1 class="mt-1 font-display text-xl tracking-tight sm:text-2xl text-walnut-900">Tiến hành đặt hàng</h1>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 pt-2.5 pb-8 sm:pt-4 sm:pb-12">
    <div data-checkout-root>

      <!-- EMPTY STATE -->
      <div data-checkout-empty class="hidden border border-walnut-900/10 bg-sand-50/50 rounded-lg px-6 py-20 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-sand-200/80 text-walnut-800">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <p class="mt-5 font-display text-2xl text-walnut-900">Chưa có sản phẩm để thanh toán</p>
        <p class="mt-2 text-sm text-walnut-800">Giỏ hàng của bạn đang trống. Hãy chọn sản phẩm yêu thích trước khi đặt hàng nhé.</p>
        <a href="/san-pham" class="mt-8 inline-block bg-walnut-900 px-8 py-3.5 text-xs uppercase tracking-[0.2em] text-sand-50 transition-colors hover:bg-clay-600 rounded-sm">
          Khám phá sản phẩm
        </a>
      </div>

      <!-- CHECKOUT CONTENT -->
      <div data-checkout-content class="hidden">

        <!-- STEPS NAV -->
        <ol data-checkout-steps class="flex flex-wrap gap-x-8 gap-y-2 border-b border-walnut-900/10 pb-5 text-[11px] uppercase tracking-[0.2em]">
          <li data-step-label="0" class="text-walnut-900 font-semibold">1 — Địa chỉ nhận hàng</li>
          <li data-step-label="1" class="text-walnut-800">2 — Phương thức thanh toán</li>
          <li data-step-label="2" class="text-walnut-800">3 — Xác nhận & Đặt hàng</li>
        </ol>

        <!-- ĐÃ TỐI ƯU: GRID 12 CỘT CÂN ĐỐI (7-5), THOÁNG ĐÃNG VÀ CHẶT CHẼ -->
        <div data-checkout-grid class="mt-8 grid gap-8 lg:grid-cols-12 lg:gap-10 items-start">

          <!-- BÊN TRÁI: FORM ĐIỀN THÔNG TIN (Chiếm 7 phần) -->
          <div class="lg:col-span-7">
            
            <!-- STEP 1: ADDRESS FORM -->
            <form data-address-form data-step-panel="0" novalidate class="grid gap-5 sm:grid-cols-2">

              <!-- THANH TIÊU ĐỀ & NÚT CHỌN SỔ ĐỊA CHỈ -->
              <div class="sm:col-span-2 flex items-center justify-between pb-3 border-b border-walnut-900/10 flex-wrap gap-2">
                <span class="text-xs uppercase tracking-[0.18em] text-walnut-900 font-bold flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-[#173524]"></span>
                  <span>Thông tin người nhận & Địa chỉ</span>
                </span>
                <button
                  type="button"
                  id="btn-choose-address-book"
                  class="hidden inline-flex items-center gap-1.5 text-xs text-[#173524] hover:text-[#D8B670] font-bold border border-[#173524]/40 bg-sand-100 hover:bg-[#173524] px-3.5 py-1.5 transition-all shadow-xs cursor-pointer rounded-none active:scale-95"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span>Chọn địa chỉ (<span id="count-saved-addresses">0</span>)</span>
                </button>
              </div>
              <div>
                <label for="ck-name" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Họ và tên <span class="text-red-500">*</span></label>
                <input id="ck-name" name="fullname" type="text" autocomplete="name" required placeholder="Nguyễn Văn A" class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="fullname" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div>
                <label for="ck-phone" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Số điện thoại <span class="text-red-500">*</span></label>
                <input id="ck-phone" name="phone" type="tel" autocomplete="tel" required class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="phone" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="ck-email" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Email nhận thông báo</label>
                <input id="ck-email" name="email" type="email" autocomplete="email" placeholder="email@vidu.com" class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="email" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div>
                <label for="ck-province" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Tỉnh / Thành phố <span class="text-red-500">*</span></label>
                <select id="ck-province" name="province" required class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm text-walnut-900 rounded outline-none transition-colors focus:border-clay-600">
                  <option value="">-- Chọn tỉnh/thành --</option>
                  {provinces.map((province) => <option value={province}>{province}</option>)}
                </select>
                <p data-error-for="province" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div>
                <label for="ck-district" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Quận / Huyện <span class="text-red-500">*</span></label>
                <input id="ck-district" name="district" type="text" required class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="district" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="ck-address" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Địa chỉ cụ thể <span class="text-red-500">*</span></label>
                <input id="ck-address" name="address" type="text" autocomplete="street-address" required placeholder="Số nhà, tên đường, phường/xã" class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors placeholder:text-walnut-800/50 focus:border-clay-600" />
                <p data-error-for="address" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="ck-note" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Ghi chú đơn hàng (nếu có)</label>
                <textarea id="ck-note" name="note" rows="3" placeholder="Ghi chú về thời gian nhận hàng, tầng chung cư..." class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600"></textarea>
              </div>

              
              <div class="sm:col-span-2 pt-1" id="save-address-checkbox-row">
                <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                  <input
                    type="checkbox"
                    id="ck-save-address"
                    name="save_address"
                    checked
                    class="h-4 w-4 rounded-none border-walnut-900/30 text-clay-600 focus:ring-0 cursor-pointer"
                  />
                  <span class="text-xs text-walnut-800 font-medium">Lưu địa chỉ này để tự động điền cho các lần đặt sau</span>
                </label>
              </div>

              <div class="sm:col-span-2">
                <button type="submit" class="bg-clay-600 px-8 py-4 text-xs font-medium uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 rounded-sm shadow-sm active:scale-95">
                  Tiếp tục chọn thanh toán →
                </button>
              </div>
            </form>

            <!-- STEP 2: PAYMENT METHOD -->
            <div data-step-panel="1" class="hidden">
              <p class="text-xs uppercase tracking-[0.2em] text-walnut-800 font-semibold">Chọn phương thức thanh toán</p>

              <label class="mt-5 flex cursor-pointer gap-4 border-2 border-clay-600 bg-sand-50/80 p-5 rounded-lg transition-all shadow-sm hover:border-clay-700 relative overflow-hidden">
                <span class="absolute top-0 right-0 bg-clay-600 text-[10px] font-bold text-white px-3 py-0.5 rounded-bl uppercase tracking-wider">Khuyên Dùng • Tự Động 3s</span>
                <input type="radio" name="payment" value="sepay" checked data-payment class="mt-1 h-4 w-4 accent-[#b45309]" />
                <span class="flex-1">
                  <span class="flex items-center gap-2">
                    <span class="text-sm font-bold text-walnut-900">Chuyển khoản VietQR tự động (SePay)</span>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Xác nhận tức thì
                    </span>
                  </span>
                  <span class="mt-1 block text-xs leading-relaxed text-walnut-800">
                    Quét mã QR bằng mọi App ngân hàng hoặc Ví điện tử. Hệ thống tự động kích hoạt đơn hàng trong 3 giây không cần chờ duyệt.
                  </span>
                </span>
              </label>

              <label class="mt-3 flex cursor-pointer gap-4 border border-walnut-900/20 bg-sand-50/50 p-5 rounded-lg transition-all hover:border-walnut-900">
                <input type="radio" name="payment" value="cod" data-payment class="mt-1 h-4 w-4 accent-[#b45309]" />
                <span>
                  <span class="block text-sm font-semibold text-walnut-900">Thanh toán khi nhận hàng (COD)</span>
                  <span class="mt-1 block text-xs leading-relaxed text-walnut-800">Kiểm tra sản phẩm cẩn thận trước khi thanh toán tiền mặt cho nhân viên giao hàng.</span>
                </span>
              </label>

              <label class="mt-3 flex cursor-pointer gap-4 border border-walnut-900/20 bg-sand-50/50 p-5 rounded-lg transition-all hover:border-walnut-900">
                <input type="radio" name="payment" value="bank" data-payment class="mt-1 h-4 w-4 accent-[#b45309]" />
                <span>
                  <span class="block text-sm font-semibold text-walnut-900">Chuyển khoản truyền thống (Thủ công)</span>
                  <span class="mt-1 block text-xs leading-relaxed text-walnut-800">Chuyển khoản qua số tài khoản thông thường, nhân viên sẽ liên hệ đối soát sau.</span>
                </span>
              </label>

              <div class="mt-8 flex flex-wrap gap-3">
                <button type="button" data-step-back="0" class="border border-walnut-900/30 px-8 py-3.5 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:border-walnut-900 rounded-sm">
                  ← Quay lại
                </button>
                <button type="button" data-step-next class="bg-clay-600 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 rounded-sm shadow-sm active:scale-95">
                  Kiểm tra đơn hàng →
                </button>
              </div>
            </div>

            <!-- STEP 3: REVIEW & CONFIRM -->
            <div data-step-panel="2" class="hidden">
              <p class="text-xs uppercase tracking-[0.2em] text-walnut-800 font-semibold">Xác nhận thông tin đặt hàng</p>

              <dl class="mt-6 flex flex-col gap-6 text-sm rounded border border-walnut-900/10 bg-sand-50/40 p-6">
                <div>
                  <dt class="text-[11px] uppercase tracking-[0.2em] text-walnut-800/80 font-medium">Địa chỉ người nhận</dt>
                  <dd data-review-address class="mt-2 flex flex-col gap-1 leading-relaxed text-walnut-900 font-medium"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-[0.2em] text-walnut-800/80 font-medium">Phương thức thanh toán</dt>
                  <dd data-review-payment class="mt-2 text-walnut-900 font-medium"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-[0.2em] text-walnut-800/80 font-medium">Chi tiết sản phẩm</dt>
                  <dd data-review-items class="mt-2 border-t border-walnut-900/10"></dd>
                </div>
              </dl>

              <div id="checkout-error-msg" class="mt-4 hidden p-4 rounded bg-red-50 border border-red-200 text-xs text-red-700"></div>

              <div class="mt-8 flex flex-wrap gap-3">
                <button type="button" data-step-back="1" class="border border-walnut-900/30 px-8 py-4 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:border-walnut-900 rounded-sm">
                  ← Quay lại
                </button>
                <button type="button" data-place-order class="bg-clay-600 px-10 py-4 text-xs font-semibold uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 rounded-sm shadow-md active:scale-95 cursor-pointer">
                  Hoàn tất đặt hàng
                </button>
              </div>
            </div>
          </div>

          <!-- BÊN PHẢI: ASIDE SUMMARY (THIẾT KẾ HIỆN ĐẠI, THOÁNG ĐÃNG, KHÔNG KHOẢNG TRỐNG THỪA) -->
          <aside class="lg:col-span-5 h-fit rounded-2xl border border-walnut-900/10 bg-white p-5 sm:p-7 shadow-sm sticky top-6 mb-12">
            <!-- HEADER -->
            <div class="flex items-center justify-between pb-3.5 border-b border-walnut-900/10">
              <h2 class="text-xs uppercase tracking-[0.2em] text-walnut-900 font-bold flex items-center gap-2">
                <svg class="w-4 h-4 text-clay-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <span>Đơn hàng của bạn</span>
              </h2>
              <span data-checkout-count class="text-[11px] font-semibold bg-sand-100 text-walnut-800 px-2.5 py-0.5 rounded-full border border-walnut-900/10">0 sản phẩm</span>
            </div>

            <!-- DANH SÁCH MÓN HÀNG TRONG ĐƠN -->
            <div data-checkout-items class="max-h-[28rem] overflow-y-auto pr-1 mt-3 space-y-2.5"></div>

            <!-- KHỐI ÁP DỤNG MÃ GIẢM GIÁ -->
            <div class="mt-4 pt-4 border-t border-walnut-900/10">
              <label for="coupon-code-input" class="block text-[11px] uppercase tracking-[0.2em] text-walnut-800 font-semibold mb-2">
                Mã ưu đãi / Giảm giá
              </label>
              <div id="coupon-input-group" class="flex gap-2">
                <input
                  id="coupon-code-input"
                  type="text"
                  placeholder="Nhập mã giảm giá..."
                  class="flex-1 uppercase rounded-lg border border-walnut-900/20 bg-sand-50/50 px-3.5 py-2.5 text-xs font-semibold tracking-wider outline-none transition-colors focus:border-clay-600 focus:bg-white placeholder:normal-case placeholder:font-normal placeholder:tracking-normal placeholder:text-walnut-800/40"
                />
                <button
                  type="button"
                  id="apply-coupon-btn"
                  class="rounded-lg bg-walnut-900 px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-sand-50 transition-colors hover:bg-clay-600 active:scale-95 cursor-pointer disabled:opacity-50 shrink-0"
                >
                  Áp dụng
                </button>
              </div>

              <!-- THẺ MÃ ĐÃ ÁP DỤNG THÀNH CÔNG -->
              <div id="applied-coupon-box" class="hidden mt-2 p-2.5 rounded-lg bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 flex items-center justify-between">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="font-bold text-emerald-800 shrink-0">✓ <span id="applied-code-name"></span></span>
                  <span id="applied-discount-text" class="text-xs text-emerald-700 font-semibold"></span>
                </div>
                <button type="button" id="remove-coupon-btn" class="text-xs text-red-600 hover:text-red-700 underline font-medium cursor-pointer shrink-0 ml-2" title="Hủy mã">Gỡ bỏ</button>
              </div>

              <!-- THÔNG BÁO LỖI / THÀNH CÔNG -->
              <p id="coupon-message" class="mt-1.5 hidden text-xs font-medium"></p>

              <!-- NÚT MỞ KHO VOUCHER / ƯU ĐÃI -->
              <div id="quick-coupons-container" class="mt-3 hidden">
                <button
                  type="button"
                  id="btn-open-coupon-modal"
                  class="w-full flex items-center justify-between p-2.5 rounded-lg border border-dashed border-clay-600/40 bg-clay-50/60 hover:bg-clay-100 hover:border-clay-600 transition-all text-left cursor-pointer group shadow-2xs"
                >
                  <span class="flex items-center gap-2 text-xs font-semibold text-clay-900">
                    <img src="/images/icons/discount-voucher.png" alt="Voucher" class="w-4 h-4 object-contain inline-block shrink-0" />
                    <span>Chọn từ kho ưu đãi</span>
                  </span>
                  <span class="inline-flex items-center gap-1 text-[11px] font-bold text-clay-700 bg-white px-2 py-0.5 rounded border border-clay-300 shadow-2xs group-hover:bg-clay-600 group-hover:text-white transition-colors">
                    <span id="coupon-available-count">0</span> mã khả dụng →
                  </span>
                </button>
              </div>
            </div>

            <!-- TÍNH TOÁN CHI PHÍ -->
            <dl class="mt-4 pt-4 border-t border-walnut-900/10 space-y-2.5 text-sm">
              <div class="flex items-center justify-between text-walnut-800">
                <dt class="font-medium">Tạm tính</dt>
                <dd data-checkout-subtotal class="font-bold text-walnut-900">0 đ</dd>
              </div>
              <div id="checkout-discount-row" class="hidden items-center justify-between text-emerald-700 font-medium">
                <dt class="flex items-center gap-1.5 text-emerald-700">
                  <span>Giảm giá</span>
                  <span id="checkout-discount-code-tag" class="rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-bold uppercase"></span>
                </dt>
                <dd id="checkout-discount-amount" class="font-semibold text-emerald-700">-0 đ</dd>
              </div>
              <div class="flex items-center justify-between text-walnut-800">
                <dt class="font-medium">Phí vận chuyển</dt>
                <dd data-checkout-shipping class="text-walnut-900 font-bold">Miễn phí</dd>
              </div>
            </dl>

            <!-- TỔNG THANH TOÁN (CARD HIGHLIGHT SANG TRỌNG, TRÁNH BỊ CHATBOT CHE) -->
            <div class="mt-4 rounded-xl bg-gradient-to-br from-sand-100/90 to-sand-200/50 p-4 border border-walnut-900/10">
              <div class="flex items-baseline justify-between gap-2">
                <div>
                  <span class="block text-xs uppercase tracking-wider font-bold text-walnut-900">Tổng thanh toán</span>
                  <span class="block text-[11px] text-walnut-800/70 font-normal mt-0.5">(Đã bao gồm VAT)</span>
                </div>
                <span data-checkout-total class="font-display text-2xl sm:text-3xl font-extrabold text-clay-700 tracking-tight">0 đ</span>
              </div>
            </div>

            <a href="/gio-hang" class="mt-5 flex items-center justify-center gap-1.5 text-center text-xs font-bold uppercase tracking-[0.15em] text-walnut-800 transition-colors hover:text-clay-600">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span>Quay lại giỏ hàng</span>
            </a>
          </aside>

        </div>

        <!-- SEPAY VIETQR PAYMENT SCREEN (CHUẨN FORMAT SEPAY) -->
        <div data-sepay-screen class="hidden rounded-2xl bg-white shadow-2xl border border-gray-100 max-w-5xl mx-auto overflow-hidden mt-10">
          <div class="grid grid-cols-1 md:grid-cols-12">
            
            <div class="md:col-span-5 p-6 sm:p-7 flex flex-col items-center justify-center text-center md:border-r border-gray-100 bg-[#fafafa]/50">
              <h2 class="font-bold text-lg sm:text-xl text-gray-900 tracking-tight font-sans whitespace-nowrap">Quét mã VietQR để thanh toán</h2>

              <div class="relative p-2.5 bg-white rounded-xl shadow-md border border-gray-100 my-5 flex items-center justify-center">
                <span class="absolute -top-1.5 -left-1.5 w-7 h-7 border-t-[3.5px] border-l-[3.5px] border-[#ea580c] rounded-tl pointer-events-none"></span>
