---
import BaseLayout from '../../layouts/BaseLayout.astro';

const provinces = [
  'TP. Hồ Chí Minh',
  'Hà Nội',
  'Đà Nẵng',
  'Cần Thơ',
  'Bình Dương',
  'Đồng Nai',
  'Khánh Hòa',
  'Tỉnh/thành khác',
];
---

<BaseLayout title="Thanh toán | Nội Thất" description="Hoàn tất đơn hàng: địa chỉ giao hàng, phương thức thanh toán và xác nhận.">

  <div class="border-b border-walnut-900/10 bg-sand-100">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:py-12">
      <nav class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">
        <a href="/" class="transition-colors hover:text-clay-600">Trang chủ</a>
        <span class="mx-2">/</span>
        <a href="/gio-hang" class="transition-colors hover:text-clay-600">Giỏ hàng</a>
        <span class="mx-2">/</span>
        <span class="text-walnut-900">Thanh toán</span>
      </nav>
      <h1 class="mt-4 font-display text-3xl tracking-tight sm:text-4xl">Thanh toán</h1>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:py-14">
    <div data-checkout-root>

      <div data-checkout-empty class="hidden border border-walnut-900/10 px-6 py-20 text-center">
        <p class="font-display text-xl">Chưa có sản phẩm để thanh toán</p>
        <p class="mt-3 text-sm text-walnut-800">Giỏ hàng của bạn đang trống. Hãy chọn sản phẩm trước khi đặt hàng.</p>
        <a href="/san-pham" class="mt-8 inline-block border border-walnut-900 px-8 py-3 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:bg-walnut-900 hover:text-sand-50">
          Chọn sản phẩm
        </a>
      </div>

      <div data-checkout-content class="hidden">

        <ol data-checkout-steps class="flex flex-wrap gap-x-8 gap-y-2 border-b border-walnut-900/10 pb-5 text-[11px] uppercase tracking-[0.2em]">
          <li data-step-label="0" class="text-walnut-900">1 — Địa chỉ giao hàng</li>
          <li data-step-label="1" class="text-walnut-800">2 — Phương thức thanh toán</li>
          <li data-step-label="2" class="text-walnut-800">3 — Xác nhận đơn hàng</li>
        </ol>

        <div data-checkout-grid class="mt-10 grid gap-10 lg:grid-cols-[1fr_20rem] lg:gap-16">

          <div>
            <form data-address-form data-step-panel="0" novalidate class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="ck-name" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Họ và tên</label>
                <input id="ck-name" name="fullname" type="text" autocomplete="name" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="fullname" class="mt-2 hidden text-xs text-danger-600"></p>
              </div>

              <div>
                <label for="ck-phone" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Số điện thoại</label>
                <input id="ck-phone" name="phone" type="tel" autocomplete="tel" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="phone" class="mt-2 hidden text-xs text-danger-600"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="ck-email" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Email</label>
                <input id="ck-email" name="email" type="email" autocomplete="email" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="email" class="mt-2 hidden text-xs text-danger-600"></p>
              </div>

              <div>
                <label for="ck-province" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Tỉnh / Thành phố</label>
                <select id="ck-province" name="province" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600">
                  <option value="">— Chọn tỉnh/thành —</option>
                  {provinces.map((province) => <option value={province}>{province}</option>)}
                </select>
                <p data-error-for="province" class="mt-2 hidden text-xs text-danger-600"></p>
              </div>

              <div>
                <label for="ck-district" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Quận / Huyện</label>
                <input id="ck-district" name="district" type="text" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="district" class="mt-2 hidden text-xs text-danger-600"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="ck-address" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Địa chỉ chi tiết</label>
                <input id="ck-address" name="address" type="text" autocomplete="street-address" placeholder="Số nhà, tên đường" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors placeholder:text-walnut-800/50 focus:border-clay-600" />
                <p data-error-for="address" class="mt-2 hidden text-xs text-danger-600"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="ck-note" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Ghi chú (không bắt buộc)</label>
                <textarea id="ck-note" name="note" rows="3" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600"></textarea>
              </div>

              <div class="sm:col-span-2">
                <button type="submit" class="bg-clay-600 px-8 py-4 text-xs uppercase tracking-[0.2em] text-sand-50 transition-colors hover:bg-clay-500">
                  Tiếp tục
                </button>
              </div>
            </form>

            <div data-step-panel="1" class="hidden">
              <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Chọn phương thức thanh toán</p>

              <label class="mt-5 flex cursor-pointer gap-4 border border-walnut-900/15 p-5 transition-colors hover:border-walnut-900/40">
                <input type="radio" name="payment" value="cod" checked data-payment class="mt-1 h-4 w-4 accent-[#333333]" />
                <span>
                  <span class="block text-sm text-walnut-900">Thanh toán khi nhận hàng (COD)</span>
                  <span class="mt-1 block text-xs leading-relaxed text-walnut-800">Kiểm tra hàng trước khi thanh toán cho nhân viên giao hàng.</span>
                </span>
              </label>

              <label class="mt-3 flex cursor-pointer gap-4 border border-walnut-900/15 p-5 transition-colors hover:border-walnut-900/40">
                <input type="radio" name="payment" value="bank" data-payment class="mt-1 h-4 w-4 accent-[#333333]" />
                <span>
                  <span class="block text-sm text-walnut-900">Chuyển khoản ngân hàng</span>
                  <span class="mt-1 block text-xs leading-relaxed text-walnut-800">Thông tin tài khoản sẽ được gửi sau khi đơn hàng được xác nhận.</span>
                </span>
              </label>

              <p class="mt-5 text-xs leading-relaxed text-walnut-800">Thanh toán online bằng thẻ hoặc ví điện tử sẽ được bổ sung ở giai đoạn sau.</p>

              <div class="mt-8 flex flex-wrap gap-3">
                <button type="button" data-step-back="0" class="border border-walnut-900/20 px-8 py-4 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:border-walnut-900">Quay lại</button>
                <button type="button" data-step-next class="bg-clay-600 px-8 py-4 text-xs uppercase tracking-[0.2em] text-sand-50 transition-colors hover:bg-clay-500">Tiếp tục</button>
              </div>
            </div>

            <div data-step-panel="2" class="hidden">
              <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Kiểm tra lại thông tin</p>

              <dl class="mt-6 flex flex-col gap-7 text-sm">
                <div>
                  <dt class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Địa chỉ giao hàng</dt>
                  <dd data-review-address class="mt-2 flex flex-col gap-1 leading-relaxed text-walnut-900"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Phương thức thanh toán</dt>
                  <dd data-review-payment class="mt-2 text-walnut-900"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Sản phẩm</dt>
                  <dd data-review-items class="mt-2"></dd>
                </div>
              </dl>

              <div class="mt-8 flex flex-wrap gap-3">
                <button type="button" data-step-back="1" class="border border-walnut-900/20 px-8 py-4 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:border-walnut-900">Quay lại</button>
                <button type="button" data-place-order class="bg-clay-600 px-8 py-4 text-xs uppercase tracking-[0.2em] text-sand-50 transition-colors hover:bg-clay-500">Đặt hàng</button>
              </div>
            </div>
          </div>

          <aside class="h-fit border border-walnut-900/10 p-6">
            <h2 class="text-[11px] uppercase tracking-[0.25em] text-walnut-900">Đơn hàng của bạn</h2>

            <div data-checkout-items class="mt-5"></div>

            <dl class="mt-5 flex flex-col gap-3 text-sm">
              <div class="flex items-center justify-between">
                <dt class="text-walnut-800">Tạm tính</dt>
                <dd data-checkout-subtotal class="text-walnut-900">0₫</dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="text-walnut-800">Phí vận chuyển</dt>
                <dd class="text-walnut-900">Miễn phí</dd>
              </div>
            </dl>

            <div class="mt-5 flex items-center justify-between border-t border-walnut-900/10 pt-5">
              <span class="text-sm text-walnut-900">Tổng cộng</span>
              <span data-checkout-total class="text-lg text-walnut-900">0₫</span>
            </div>

            <a href="/gio-hang" class="mt-6 block text-center text-xs uppercase tracking-[0.2em] text-walnut-800 underline underline-offset-4 transition-colors hover:text-clay-600">Sửa giỏ hàng</a>
          </aside>

        </div>

        <div data-checkout-success class="hidden border border-walnut-900/10 p-8 sm:p-12">
          <p class="text-[11px] uppercase tracking-[0.25em] text-walnut-800">Đặt hàng thành công</p>
          <h2 class="mt-3 font-display text-2xl tracking-tight sm:text-3xl">Cảm ơn bạn đã đặt hàng</h2>
          <p class="mt-5 text-sm leading-relaxed text-walnut-800">
            Mã đơn hàng của bạn là <span data-order-code class="text-walnut-900">—</span>. Nhân viên sẽ liên hệ xác nhận trong thời gian sớm nhất.
          </p>
          <p class="mt-3 text-xs leading-relaxed text-walnut-800">
            Bản demo chưa gửi đơn lên máy chủ nên mã đơn chỉ mang tính minh hoạ — giỏ hàng đã được xoá và không có thông tin nào rời khỏi trình duyệt.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/san-pham" class="bg-clay-600 px-8 py-3 text-xs uppercase tracking-[0.2em] text-sand-50 transition-colors hover:bg-clay-500">Tiếp tục mua sắm</a>
            <a href="/" class="border border-walnut-900 px-8 py-3 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:bg-walnut-900 hover:text-sand-50">Về trang chủ</a>
          </div>
        </div>

      </div>

    </div>
  </section>

</BaseLayout>

<script>
  import { readCart, clearCart, totalPrice, formatVnd } from '../../scripts/cart';
  import type { CartItem } from '../../scripts/cart';
  import { initAuthForm, required, email, phone, minLength } from '../../scripts/validate';

  const root = document.querySelector<HTMLElement>('[data-checkout-root]');

  if (root) {
    const emptyEl = root.querySelector<HTMLElement>('[data-checkout-empty]');
    const contentEl = root.querySelector<HTMLElement>('[data-checkout-content]');
    const gridEl = root.querySelector<HTMLElement>('[data-checkout-grid]');
    const stepsEl = root.querySelector<HTMLElement>('[data-checkout-steps]');
    const successEl = root.querySelector<HTMLElement>('[data-checkout-success]');
    const form = root.querySelector<HTMLFormElement>('[data-address-form]');
    const itemsEl = root.querySelector<HTMLElement>('[data-checkout-items]');
    const subtotalEl = root.querySelector<HTMLElement>('[data-checkout-subtotal]');
    const totalEl = root.querySelector<HTMLElement>('[data-checkout-total]');
    const reviewAddressEl = root.querySelector<HTMLElement>('[data-review-address]');
    const reviewPaymentEl = root.querySelector<HTMLElement>('[data-review-payment]');
    const reviewItemsEl = root.querySelector<HTMLElement>('[data-review-items]');
    const orderCodeEl = root.querySelector<HTMLElement>('[data-order-code]');
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-step-panel]'));
    const labels = Array.from(root.querySelectorAll<HTMLElement>('[data-step-label]'));

    const PAYMENTS: Record<string, string> = {
      cod: 'Thanh toán khi nhận hàng (COD)',
      bank: 'Chuyển khoản ngân hàng',
    };

    let payment = 'cod';

    const buildRow = (item: CartItem) => {
      const row = document.createElement('div');
      row.className = 'flex items-start justify-between gap-4 border-b border-walnut-900/10 py-3 text-sm';

      const left = document.createElement('div');
      left.className = 'min-w-0';

      const name = document.createElement('p');
      name.className = 'text-walnut-900';
      name.textContent = item.name;

      const meta = document.createElement('p');
      meta.className = 'mt-1 text-xs text-walnut-800';
      meta.textContent = item.qty + ' × ' + formatVnd(item.price);

      left.appendChild(name);
      left.appendChild(meta);

      const line = document.createElement('p');
      line.className = 'whitespace-nowrap text-walnut-900';
      line.textContent = formatVnd(item.price * item.qty);

      row.appendChild(left);
      row.appendChild(line);
      return row;
    };

    const renderSummary = () => {
      const items = readCart();

      if (itemsEl) {
        itemsEl.textContent = '';
        items.forEach((item) => itemsEl.appendChild(buildRow(item)));
      }

      const subtotal = totalPrice(items);
      if (subtotalEl) subtotalEl.textContent = formatVnd(subtotal);
      if (totalEl) totalEl.textContent = formatVnd(subtotal);
    };

    const renderReview = () => {
      if (!form) return;

      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '').trim();

      if (reviewAddressEl) {
        reviewAddressEl.textContent = '';
        const lines = [
          value('fullname') + ' · ' + value('phone'),
          value('email'),
          [value('address'), value('district'), value('province')].filter(Boolean).join(', '),
        ];
        const note = value('note');
        if (note) lines.push('Ghi chú: ' + note);

        lines.filter(Boolean).forEach((line) => {
          const p = document.createElement('p');
          p.textContent = line;
          reviewAddressEl.appendChild(p);
        });
      }

      if (reviewPaymentEl) reviewPaymentEl.textContent = PAYMENTS[payment] ?? '';

      if (reviewItemsEl) {
        reviewItemsEl.textContent = '';
        readCart().forEach((item) => reviewItemsEl.appendChild(buildRow(item)));
      }
    };

    const goTo = (index: number) => {
      panels.forEach((panel, i) => panel.classList.toggle('hidden', i !== index));
      labels.forEach((label, i) => {
        label.classList.toggle('text-walnut-900', i === index);
        label.classList.toggle('text-walnut-800', i !== index);
      });
      if (index === 2) renderReview();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const placeOrder = () => {
      if (orderCodeEl) orderCodeEl.textContent = 'NT-' + String(Date.now()).slice(-6);
      clearCart();
      gridEl?.classList.add('hidden');
      stepsEl?.classList.add('hidden');
      successEl?.classList.remove('hidden');
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const refresh = () => {
      const hasItems = readCart().length > 0;
      emptyEl?.classList.toggle('hidden', hasItems);
      contentEl?.classList.toggle('hidden', !hasItems);
      if (hasItems) renderSummary();
    };

    if (form) {
      initAuthForm(
        form,
        {
          fullname: [required('Vui lòng nhập họ và tên.'), minLength(2, 'Họ và tên cần ít nhất 2 ký tự.')],
          phone: [required('Vui lòng nhập số điện thoại.'), phone('Số điện thoại chưa hợp lệ (ví dụ 0912345678).')],
          email: [required('Vui lòng nhập email.'), email('Email chưa đúng định dạng.')],
          province: [required('Vui lòng chọn tỉnh/thành.')],
          district: [required('Vui lòng nhập quận/huyện.')],
          address: [required('Vui lòng nhập địa chỉ chi tiết.')],
        },
        () => goTo(1)
      );
    }

    root.querySelectorAll<HTMLInputElement>('[data-payment]').forEach((input) => {
      input.addEventListener('change', () => {
        payment = input.value;
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-step-next]').forEach((btn) => {
      btn.addEventListener('click', () => goTo(2));
    });

    root.querySelectorAll<HTMLButtonElement>('[data-step-back]').forEach((btn) => {
      btn.addEventListener('click', () => goTo(Number(btn.dataset.stepBack ?? 0)));
    });

    root.querySelector<HTMLButtonElement>('[data-place-order]')?.addEventListener('click', placeOrder);

    refresh();
    goTo(0);
  }
</script>
