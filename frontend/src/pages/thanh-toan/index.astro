---
import BaseLayout from '../../layouts/BaseLayout.astro';

const provinces = [
  'Hà Nội',
  'TP. Hồ Chí Minh',
  'Đà Nẵng',
  'Hải Phòng',
  'Cần Thơ',
  'Bình Dương',
  'Đồng Nai',
  'Khánh Hòa',
  'Quảng Ninh',
  'Tỉnh/thành khác',
];
---

<BaseLayout title="Thanh toán & Đặt hàng | Nội Thất" description="Hoàn tất đơn hàng: thông tin giao hàng, phương thức thanh toán và xác nhận đặt hàng.">

  <div class="border-b border-walnut-900/10 bg-sand-100">
    <div class="mx-auto max-w-7xl px-4 py-2.5 sm:py-3.5">
      <nav class="text-[10px] uppercase tracking-[0.2em] text-walnut-800">
        <a href="/" class="transition-colors hover:text-clay-600">Trang chủ</a>
        <span class="mx-1.5">/</span>
        <a href="/gio-hang" class="transition-colors hover:text-clay-600">Giỏ hàng</a>
        <span class="mx-1.5">/</span>
        <span class="text-walnut-900 font-medium">Đặt hàng</span>
      </nav>
      <h1 class="mt-1 font-display text-xl tracking-tight sm:text-2xl text-walnut-900">Tiến hành đặt hàng</h1>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 pt-2.5 pb-8 sm:pt-4 sm:pb-12">
    <div data-checkout-root>

      <!-- EMPTY STATE -->
      <div data-checkout-empty class="hidden border border-walnut-900/10 bg-sand-50/50 rounded-lg px-6 py-20 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-sand-200/80 text-walnut-800">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <p class="mt-5 font-display text-2xl text-walnut-900">Chưa có sản phẩm để thanh toán</p>
        <p class="mt-2 text-sm text-walnut-800">Giỏ hàng của bạn đang trống. Hãy chọn sản phẩm yêu thích trước khi đặt hàng nhé.</p>
        <a href="/san-pham" class="mt-8 inline-block bg-walnut-900 px-8 py-3.5 text-xs uppercase tracking-[0.2em] text-sand-50 transition-colors hover:bg-clay-600 rounded-sm">
          Khám phá sản phẩm
        </a>
      </div>

      <!-- CHECKOUT CONTENT -->
      <div data-checkout-content class="hidden">

        <!-- STEPS NAV -->
        <ol data-checkout-steps class="flex flex-wrap gap-x-8 gap-y-2 border-b border-walnut-900/10 pb-5 text-[11px] uppercase tracking-[0.2em]">
          <li data-step-label="0" class="text-walnut-900 font-semibold">1 — Địa chỉ nhận hàng</li>
          <li data-step-label="1" class="text-walnut-800">2 — Phương thức thanh toán</li>
          <li data-step-label="2" class="text-walnut-800">3 — Xác nhận & Đặt hàng</li>
        </ol>

        <div data-checkout-grid class="mt-10 grid gap-10 lg:grid-cols-[1fr_22rem] lg:gap-16">

          <div>
            <!-- STEP 1: ADDRESS FORM -->
            <form data-address-form data-step-panel="0" novalidate class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="ck-name" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Họ và tên <span class="text-red-500">*</span></label>
                <input id="ck-name" name="fullname" type="text" autocomplete="name" required placeholder="Nguyễn Văn A" class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="fullname" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div>
                <label for="ck-phone" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Số điện thoại <span class="text-red-500">*</span></label>
                <input id="ck-phone" name="phone" type="tel" autocomplete="tel" required placeholder="0912345678" class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="phone" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="ck-email" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Email nhận thông báo</label>
                <input id="ck-email" name="email" type="email" autocomplete="email" placeholder="email@vidu.com" class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="email" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div>
                <label for="ck-province" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Tỉnh / Thành phố <span class="text-red-500">*</span></label>
                <select id="ck-province" name="province" required class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm text-walnut-900 rounded outline-none transition-colors focus:border-clay-600">
                  <option value="">-- Chọn tỉnh/thành --</option>
                  {provinces.map((province) => <option value={province}>{province}</option>)}
                </select>
                <p data-error-for="province" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div>
                <label for="ck-district" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Quận / Huyện <span class="text-red-500">*</span></label>
                <input id="ck-district" name="district" type="text" required placeholder="Quận Ba Đình" class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600" />
                <p data-error-for="district" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="ck-address" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Địa chỉ cụ thể <span class="text-red-500">*</span></label>
                <input id="ck-address" name="address" type="text" autocomplete="street-address" required placeholder="Số nhà, tên đường, phường/xã" class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors placeholder:text-walnut-800/50 focus:border-clay-600" />
                <p data-error-for="address" class="mt-1.5 hidden text-xs text-red-600"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="ck-note" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Ghi chú đơn hàng (nếu có)</label>
                <textarea id="ck-note" name="note" rows="3" placeholder="Ghi chú về thời gian nhận hàng, tầng chung cư..." class="mt-2 w-full border border-walnut-900/20 bg-white px-4 py-3 text-sm rounded outline-none transition-colors focus:border-clay-600"></textarea>
              </div>

              <div class="sm:col-span-2">
                <button type="submit" class="bg-clay-600 px-8 py-4 text-xs font-medium uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 rounded-sm shadow-sm active:scale-95">
                  Tiếp tục chọn thanh toán →
                </button>
              </div>
            </form>

            <!-- STEP 2: PAYMENT METHOD -->
            <div data-step-panel="1" class="hidden">
              <p class="text-xs uppercase tracking-[0.2em] text-walnut-800 font-semibold">Chọn phương thức thanh toán</p>

              <label class="mt-5 flex cursor-pointer gap-4 border-2 border-clay-600 bg-sand-50/80 p-5 rounded-lg transition-all shadow-sm hover:border-clay-700 relative overflow-hidden">
                <span class="absolute top-0 right-0 bg-clay-600 text-[10px] font-bold text-white px-3 py-0.5 rounded-bl uppercase tracking-wider">Khuyên Dùng • Tự Động 3s</span>
                <input type="radio" name="payment" value="sepay" checked data-payment class="mt-1 h-4 w-4 accent-[#b45309]" />
                <span class="flex-1">
                  <span class="flex items-center gap-2">
                    <span class="text-sm font-bold text-walnut-900">Chuyển khoản VietQR tự động (SePay)</span>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Xác nhận tức thì
                    </span>
                  </span>
                  <span class="mt-1 block text-xs leading-relaxed text-walnut-800">
                    Quét mã QR bằng mọi App ngân hàng hoặc Ví điện tử. Hệ thống tự động kích hoạt đơn hàng trong 3 giây không cần chờ duyệt.
                  </span>
                </span>
              </label>

              <label class="mt-3 flex cursor-pointer gap-4 border border-walnut-900/20 bg-sand-50/50 p-5 rounded-lg transition-all hover:border-walnut-900">
                <input type="radio" name="payment" value="cod" data-payment class="mt-1 h-4 w-4 accent-[#b45309]" />
                <span>
                  <span class="block text-sm font-semibold text-walnut-900">Thanh toán khi nhận hàng (COD)</span>
                  <span class="mt-1 block text-xs leading-relaxed text-walnut-800">Kiểm tra sản phẩm cẩn thận trước khi thanh toán tiền mặt cho nhân viên giao hàng.</span>
                </span>
              </label>

              <label class="mt-3 flex cursor-pointer gap-4 border border-walnut-900/20 bg-sand-50/50 p-5 rounded-lg transition-all hover:border-walnut-900">
                <input type="radio" name="payment" value="bank" data-payment class="mt-1 h-4 w-4 accent-[#b45309]" />
                <span>
                  <span class="block text-sm font-semibold text-walnut-900">Chuyển khoản truyền thống (Thủ công)</span>
                  <span class="mt-1 block text-xs leading-relaxed text-walnut-800">Chuyển khoản qua số tài khoản thông thường, nhân viên sẽ liên hệ đối soát sau.</span>
                </span>
              </label>

              <div class="mt-8 flex flex-wrap gap-3">
                <button type="button" data-step-back="0" class="border border-walnut-900/30 px-8 py-3.5 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:border-walnut-900 rounded-sm">
                  ← Quay lại
                </button>
                <button type="button" data-step-next class="bg-clay-600 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 rounded-sm shadow-sm active:scale-95">
                  Kiểm tra đơn hàng →
                </button>
              </div>
            </div>

            <!-- STEP 3: REVIEW & CONFIRM -->
            <div data-step-panel="2" class="hidden">
              <p class="text-xs uppercase tracking-[0.2em] text-walnut-800 font-semibold">Xác nhận thông tin đặt hàng</p>

              <dl class="mt-6 flex flex-col gap-6 text-sm rounded border border-walnut-900/10 bg-sand-50/40 p-6">
                <div>
                  <dt class="text-[11px] uppercase tracking-[0.2em] text-walnut-800/80 font-medium">Địa chỉ người nhận</dt>
                  <dd data-review-address class="mt-2 flex flex-col gap-1 leading-relaxed text-walnut-900 font-medium"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-[0.2em] text-walnut-800/80 font-medium">Phương thức thanh toán</dt>
                  <dd data-review-payment class="mt-2 text-walnut-900 font-medium"></dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-[0.2em] text-walnut-800/80 font-medium">Chi tiết sản phẩm</dt>
                  <dd data-review-items class="mt-2"></dd>
                </div>
              </dl>

              <div id="checkout-error-msg" class="mt-4 hidden p-4 rounded bg-red-50 border border-red-200 text-xs text-red-700"></div>

              <div class="mt-8 flex flex-wrap gap-3">
                <button type="button" data-step-back="1" class="border border-walnut-900/30 px-8 py-4 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:border-walnut-900 rounded-sm">
                  ← Quay lại
                </button>
                <button type="button" data-place-order class="bg-clay-600 px-10 py-4 text-xs font-semibold uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 rounded-sm shadow-md active:scale-95 cursor-pointer">
                  Hoàn tất đặt hàng
                </button>
              </div>
            </div>
          </div>

          <!-- ASIDE SUMMARY -->
          <aside class="h-fit rounded-lg border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
            <h2 class="text-xs uppercase tracking-[0.25em] text-walnut-900 font-semibold">Đơn hàng của bạn</h2>

            <div data-checkout-items class="mt-5 max-h-80 overflow-y-auto"></div>

            <!-- KHỐI ÁP DỤNG MÃ GIẢM GIÁ (HIỂN THỊ XUYÊN SUỐT CẢ 3 BƯỚC) -->
            <div class="mt-5 border-t border-walnut-900/10 pt-4">
              <label for="coupon-code-input" class="block text-[11px] uppercase tracking-[0.2em] text-walnut-800 font-semibold mb-2">
                Mã ưu đãi / Giảm giá
              </label>
              <div id="coupon-input-group" class="flex gap-2">
                <input
                  id="coupon-code-input"
                  type="text"
                  placeholder="Nhập mã giảm giá..."
                  class="flex-1 uppercase rounded border border-walnut-900/20 bg-white px-3 py-2 text-xs font-semibold tracking-wider outline-none transition-colors focus:border-clay-600 placeholder:normal-case placeholder:font-normal placeholder:tracking-normal"
                />
                <button
                  type="button"
                  id="apply-coupon-btn"
                  class="rounded bg-walnut-900 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-sand-50 transition-colors hover:bg-clay-600 cursor-pointer disabled:opacity-50"
                >
                  Áp dụng
                </button>
              </div>

              <!-- THẺ MÃ ĐÃ ÁP DỤNG THÀNH CÔNG -->
              <div id="applied-coupon-box" class="hidden mt-2 p-2.5 rounded bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-emerald-800">✓ <span id="applied-code-name"></span></span>
                  <span class="text-[11px] text-emerald-600 font-medium">(Đã giảm <span id="applied-discount-text"></span>)</span>
                </div>
                <button type="button" id="remove-coupon-btn" class="text-xs text-red-600 hover:text-red-700 underline font-medium cursor-pointer" title="Hủy mã">Gỡ bỏ</button>
              </div>

              <!-- THÔNG BÁO LỖI / THÀNH CÔNG -->
              <p id="coupon-message" class="mt-1.5 hidden text-xs font-medium"></p>

              <!-- DANH SÁCH MÃ GỢI Ý CÓ SẴN BẤM CHỌN NHANH -->
              <div id="quick-coupons-container" class="mt-3 hidden flex-col gap-1.5">
                <span class="text-[10px] text-walnut-800/70 uppercase tracking-wider font-medium">Mã ưu đãi dành cho bạn:</span>
                <div id="quick-coupons-list" class="flex flex-wrap gap-1.5"></div>
              </div>
            </div>

            <dl class="mt-5 flex flex-col gap-3 text-sm border-t border-walnut-900/10 pt-4">
              <div class="flex items-center justify-between">
                <dt class="text-walnut-800">Tạm tính</dt>
                <dd data-checkout-subtotal class="font-medium text-walnut-900">0 đ</dd>
              </div>
              <div id="checkout-discount-row" class="hidden items-center justify-between text-emerald-700 font-medium">
                <dt class="flex items-center gap-1 text-emerald-700">
                  <span>Giảm giá (Voucher)</span>
                  <span id="checkout-discount-code-tag" class="rounded bg-emerald-100 px-1 py-0.2 text-[10px] font-bold"></span>
                </dt>
                <dd id="checkout-discount-amount" class="font-semibold text-emerald-700">-0 đ</dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="text-walnut-800">Phí vận chuyển</dt>
                <dd data-checkout-shipping class="text-walnut-900 font-medium">Miễn phí</dd>
              </div>
            </dl>

            <div class="mt-5 flex items-center justify-between border-t border-walnut-900/10 pt-5">
              <span class="text-sm font-semibold text-walnut-900">Tổng thanh toán</span>
              <span data-checkout-total class="font-display text-2xl font-bold text-clay-600">0 đ</span>
            </div>

            <a href="/gio-hang" class="mt-6 block text-center text-xs uppercase tracking-[0.15em] text-walnut-800 underline underline-offset-4 transition-colors hover:text-clay-600">
              Quay lại giỏ hàng
            </a>
          </aside>

        </div>

        <!-- SEPAY VIETQR PAYMENT SCREEN (CHUẨN FORMAT SEPAY) -->
        <div data-sepay-screen class="hidden rounded-2xl bg-white shadow-2xl border border-gray-100 max-w-5xl mx-auto overflow-hidden">
          <div class="grid grid-cols-1 md:grid-cols-12">
            
            <!-- CỘT TRÁI: QUÉT MÃ VIETQR (5 CỘT TRONG 12 CỘT) -->
            <div class="md:col-span-5 p-6 sm:p-7 flex flex-col items-center justify-center text-center md:border-r border-gray-100 bg-[#fafafa]/50">
              <h2 class="font-bold text-lg sm:text-xl text-gray-900 tracking-tight font-sans whitespace-nowrap">Quét mã VietQR để thanh toán</h2>

              <!-- KHUNG MÃ QR VỚI 4 GÓC CAM VIETQR SẮC NÉT -->
              <div class="relative p-2.5 bg-white rounded-xl shadow-md border border-gray-100 my-5 flex items-center justify-center">
                <!-- 4 Góc L-shaped màu cam đặc trưng -->
                <span class="absolute -top-1.5 -left-1.5 w-7 h-7 border-t-[3.5px] border-l-[3.5px] border-[#ea580c] rounded-tl pointer-events-none"></span>
                <span class="absolute -top-1.5 -right-1.5 w-7 h-7 border-t-[3.5px] border-r-[3.5px] border-[#ea580c] rounded-tr pointer-events-none"></span>
                <span class="absolute -bottom-1.5 -left-1.5 w-7 h-7 border-b-[3.5px] border-l-[3.5px] border-[#ea580c] rounded-bl pointer-events-none"></span>
                <span class="absolute -bottom-1.5 -right-1.5 w-7 h-7 border-b-[3.5px] border-r-[3.5px] border-[#ea580c] rounded-br pointer-events-none"></span>

                <div class="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center overflow-hidden bg-white rounded-lg">
                  <img data-sepay-qr-img src="" alt="Mã VietQR SePay" class="w-full h-full object-contain" />
                  <div data-sepay-qr-loading class="absolute inset-0 bg-white/95 flex flex-col items-center justify-center text-xs text-gray-600 gap-2">
                    <div class="h-8 w-8 animate-spin rounded-full border-2 border-[#ea580c] border-t-transparent"></div>
                    <span class="font-medium">Đang tạo mã VietQR...</span>
                  </div>
                </div>
              </div>

              <!-- TRẠNG THÁI ĐANG CHỜ CHUYỂN KHOẢN -->
              <div class="flex items-center gap-2 text-sm font-semibold text-[#f97316] tracking-wide">
                <span class="h-3 w-3 rounded-full bg-[#f97316] animate-pulse"></span>
                <span>Đang chờ chuyển khoản...</span>
              </div>
            </div>

            <!-- CỘT PHẢI: CHI TIẾT THANH TOÁN (7 CỘT TRONG 12 CỘT RỘNG RÃI) -->
            <div class="md:col-span-7 p-6 sm:p-7 lg:p-8 flex flex-col justify-between bg-white">
              <div>
                <!-- HEADER CHI TIẾT THANH TOÁN & BADGE ĐƠN HÀNG (TUYỆT ĐỐI KHÔNG XUỐNG HÀNG) -->
                <div class="flex items-center justify-between gap-3 pb-4 border-b border-gray-100">
                  <h3 class="font-bold text-lg sm:text-xl text-gray-900 font-sans tracking-tight whitespace-nowrap shrink-0">Chi tiết thanh toán</h3>
                  <span data-sepay-order-badge class="bg-[#27272a] text-white text-[11px] sm:text-xs font-medium px-3 py-1 rounded-full tracking-wide whitespace-nowrap shrink-0 inline-block">Đơn hàng #...</span>
                </div>

                <!-- DANH SÁCH THÔNG TIN -->
                <div class="divide-y divide-gray-100">
                  <!-- NGÂN HÀNG -->
                  <div class="py-4 flex items-center justify-between">
                    <div>
                      <p class="text-xs uppercase font-bold tracking-wider text-gray-400">NGÂN HÀNG</p>
                      <p data-sepay-bank-name class="font-bold text-gray-900 text-base mt-1">MBBank</p>
                    </div>
                    <button type="button" data-copy-btn="bank" class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 hover:text-gray-800 hover:border-gray-400 hover:bg-gray-50 transition-colors cursor-pointer" title="Sao chép tên ngân hàng">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                    </button>
                  </div>

                  <!-- SỐ TÀI KHOẢN -->
                  <div class="py-4 flex items-center justify-between">
                    <div>
                      <p class="text-xs uppercase font-bold tracking-wider text-gray-400">SỐ TÀI KHOẢN</p>
                      <p data-sepay-acc-number class="font-bold text-gray-900 text-lg font-mono mt-1 tracking-wide">8890359180209</p>
                    </div>
                    <button type="button" data-copy-btn="acc" class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 hover:text-gray-800 hover:border-gray-400 hover:bg-gray-50 transition-colors cursor-pointer" title="Sao chép số tài khoản">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                    </button>
                  </div>

                  <!-- CHỦ TÀI KHOẢN -->
                  <div class="py-4 flex items-center justify-between">
                    <div>
                      <p class="text-xs uppercase font-bold tracking-wider text-gray-400">CHỦ TÀI KHOẢN</p>
                      <p data-sepay-acc-name class="font-bold text-gray-900 text-base mt-1 uppercase tracking-wide">TRUONG CHI VY</p>
                    </div>
                    <button type="button" data-copy-btn="name" class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 hover:text-gray-800 hover:border-gray-400 hover:bg-gray-50 transition-colors cursor-pointer" title="Sao chép tên chủ tài khoản">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                    </button>
                  </div>

                  <!-- SỐ TIỀN -->
                  <div class="py-4 flex items-center justify-between">
                    <div>
                      <p class="text-xs uppercase font-bold tracking-wider text-gray-400">SỐ TIỀN</p>
                      <p data-sepay-amount class="font-bold text-2xl text-[#dc2626] mt-1 font-display tracking-tight">0 đ</p>
                    </div>
                    <button type="button" data-copy-btn="amount" class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 hover:text-gray-800 hover:border-gray-400 hover:bg-gray-50 transition-colors cursor-pointer" title="Sao chép số tiền">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                    </button>
                  </div>
                </div>

                <!-- HỘP NỘI DUNG CHUYỂN KHOẢN BẮT BUỘC -->
                <div class="mt-6 border-2 border-dashed border-[#f97316] rounded-xl p-4 bg-white flex items-center justify-between shadow-sm">
                  <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-[#ea580c]">NỘI DUNG CHUYỂN KHOẢN BẮT BUỘC</p>
                    <p data-sepay-code class="font-bold text-xl text-[#ea580c] mt-1 font-mono tracking-wider">NT-XXXX-XXXX</p>
                  </div>
                  <button type="button" data-copy-btn="code" class="bg-[#ea580c] hover:bg-[#c2410c] active:scale-95 text-white px-5 py-2.5 rounded-lg font-bold text-sm flex items-center gap-2 shadow-sm transition-all cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                    <span data-copy-code-text>Copy</span>
                  </button>
                </div>
              </div>

              <!-- FOOTER QUAY LẠI -->
              <div class="pt-6 mt-6 border-t border-gray-100 flex items-center justify-between">
                <a href="/san-pham" class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-gray-900 transition-colors">
                  ← Quay lại danh sách đơn hàng
                </a>
                <span class="text-xs text-gray-400">⏱ Hết hạn sau: <strong data-sepay-timer class="text-gray-700 font-mono font-semibold">15:00</strong></span>
              </div>
            </div>

          </div>
        </div>

        <!-- SUCCESS SCREEN: BIÊN LAI ĐIỆN TỬ CAO CẤP & ĐẾM NGƯỢC CHUYỂN HƯỚNG -->
        <div data-checkout-success class="hidden rounded-none border border-walnut-900/20 bg-sand-50 shadow-2xl max-w-2xl mx-auto overflow-hidden animate-in fade-in zoom-in-95 duration-300">
          
          <!-- TOP BANNER (WALNUT XANH ĐẬM + GOLD STRIPE) -->
          <div class="relative bg-[#173524] px-6 py-6 sm:px-8 border-b border-[#D8B670]/30 text-center text-white">
            <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
            
            <!-- Animated Success Icon with pulsing rings -->
            <div class="relative mx-auto flex h-16 w-16 items-center justify-center">
              <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-25 animate-ping"></span>
              <div class="relative flex h-14 w-14 items-center justify-center rounded-full bg-emerald-500 text-white shadow-lg border-2 border-emerald-300">
                <svg class="h-7 w-7 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>

            <p data-success-badge class="mt-3 text-[11px] uppercase tracking-[0.22em] text-[#D8B670] font-bold">THANH TOÁN THÀNH CÔNG 🎉</p>
            <h2 data-success-title class="mt-1 font-display text-2xl sm:text-3xl font-bold tracking-wide text-white">Thanh toán VietQR Hoàn Tất</h2>
            <p class="mt-1.5 text-xs text-sand-200/90 max-w-md mx-auto">Giao dịch của bạn đã được hệ thống ghi nhận và xác thực thành công.</p>
          </div>

          <!-- BODY: BIÊN LAI ĐIỆN TỬ (E-RECEIPT CARD) -->
          <div class="p-6 sm:p-8 space-y-5 bg-[#FAF8F5]">

            <!-- THẺ THÔNG TIN GIAO DỊCH CHÍNH -->
            <div class="bg-white border border-walnut-900/15 p-5 shadow-xs divide-y divide-walnut-900/10 text-xs">
              
              <!-- Hàng: Mã đơn hàng & Sao chép -->
              <div class="flex items-center justify-between pb-3">
                <span class="text-walnut-800/80 font-medium">Mã đơn hàng</span>
                <div class="flex items-center gap-2">
                  <span data-order-code class="font-mono text-sm font-bold text-walnut-900 bg-sand-100 border border-walnut-900/20 px-2.5 py-0.5 rounded">NT-XXXXXX</span>
                  <button type="button" id="btn-copy-order-code" class="text-[10px] font-semibold text-clay-700 hover:text-clay-800 uppercase tracking-wider bg-clay-50 border border-clay-200 px-2 py-0.5 rounded cursor-pointer transition-colors" title="Sao chép mã đơn">
                    <span id="copy-code-label">Sao chép</span>
                  </button>
                </div>
              </div>

              <!-- Hàng: Thời gian thanh toán -->
              <div class="flex items-center justify-between py-3">
                <span class="text-walnut-800/80 font-medium">Thời gian giao dịch</span>
                <span id="receipt-time" class="font-medium text-walnut-900">--</span>
              </div>

              <!-- Hàng: Phương thức thanh toán -->
              <div class="flex items-center justify-between py-3">
                <span class="text-walnut-800/80 font-medium">Phương thức</span>
                <span data-success-method class="font-semibold text-walnut-900">Chuyển khoản VietQR SePay</span>
              </div>

              <!-- Hàng: Trạng thái thanh toán -->
              <div class="flex items-center justify-between py-3">
                <span class="text-walnut-800/80 font-medium">Trạng thái thanh toán</span>
                <span data-success-status class="inline-flex items-center gap-1 font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded text-[11px]">
                  ✓ ĐÃ THANH TOÁN (PAID)
                </span>
              </div>

              <!-- Hàng: Tổng số tiền đã thanh toán -->
              <div class="flex items-center justify-between pt-3">
                <span class="text-walnut-900 font-bold text-sm">Tổng tiền thanh toán</span>
                <span id="receipt-total-amount" class="text-xl sm:text-2xl font-bold font-display text-emerald-700">0 ₫</span>
              </div>
            </div>

            <!-- THẺ THÔNG TIN GIAO HÀNG & SẢN PHẨM -->
            <div class="bg-white border border-walnut-900/15 p-5 shadow-xs text-xs space-y-3">
              <p class="font-bold uppercase tracking-wider text-walnut-900 text-[11px] flex items-center gap-1.5 border-b border-walnut-900/10 pb-2">
                <span>📍 Thông tin người nhận</span>
              </p>
              <div class="space-y-1 text-walnut-800 leading-relaxed">
                <p><span class="font-semibold text-walnut-900" id="receipt-customer-name">--</span> (<span id="receipt-customer-phone">--</span>)</p>
                <p id="receipt-customer-address" class="text-walnut-800/90">--</p>
              </div>

              <!-- Danh sách món đã mua -->
              <div class="border-t border-walnut-900/10 pt-3">
                <p class="font-semibold text-walnut-900 text-[11px] uppercase tracking-wider mb-2">Sản phẩm trong đơn hàng</p>
                <div id="receipt-items-list" class="space-y-2 max-h-40 overflow-y-auto pr-1"></div>
              </div>
            </div>

            <!-- THANH ĐẾM NGƯỢC TỰ ĐỘNG CHUYỂN HƯỚNG SANG LỊCH SỬ ĐƠN HÀNG -->
            <div class="rounded-none border border-emerald-300 bg-emerald-50/80 p-4 shadow-xs">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs">
                <div class="flex items-center gap-2">
                  <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
                  <p class="text-emerald-900 font-medium">
                    Tự động chuyển về <strong class="text-emerald-950 font-bold">Lịch sử đơn hàng</strong> sau <span id="redirect-countdown" class="font-bold text-sm text-emerald-800 font-mono">6</span> giây...
                  </p>
                </div>
                <button 
                  type="button" 
                  id="btn-cancel-countdown"
                  class="text-[11px] uppercase tracking-wider font-semibold text-emerald-800 hover:text-emerald-950 underline cursor-pointer shrink-0 self-start sm:self-auto"
                >
                  Tạm dừng chuyển trang
                </button>
              </div>

              <!-- Thanh progress bar -->
              <div class="mt-2.5 w-full bg-emerald-200/70 h-1.5 rounded-full overflow-hidden">
                <div id="redirect-progress-bar" class="bg-gradient-to-r from-emerald-500 to-[#173524] h-full w-full transition-all duration-100 ease-linear"></div>
              </div>
            </div>

            <!-- ACTION BUTTONS -->
            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
              <a 
                id="btn-goto-order-history" 
                href="/tai-khoan?tab=orders" 
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#173524] px-8 py-3.5 text-xs font-bold uppercase tracking-[0.2em] text-[#E6CA85] transition-all hover:bg-[#204932] hover:text-white rounded-none shadow-md border border-[#D8B670]/40 cursor-pointer active:scale-95"
              >
                <span>Xem Đơn Hàng Của Tôi</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a 
                href="/san-pham" 
                class="w-full sm:w-auto text-center border border-walnut-900/20 bg-white px-6 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-walnut-800 hover:bg-sand-100 hover:text-walnut-900 transition-colors"
              >
                Tiếp Tục Mua Sắm
              </a>
              <a 
                href="/" 
                class="w-full sm:w-auto text-center border border-walnut-900/20 bg-white px-6 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-walnut-800 hover:bg-sand-100 hover:text-walnut-900 transition-colors"
              >
                Về Trang Chủ
              </a>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>

</BaseLayout>

<script>
  import { readCart, clearCart, totalPrice, formatVnd } from '../../scripts/cart';
  import type { CartItem } from '../../scripts/cart';
  import { initAuthForm, required, email, phone, minLength } from '../../scripts/validate';
  import { readUser } from '../../scripts/auth';

  const root = document.querySelector<HTMLElement>('[data-checkout-root]');

  if (root) {
    const emptyEl = root.querySelector<HTMLElement>('[data-checkout-empty]');
    const contentEl = root.querySelector<HTMLElement>('[data-checkout-content]');
    const gridEl = root.querySelector<HTMLElement>('[data-checkout-grid]');
    const stepsEl = root.querySelector<HTMLElement>('[data-checkout-steps]');
    const successEl = root.querySelector<HTMLElement>('[data-checkout-success]');
    const form = root.querySelector<HTMLFormElement>('[data-address-form]');

    // Tự động điền thông tin tài khoản nếu người dùng đã đăng nhập
    const authUser = readUser();
    let currentAuthUser: any = authUser;
    try {
      const raw = localStorage.getItem('current_user');
      if (raw) currentAuthUser = JSON.parse(raw);
    } catch {}

    if (currentAuthUser && form) {
      const nameInput = form.querySelector<HTMLInputElement>('#ck-name');
      const phoneInput = form.querySelector<HTMLInputElement>('#ck-phone');
      const emailInput = form.querySelector<HTMLInputElement>('#ck-email');
      if (nameInput && !nameInput.value && currentAuthUser.name) nameInput.value = currentAuthUser.name;
      if (phoneInput && !phoneInput.value && currentAuthUser.phone && currentAuthUser.phone !== 'Đăng nhập Google') phoneInput.value = currentAuthUser.phone;
      if (emailInput && !emailInput.value && currentAuthUser.email) emailInput.value = currentAuthUser.email;
    }
    const itemsEl = root.querySelector<HTMLElement>('[data-checkout-items]');
    const subtotalEl = root.querySelector<HTMLElement>('[data-checkout-subtotal]');
    const shippingEl = root.querySelector<HTMLElement>('[data-checkout-shipping]');
    const totalEl = root.querySelector<HTMLElement>('[data-checkout-total]');
    const reviewAddressEl = root.querySelector<HTMLElement>('[data-review-address]');
    const reviewPaymentEl = root.querySelector<HTMLElement>('[data-review-payment]');
    const reviewItemsEl = root.querySelector<HTMLElement>('[data-review-items]');
    const orderCodeEl = root.querySelector<HTMLElement>('[data-order-code]');
    const errorBox = root.querySelector<HTMLElement>('#checkout-error-msg');
    const placeOrderBtn = root.querySelector<HTMLButtonElement>('[data-place-order]');
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-step-panel]'));
    const labels = Array.from(root.querySelectorAll<HTMLElement>('[data-step-label]'));

    // Coupon DOM Elements
    const couponInput = root.querySelector<HTMLInputElement>('#coupon-code-input');
    const applyCouponBtn = root.querySelector<HTMLButtonElement>('#apply-coupon-btn');
    const appliedBox = root.querySelector<HTMLElement>('#applied-coupon-box');
    const appliedCodeName = root.querySelector<HTMLElement>('#applied-code-name');
    const appliedDiscountText = root.querySelector<HTMLElement>('#applied-discount-text');
    const removeCouponBtn = root.querySelector<HTMLButtonElement>('#remove-coupon-btn');
    const couponMessage = root.querySelector<HTMLElement>('#coupon-message');
    const quickCouponsContainer = root.querySelector<HTMLElement>('#quick-coupons-container');
    const quickCouponsList = root.querySelector<HTMLElement>('#quick-coupons-list');
    const discountRow = root.querySelector<HTMLElement>('#checkout-discount-row');
    const discountCodeTag = root.querySelector<HTMLElement>('#checkout-discount-code-tag');
    const discountAmountEl = root.querySelector<HTMLElement>('#checkout-discount-amount');

    interface AppliedCoupon {
      couponId: number;
      code: string;
      discountType: string;
      discountValue: number;
      discountAmount: number;
      minOrderValue: number;
      maxDiscountAmount?: number | null;
    }

    let currentCoupon: AppliedCoupon | null = null;

    const showCouponMessage = (msg: string, type: 'error' | 'success') => {
      if (!couponMessage) return;
      couponMessage.textContent = msg;
      couponMessage.className = type === 'error'
        ? 'mt-1.5 text-xs font-medium text-red-600 block'
        : 'mt-1.5 text-xs font-medium text-emerald-600 block';
    };

    const clearCouponMessage = () => {
      if (!couponMessage) return;
      couponMessage.textContent = '';
      couponMessage.className = 'mt-1.5 hidden text-xs font-medium';
    };

    const updateCouponUI = () => {
      const inputGroup = root.querySelector<HTMLElement>('#coupon-input-group');
      if (currentCoupon) {
        inputGroup?.classList.add('hidden');
        appliedBox?.classList.remove('hidden');
        if (appliedCodeName) appliedCodeName.textContent = currentCoupon.code;
        if (appliedDiscountText) {
          appliedDiscountText.textContent = currentCoupon.discountType === 'free_shipping'
            ? `Miễn phí ship (${formatVnd(currentCoupon.discountAmount)})`
            : formatVnd(currentCoupon.discountAmount);
        }

        discountRow?.classList.remove('hidden');
        discountRow?.classList.add('flex');
        if (discountCodeTag) {
          discountCodeTag.textContent = currentCoupon.discountType === 'free_shipping'
            ? `${currentCoupon.code} (Freeship)`
            : currentCoupon.code;
        }
        if (discountAmountEl) discountAmountEl.textContent = '-' + formatVnd(currentCoupon.discountAmount);
      } else {
        inputGroup?.classList.remove('hidden');
        appliedBox?.classList.add('hidden');
        discountRow?.classList.add('hidden');
        discountRow?.classList.remove('flex');
      }
    };

    const applyCoupon = async (codeToApply: string) => {
      const code = codeToApply.trim().toUpperCase();
      if (!code) {
        showCouponMessage('Vui lòng nhập mã giảm giá.', 'error');
        return;
      }

      const items = readCart();
      const subtotal = totalPrice(items);

      if (applyCouponBtn) {
        applyCouponBtn.disabled = true;
        applyCouponBtn.textContent = '...';
      }
      clearCouponMessage();

      try {
        const res = await fetch('http://localhost:4000/api/coupons/validate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code, subtotal }),
        });

        const json = await res.json();

        if (res.ok && json.success && json.data) {
          currentCoupon = json.data;
          localStorage.setItem('cart_coupon', code);
          showCouponMessage(json.message || 'Áp dụng mã thành công!', 'success');
          updateCouponUI();
          renderSummary();
        } else {
          showCouponMessage(json.message || 'Mã giảm giá không hợp lệ.', 'error');
        }
      } catch (err) {
        showCouponMessage('Không thể kết nối máy chủ để kiểm tra mã.', 'error');
      } finally {
        if (applyCouponBtn) {
          applyCouponBtn.disabled = false;
          applyCouponBtn.textContent = 'Áp dụng';
        }
      }
    };

    const removeCoupon = () => {
      currentCoupon = null;
      localStorage.removeItem('cart_coupon');
      if (couponInput) couponInput.value = '';
      clearCouponMessage();
      updateCouponUI();
      renderSummary();
    };

    const PAYMENTS: Record<string, string> = {
      sepay: 'Chuyển khoản VietQR tự động (SePay)',
      cod: 'Thanh toán khi nhận hàng (COD)',
      bank: 'Chuyển khoản truyền thống (Thủ công)',
    };

    let payment = 'sepay';
    let pollInterval: any = null;
    let timerInterval: any = null;

    // SePay UI Elements
    const sepayScreenEl = root.querySelector<HTMLElement>('[data-sepay-screen]');
    const sepayQrImg = root.querySelector<HTMLImageElement>('[data-sepay-qr-img]');
    const sepayQrLoading = root.querySelector<HTMLElement>('[data-sepay-qr-loading]');
    const sepayTimerEl = root.querySelector<HTMLElement>('[data-sepay-timer]');
    const sepayBankNameEl = root.querySelector<HTMLElement>('[data-sepay-bank-name]');
    const sepayAccNameEl = root.querySelector<HTMLElement>('[data-sepay-acc-name]');
    const sepayAccNumberEl = root.querySelector<HTMLElement>('[data-sepay-acc-number]');
    const sepayAmountEl = root.querySelector<HTMLElement>('[data-sepay-amount]');
    const sepayCodeEl = root.querySelector<HTMLElement>('[data-sepay-code]');

    // Success Screen Elements
    const successBadgeEl = root.querySelector<HTMLElement>('[data-success-badge]');
    const successTitleEl = root.querySelector<HTMLElement>('[data-success-title]');
    const successMethodEl = root.querySelector<HTMLElement>('[data-success-method]');
    const successStatusEl = root.querySelector<HTMLElement>('[data-success-status]');

    const buildRow = (item: CartItem) => {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between gap-3 border-b border-walnut-900/10 py-3 text-sm';

      const left = document.createElement('div');
      left.className = 'flex items-center gap-3 min-w-0';

      if (item.thumbnail) {
        const img = document.createElement('img');
        img.src = item.thumbnail;
        img.alt = item.name;
        img.className = 'h-10 w-10 shrink-0 rounded object-cover border border-walnut-900/10';
        left.appendChild(img);
      }

      const textCol = document.createElement('div');
      textCol.className = 'min-w-0';
      const name = document.createElement('p');
      name.className = 'text-walnut-900 font-medium truncate text-xs sm:text-sm';
      name.textContent = item.name;

      const meta = document.createElement('p');
      meta.className = 'mt-0.5 text-[11px] text-walnut-800';
      meta.textContent = item.qty + ' × ' + formatVnd(item.price);

      textCol.appendChild(name);
      textCol.appendChild(meta);
      left.appendChild(textCol);

      const line = document.createElement('p');
      line.className = 'whitespace-nowrap font-semibold text-walnut-900 text-xs sm:text-sm';
      line.textContent = formatVnd(item.price * item.qty);

      row.appendChild(left);
      row.appendChild(line);
      return row;
    };

    const renderSummary = () => {
      const items = readCart();

      if (itemsEl) {
        itemsEl.textContent = '';
        items.forEach((item) => itemsEl.appendChild(buildRow(item)));
      }

      const subtotal = totalPrice(items);
      const standardShipping = subtotal >= 2000000 ? 0 : (items.length > 0 ? 50000 : 0);
      let shippingFee = standardShipping;
      let discountAmount = 0;

      if (currentCoupon) {
        if (subtotal < currentCoupon.minOrderValue) {
          const minText = formatVnd(currentCoupon.minOrderValue);
          removeCoupon();
          showCouponMessage(`Đơn hàng cần đạt tối thiểu ${minText} để áp dụng mã.`, 'error');
        } else {
          if (currentCoupon.discountType === 'free_shipping') {
            const val = currentCoupon.discountValue || 0;
            const shipDiscount = (val === 0 || val >= standardShipping) ? standardShipping : val;
            discountAmount = shipDiscount;
            shippingFee = Math.max(0, standardShipping - shipDiscount);
            currentCoupon.discountAmount = discountAmount;
            if (appliedDiscountText) appliedDiscountText.textContent = `Miễn phí ship (${formatVnd(discountAmount)})`;
            if (discountAmountEl) discountAmountEl.textContent = '-' + formatVnd(discountAmount);
          } else if (currentCoupon.discountType === 'percent' || currentCoupon.discountType === 'percentage') {
            discountAmount = Math.round((subtotal * currentCoupon.discountValue) / 100);
            if (currentCoupon.maxDiscountAmount && discountAmount > currentCoupon.maxDiscountAmount) {
              discountAmount = currentCoupon.maxDiscountAmount;
            }
            currentCoupon.discountAmount = discountAmount;
            if (appliedDiscountText) appliedDiscountText.textContent = formatVnd(discountAmount);
            if (discountAmountEl) discountAmountEl.textContent = '-' + formatVnd(discountAmount);
          } else {
            discountAmount = Math.min(subtotal, currentCoupon.discountValue);
            currentCoupon.discountAmount = discountAmount;
            if (appliedDiscountText) appliedDiscountText.textContent = formatVnd(discountAmount);
            if (discountAmountEl) discountAmountEl.textContent = '-' + formatVnd(discountAmount);
          }
        }
      }

      const grandTotal = currentCoupon?.discountType === 'free_shipping'
        ? subtotal + shippingFee
        : Math.max(0, subtotal - discountAmount) + shippingFee;

      if (subtotalEl) subtotalEl.textContent = formatVnd(subtotal);
      if (shippingEl) {
        if (currentCoupon?.discountType === 'free_shipping' && standardShipping > 0) {
          shippingEl.innerHTML = `<span class="line-through text-walnut-800/60 mr-1.5 text-xs font-normal">${formatVnd(standardShipping)}</span><span class="text-emerald-700 font-bold">${shippingFee === 0 ? 'Miễn phí' : formatVnd(shippingFee)}</span>`;
        } else {
          shippingEl.textContent = shippingFee === 0 ? 'Miễn phí' : formatVnd(shippingFee);
        }
      }
      if (totalEl) totalEl.textContent = formatVnd(grandTotal);
    };

    const renderReview = () => {
      if (!form) return;

      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '').trim();

      if (reviewAddressEl) {
        reviewAddressEl.textContent = '';
        const lines = [
          `Người nhận: ${value('fullname')} - ${value('phone')}`,
          value('email') ? `Email: ${value('email')}` : '',
          `Địa chỉ: ${[value('address'), value('district'), value('province')].filter(Boolean).join(', ')}`,
        ];
        const note = value('note');
        if (note) lines.push(`Ghi chú: ${note}`);

        lines.filter(Boolean).forEach((line) => {
          const p = document.createElement('p');
          p.textContent = line;
          reviewAddressEl.appendChild(p);
        });
      }

      if (reviewPaymentEl) reviewPaymentEl.textContent = PAYMENTS[payment] ?? '';

      if (reviewItemsEl) {
        reviewItemsEl.textContent = '';
        readCart().forEach((item) => reviewItemsEl.appendChild(buildRow(item)));
      }
    };

    const goTo = (index: number) => {
      panels.forEach((panel, i) => panel.classList.toggle('hidden', i !== index));
      labels.forEach((label, i) => {
        label.classList.toggle('text-walnut-900', i === index);
        label.classList.toggle('font-semibold', i === index);
        label.classList.toggle('text-walnut-800', i !== index);
      });
      if (index === 2) renderReview();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const copyText = (text: string, btn: HTMLButtonElement) => {
      navigator.clipboard.writeText(text).then(() => {
        const copySpan = btn.querySelector('[data-copy-code-text]');
        if (copySpan) {
          const original = copySpan.textContent;
          copySpan.textContent = 'Đã chép ✓';
          btn.classList.add('bg-emerald-600');
          setTimeout(() => {
            copySpan.textContent = original;
            btn.classList.remove('bg-emerald-600');
          }, 2000);
        } else {
          btn.classList.add('bg-emerald-50', 'text-emerald-600', 'border-emerald-400');
          setTimeout(() => {
            btn.classList.remove('bg-emerald-50', 'text-emerald-600', 'border-emerald-400');
          }, 1500);
        }
      });
    };

    const startCountdown = (durationSeconds: number) => {
      let remaining = durationSeconds;
      if (timerInterval) clearInterval(timerInterval);

      const updateDisplay = () => {
        const m = Math.floor(remaining / 60);
        const s = remaining % 60;
        if (sepayTimerEl) {
          sepayTimerEl.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }
        if (remaining <= 0) {
          clearInterval(timerInterval);
          if (sepayTimerEl) sepayTimerEl.textContent = 'Hết hạn';
        }
        remaining--;
      };

      updateDisplay();
      timerInterval = setInterval(updateDisplay, 1000);
    };

    let lastOrderDetails: {
      orderCode: string;
      customerName: string;
      customerPhone: string;
      customerAddress: string;
      paymentMethod: string;
      items: CartItem[];
      totalAmount: number;
    } | null = null;

    let redirectTimer: any = null;

    const showPaymentSuccess = (orderCode: string, extra: {
      method: string;
      isPaid: boolean;
      totalAmount: number;
      customerName: string;
      customerPhone: string;
      customerAddress: string;
      items: CartItem[];
    }) => {
      if (pollInterval) clearInterval(pollInterval);
      if (timerInterval) clearInterval(timerInterval);
      if (redirectTimer) clearInterval(redirectTimer);

      clearCart();
      localStorage.removeItem('cart_coupon');

      // 1. Lưu mã đơn hàng vào danh sách đơn gần đây để trang Lịch sử đơn hàng luôn hiển thị
      try {
        const recent: string[] = JSON.parse(localStorage.getItem('my_recent_orders') || '[]');
        if (!recent.includes(orderCode)) {
          recent.unshift(orderCode);
          localStorage.setItem('my_recent_orders', JSON.stringify(recent.slice(0, 10)));
        }
      } catch {}

      window.dispatchEvent(new Event('orders:changed'));

      // 2. Điền thông tin Biên lai điện tử (E-Receipt)
      if (orderCodeEl) orderCodeEl.textContent = orderCode;

      const copyBtn = root.querySelector<HTMLButtonElement>('#btn-copy-order-code');
      const copyLabel = root.querySelector<HTMLElement>('#copy-code-label');
      if (copyBtn) {
        copyBtn.onclick = () => {
          navigator.clipboard.writeText(orderCode).then(() => {
            if (copyLabel) copyLabel.textContent = 'Đã chép ✓';
            copyBtn.classList.add('bg-emerald-100', 'text-emerald-800');
            setTimeout(() => {
              if (copyLabel) copyLabel.textContent = 'Sao chép';
              copyBtn.classList.remove('bg-emerald-100', 'text-emerald-800');
            }, 2000);
          });
        };
      }

      const receiptTimeEl = root.querySelector<HTMLElement>('#receipt-time');
      if (receiptTimeEl) {
        receiptTimeEl.textContent = new Date().toLocaleString('vi-VN', {
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          day: '2-digit',
          month: '2-digit',
          year: 'numeric',
        });
      }

      if (successMethodEl) {
        successMethodEl.textContent = PAYMENTS[extra.method] || extra.method;
      }

      if (successStatusEl) {
        if (extra.isPaid) {
          successStatusEl.innerHTML = '✓ ĐÃ THANH TOÁN (PAID)';
          successStatusEl.className = 'inline-flex items-center gap-1 font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded text-[11px]';
        } else {
          successStatusEl.innerHTML = extra.method === 'cod' ? '⏱ THANH TOÁN KHI NHẬN HÀNG (COD)' : '⏱ CHỜ XÁC NHẬN CHUYỂN KHOẢN';
          successStatusEl.className = 'inline-flex items-center gap-1 font-bold text-amber-800 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded text-[11px]';
        }
      }

      const receiptTotalEl = root.querySelector<HTMLElement>('#receipt-total-amount');
      if (receiptTotalEl) receiptTotalEl.textContent = formatVnd(extra.totalAmount);

      const customerNameEl = root.querySelector<HTMLElement>('#receipt-customer-name');
      if (customerNameEl) customerNameEl.textContent = extra.customerName || '--';

      const customerPhoneEl = root.querySelector<HTMLElement>('#receipt-customer-phone');
      if (customerPhoneEl) customerPhoneEl.textContent = extra.customerPhone || '--';

      const customerAddressEl = root.querySelector<HTMLElement>('#receipt-customer-address');
      if (customerAddressEl) customerAddressEl.textContent = extra.customerAddress || '--';

      const receiptItemsList = root.querySelector<HTMLElement>('#receipt-items-list');
      if (receiptItemsList && Array.isArray(extra.items)) {
        receiptItemsList.innerHTML = extra.items.map((it) => `
          <div class="flex items-center justify-between text-xs py-1.5 border-b border-walnut-900/5 last:border-b-0">
            <div class="flex items-center gap-2 min-w-0">
              ${it.thumbnail ? `<img src="${it.thumbnail}" alt="${it.name}" class="w-8 h-8 rounded object-cover border border-walnut-900/10 shrink-0" />` : ''}
              <div class="min-w-0">
                <p class="font-medium text-walnut-900 truncate">${it.name}</p>
                <p class="text-[10px] text-walnut-800/60 font-mono">${it.qty} × ${formatVnd(it.price)}</p>
              </div>
            </div>
            <span class="font-semibold text-walnut-900 whitespace-nowrap ml-2">${formatVnd(it.price * it.qty)}</span>
          </div>
        `).join('');
      }

      // 3. Cập nhật nút điều hướng kèm mã đơn hàng highlight
      const redirectUrl = `/tai-khoan?tab=orders&highlight=${encodeURIComponent(orderCode)}`;
      const btnGotoHistory = root.querySelector<HTMLAnchorElement>('#btn-goto-order-history');
      if (btnGotoHistory) btnGotoHistory.href = redirectUrl;

      // 4. Ẩn form/sepay và hiển thị màn hình thành công
      gridEl?.classList.add('hidden');
      stepsEl?.classList.add('hidden');
      sepayScreenEl?.classList.add('hidden');
      successEl?.classList.remove('hidden');
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // 5. Khởi chạy đếm ngược 6 giây và thanh tiến trình
      const countdownEl = root.querySelector<HTMLElement>('#redirect-countdown');
      const progressBarEl = root.querySelector<HTMLElement>('#redirect-progress-bar');
      const cancelBtn = root.querySelector<HTMLButtonElement>('#btn-cancel-countdown');

      const durationMs = 6000;
      const startTime = Date.now();

      const updateProgress = () => {
        const elapsed = Date.now() - startTime;
        const remaining = Math.max(0, durationMs - elapsed);
        const secondsLeft = Math.ceil(remaining / 1000);
        const pct = Math.max(0, (remaining / durationMs) * 100);

        if (countdownEl) countdownEl.textContent = String(secondsLeft);
        if (progressBarEl) progressBarEl.style.width = `${pct}%`;

        if (remaining <= 0) {
          clearInterval(redirectTimer);
          window.location.href = redirectUrl;
        }
      };

      redirectTimer = setInterval(updateProgress, 60);

      if (cancelBtn) {
        cancelBtn.onclick = () => {
          clearInterval(redirectTimer);
          if (countdownEl && countdownEl.parentElement) {
            countdownEl.parentElement.innerHTML = '<span class="text-emerald-950 font-semibold">✓ Đã dừng tự chuyển trang. Bạn có thể xem chi tiết hoặc bấm "Xem Đơn Hàng Của Tôi" bên dưới.</span>';
          }
          if (progressBarEl) progressBarEl.style.width = '0%';
          cancelBtn.remove();
        };
      }
    };

    const startSepayFlow = async (orderCode: string, totalAmount: number) => {
      gridEl?.classList.add('hidden');
      stepsEl?.classList.add('hidden');
      sepayScreenEl?.classList.remove('hidden');
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // Cập nhật badge đơn hàng
      const orderBadge = root.querySelector<HTMLElement>('[data-sepay-order-badge]');
      if (orderBadge) orderBadge.textContent = `Đơn hàng #${orderCode}`;

      // 1. Lấy thông tin cấu hình SePay từ backend
      let config = {
        bankAccount: '8890359180209',
        bankName: 'MBBank',
        accountName: 'TRUONG CHI VY',
      };

      try {
        const confRes = await fetch('http://localhost:4000/api/sepay/config');
        const confJson = await confRes.json();
        if (confJson.success && confJson.data) {
          config = confJson.data;
        }
      } catch (err) {
        console.warn('Không tải được config SePay động, dùng giá trị mặc định.', err);
      }

      // 2. Điền thông tin chuyển khoản vào giao diện
      if (sepayBankNameEl) sepayBankNameEl.textContent = config.bankName;
      if (sepayAccNameEl) sepayAccNameEl.textContent = config.accountName;
      if (sepayAccNumberEl) sepayAccNumberEl.textContent = config.bankAccount;
      if (sepayAmountEl) sepayAmountEl.textContent = formatVnd(totalAmount);
      if (sepayCodeEl) sepayCodeEl.textContent = orderCode;

      // 3. Thiết lập các nút sao chép
      root.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach((btn) => {
        btn.onclick = () => {
          const type = btn.dataset.copyBtn;
          if (type === 'bank') copyText(config.bankName, btn);
          else if (type === 'acc') copyText(config.bankAccount, btn);
          else if (type === 'name') copyText(config.accountName, btn);
          else if (type === 'amount') copyText(String(totalAmount), btn);
          else if (type === 'code') copyText(orderCode, btn);
        };
      });

      // 4. Sinh URL mã VietQR SePay động & QR gốc
      const qrUrl = `https://qr.sepay.vn/img?acc=${encodeURIComponent(config.bankAccount)}&bank=${encodeURIComponent(config.bankName)}&amount=${totalAmount}&des=${encodeURIComponent(orderCode)}&template=compact`;

      if (sepayQrImg) {
        sepayQrImg.onload = () => {
          sepayQrLoading?.classList.add('hidden');
        };
        sepayQrImg.src = qrUrl;
      }

      const dynamicBtn = root.querySelector<HTMLButtonElement>('[data-qr-mode="dynamic"]');
      const realBtn = root.querySelector<HTMLButtonElement>('[data-qr-mode="real"]');

      if (dynamicBtn && realBtn) {
        dynamicBtn.onclick = () => {
          dynamicBtn.className = 'px-2.5 py-1 rounded bg-white font-semibold text-walnut-900 shadow-sm transition-all';
          realBtn.className = 'px-2.5 py-1 rounded text-walnut-800 hover:text-walnut-900 font-medium transition-all';
          if (sepayQrImg) sepayQrImg.src = qrUrl;
        };

        realBtn.onclick = () => {
          realBtn.className = 'px-2.5 py-1 rounded bg-white font-semibold text-walnut-900 shadow-sm transition-all';
          dynamicBtn.className = 'px-2.5 py-1 rounded text-walnut-800 hover:text-walnut-900 font-medium transition-all';
          if (sepayQrImg) sepayQrImg.src = '/images/sepay-qr-real.png';
        };
      }

      // 5. Khởi động đồng hồ đếm ngược 15 phút
      startCountdown(15 * 60);

      // 6. Polling kiểm tra trạng thái đơn hàng định kỳ 2.5 giây từ SePay Webhook thực
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(async () => {
        try {
          const res = await fetch(`http://localhost:4000/api/orders/${orderCode}`);
          const json = await res.json();

          if (json.success && json.data && json.data.paymentStatus === 'paid') {
            clearInterval(pollInterval);
            clearInterval(timerInterval);

            // Kích hoạt màn hình thành công cao cấp & đếm ngược chuyển trang
            if (lastOrderDetails) {
              showPaymentSuccess(orderCode, {
                ...lastOrderDetails,
                isPaid: true,
              });
            } else {
              showPaymentSuccess(orderCode, {
                method: 'sepay',
                isPaid: true,
                totalAmount: json.data.total || totalAmount,
                customerName: json.data.customerName || 'Quý khách',
                customerPhone: json.data.phone || '',
                customerAddress: json.data.shippingAddress || '',
                items: (json.data.items || []).map((it: any) => ({
                  name: it.name,
                  price: it.price,
                  qty: it.qty,
                  slug: '',
                })),
              });
            }
          }
        } catch (pollErr) {
          console.error('Lỗi kiểm tra trạng thái đơn hàng:', pollErr);
        }
      }, 2500);
    };

    const placeOrder = async () => {
      if (!form) return;
      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '').trim();

      const items = readCart();
      if (items.length === 0) {
        alert('Giỏ hàng của bạn đang trống.');
        return;
      }

      if (placeOrderBtn) {
        placeOrderBtn.disabled = true;
        placeOrderBtn.textContent = 'Đang xử lý đặt hàng...';
      }
      if (errorBox) errorBox.classList.add('hidden');

      try {
        const payload = {
          fullname: value('fullname'),
          phone: value('phone'),
          email: value('email') || undefined,
          province: value('province'),
          district: value('district'),
          address: value('address'),
          note: value('note') || undefined,
          payment_method: payment,
          coupon_code: currentCoupon?.code || undefined,
          items: items.map((i) => ({
            slug: i.slug,
            name: i.name,
            price: i.price,
            qty: i.qty,
          })),
        };

        const token = localStorage.getItem('auth_token');
        const headers: Record<string, string> = {
          'Content-Type': 'application/json',
        };
        if (token) {
          headers['Authorization'] = `Bearer ${token}`;
        }

        const res = await fetch('http://localhost:4000/api/orders', {
          method: 'POST',
          headers,
          body: JSON.stringify(payload),
        });

        const json = await res.json();

        if (res.ok && json.success) {
          const code = json.data?.orderCode || ('NT-' + String(Date.now()).slice(-6));
          const totalAmount = Number(json.data?.totalAmount) || 0;

          // Lưu lại thông tin đơn hàng để biên lai hiển thị trọn vẹn
          lastOrderDetails = {
            orderCode: code,
            customerName: value('fullname'),
            customerPhone: value('phone'),
            customerAddress: [value('address'), value('district'), value('province')].filter(Boolean).join(', '),
            paymentMethod: payment,
            items: [...items],
            totalAmount,
          };

          if (payment === 'sepay') {
            // Chuyển sang luồng quét mã VietQR SePay
            startSepayFlow(code, totalAmount);
          } else {
            // Thanh toán COD hoặc chuyển khoản thông thường
            showPaymentSuccess(code, {
              ...lastOrderDetails,
              isPaid: false,
            });
          }
        } else {
          throw new Error(json.message || 'Không thể tạo đơn hàng trên máy chủ.');
        }
      } catch (err: any) {
        console.error('Lỗi khi đặt hàng:', err);
        if (errorBox) {
          errorBox.textContent = 'Lỗi đặt hàng: ' + (err.message || 'Không thể kết nối đến máy chủ.');
          errorBox.classList.remove('hidden');
        }
        if (placeOrderBtn) {
          placeOrderBtn.disabled = false;
          placeOrderBtn.textContent = 'Hoàn tất đặt hàng';
        }
      }
    };

    const refresh = () => {
      const hasItems = readCart().length > 0;
      emptyEl?.classList.toggle('hidden', hasItems);
      contentEl?.classList.toggle('hidden', !hasItems);
      if (hasItems) renderSummary();
    };

    // Sự kiện Áp dụng mã giảm giá
    applyCouponBtn?.addEventListener('click', () => {
      applyCoupon(couponInput?.value || '');
    });

    couponInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        applyCoupon(couponInput.value);
      }
    });

    removeCouponBtn?.addEventListener('click', removeCoupon);

    // Tải danh sách mã giảm giá gợi ý
    fetch('http://localhost:4000/api/coupons')
      .then((r) => r.json())
      .then((json) => {
        if (json.success && Array.isArray(json.data)) {
          const now = new Date();
          const activeList = json.data.filter((c: any) => {
            if (!c.status) return false;
            if (c.startDate && new Date(c.startDate) > now) return false;
            if (c.endDate && new Date(c.endDate) < now) return false;
            if (c.usageLimit && (c.usedCount || 0) >= c.usageLimit) return false;
            return true;
          });

          if (activeList.length > 0 && quickCouponsContainer && quickCouponsList) {
            quickCouponsContainer.classList.remove('hidden');
            quickCouponsContainer.classList.add('flex');
            quickCouponsList.innerHTML = '';

            activeList.slice(0, 3).forEach((cp: any) => {
              const pill = document.createElement('button');
              pill.type = 'button';
              pill.className = 'inline-flex items-center gap-1 rounded border border-dashed border-clay-600/60 bg-clay-50/50 hover:bg-clay-100/70 px-2 py-1 text-[11px] font-semibold text-clay-700 transition-colors cursor-pointer';
              const isFreeShip = cp.discountType === 'free_shipping';
              let valText = '';
              if (isFreeShip) {
                valText = cp.discountValue > 0 ? `Freeship -${formatVnd(cp.discountValue)}` : 'Freeship 100%';
              } else if (cp.discountType === 'percent' || cp.discountType === 'percentage') {
                valText = `-${cp.discountValue}%`;
              } else {
                valText = `-${formatVnd(cp.discountValue)}`;
              }
              const icon = isFreeShip ? '🚚' : '🏷️';
              pill.innerHTML = `<span>${icon} ${cp.code}</span> <span class="text-[10px] text-clay-600 font-normal">(${valText})</span>`;
              pill.onclick = () => {
                if (couponInput) couponInput.value = cp.code;
                applyCoupon(cp.code);
              };
              quickCouponsList.appendChild(pill);
            });
          }
        }
      })
      .catch(() => {});

    // Kiểm tra xem đã có mã lưu từ trước chưa
    const savedCoupon = localStorage.getItem('cart_coupon');
    if (savedCoupon) {
      if (couponInput) couponInput.value = savedCoupon;
      applyCoupon(savedCoupon);
    }

    if (form) {
      initAuthForm(
        form,
        {
          fullname: [required('Vui lòng nhập họ và tên.'), minLength(2, 'Họ và tên cần ít nhất 2 ký tự.')],
          phone: [required('Vui lòng nhập số điện thoại.'), phone('Số điện thoại chưa hợp lệ (ví dụ: 0912345678).')],
          province: [required('Vui lòng chọn tỉnh/thành.')],
          district: [required('Vui lòng nhập quận/huyện.')],
          address: [required('Vui lòng nhập địa chỉ chi tiết.')],
        },
        () => goTo(1)
      );
    }

    root.querySelectorAll<HTMLInputElement>('[data-payment]').forEach((input) => {
      input.addEventListener('change', () => {
        payment = input.value;
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-step-next]').forEach((btn) => {
      btn.addEventListener('click', () => goTo(2));
    });

    root.querySelectorAll<HTMLButtonElement>('[data-step-back]').forEach((btn) => {
      btn.addEventListener('click', () => goTo(Number(btn.dataset.stepBack ?? 0)));
    });

    placeOrderBtn?.addEventListener('click', placeOrder);

    refresh();
    goTo(0);
