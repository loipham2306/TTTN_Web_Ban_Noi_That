<!-- Hiệu ứng chuyển động mượt mà khi cuộn trang & Popup Controller -->
<script>
  // Parallax nhẹ nhàng cho Hero image khi cuộn
  const heroImg = document.getElementById('hero-bg-img');
  window.addEventListener('scroll', () => {
    if (!heroImg) return;
    const scrolled = window.scrollY;
    if (scrolled < 800) {
      heroImg.style.transform = `scale(1.05) translateY(${scrolled * 0.25}px)`;
    }
  }, { passive: true });

  // Intersection Observer làm xuất hiện từng hàng câu chuyện mượt mà
  const storyRows = document.querySelectorAll('.story-row');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('opacity-100', 'translate-y-0');
        entry.target.classList.remove('opacity-0', 'translate-y-8');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  storyRows.forEach((row) => {
    row.classList.add('transition-all', 'duration-1000', 'opacity-0', 'translate-y-8');
    observer.observe(row);
  });

  // Popup Chi tiết 4 Trụ Cột Triết Lý
  const pillarsDataElement = document.getElementById('pillars-json');
  let pillarsData: any[] = [];
  try {
    pillarsData = JSON.parse(pillarsDataElement?.textContent || '[]');
  } catch (e) {
    console.error('Lỗi phân tích dữ liệu pillars:', e);
  }

  const popup = document.getElementById('pillar-popup');
  const popupBox = document.getElementById('pillar-popup-box');
  const popupClose = document.getElementById('pillar-popup-close');
  const popupDismiss = document.getElementById('pillar-popup-dismiss');
  const popupImg = document.getElementById('pillar-popup-img') as HTMLImageElement | null;
  const popupNum = document.getElementById('pillar-popup-num');
  const popupEng = document.getElementById('pillar-popup-eng');
  const popupTitle = document.getElementById('pillar-popup-title');
  const popupSubtitle = document.getElementById('pillar-popup-subtitle');
  const popupDetails = document.getElementById('pillar-popup-details');
  const popupCta = document.getElementById('pillar-popup-cta') as HTMLAnchorElement | null;
  const popupCtaText = document.getElementById('pillar-popup-cta-text');
  const popupCommitment = document.getElementById('pillar-popup-commitment');

  function openPillarPopup(pillarId: string) {
    const item = pillarsData.find((p) => p.id === pillarId);
    if (!item || !popup) return;

    // Di chuyển popup ra trực tiếp document.body để đè lên Header (thoát stacking context)
    if (popup.parentElement !== document.body) {
      document.body.appendChild(popup);
    }

    if (popupImg) {
      popupImg.src = item.modalImage;
      popupImg.alt = item.title;
    }
    if (popupNum) popupNum.textContent = item.num;
    if (popupEng) popupEng.textContent = item.eng;
    if (popupTitle) popupTitle.textContent = item.title;
    if (popupSubtitle) popupSubtitle.textContent = item.modalSubtitle;
    if (popupCommitment) popupCommitment.textContent = item.commitment || 'Cam kết chất lượng độc bản & bảo hành trọn đời.';
    if (popupCtaText) popupCtaText.textContent = item.ctaText;
    if (popupCta) popupCta.href = item.ctaLink;

    if (popupDetails) {
      popupDetails.innerHTML = (item.details || []).map((d: any, idx: number) => `
        <div class="rounded-none border border-walnut-900/10 bg-white/90 p-2.5 sm:p-3 shadow-2xs hover:border-[#B88E28]/50 transition-colors flex flex-col justify-start">
          <div class="flex items-center gap-1.5 mb-0.5 sm:mb-1">
            <span class="text-[10px] sm:text-[11px] font-bold text-[#B88E28]">0${idx + 1}.</span>
            <h4 class="text-[11.5px] sm:text-xs font-bold text-walnut-900 font-display line-clamp-1">${d.title}</h4>
          </div>
          <p class="text-walnut-800/75 text-[10.5px] sm:text-[11px] leading-relaxed font-sans">${d.desc}</p>
        </div>
      `).join('');
    }

    popup.classList.remove('hidden');
    popup.classList.add('flex');
    requestAnimationFrame(() => {
      popup.classList.remove('opacity-0');
      popup.classList.add('opacity-100');
      if (popupBox) {
        popupBox.classList.remove('scale-95');
        popupBox.classList.add('scale-100');
      }
    });

    document.body.style.overflow = 'hidden';
    popup.setAttribute('aria-hidden', 'false');
  }

  function closePillarPopup() {
    if (!popup) return;
    popup.classList.remove('opacity-100');
    popup.classList.add('opacity-0');
    if (popupBox) {
      popupBox.classList.remove('scale-100');
      popupBox.classList.add('scale-95');
    }

    setTimeout(() => {
      popup.classList.remove('flex');
      popup.classList.add('hidden');
      document.body.style.overflow = '';
      popup.setAttribute('aria-hidden', 'true');
    }, 250);
  }

  // Click vào thẻ trụ cột để mở popup
  document.querySelectorAll('[data-pillar-card]').forEach((card) => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-pillar-card');
      if (id) openPillarPopup(id);
    });
  });

  popupClose?.addEventListener('click', closePillarPopup);
  popupDismiss?.addEventListener('click', closePillarPopup);
  popup?.addEventListener('click', (e) => {
    if (e.target === popup) closePillarPopup();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && popup && !popup.classList.contains('hidden')) {
      closePillarPopup();
    }
  });

  // Hỗ trợ cuộn mượt nếu CTA là liên kết neo
  popupCta?.addEventListener('click', (e) => {
    const href = popupCta.getAttribute('href');
    if (href && href.startsWith('#')) {
      closePillarPopup();
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth' });
      }
    }
  });
</script>
