---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { CONTACT } from '../../data/contact';
---

<BaseLayout
  title="Về Chúng Tôi — KTUFA Luxury Furniture"
  description="Khám phá hành trình kiến tạo không gian sống thượng lưu, trải nghiệm showroom nội thất cao cấp tại 615 Âu Cơ, TP. HCM và các chính sách hợp tác kiến trúc sư, đối tác dự án."
>
  <!-- 1. PAGE BANNER HỆ THỐNG (Quản lý tại /admin/banner với position = 've-chung-toi') -->
  <PageBanner
    position="ve-chung-toi"
    fallbackTitle="VỀ CHÚNG TÔI"
    fallbackSubtitle="KTUFA LUXURY FURNITURE"
    fallbackDescription="Hòa quyện tinh hoa chế tác mộc thủ công, da thuộc Mastrotto thượng hạng và triết lý phong thủy Á Đông kiến tạo kiệt tác không gian sống."
    fallbackImage="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1920&q=80"
    breadcrumbs={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Về chúng tôi' }
    ]}
  />

  <!-- 2. PHẦN 1: CÂU CHUYỆN THƯƠNG HIỆU (#cau-chuyen) -->
  <section id="cau-chuyen" class="mx-auto grid max-w-7xl scroll-mt-28 lg:scroll-mt-32 items-center gap-8 lg:gap-14 px-4 py-12 sm:py-16 lg:py-20 lg:grid-cols-12">
    <!-- Cột trái: Ảnh minh họa chế tác nghệ nhân -->
    <div class="relative group aspect-[1.08/1] sm:aspect-[1.12/1] w-full max-h-[460px] lg:max-h-[500px] overflow-hidden rounded border border-walnut-900/10 shadow-md lg:col-span-7">
      <img
        src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=1200&q=80"
        alt="Chế tác nội thất thủ công KTUFA"
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
      <div class="absolute bottom-3.5 left-3.5 sm:bottom-4 sm:left-4 bg-[#173524]/90 backdrop-blur-md px-3.5 py-1.5 sm:px-4 sm:py-2 border border-[#D8B670]/40 rounded-xs shadow-md">
        <p class="text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.2em] text-[#E6CA85]">KTUFA Artisan</p>
        <p class="text-[11px] sm:text-xs font-semibold text-white mt-0.5">Nghệ nhân trên 15 năm kinh nghiệm</p>
      </div>
    </div>

    <!-- Cột phải: Thông điệp thương hiệu & Nút Tìm hiểu thêm dẫn sang trang chi tiết con -->
    <div class="flex flex-col justify-center lg:col-span-5">
      <p class="text-xs uppercase tracking-[0.3em] text-[#B88E28] font-bold">Câu chuyện thương hiệu</p>
      <h2 class="mt-2.5 sm:mt-3 font-display text-2xl leading-snug tracking-tight sm:text-3xl text-walnut-900">
        Mỗi sản phẩm là một cam kết về chất lượng và thẩm mỹ
      </h2>
      <p class="mt-3.5 sm:mt-4 max-w-md text-sm leading-relaxed text-walnut-800">
        Chúng tôi làm việc trực tiếp với các xưởng chế tác thủ công, chọn lọc những thiết kế bền vững và trường tồn theo thời gian.
      </p>
      <div class="mt-6 sm:mt-7">
        <a
          href="/ve-chung-toi/cau-chuyen-thuong-hieu"
          class="group/btn inline-flex items-center gap-2 border-b-2 border-walnut-900 pb-1 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-all hover:border-[#B88E28] hover:text-[#B88E28] font-bold"
        >
          <span>Tìm hiểu thêm</span>
          <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. PHẦN 2: SHOWROOM & LIÊN HỆ (#showroom) -->
  <section id="showroom" class="scroll-mt-28 lg:scroll-mt-32 border-t border-b border-walnut-900/10 bg-sand-100 text-walnut-900">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 lg:py-20 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-walnut-800/80 font-bold">Ghé thăm showroom</p>
        <h2 class="mt-2 font-display text-2xl sm:text-3xl text-walnut-900">615 Âu Cơ, TP. Hồ Chí Minh</h2>
        <p class="mt-3 text-xs sm:text-sm text-walnut-800/80 leading-relaxed">
          Giờ mở cửa: <strong class="text-walnut-900">08:30 – 21:00</strong> (Tất cả các ngày trong tuần) • Trải nghiệm không gian sống thượng lưu & tư vấn ngũ hành phong thủy 1:1 cùng chuyên gia.
        </p>

        <!-- 4 Nút hành động liên hệ -->
        <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3">
          <a
            href={`tel:${CONTACT.phone}`}
            class="border border-walnut-900/30 bg-sand-50 px-6 py-2.5 text-xs uppercase tracking-[0.2em] text-walnut-900 transition hover:border-clay-600 hover:bg-clay-600 hover:text-sand-50 rounded-sm font-semibold shadow-2xs"
          >
            Hotline
          </a>
          <a
            href={CONTACT.zalo}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-walnut-900/30 bg-sand-50 px-6 py-2.5 text-xs uppercase tracking-[0.2em] text-walnut-900 transition hover:border-clay-600 hover:bg-clay-600 hover:text-sand-50 rounded-sm font-semibold shadow-2xs"
          >
            Zalo
          </a>
          <a
            href={CONTACT.messenger}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-walnut-900/30 bg-sand-50 px-6 py-2.5 text-xs uppercase tracking-[0.2em] text-walnut-900 transition hover:border-clay-600 hover:bg-clay-600 hover:text-sand-50 rounded-sm font-semibold shadow-2xs"
          >
            Messenger
          </a>
          <a
            href="https://www.google.com/maps?q=10.785194,106.641778"
            target="_blank"
            rel="noopener noreferrer"
            class="border border-[#173524] bg-[#173524] px-6 py-2.5 text-xs uppercase tracking-[0.2em] text-[#F3E5AB] transition hover:bg-[#234e35] hover:border-[#234e35] rounded-sm shadow-xs font-semibold"
            title="Mở chỉ đường trên Google Maps"
          >
            Chỉ đường
          </a>
        </div>
      </div>

      <!-- Bản đồ Google Maps nhúng -->
      <div class="relative group overflow-hidden rounded-lg border border-walnut-900/15 shadow-sm bg-sand-200">
        <iframe
          title="Bản đồ showroom KTUFA 615 Âu Cơ"
          src="https://maps.google.com/maps?q=10.785194,106.641778&z=17&output=embed"
          class="h-72 w-full border-0 lg:h-80 pointer-events-none"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <!-- Lớp phủ clickable bao trùm toàn bộ bản đồ -->
        <a
          href="https://www.google.com/maps?q=10.785194,106.641778"
          target="_blank"
          rel="noopener noreferrer"
          class="absolute inset-0 flex items-end justify-end p-3.5 bg-black/0 group-hover:bg-black/10 transition-colors cursor-pointer"
          title="Nhấp để mở vị trí trên Google Maps"
        >
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white/95 text-walnut-900 text-xs font-semibold shadow-md border border-walnut-900/15 group-hover:bg-[#173524] group-hover:text-[#F3E5AB] transition-all">
            <span>Mở trong Google Maps</span>
            <span class="text-xs">↗</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. PHẦN 3: ĐỐI TÁC & NHẬN BẢN TIN (#doi-tac) -->
  <section id="doi-tac" class="mx-auto max-w-7xl scroll-mt-28 lg:scroll-mt-32 px-4 py-14 sm:py-20 lg:py-24">
    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Card Đối tác kiến trúc sư -->
      <div class="border border-walnut-900/10 bg-sand-50 p-8 sm:p-12 rounded shadow-sm flex flex-col justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-walnut-800 font-bold">Dành cho đối tác</p>
          <h2 class="mt-4 font-display text-2xl sm:text-3xl tracking-tight text-walnut-900">
            Kiến trúc sư và nhà thiết kế
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-walnut-800">
            Chính sách giá ưu đãi và hỗ trợ riêng cho các dự án nội thất chuyên nghiệp. Hợp tác cung ứng vật liệu độc bản, bản vẽ kỹ thuật CAD/3D và bảo hành công trình lên đến 10 năm.
          </p>
        </div>
        <div class="mt-8">
          <a
            href={CONTACT.zalo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-[#173524] px-7 py-3 text-xs uppercase tracking-[0.2em] text-[#D8B670] transition hover:bg-[#234e35] rounded-sm font-bold shadow-xs border border-[#D8B670]/30"
          >
            Đăng ký đối tác
          </a>
        </div>
      </div>

      <!-- Card Nhận bản tin -->
      <div class="border border-walnut-900/10 bg-sand-50 p-8 sm:p-12 rounded shadow-sm flex flex-col justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-walnut-800 font-bold">Nhận bản tin</p>
          <h2 class="mt-4 font-display text-2xl sm:text-3xl tracking-tight text-walnut-900">
            Bộ sưu tập mới và ưu đãi
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-walnut-800">
            Đăng ký để trở thành người đầu tiên nhận catalogue xu hướng nội thất hàng quý và những lời mời tham dự triển lãm riêng tư của KTUFA.
          </p>
        </div>
        <form
          class="mt-8 flex flex-col gap-3 sm:flex-row"
          onsubmit="event.preventDefault(); alert('Cảm ơn bạn đã đăng ký nhận bản tin từ KTUFA!'); (event.target as HTMLFormElement).reset();"
        >
          <input
            type="email"
            required
            placeholder="Nhập địa chỉ email của bạn"
            class="w-full border-b border-walnut-900/30 bg-transparent px-1 py-3 text-sm outline-none transition focus:border-clay-600 text-walnut-900 placeholder-walnut-800/50"
          />
          <button
            type="submit"
            class="border border-walnut-900 px-7 py-3 text-xs uppercase tracking-[0.2em] text-walnut-900 transition hover:bg-walnut-900 hover:text-sand-50 rounded-sm cursor-pointer font-bold shrink-0"
          >
            Gửi
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Script xử lý cuộn mượt tự động khi có Hash hoặc khi click menu -->
  <script>
    function handleHashScroll() {
      const hash = window.location.hash;
      if (!hash) return;
      
      const targetElement = document.querySelector(hash);
      if (targetElement) {
        // Trừ bớt chiều cao của header cố định
        const header = document.getElementById('site-header');
        const headerHeight = header ? header.offsetHeight : 90;
        const targetPosition = targetElement.getBoundingClientRect().top + window.scrollY - headerHeight - 16;
        
        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });
      }
    }

    // Cuộn khi trang vừa tải xong nếu URL có hash (#cau-chuyen, #showroom, #doi-tac)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(handleHashScroll, 120);
      });
    } else {
      setTimeout(handleHashScroll, 120);
    }

    // Cuộn khi thay đổi hash (ví dụ người dùng đang ở trang này và click vào mục khác ở menu header)
    window.addEventListener('hashchange', handleHashScroll);
  </script>
</BaseLayout>

