---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Giỏ hàng | Nội Thất" description="Xem lại các sản phẩm bạn đã chọn và tiến hành đặt hàng.">

  <div class="border-b border-walnut-900/10 bg-sand-100">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:py-12">
      <nav class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">
        <a href="/" class="transition-colors hover:text-clay-600">Trang chủ</a>
        <span class="mx-2">/</span>
        <span class="text-walnut-900">Giỏ hàng</span>
      </nav>
      <h1 class="mt-4 font-display text-3xl tracking-tight sm:text-4xl text-walnut-900">Giỏ hàng của bạn</h1>
      <p class="mt-3 text-sm text-walnut-800"><span data-cart-count-label>0</span> sản phẩm đang có trong giỏ hàng</p>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:py-14">
    <div data-cart-root>

      <!-- Empty State -->
      <div data-cart-empty class="hidden border border-walnut-900/10 bg-sand-50/50 rounded-lg px-6 py-20 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-sand-200/80 text-walnut-800">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <p class="mt-5 font-display text-2xl text-walnut-900">Giỏ hàng của bạn đang trống</p>
        <p class="mt-2 text-sm text-walnut-800">Hãy khám phá bộ sưu tập nội thất tinh tế và chọn món đồ yêu thích nhé.</p>
        <a href="/san-pham" class="mt-8 inline-block bg-walnut-900 px-8 py-3.5 text-xs uppercase tracking-[0.2em] text-sand-50 transition-colors hover:bg-clay-600 rounded-sm">
          Khám phá sản phẩm ngay
        </a>
      </div>

      <!-- Cart Content -->
      <div data-cart-content class="hidden">
        <div class="grid gap-10 lg:grid-cols-[1fr_22rem] lg:gap-16">

          <div>
            <div class="flex items-center justify-between border-b border-walnut-900/10 pb-3 text-[11px] uppercase tracking-[0.2em] text-walnut-800">
              <span>Sản phẩm</span>
              <span>Số lượng / Thành tiền</span>
            </div>
            <div data-cart-items></div>
          </div>

          <aside class="h-fit rounded-2xl border border-walnut-900/10 bg-white p-6 sm:p-7 shadow-sm sticky top-6">
            <h2 class="text-xs font-bold uppercase tracking-[0.25em] text-walnut-900 pb-4 border-b border-walnut-900/10">Tóm tắt đơn hàng</h2>

            <!-- BỐ CỤC TẠM TÍNH & PHÍ VẬN CHUYỂN CÂN ĐỐI, ĐỀU ĐẸP -->
            <dl class="mt-5 space-y-3.5 text-sm">
              <div class="flex items-center justify-between gap-4 pb-3 border-b border-walnut-900/5">
                <dt class="text-walnut-800 font-medium whitespace-nowrap">Tạm tính</dt>
                <dd data-cart-subtotal class="font-bold text-walnut-900 text-base text-right whitespace-nowrap">0 đ</dd>
              </div>
              <div class="flex items-center justify-between gap-4">
                <dt class="text-walnut-800 font-medium whitespace-nowrap">Phí vận chuyển</dt>
                <dd class="font-medium text-walnut-800 text-xs text-right whitespace-nowrap">Tính khi thanh toán</dd>
              </div>
            </dl>

            <!-- TỔNG CỘNG GỌN GÀNG, CĂN ĐỀU -->
            <div class="mt-5 rounded-xl bg-gradient-to-br from-sand-100/90 to-sand-200/50 p-4 border border-walnut-900/10">
              <div class="flex items-center justify-between gap-3">
                <span class="text-xs uppercase tracking-wider font-bold text-walnut-900 whitespace-nowrap">Tổng cộng</span>
                <span data-cart-total class="font-display text-2xl font-extrabold text-clay-700 tracking-tight text-right whitespace-nowrap">0 đ</span>
              </div>
            </div>

<a href="/thanh-toan" id="btn-cart-checkout" class="mt-5 block w-full bg-clay-600 px-6 py-4 text-center text-xs font-bold uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 rounded-sm shadow-sm active:scale-95">
              Tiến hành đặt hàng →
            </a>

            <!-- Gợi ý đăng nhập nếu khách chưa đăng nhập -->
            <div id="cart-login-hint" class="mt-2.5 hidden rounded bg-amber-50/90 border border-amber-200/80 p-2 text-center text-[11px] text-amber-900 leading-snug">
              <span>💡 Bạn chưa đăng nhập. Nhấn <strong>Đặt hàng</strong> để đăng nhập và bảo lưu đơn hàng nhé.</span>
            </div>

            <button type="button" data-cart-clear class="mt-4 w-full text-center text-xs uppercase tracking-[0.15em] text-walnut-800/70 hover:text-red-600 underline underline-offset-4 transition-colors cursor-pointer">
              Xóa toàn bộ giỏ hàng
            </button>
          </aside>

        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  import { readCart, updateQty, removeItem, clearCart, countItems, totalPrice, formatVnd, CART_EVENT, showCartToast, clampQty } from '../../scripts/cart';
  import type { CartItem } from '../../scripts/cart';

  const root = document.querySelector<HTMLElement>('[data-cart-root]');

  const itemsEl = root?.querySelector<HTMLElement>('[data-cart-items]');
  const emptyEl = root?.querySelector<HTMLElement>('[data-cart-empty]');
  const contentEl = root?.querySelector<HTMLElement>('[data-cart-content]');
  const subtotalEl = root?.querySelector<HTMLElement>('[data-cart-subtotal]');
  const totalEl = root?.querySelector<HTMLElement>('[data-cart-total]');
  const clearBtn = root?.querySelector<HTMLButtonElement>('[data-cart-clear]');
  const checkoutBtn = root?.querySelector<HTMLAnchorElement>('#btn-cart-checkout, a[href="/thanh-toan"]');
  const loginHint = root?.querySelector<HTMLElement>('#cart-login-hint');

  const updateLoginHint = () => {
    const token = localStorage.getItem('auth_token');
    if (!token && loginHint) {
      loginHint.classList.remove('hidden');
    } else if (loginHint) {
      loginHint.classList.add('hidden');
    }
  };
  updateLoginHint();

  // Chặn khách chưa đăng nhập khi bấm đặt hàng từ giỏ hàng kèm thông báo thân thiện
  checkoutBtn?.addEventListener('click', (e) => {
    const token = localStorage.getItem('auth_token');
    if (!token) {
      e.preventDefault();
      showCartToast('Vui lòng đăng nhập tài khoản để tiếp tục thanh toán và đặt hàng!');
      setTimeout(() => {
        window.location.href = '/dang-nhap?redirect=/thanh-toan';
      }, 900);
    }
  });
  const countLabel = document.querySelector<HTMLElement>('[data-cart-count-label]');

  if (itemsEl && emptyEl && contentEl && subtotalEl && totalEl) {

    const rowHtml = (item: CartItem) => {
      const imgHtml = item.thumbnail
        ? `<img src="${item.thumbnail}" alt="${item.name}" class="h-full w-full object-cover rounded-sm" />`
        : `<div class="flex h-full w-full items-center justify-center text-walnut-900/30">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>`;

      return `
        <div data-row="${item.slug}" class="flex gap-4 border-b border-walnut-900/10 py-6">
          <a href="/san-pham/${item.slug}" class="block h-24 w-20 shrink-0 bg-sand-200 overflow-hidden rounded border border-walnut-900/10" aria-label="${item.name}">
            ${imgHtml}
          </a>
          <div class="flex min-w-0 flex-1 flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <a href="/san-pham/${item.slug}" class="text-sm font-medium text-walnut-900 transition-colors hover:text-clay-600">${item.name}</a>
              <p class="mt-1 text-xs text-walnut-800">${formatVnd(item.price)}</p>
            </div>
            <div class="flex items-center gap-4">
              <div class="flex h-9 items-center border border-walnut-900/20 rounded bg-white">
                <button type="button" data-row-down class="h-full px-3 text-walnut-900 transition-colors hover:bg-walnut-900/10" aria-label="Giảm số lượng">-</button>
                <input data-row-qty type="number" min="1" max="99" value="${item.qty}" aria-label="Số lượng" class="h-full w-12 border-x border-walnut-900/20 bg-transparent text-center text-xs font-semibold outline-none focus:bg-sand-50" />
                <button type="button" data-row-up class="h-full px-3 text-walnut-900 transition-colors hover:bg-walnut-900/10" aria-label="Tăng số lượng">+</button>
              </div>
              <p class="w-28 text-right text-sm font-semibold text-walnut-900">${formatVnd(item.price * item.qty)}</p>
              <button type="button" data-row-remove class="text-xs uppercase tracking-[0.15em] text-walnut-800 underline underline-offset-4 transition-colors hover:text-red-600" title="Xóa món này">Xóa</button>
            </div>
          </div>
        </div>
      `;
    };

    const bindRows = () => {
      itemsEl.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
        const slug = row.getAttribute('data-row') || '';
        const qtyInput = row.querySelector<HTMLInputElement>('[data-row-qty]');
        const current = () => Number(qtyInput?.value ?? 1) || 1;

        row.querySelector('[data-row-up]')?.addEventListener('click', () => {
          updateQty(slug, current() + 1);
          render();
        });
        row.querySelector('[data-row-down]')?.addEventListener('click', () => {
          updateQty(slug, Math.max(1, current() - 1));
          render();
        });
        row.querySelector('[data-row-remove]')?.addEventListener('click', () => {
          removeItem(slug);
          render();
        });

        const handleManualQty = () => {
          const rawVal = qtyInput?.value;
          const parsed = clampQty(rawVal, 99);
          updateQty(slug, parsed);
          render();
        };

        qtyInput?.addEventListener('change', handleManualQty);
        qtyInput?.addEventListener('blur', handleManualQty);
        qtyInput?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            handleManualQty();
          }
        });
      });
    };

    const render = () => {
      const items = readCart();
      const isEmpty = items.length === 0;

      itemsEl.innerHTML = items.map(rowHtml).join('');
      emptyEl.classList.toggle('hidden', !isEmpty);
      contentEl.classList.toggle('hidden', isEmpty);

      const subtotal = totalPrice(items);

      subtotalEl.textContent = formatVnd(subtotal);
      totalEl.textContent = formatVnd(subtotal);
      if (countLabel) countLabel.textContent = String(countItems(items));

      if (!isEmpty) bindRows();
    };

    clearBtn?.addEventListener('click', () => {
      if (confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?')) {
        clearCart();
        render();
      }
    });

    window.addEventListener('storage', render);
    window.addEventListener(CART_EVENT, render);
    window.addEventListener('auth:changed', render);
    render();
  }
</script>