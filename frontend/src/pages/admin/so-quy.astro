          <div>
            <p class="text-[10px] uppercase tracking-[0.22em] text-[#D8B670] font-semibold">CHỨNG TỪ KẾ TOÁN</p>
            <h2 class="text-lg sm:text-xl font-display font-bold text-white tracking-wide mt-0.5">Phiếu Thu / Chi A5</h2>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="btn-do-print-voucher" type="button" class="inline-flex items-center gap-1.5 bg-gradient-to-r from-[#D8B670] via-[#E2C37E] to-[#C49E52] px-4 py-2 text-xs uppercase tracking-[0.15em] font-bold text-[#173524] hover:from-[#C49E52] hover:to-[#B58F43] hover:text-white shadow-md transition-all active:scale-95 cursor-pointer border border-[#E0C582]/50 rounded-none">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            In Phiếu (A5)
          </button>
          <button 
            type="button" 
            class="btn-close-modal h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-sand-200 hover:text-white flex items-center justify-center transition-all hover:rotate-90 cursor-pointer border border-white/10"
            title="Đóng cửa sổ"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Printable Area -->
      <div id="print-area-voucher" class="p-8 text-xs text-walnut-900 space-y-5 bg-white overflow-y-auto flex-1">
        <div class="flex justify-between items-start border-b border-walnut-900/15 pb-4">
          <div>
            <h3 class="text-base font-bold font-display text-[#173524] uppercase">NỘI THẤT CAO CẤP KTUFA</h3>
            <p class="text-[10px] text-walnut-800">Địa chỉ: KCN Biên Hòa 2, Đồng Nai | Hotline: 0902.455.060</p>
          </div>
          <div class="text-right">
            <h2 id="print-v-title" class="text-lg font-bold font-display text-[#173524] uppercase">PHIẾU THU TIỀN</h2>
            <p id="print-v-code" class="font-mono font-bold text-xs text-[#D8B670]">PT-XXXX</p>
            <p id="print-v-date" class="text-[10px] text-walnut-800/80">Ngày: --/--/----</p>
          </div>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex">
            <span class="w-40 text-walnut-800">Họ và tên người <span id="print-v-role-label">nộp</span>:</span>
            <span id="print-v-recipient" class="font-bold text-[#173524]">--</span>
