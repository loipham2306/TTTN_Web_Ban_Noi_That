  <style>
    @media print {
      body * { visibility: hidden; }
      #print-area-voucher, #print-area-voucher * { visibility: visible; }
      #print-area-voucher {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        padding: 0;
        margin: 0;
      }
      .no-print { display: none !important; }
    }
  </style>

  <script define:vars={{ initialTransactions, pendingCodOrders }}>
    window.__TRANSACTIONS = initialTransactions || [];
    window.__COD_ORDERS = pendingCodOrders || [];

    const formatMoney = (amount) => {
      return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount || 0);
    };

    document.addEventListener('DOMContentLoaded', () => {
      // 1. Chuyển Tab
      const tabBtns = document.querySelectorAll('.tab-trigger');
      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabBtns.forEach((b) => {
            b.classList.remove('bg-[#173524]', 'text-white');
            b.classList.add('text-walnut-800/80');
          });
          btn.classList.add('bg-[#173524]', 'text-white');
          btn.classList.remove('text-walnut-800/80');

          const targetId = btn.getAttribute('data-target');
          document.querySelectorAll('.tab-pane').forEach((p) => p.classList.add('hidden'));
          document.getElementById(targetId)?.classList.remove('hidden');
        });
      });

      // 2. Lọc Nhật ký Sổ quỹ
      const searchInput = document.getElementById('search-ledger-input');
      const filterType = document.getElementById('filter-ledger-type');
      const filterMethod = document.getElementById('filter-ledger-method');

      const filterLedger = () => {
        const q = searchInput?.value.toLowerCase().trim() || '';
        const type = filterType?.value || '';
        const method = filterMethod?.value || '';

        document.querySelectorAll('.ledger-row').forEach((row) => {
          const rowType = row.getAttribute('data-type') || '';
          const rowMethod = row.getAttribute('data-method') || '';
          const rowText = row.getAttribute('data-text')?.toLowerCase() || '';

          const matchQ = !q || rowText.includes(q);
          const matchType = !type || rowType === type;
          const matchMethod = !method || rowMethod === method;

          row.style.display = (matchQ && matchType && matchMethod) ? '' : 'none';
        });
      };

      searchInput?.addEventListener('input', filterLedger);
      filterType?.addEventListener('change', filterLedger);
      filterMethod?.addEventListener('change', filterLedger);

      // 3. Đóng mở modals
      const openModal = (id) => document.getElementById(id)?.classList.remove('hidden');
      const closeModal = (id) => document.getElementById(id)?.classList.add('hidden');
      document.querySelectorAll('.btn-close-modal').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('[id^="modal-"]').forEach((m) => m.classList.add('hidden'));
        });
      });

      // 4. Đối Soát COD 1 chạm
      document.querySelectorAll('.btn-reconcile-cod').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const orderCode = btn.getAttribute('data-code');
          const amount = parseFloat(btn.getAttribute('data-amount') || '0');
          const customer = btn.getAttribute('data-customer');
          const method = btn.getAttribute('data-method');

          const methodText = method === 'cash' ? 'TIỀN MẶT VÀO KÉT QUỸ' : 'CHUYỂN KHOẢN NGÂN HÀNG';
          const confirmMsg = `Xác nhận thu ${formatMoney(amount)} (${methodText}) cho đơn hàng ${orderCode} của khách hàng ${customer}?`;

          if (!confirm(confirmMsg)) return;

          try {
            btn.disabled = true;
            btn.textContent = 'Đang xử lý...';
            const token = localStorage.getItem('admin_token') || localStorage.getItem('auth_token');

            const res = await fetch('http://localhost:4000/api/cashbook/reconcile-cod', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({
                orderCode,
                paymentMethod: method,
                note: `Thu tiền đối soát COD từ shipper cho đơn ${orderCode}`
              })
            });

            const data = await res.json();
            if (data.success) {
              alert(`Đối soát thành công! Đã ghi sổ Phiếu Thu: ${data.data.voucherCode}`);
              window.location.reload();
            } else {
              alert(data.message || 'Lỗi đối soát.');
              btn.disabled = false;
              btn.textContent = 'Thử lại';
            }
          } catch {
            alert('Lỗi kết nối máy chủ.');
            btn.disabled = false;
          }
        });
      });

      // 5. Mở Modal Phiếu Thu
      document.getElementById('btn-open-create-income')?.addEventListener('click', () => {
        document.getElementById('voucher-type').value = 'income';
        document.getElementById('voucher-modal-title').textContent = 'Lập Phiếu Thu Tiền Mặt / Ngân Hàng';
        document.getElementById('voucher-recipient-label').textContent = 'Người Nộp Tiền *';
        const submitBtn = document.getElementById('btn-submit-voucher');
        if (submitBtn) {
          submitBtn.className = 'px-5 py-2 rounded-xl bg-emerald-700 text-xs font-bold text-white hover:bg-emerald-800';
          submitBtn.textContent = 'Lưu & Nhập Quỹ (Thu)';
        }
        openModal('modal-create-voucher');
      });

      // Mở Modal Phiếu Chi
      document.getElementById('btn-open-create-expense')?.addEventListener('click', () => {
        document.getElementById('voucher-type').value = 'expense';
        document.getElementById('voucher-modal-title').textContent = 'Lập Phiếu Chi Tiền Mặt / Ngân Hàng';
        document.getElementById('voucher-recipient-label').textContent = 'Người Nhận Tiền *';
        const submitBtn = document.getElementById('btn-submit-voucher');
        if (submitBtn) {
          submitBtn.className = 'px-5 py-2 rounded-xl bg-red-700 text-xs font-bold text-white hover:bg-red-800';
          submitBtn.textContent = 'Lưu & Xuất Quỹ (Chi)';
        }
        openModal('modal-create-voucher');
      });

      // Submit Phiếu Thu / Chi thủ công
      document.getElementById('form-create-voucher')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const type = document.getElementById('voucher-type').value;
        const amount = parseFloat(document.getElementById('voucher-amount').value);
        const paymentMethod = document.getElementById('voucher-method').value;
        const category = document.getElementById('voucher-category').value;
        const recipientName = document.getElementById('voucher-recipient').value;
        const referenceCode = document.getElementById('voucher-ref').value;
        const note = document.getElementById('voucher-note').value;

        try {
          const token = localStorage.getItem('admin_token') || localStorage.getItem('auth_token');
          const submitBtn = document.getElementById('btn-submit-voucher');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Đang lưu...';
          }

          const res = await fetch('http://localhost:4000/api/cashbook', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({
              type,
              amount,
              paymentMethod,
              category,
              recipientName,
              referenceCode,
              note
            })
          });

          const data = await res.json();
          if (data.success) {
            alert(`Lập chứng từ ${type === 'income' ? 'Phiếu Thu' : 'Phiếu Chi'} thành công! Mã: ${data.data.code}`);
            window.location.reload();
          } else {
            alert(data.message || 'Lỗi ghi sổ.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Thử lại';
            }
          }
        } catch {
          alert('Lỗi kết nối máy chủ.');
        }
      });

      // 6. In Phiếu Thu / Chi A5
      document.querySelectorAll('.btn-print-voucher').forEach((btn) => {
        btn.addEventListener('click', () => {
          const code = btn.getAttribute('data-code');
          const type = btn.getAttribute('data-type');
          const amount = parseFloat(btn.getAttribute('data-amount') || '0');
          const category = btn.getAttribute('data-category');
          const recipient = btn.getAttribute('data-recipient');
          const method = btn.getAttribute('data-method');
          const note = btn.getAttribute('data-note');
          const date = btn.getAttribute('data-date');

          const isIncome = type === 'income';
          document.getElementById('print-v-title').textContent = isIncome ? 'PHIẾU THU TIỀN' : 'PHIẾU CHI TIỀN';
          document.getElementById('print-v-code').textContent = code;
          document.getElementById('print-v-date').textContent = `Ngày: ${new Date(date).toLocaleString('vi-VN')}`;
          document.getElementById('print-v-role-label').textContent = isIncome ? 'nộp' : 'nhận';
          document.getElementById('print-v-recipient').textContent = recipient;
          document.getElementById('print-v-category').textContent = category;
          document.getElementById('print-v-method').textContent = method === 'cash' ? 'Tiền mặt (Két quỹ)' : 'Chuyển khoản (VietQR / Ngân hàng)';
          document.getElementById('print-v-amount').textContent = formatMoney(amount);
          document.getElementById('print-v-note').textContent = note || 'Không có ghi chú thêm.';
          document.getElementById('print-v-sign-label').textContent = isIncome ? 'Người Nộp Tiền' : 'Người Nhận Tiền';
          document.getElementById('print-v-sign-name').textContent = recipient;

          openModal('modal-print-voucher');
        });
      });

      document.getElementById('btn-do-print-voucher')?.addEventListener('click', () => {
        window.print();
      });
    });
  </script>
</AdminLayout>
