        <div>
          <p class="font-bold text-walnut-900 uppercase tracking-wider text-[10px] mb-1.5 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#173524]"></span>
            Nội dung gửi khách hàng:
          </p>
          <div id="detail-cam-content" class="p-3.5 bg-white border border-walnut-900/15 text-walnut-800 leading-relaxed text-xs shadow-xs whitespace-pre-line">
            Nội dung chi tiết của email...
          </div>
        </div>
      </div>

      <!-- MODAL FOOTER (STICKY BOTTOM) -->
      <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex items-center justify-between gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
        <button 
          type="button" 
          id="btn-test-mail" 
          class="border border-clay-600 text-clay-600 hover:bg-clay-600 hover:text-white px-4 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold transition-colors cursor-pointer"
        >
          Gửi Test Thử Nghiệm
        </button>
        <button 
          type="button" 
          id="btn-close-detail-footer" 
          class="border border-walnut-900/20 px-5 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer"
        >
          Đóng
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST -->
  <div id="cam-toast" class="fixed bottom-6 right-6 z-50 hidden translate-y-4 rounded bg-walnut-900 px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300 border border-emerald-500/40">
    <span id="cam-toast-msg">Đã thực hiện thành công!</span>
  </div>

</AdminLayout>

<script>
  const initCampaignPage = () => {
    const API_BASE = 'http://localhost:4000/api/campaigns';

    const tableBody = document.getElementById('campaign-table-body') as HTMLElement;
    const totalSentEl = document.getElementById('stat-total-sent') as HTMLElement;

    // Create Modal
    const createModal = document.getElementById('create-campaign-modal') as HTMLElement;
    const btnOpenCreate = document.getElementById('btn-open-create-campaign') as HTMLButtonElement;
    const btnCloseCreate = document.getElementById('btn-close-create-modal') as HTMLButtonElement;
    const btnCancelCreate = document.getElementById('btn-cancel-create-modal') as HTMLButtonElement;
    const createForm = document.getElementById('create-campaign-form') as HTMLFormElement;

    // Detail Modal
    const detailModal = document.getElementById('detail-campaign-modal') as HTMLElement;
    const btnCloseDetail = document.getElementById('btn-close-detail-modal') as HTMLButtonElement;
    const btnCloseDetailFooter = document.getElementById('btn-close-detail-footer') as HTMLButtonElement;
    const detailId = document.getElementById('detail-cam-id') as HTMLElement;
    const detailTitle = document.getElementById('detail-cam-title') as HTMLElement;
    const detailRecipients = document.getElementById('detail-cam-recipients') as HTMLElement;
    const detailOpenRate = document.getElementById('detail-cam-open-rate') as HTMLElement;
    const detailClickRate = document.getElementById('detail-cam-click-rate') as HTMLElement;
    const detailAudience = document.getElementById('detail-cam-audience') as HTMLElement;
    const detailDate = document.getElementById('detail-cam-date') as HTMLElement;
    const detailStatus = document.getElementById('detail-cam-status') as HTMLElement;
    const detailContent = document.getElementById('detail-cam-content') as HTMLElement;
    const btnTestMail = document.getElementById('btn-test-mail') as HTMLButtonElement;

    // Toast
    const toast = document.getElementById('cam-toast') as HTMLElement;
    const toastMsg = document.getElementById('cam-toast-msg') as HTMLElement;

    const showToast = (msg: string, isError = false) => {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.className = `fixed bottom-6 right-6 z-50 rounded px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300 border ${
        isError ? 'bg-red-900 border-red-500/50' : 'bg-walnut-900 border-emerald-500/40'
      }`;
      toast.classList.remove('hidden', 'translate-y-4');
      setTimeout(() => {
        toast.classList.add('translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3500);
    };

    const getHeaders = () => {
      const token = localStorage.getItem('token') || localStorage.getItem('admin_token') || localStorage.getItem('auth_token') || localStorage.getItem('accessToken') || '';
      const headers: Record<string, string> = {
        'Content-Type': 'application/json',
      };
      if (token) {
        headers['Authorization'] = `Bearer ${token}`;
      }
      return headers;
    };

    // Close handlers
    const closeCreate = () => createModal?.classList.add('hidden');
    const closeDetail = () => detailModal?.classList.add('hidden');

    btnOpenCreate?.addEventListener('click', () => {
      createForm?.reset();
      createModal?.classList.remove('hidden');
    });
    btnCloseCreate?.addEventListener('click', closeCreate);
    btnCancelCreate?.addEventListener('click', closeCreate);

    btnCloseDetail?.addEventListener('click', closeDetail);
    btnCloseDetailFooter?.addEventListener('click', closeDetail);

    [createModal, detailModal].forEach((m) => {
      m?.addEventListener('click', (e) => {
        if (e.target === m) m.classList.add('hidden');
      });
    });

    // Gửi email thử nghiệm cho admin
    btnTestMail?.addEventListener('click', async () => {
      const originalText = btnTestMail.textContent;
      btnTestMail.textContent = 'Đang gửi...';
      btnTestMail.disabled = true;

      try {
        const res = await fetch(`${API_BASE}/test-mail`, {
          method: 'POST',
          headers: getHeaders(),
          body: JSON.stringify({ email: 'admin@noithat.vn' }),
        });
        const resData = await res.json();
        if (!res.ok || !resData.success) throw new Error(resData.message || 'Lỗi gửi test');

        showToast(resData.message || 'Đã gửi email thử nghiệm thành công tới admin@noithat.vn!');
      } catch (err: any) {
        showToast(err.message || 'Lỗi khi gửi email test', true);
      } finally {
        btnTestMail.textContent = originalText;
        btnTestMail.disabled = false;
      }
    });

    // Gắn sự kiện cho từng hàng chiến dịch
    const attachRowActions = (row: HTMLTableRowElement) => {
      const detailBtn = row.querySelector('[data-btn-detail]');
      const duplicateBtn = row.querySelector('[data-btn-duplicate]');
      const deleteBtn = row.querySelector('[data-btn-delete]');

      // View Detail
      detailBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        if (detailId) detailId.textContent = `CHI TIẾT: ${row.dataset.id || ''}`;
        if (detailTitle) detailTitle.textContent = row.dataset.title || '';
        if (detailRecipients) detailRecipients.textContent = row.dataset.recipients || '';
        if (detailOpenRate) detailOpenRate.textContent = row.dataset.openRate || '--';
        if (detailClickRate) detailClickRate.textContent = row.dataset.clickRate || '--';
        if (detailAudience) detailAudience.textContent = row.dataset.audience || 'Tất cả khách hàng';
        if (detailDate) detailDate.textContent = row.dataset.date || '';
        if (detailStatus) detailStatus.textContent = row.dataset.status || '';
        if (detailContent) detailContent.textContent = row.dataset.content || 'Nội dung chưa cập nhật';
        detailModal?.classList.remove('hidden');
      });

      // Duplicate -> Gọi POST /api/campaigns/:id/duplicate
      duplicateBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        const code = row.dataset.id;
        if (!code) return;

        try {
          const res = await fetch(`${API_BASE}/${code}/duplicate`, {
            method: 'POST',
            headers: getHeaders(),
          });
          const resData = await res.json();
          if (!res.ok || !resData.success) throw new Error(resData.message || 'Lỗi sao chép chiến dịch');

          const dup = resData.data;
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-sand-100/50 transition-colors bg-blue-50/20';
          tr.setAttribute('data-campaign-row', '');
          tr.dataset.id = dup.id;
          tr.dataset.title = dup.title;
          tr.dataset.recipients = dup.recipients;
          tr.dataset.audience = dup.targetAudience;
          tr.dataset.openRate = dup.openRate;
          tr.dataset.clickRate = dup.clickRate;
          tr.dataset.date = dup.date;
          tr.dataset.status = dup.status;
          tr.dataset.content = dup.content;

          tr.innerHTML = `
            <td class="py-3 px-4 font-mono font-bold text-walnut-900" data-col="id">${dup.id}</td>
            <td class="py-3 px-4 font-bold text-walnut-900 max-w-xs" data-col="title">${dup.title}</td>
            <td class="py-3 px-4 font-medium text-walnut-800" data-col="recipients">${dup.recipients}</td>
            <td class="py-3 px-4 font-semibold text-emerald-700" data-col="open-rate">${dup.openRate}</td>
            <td class="py-3 px-4 font-semibold text-clay-600" data-col="click-rate">${dup.clickRate}</td>
            <td class="py-3 px-4 text-walnut-800/80" data-col="date">${dup.date}</td>
            <td class="py-3 px-4" data-col="status">
              <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${dup.statusColor}">
                ${dup.status}
              </span>
            </td>
            <td class="py-3 px-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <button type="button" data-btn-detail class="text-xs font-semibold text-clay-600 hover:underline cursor-pointer">Chi tiết</button>
                <span class="text-walnut-800/30">|</span>
                <button type="button" data-btn-duplicate class="text-xs font-semibold text-walnut-800 hover:underline cursor-pointer">Sao chép</button>
                <span class="text-walnut-800/30">|</span>
                <button type="button" data-btn-delete class="text-xs font-semibold text-red-600 hover:underline cursor-pointer">Xóa</button>
              </div>
            </td>
          `;

          attachRowActions(tr);
          tableBody?.prepend(tr);
          showToast(`Đã sao chép chiến dịch thành công thành "${dup.id}"!`);
        } catch (err: any) {
          showToast(err.message || 'Lỗi khi sao chép chiến dịch', true);
        }
      });

      // Delete -> Gọi DELETE /api/campaigns/:id
      deleteBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        const code = row.dataset.id;
        const title = row.dataset.title;
        if (!code) return;

        if (!confirm(`Bạn có chắc chắn muốn xóa chiến dịch "${title}" khỏi hệ thống không?`)) {
          return;
        }

        try {
          const res = await fetch(`${API_BASE}/${code}`, {
            method: 'DELETE',
            headers: getHeaders(),
          });
          const resData = await res.json();
          if (!res.ok || !resData.success) throw new Error(resData.message || 'Lỗi xóa chiến dịch');

          row.remove();
          showToast(`Đã xóa chiến dịch "${title}" khỏi cơ sở dữ liệu!`);
        } catch (err: any) {
          showToast(err.message || 'Lỗi khi xóa chiến dịch', true);
        }
      });
    };

    if (tableBody) {
      tableBody.querySelectorAll<HTMLTableRowElement>('[data-campaign-row]').forEach(attachRowActions);
    }

    // Submit Create Form -> Gọi POST /api/campaigns
    createForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('cam-title-input') as HTMLInputElement)?.value.trim();
      const audience = (document.getElementById('cam-audience-select') as HTMLSelectElement)?.value;
      const actionType = (document.getElementById('cam-action-type') as HTMLSelectElement)?.value;
      const content = (document.getElementById('cam-content-input') as HTMLTextAreaElement)?.value.trim();

      if (!title || !content || !tableBody) return;

      const submitBtn = document.getElementById('btn-submit-campaign') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang lưu vào MySQL...';
      }

      try {
        const res = await fetch(API_BASE, {
          method: 'POST',
          headers: getHeaders(),
          body: JSON.stringify({
            title,
            audience,
            actionType,
            content,
          }),
        });

        const resData = await res.json();
        if (!res.ok || !resData.success) throw new Error(resData.message || 'Lỗi tạo chiến dịch');

        const newCam = resData.data;

        // Xóa hàng rỗng nếu có
        const emptyRow = document.getElementById('empty-campaign-row');
        if (emptyRow) emptyRow.remove();

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-sand-100/50 transition-colors bg-emerald-50/30';
        tr.setAttribute('data-campaign-row', '');
        tr.dataset.id = newCam.id;
        tr.dataset.title = newCam.title;
        tr.dataset.recipients = newCam.recipients;
        tr.dataset.audience = newCam.targetAudience;
        tr.dataset.openRate = newCam.openRate;
        tr.dataset.clickRate = newCam.clickRate;
        tr.dataset.date = newCam.date;
        tr.dataset.status = newCam.status;
        tr.dataset.content = newCam.content;

        tr.innerHTML = `
          <td class="py-3 px-4 font-mono font-bold text-walnut-900" data-col="id">${newCam.id}</td>
          <td class="py-3 px-4 font-bold text-walnut-900 max-w-xs" data-col="title">${newCam.title}</td>
          <td class="py-3 px-4 font-medium text-walnut-800" data-col="recipients">${newCam.recipients}</td>
          <td class="py-3 px-4 font-semibold text-emerald-700" data-col="open-rate">${newCam.openRate}</td>
          <td class="py-3 px-4 font-semibold text-clay-600" data-col="click-rate">${newCam.clickRate}</td>
          <td class="py-3 px-4 text-walnut-800/80" data-col="date">${newCam.date}</td>
          <td class="py-3 px-4" data-col="status">
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${newCam.statusColor}">
              ${newCam.status}
            </span>
          </td>
          <td class="py-3 px-4 text-right">
            <div class="flex items-center justify-end gap-2">
              <button type="button" data-btn-detail class="text-xs font-semibold text-clay-600 hover:underline cursor-pointer">Chi tiết</button>
              <span class="text-walnut-800/30">|</span>
              <button type="button" data-btn-duplicate class="text-xs font-semibold text-walnut-800 hover:underline cursor-pointer">Sao chép</button>
              <span class="text-walnut-800/30">|</span>
              <button type="button" data-btn-delete class="text-xs font-semibold text-red-600 hover:underline cursor-pointer">Xóa</button>
            </div>
          </td>
        `;

        attachRowActions(tr);
        tableBody.prepend(tr);
        closeCreate();
        createForm.reset();
        showToast(`Đã tạo chiến dịch "${title}" thành công!`);
      } catch (err: any) {
        showToast(err.message || 'Lỗi khi tạo chiến dịch', true);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Lưu & Phát hành';
        }
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCampaignPage);
  } else {
    initCampaignPage();
  }
</script>
