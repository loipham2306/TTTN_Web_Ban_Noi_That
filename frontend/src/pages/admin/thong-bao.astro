---
import AdminLayout from '../../layouts/AdminLayout.astro';

interface CampaignItem {
  id: string;
  rawId?: number;
  title: string;
  recipients: string;
  targetAudience: string;
  openRate: string;
  clickRate: string;
  date: string;
  status: string;
  statusColor: string;
  content: string;
}

let campaigns: CampaignItem[] = [];
let campaignStats = {
  totalSent: 0,
  totalSentText: '0 emails',
  avgOpenRate: '0',
  avgOpenRateText: '0%',
  avgClickRate: '0',
  avgClickRateText: '0%',
  smtpStatus: 'Sẵn sàng',
};

let audienceOptions: any[] = [];

// 1. Tải danh sách chiến dịch & KPIs từ Backend API
try {
  const res = await fetch('http://localhost:4000/api/campaigns', { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data)) {
      campaigns = json.data;
      if (json.stats) {
        campaignStats = json.stats;
      }
    }
  }
} catch (err) {
  console.warn('Backend chưa sẵn sàng khi render SSR campaigns:', err);
}

// 2. Tải số lượng khách hàng thực tế theo phân khúc
try {
  const audRes = await fetch('http://localhost:4000/api/campaigns/audiences', { signal: AbortSignal.timeout(3000) });
  if (audRes.ok) {
    const json = await audRes.json();
    if (json.success && json.data) {
      audienceOptions = Object.values(json.data);
    }
  }
} catch (err) {}

// Fallback an toàn nếu backend đang nạp
if (audienceOptions.length === 0) {
  audienceOptions = [
    { label: 'Tất cả khách hàng', text: 'Tất cả khách hàng (9 khách)' },
    { label: 'Hội viên VIP (Kim Cương / Vàng)', text: 'Hội viên VIP (0 khách)' },
    { label: 'Khách hàng thân thiết (Bạc)', text: 'Khách hàng thân thiết (2 khách)' },
    { label: 'Khách hàng mới đăng ký (30 ngày)', text: 'Khách hàng mới đăng ký (9 khách)' },
    { label: 'Khách hàng chưa có đơn mua', text: 'Khách hàng chưa có đơn (5 khách)' },
  ];
}
---

<AdminLayout title="Email & Thông Báo Tiếp Thị - Nội Thất">
  <div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-sans font-bold text-2xl sm:text-3xl text-walnut-900">Email & Thông Báo Khách Hàng</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Quản lý các chiến dịch gửi email tự động, thông báo đẩy và chăm sóc sau mua.</p>
      </div>

      <button 
        type="button" 
        id="btn-open-create-campaign"
        class="inline-flex items-center gap-2 bg-walnut-900 px-4 py-2.5 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm cursor-pointer font-medium"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Tạo Chiến Dịch Mới</span>
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Email đã gửi trong tháng</p>
        <p id="stat-total-sent" class="text-2xl font-bold text-walnut-900 mt-1">{campaignStats.totalSentText}</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tỷ lệ mở trung bình (Open)</p>
        <p id="stat-avg-open" class="text-2xl font-bold text-emerald-700 mt-1">{campaignStats.avgOpenRateText}</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tỷ lệ nhấp chuột (CTR)</p>
        <p id="stat-avg-click" class="text-2xl font-bold text-clay-600 mt-1">{campaignStats.avgClickRateText}</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Máy chủ SMTP Mailer</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{campaignStats.smtpStatus}</span>
        </p>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Mã</th>
              <th class="py-3 px-4 font-semibold">Tiêu đề chiến dịch</th>
              <th class="py-3 px-4 font-semibold">Người nhận</th>
              <th class="py-3 px-4 font-semibold">Tỷ lệ mở</th>
              <th class="py-3 px-4 font-semibold">Tỷ lệ Click</th>
              <th class="py-3 px-4 font-semibold">Thời gian</th>
              <th class="py-3 px-4 font-semibold">Trạng thái</th>
              <th class="py-3 px-4 font-semibold text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody id="campaign-table-body" class="divide-y divide-walnut-900/10">
            {campaigns.length === 0 ? (
              <tr id="empty-campaign-row">
                <td colspan="8" class="py-12 text-center text-walnut-800 text-sm">
                  Chưa có chiến dịch email nào. Nhấn "Tạo Chiến Dịch Mới" để bắt đầu gửi email tiếp thị.
                </td>
              </tr>
            ) : (
              campaigns.map((c) => (
              <tr 
                class="hover:bg-sand-100/50 transition-colors"
                data-campaign-row
                data-id={c.id}
                data-title={c.title}
                data-recipients={c.recipients}
                data-audience={c.targetAudience}
                data-open-rate={c.openRate}
                data-click-rate={c.clickRate}
                data-date={c.date}
                data-status={c.status}
                data-content={c.content}
              >
                <td class="py-3 px-4 font-mono font-bold text-walnut-900" data-col="id">{c.id}</td>
                <td class="py-3 px-4 font-bold text-walnut-900 max-w-xs" data-col="title">{c.title}</td>
                <td class="py-3 px-4 font-medium text-walnut-800" data-col="recipients">{c.recipients}</td>
                <td class="py-3 px-4 font-semibold text-emerald-700" data-col="open-rate">{c.openRate}</td>
                <td class="py-3 px-4 font-semibold text-clay-600" data-col="click-rate">{c.clickRate}</td>
                <td class="py-3 px-4 text-walnut-800/80" data-col="date">{c.date}</td>
                <td class="py-3 px-4" data-col="status">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${c.statusColor}`}>
                    {c.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button 
                      type="button" 
                      data-btn-detail
                      class="text-xs font-semibold text-clay-600 hover:underline cursor-pointer"
                    >
                      Chi tiết
                    </button>
                    <span class="text-walnut-800/30">|</span>
                    <button 
                      type="button" 
                      data-btn-duplicate
                      class="text-xs font-semibold text-walnut-800 hover:underline cursor-pointer"
                    >
                      Sao chép
                    </button>
                    <span class="text-walnut-800/30">|</span>
                    <button 
                      type="button" 
                      data-btn-delete
                      class="text-xs font-semibold text-red-600 hover:underline cursor-pointer"
                    >
                      Xóa
                    </button>
                  </div>
                </td>
              </tr>
            )))}
