          </div>
          <div class="p-3 bg-white rounded-none border border-walnut-900/15 shadow-xs">
            <p class="text-[10px] uppercase text-walnut-800/70 tracking-wider">Tỷ lệ Click</p>
            <p id="detail-cam-click-rate" class="text-base font-bold text-clay-600 mt-1">24.2%</p>
          </div>
        </div>

        <div class="p-3.5 bg-white border border-walnut-900/15 shadow-xs space-y-2">
