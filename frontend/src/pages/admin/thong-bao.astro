              placeholder="Chào quý khách, chúng tôi trân trọng gửi tới bạn chương trình tri ân đặc quyền..." 
              class="mt-1.5 w-full border border-walnut-900/20 bg-white p-3 text-xs outline-none focus:border-clay-600 leading-relaxed shadow-xs"
            ></textarea>
            <p class="text-[10px] text-walnut-800/60 mt-1">Hệ thống sẽ tự động đóng gói nội dung vào khung template HTML thương hiệu sang trọng khi gửi.</p>
          </div>
        </div>

        <!-- MODAL FOOTER (STICKY BOTTOM) -->
        <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex items-center justify-end gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
          <button 
            type="button" 
            id="btn-cancel-create-modal" 
            class="border border-walnut-900/20 px-5 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer"
          >
            Hủy
