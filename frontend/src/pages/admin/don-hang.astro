---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatVnd } from '../../data/products';

interface OrderItem {
  name: string;
  price: number;
  qty: number;
  sku: string;
}

interface OrderRecord {
  id: string;
  orderCode: string;
  customerName: string;
  phone: string;
  email: string;
  address: string;
  province: string;
  district: string;
  note: string;
  shippingMethod: 'standard' | 'express';
  shippingMethodLabel: string;
  shippingFee: number;
  paymentMethod: 'cod' | 'bank';
  paymentMethodLabel: string;
  paymentStatus: 'unpaid' | 'paid';
  orderStatus: 'cho-xac-nhan' | 'dang-chuan-bi' | 'dang-giao' | 'hoan-thanh' | 'da-huy';
  trackingCode?: string;
  carrier?: string;
  createdAt: string;
  items: OrderItem[];
  subtotal: number;
  total: number;
}

const mockOrders: OrderRecord[] = [
  {
    id: '1',
    orderCode: 'NT-202610-001',
    customerName: 'Nguyễn Văn Hùng',
    phone: '0912345678',
    email: 'hung.nguyen@gmail.com',
    address: 'Số 45 Đường Lê Lợi, Phường Bến Nghé',
    district: 'Quận 1',
    province: 'TP. Hồ Chí Minh',
    note: 'Giao trong giờ hành chính giúp tôi.',
    shippingMethod: 'express',
    shippingMethodLabel: 'Giao hàng hỏa tốc (24h)',
    shippingFee: 70000,
    paymentMethod: 'cod',
    paymentMethodLabel: 'Thanh toán khi nhận hàng (COD)',
    paymentStatus: 'unpaid',
    orderStatus: 'dang-giao',
    trackingCode: 'VAB-SHIP-88912',
    carrier: 'Giao Hàng Tiết Kiệm (GHTK)',
    createdAt: '08/10/2026 09:30',
    subtotal: 58900000,
    total: 58970000,
    items: [
      { name: 'Sofa da Ý Milano', sku: 'SKU-SOFA-MILANO', price: 58900000, qty: 1 }
    ]
  },
  {
    id: '2',
    orderCode: 'NT-202610-002',
    customerName: 'Trần Thị Thu Trang',
    phone: '0988776655',
    email: 'thutrang.tran@gmail.com',
    address: 'Toà S2.05 Vinhomes Ocean Park, Đa Tốn',
    district: 'Gia Lâm',
    province: 'Hà Nội',
    note: 'Gọi trước khi giao 30 phút.',
    shippingMethod: 'standard',
    shippingMethodLabel: 'Giao hàng tiêu chuẩn (3-5 ngày)',
    shippingFee: 35000,
    paymentMethod: 'bank',
    paymentMethodLabel: 'Chuyển khoản ngân hàng',
    paymentStatus: 'paid',
    orderStatus: 'cho-xac-nhan',
    createdAt: '08/10/2026 14:15',
    subtotal: 36700000,
    total: 36735000,
    items: [
      { name: 'Bàn ăn đá marble Carrara', sku: 'SKU-BAN-MARBLE', price: 32500000, qty: 1 },
      { name: 'Ghế ăn da bọc Ý', sku: 'SKU-GHE-DA-Y', price: 4200000, qty: 1 }
    ]
  },
  {
    id: '3',
    orderCode: 'NT-202610-003',
    customerName: 'Phạm Đức Anh',
    phone: '0933112233',
    email: 'ducanh.pham@gmail.com',
    address: 'Khu đô thị Hòa Xuân, Cẩm Lệ',
    district: 'Cẩm Lệ',
    province: 'Đà Nẵng',
    note: '',
    shippingMethod: 'standard',
    shippingMethodLabel: 'Giao hàng tiêu chuẩn (3-5 ngày)',
    shippingFee: 35000,
    paymentMethod: 'bank',
    paymentMethodLabel: 'Chuyển khoản ngân hàng',
    paymentStatus: 'paid',
    orderStatus: 'hoan-thanh',
    trackingCode: 'VT-SHIP-11029',
    carrier: 'Viettel Post',
    createdAt: '07/10/2026 10:00',
    subtotal: 26500000,
    total: 26535000,
    items: [
      { name: 'Sofa vải linen Oslo', sku: 'SKU-SOFA-OSLO', price: 26500000, qty: 1 }
    ]
  },
  {
    id: '4',
    orderCode: 'NT-202610-004',
    customerName: 'Lê Hoàng Nam',
    phone: '0909456789',
    email: 'hoangnam.le@gmail.com',
    address: '128 Đường Nguyễn Văn Cừ, An Khánh',
    district: 'Ninh Kiều',
    province: 'Cần Thơ',
    note: 'Kiểm tra hàng trước khi nhận.',
    shippingMethod: 'standard',
    shippingMethodLabel: 'Giao hàng tiêu chuẩn (3-5 ngày)',
    shippingFee: 35000,
    paymentMethod: 'cod',
    paymentMethodLabel: 'Thanh toán khi nhận hàng (COD)',
    paymentStatus: 'unpaid',
    orderStatus: 'dang-chuan-bi',
    createdAt: '08/10/2026 16:45',
    subtotal: 9800000,
