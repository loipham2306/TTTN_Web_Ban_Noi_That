---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatVnd } from '../../data/products';

interface OrderItem {
  name: string;
  price: number;
  qty: number;
  sku: string;
}

interface OrderRecord {
  id: string;
  orderCode: string;
  customerName: string;
  phone: string;
  email: string;
  address: string;
  province: string;
  district: string;
  note: string;
  shippingMethod: 'standard' | 'express';
  shippingMethodLabel: string;
  shippingFee: number;
  paymentMethod: 'cod' | 'bank';
  paymentMethodLabel: string;
  paymentStatus: 'unpaid' | 'paid';
  cancelReason?: string | null;
  orderStatus: 'cho-xac-nhan' | 'dang-chuan-bi' | 'dang-giao' | 'hoan-thanh' | 'da-huy';
  trackingCode?: string;
  carrier?: string;
  createdAt: string;
  items: OrderItem[];
  subtotal: number;
  total: number;
}

const STATUS_BADGE: Record<string, { label: string; cls: string }> = {
  'cho-xac-nhan': { label: 'Chờ xác nhận', cls: 'bg-amber-100 text-amber-900 border border-amber-300' },
  'dang-chuan-bi': { label: 'Đang chuẩn bị', cls: 'bg-blue-100 text-blue-900 border border-blue-300' },
  'dang-giao': { label: 'Đang giao hàng', cls: 'bg-purple-100 text-purple-900 border border-purple-300' },
  'hoan-thanh': { label: 'Đã hoàn thành', cls: 'bg-emerald-100 text-emerald-900 border border-emerald-300' },
  'da-huy': { label: 'Đã hủy', cls: 'bg-red-100 text-red-900 border border-red-300' },
};

// Live orders from MySQL backend
let liveOrders: OrderRecord[] = [];
try {
  const res = await fetch('http://localhost:4000/api/orders', {
    signal: AbortSignal.timeout(2000),
  });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data) && json.data.length > 0) {
      liveOrders = json.data.map((o: any) => ({
        id: String(o.id),
        orderCode: o.orderCode,
        customerName: o.customerName || 'Khách vãng lai',
        phone: o.phone || '',
        email: o.email || '',
        address: o.shippingAddress || '',
        province: '',
        district: '',
        note: o.customerNote || '',
        shippingMethod: 'standard',
        shippingMethodLabel: 'Giao hàng tiêu chuẩn',
        shippingFee: o.shippingFee || 0,
        paymentMethod: o.paymentMethod || 'cod',
        paymentMethodLabel: (() => {
          if (o.paymentMethod === 'sepay') return 'VietQR Chuyển khoản (SePay)';
          if (o.paymentMethod === 'bank' || o.paymentMethod === 'bank_transfer') return 'Chuyển khoản ngân hàng';
          return 'Thanh toán COD';
        })(),
        paymentStatus: o.paymentStatus === 'paid' ? 'paid' : 'unpaid',
        cancelReason: o.cancelReason || null,
        orderStatus: (() => {
          if (o.orderStatus === 'completed' || o.orderStatus === 'hoan-thanh') return 'hoan-thanh';
          if (o.orderStatus === 'confirmed' || o.orderStatus === 'dang-chuan-bi') return 'dang-chuan-bi';
          if (o.orderStatus === 'shipping' || o.orderStatus === 'dang-giao') return 'dang-giao';
          if (o.orderStatus === 'cancelled' || o.orderStatus === 'da-huy') return 'da-huy';
          return 'cho-xac-nhan';
        })(),
        createdAt: new Date(o.createdAt).toLocaleString('vi-VN'),
        items: Array.isArray(o.items) ? o.items.map((it: any) => ({
          name: it.name,
          sku: it.sku || 'SKU',
          price: it.price,
          qty: it.qty,
        })) : [],
        subtotal: o.subtotal || 0,
        total: o.total || 0,
      }));
    }
  }
} catch {
  // Backend unavailable - empty live orders
}

const displayOrders: OrderRecord[] = liveOrders;

const totalRevenue = displayOrders
  .filter((o) => o.orderStatus !== 'da-huy')
  .reduce((acc, curr) => acc + curr.total, 0);
---

<AdminLayout title="Quản trị · Đơn hàng & Vận chuyển | Nội Thất">

  <!-- PAGE HEADER -->
  <header class="flex flex-wrap items-end justify-between gap-4 border-b border-walnut-900/10 pb-6">
    <div>
      <p class="text-[11px] uppercase tracking-[0.25em] text-walnut-800">Bảng điều khiển</p>
      <h1 class="mt-2 font-display text-2xl tracking-tight sm:text-3xl text-walnut-900">Quản Lý Đơn Hàng & Vận Chuyển</h1>
      <p class="mt-1 text-sm text-walnut-800">Theo dõi đơn đặt mua, phân loại phương thức ship và cập nhật tiến độ giao hàng.</p>
    </div>

    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-2 border border-walnut-900/20 bg-sand-50 px-4 py-2.5 text-xs text-walnut-900">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Bộ vận đơn nội bộ: Hoạt động</span>
      </span>
    </div>
  </header>

  <!-- STATS -->
  <section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Tổng doanh thu</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-walnut-900">{formatVnd(totalRevenue)}</p>
      <p class="mt-1 text-xs text-walnut-800/70">Tính trên các đơn hợp lệ</p>
    </div>
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Tổng số đơn</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-walnut-900">{displayOrders.length} đơn</p>
      <p class="mt-1 text-xs text-walnut-800/70">Trong tuần hiện tại</p>
    </div>
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Đơn chờ xử lý</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-amber-700">
        {displayOrders.filter((o) => o.orderStatus === 'cho-xac-nhan' || o.orderStatus === 'dang-chuan-bi').length} đơn
      </p>
      <p class="mt-1 text-xs text-walnut-800/70">Cần xác nhận & đóng gói</p>
    </div>
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Đang vận chuyển (Ship)</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-purple-700">
        {displayOrders.filter((o) => o.orderStatus === 'dang-giao').length} đơn
      </p>
      <p class="mt-1 text-xs text-walnut-800/70">Shipper đang giao hàng</p>
    </div>
  </section>

  <!-- FILTER & SEARCH -->
  <section class="mt-8">
    <div class="flex flex-wrap items-center gap-3 bg-sand-50 p-4 border border-walnut-900/10">
      <div class="relative w-full max-w-xs">
        <input
          id="order-search"
          type="search"
          placeholder="Tìm theo mã đơn hoặc tên khách..."
          class="w-full border border-walnut-900/20 bg-sand-100/50 pl-9 pr-4 py-2.5 text-sm outline-none transition-colors placeholder:text-walnut-800/50 focus:border-clay-600 focus:bg-sand-50"
        />
        <svg class="absolute left-3 top-3 h-4 w-4 text-walnut-800/50 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <select
        id="order-status-filter"
        class="border border-walnut-900/20 bg-sand-50 px-3 py-2.5 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600 cursor-pointer"
      >
        <option value="">Tất cả trạng thái</option>
        <option value="cho-xac-nhan">Chờ xác nhận</option>
        <option value="dang-chuan-bi">Đang chuẩn bị</option>
        <option value="dang-giao">Đang giao hàng</option>
        <option value="hoan-thanh">Đã hoàn thành</option>
        <option value="da-huy">Đã hủy</option>
      </select>

      <select
        id="order-ship-filter"
        class="border border-walnut-900/20 bg-sand-50 px-3 py-2.5 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600 cursor-pointer"
      >
        <option value="">Tất cả phương thức ship</option>
        <option value="standard">Tiêu chuẩn (3-5 ngày)</option>
        <option value="express">Hỏa tốc (24h)</option>
      </select>

      <select
        id="order-pay-filter"
        class="border border-walnut-900/20 bg-sand-50 px-3 py-2.5 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600 cursor-pointer"
      >
        <option value="">Tất cả thanh toán</option>
        <option value="paid">Đã thanh toán</option>
        <option value="unpaid">Chưa thanh toán</option>
        <option value="bank">Chuyển khoản / VietQR</option>
        <option value="cod">Thanh toán COD</option>
      </select>

      <button
        type="button"
        id="btn-order-reset"
        class="text-xs uppercase tracking-[0.18em] text-walnut-800 underline underline-offset-4 transition-colors hover:text-clay-600 cursor-pointer"
      >
        Xóa lọc
      </button>

      <p id="order-count-label" class="ml-auto text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium"></p>
    </div>

    <!-- TABLE -->
    <div class="mt-4 overflow-x-auto border border-walnut-900/10 bg-sand-50 shadow-sm">
      <table class="w-full min-w-[55rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-walnut-900/15 bg-sand-100/50 text-[11px] uppercase tracking-[0.18em] text-walnut-800">
            <th scope="col" class="px-4 py-3.5 font-medium">Mã đơn hàng</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Khách hàng</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Gói Vận chuyển (Ship)</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Thanh toán</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Tổng tiền</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Trạng thái</th>
            <th scope="col" class="px-4 py-3.5 font-medium text-right">Chi tiết</th>
          </tr>
        </thead>

        <tbody id="order-table-body">
          {displayOrders.length === 0 ? (
            <tr>
              <td colspan="7" class="px-4 py-12 text-center text-sm text-walnut-800">
                Chưa có đơn hàng nào trong hệ thống.
              </td>
            </tr>
          ) : (
            displayOrders.map((order) => (
            <tr
              data-order-row
              data-id={order.id}
              data-code={order.orderCode}
              data-name={order.customerName}
              data-phone={order.phone}
              data-email={order.email}
              data-address={order.address}
              data-district={order.district}
              data-province={order.province}
              data-note={order.note}
              data-ship-method={order.shippingMethod}
              data-ship-label={order.shippingMethodLabel}
              data-ship-fee={order.shippingFee}
              data-pay-method={order.paymentMethodLabel}
              data-pay-status={order.paymentStatus}
              data-raw-pay-method={order.paymentMethod}
              data-cancel-reason={order.cancelReason || ""}
              data-status={order.orderStatus}
              data-carrier={order.carrier ?? 'Đang điều phối'}
              data-tracking={order.trackingCode ?? 'Chưa tạo'}
              data-time={order.createdAt}
              data-total={order.total}
              data-subtotal={order.subtotal}
              data-items={JSON.stringify(order.items)}
              class="border-b border-walnut-900/10 last:border-b-0 hover:bg-sand-100/30 transition-colors"
            >
              <td class="px-4 py-3.5 align-middle">
                <span class="font-medium text-sm text-walnut-900 block">{order.orderCode}</span>
                <span class="text-[11px] text-walnut-800/60 block">{order.createdAt}</span>
              </td>
              <td class="px-4 py-3.5 align-middle">
                <p class="text-sm font-medium text-walnut-900">{order.customerName}</p>
                <p class="text-xs text-walnut-800/70">{order.phone} · {order.province}</p>
              </td>
              <td class="px-4 py-3.5 align-middle">
                <p class="text-xs text-walnut-900 font-medium">{order.shippingMethodLabel}</p>
                <p class="text-[11px] text-walnut-800/70">Phí ship: {formatVnd(order.shippingFee)}</p>
              </td>
              <td class="px-4 py-3.5 align-middle">
                <p class="text-xs text-walnut-900 font-medium">{order.paymentMethodLabel}</p>
                <span class={`inline-block px-1.5 py-0.5 text-[9px] uppercase tracking-[0.1em] rounded ${
                  order.paymentStatus === 'paid' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'
                }`}>
                  {order.paymentStatus === 'paid' ? 'Đã thanh toán' : 'Chưa thanh toán'}
                </span>
              </td>
              <td class="whitespace-nowrap px-4 py-3.5 align-middle text-sm font-semibold text-walnut-900">
                {formatVnd(order.total)}
              </td>
              <td class="px-4 py-3.5 align-middle">
                <span data-status-badge class={`inline-block px-2.5 py-1 text-[10px] uppercase tracking-[0.15em] rounded ${STATUS_BADGE[order.orderStatus].cls}`}>
                  {STATUS_BADGE[order.orderStatus].label}
                </span>
                {order.orderStatus === 'da-huy' && order.cancelReason && (
                  <p class="cancel-reason-label text-[11px] text-red-600 font-medium mt-1 leading-tight max-w-[170px]" title={order.cancelReason}>
                    <span class="font-bold">Lý do:</span> {order.cancelReason}
                  </p>
                )}
              </td>
              <td class="px-4 py-3.5 align-middle text-right">
                <button
                  type="button"
                  data-btn-view-order
                  class="bg-walnut-900 text-sand-50 px-3.5 py-1.5 text-xs uppercase tracking-[0.15em] hover:bg-clay-600 transition-colors cursor-pointer"
                >
                  Xem & Cập nhật
                </button>
              </td>
            </tr>
          )))}
        </tbody>
      </table>
    </div>

    <p id="order-empty-label" class="mt-8 hidden text-center text-sm text-walnut-800 py-10 bg-sand-50 border border-walnut-900/10">
      Không tìm thấy đơn hàng nào khớp với tìm kiếm.
    </p>
  </section>

  <!-- MODAL: CHI TIẾT ĐƠN HÀNG & CẬP NHẬT SHIP -->
  <div id="order-detail-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/30 w-full max-w-3xl shadow-2xl rounded-none relative my-4 max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- HEADER WALNUT XANH ĐẬM VỚI DẢI VÀNG CHAMPAGNE -->
      <div class="relative bg-[#173524] px-6 py-5 sm:px-8 border-b border-[#D8B670]/30 shrink-0">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#D8B670]/25 to-[#D8B670]/5 border border-[#D8B670]/40 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 text-[#E6CA85]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.22em] text-[#D8B670] font-semibold">CHI TIẾT VẬN ĐƠN & ĐƠN HÀNG</p>
              <h2 id="modal-order-code" class="text-lg sm:text-xl font-display font-bold text-white tracking-wide mt-0.5">NT-202610-001</h2>
            </div>
          </div>

          <button 
            type="button" 
            id="btn-close-order-modal" 
            class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-sand-200 hover:text-white flex items-center justify-center transition-all hover:rotate-90 cursor-pointer border border-white/10"
            title="Đóng cửa sổ"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- MODAL BODY (SCROLLABLE) -->
      <div class="p-6 sm:p-8 space-y-6 overflow-y-auto flex-1 bg-[#FAF8F5]">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- CUSTOMER & SHIPPING INFO -->
          <div class="bg-white p-4 border border-walnut-900/15 shadow-xs text-xs">
            <p class="font-bold text-walnut-900 uppercase tracking-[0.15em] mb-2.5 border-b border-walnut-900/10 pb-2 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#173524]"></span>
              Thông tin nhận hàng
            </p>
            <p class="py-1"><span class="text-walnut-800/70">Người nhận:</span> <strong id="modal-cust-name" class="text-walnut-900 font-semibold"></strong></p>
            <p class="py-1"><span class="text-walnut-800/70">Số điện thoại:</span> <strong id="modal-cust-phone" class="text-walnut-900 font-semibold"></strong></p>
            <p class="py-1"><span class="text-walnut-800/70">Email:</span> <span id="modal-cust-email" class="text-walnut-900"></span></p>
            <p class="py-1"><span class="text-walnut-800/70">Địa chỉ:</span> <span id="modal-cust-address" class="text-walnut-900"></span></p>
            <p class="py-1"><span class="text-walnut-800/70">Ghi chú:</span> <span id="modal-cust-note" class="italic text-walnut-800"></span></p>
          </div>

          <!-- SHIPPING STATUS & CARRIER & PAYMENT -->
          <div class="bg-white p-4 border border-walnut-900/15 shadow-xs text-xs flex flex-col justify-between">
            <div>
              <p class="font-bold text-walnut-900 uppercase tracking-[0.15em] mb-2.5 border-b border-walnut-900/10 pb-2 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#D8B670]"></span>
                Trạng thái vận đơn & Thanh toán
              </p>
              <p class="py-1"><span class="text-walnut-800/70">Gói vận chuyển:</span> <strong id="modal-ship-method" class="text-walnut-900 font-semibold"></strong></p>
              <p class="py-1"><span class="text-walnut-800/70">Cước phí ship:</span> <span id="modal-ship-fee" class="text-walnut-900 font-semibold"></span></p>
              <p class="py-1"><span class="text-walnut-800/70">Đơn vị vận chuyển:</span> <span id="modal-carrier" class="text-walnut-900 font-semibold"></span></p>
              <p class="py-1"><span class="text-walnut-800/70">Mã vận đơn:</span> <span id="modal-tracking" class="font-mono bg-sand-200/80 px-2 py-0.5 rounded text-walnut-900 border border-walnut-900/10"></span></p>
              <p class="py-1"><span class="text-walnut-800/70">Hình thức thanh toán:</span> <strong id="modal-pay-method-name" class="text-walnut-900 font-semibold"></strong></p>
              <p class="py-1 flex items-center justify-between">
                <span class="text-walnut-800/70">Tình trạng thanh toán:</span>
                <span id="modal-pay-status-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider"></span>
              </p>
            </div>

            <div class="mt-3 pt-3 border-t border-walnut-900/10 space-y-2.5">
              <!-- NÚT XÁC NHẬN ĐÃ THANH TOÁN (Chỉ hiện khi là đơn chuyển khoản và chưa thanh toán) -->
              <div id="modal-pay-action-wrapper" class="hidden">
                <button
                  type="button"
                  id="btn-admin-confirm-paid"
                  class="w-full bg-emerald-700 hover:bg-emerald-800 active:scale-98 text-white px-3.5 py-2.5 text-xs font-bold uppercase tracking-wider rounded shadow transition-all cursor-pointer flex items-center justify-center gap-2"
                >
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>💳 Xác nhận đã nhận tiền chuyển khoản</span>
                </button>
                <p class="text-[10px] text-amber-800 mt-1 italic leading-tight text-center">
                  * Bấm khi tiền đã vào tài khoản. Đơn sẽ chuyển sang "Đang chuẩn bị" và tự gửi email cho khách.
                </p>
              </div>

              <div>
                <label for="update-order-status" class="block font-bold uppercase tracking-[0.15em] text-walnut-900 mb-1">Cập nhật tiến độ đơn:</label>
                <select id="update-order-status" class="w-full border border-walnut-900/25 bg-sand-50 px-3 py-2 text-xs outline-none focus:border-clay-600 cursor-pointer font-semibold text-walnut-900">
                  <option value="cho-xac-nhan">Chờ xác nhận</option>
                  <option value="dang-chuan-bi">Đang chuẩn bị hàng</option>
                  <option value="dang-giao">Đang giao hàng (Shipper)</option>
                  <option value="hoan-thanh">Đã hoàn thành</option>
                  <option value="da-huy">Đã hủy đơn</option>
                </select>
              </div>

              <div>
                <label for="update-payment-status" class="block font-bold uppercase tracking-[0.15em] text-walnut-900 mb-1">Tình trạng thanh toán:</label>
                <select id="update-payment-status" class="w-full border border-walnut-900/25 bg-sand-50 px-3 py-2 text-xs outline-none focus:border-clay-600 cursor-pointer font-semibold text-walnut-900">
                  <option value="unpaid">Chưa thanh toán</option>
                  <option value="paid">Đã thanh toán (Hoàn tất)</option>
                </select>
              </div>

              <!-- Lý do hủy đơn nếu đơn bị hủy -->
              <div id="modal-cancel-reason-box" class="hidden p-2.5 bg-red-50 border border-red-200 text-red-800 text-xs">
                <p class="font-bold text-[10px] uppercase text-red-900">⚠️ Lý do hủy đơn:</p>
                <p id="modal-cancel-reason-text" class="mt-0.5 font-medium"></p>
              </div>
            </div>
          </div>
        </div>

        <!-- ITEMS LIST -->
        <div>
          <p class="text-xs uppercase tracking-[0.15em] font-bold text-walnut-900 mb-2.5">Các món hàng đã mua</p>
          <div class="border border-walnut-900/15 bg-white shadow-xs overflow-x-auto">
            <table class="w-full text-xs text-left">
              <thead>
                <tr class="border-b border-walnut-900/15 bg-sand-100/60 text-[10px] uppercase tracking-[0.15em] text-walnut-800">
                  <th class="p-3">Sản phẩm</th>
                  <th class="p-3">Mã SKU</th>
                  <th class="p-3 text-right">Đơn giá</th>
                  <th class="p-3 text-center">SL</th>
                  <th class="p-3 text-right">Thành tiền</th>
                </tr>
              </thead>
              <tbody id="modal-items-tbody"></tbody>
            </table>
          </div>

          <div class="mt-4 flex flex-col items-end gap-1.5 text-xs text-walnut-800 border-t border-walnut-900/10 pt-3">
            <p>Tiền hàng: <span id="modal-subtotal" class="font-semibold text-walnut-900"></span></p>
            <p>Phí ship: <span id="modal-fee" class="font-semibold text-walnut-900"></span></p>
            <p class="text-sm font-bold text-walnut-900">Tổng thanh toán: <span id="modal-total" class="text-clay-600 font-display text-base font-bold"></span></p>
          </div>
        </div>
      </div>

      <!-- MODAL FOOTER (STICKY BOTTOM) -->
      <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex flex-wrap items-center justify-between gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
        <button 
          type="button" 
          id="btn-print-order" 
          class="inline-flex items-center gap-2 border border-walnut-900/30 bg-sand-50 px-4 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-900 hover:bg-sand-200 transition-colors cursor-pointer"
          title="In phiếu xuất kho và giao hàng"
        >
          <svg class="h-4 w-4 text-walnut-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>In Phiếu Giao Hàng</span>
        </button>

        <div class="flex items-center gap-3">
          <button 
            type="button" 
            id="btn-cancel-order-modal" 
            class="border border-walnut-900/20 px-5 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer"
          >
            Đóng
          </button>
          <button 
            type="button" 
            id="btn-save-order-status" 
            class="bg-gradient-to-r from-[#D8B670] via-[#E2C37E] to-[#C49E52] px-6 py-2.5 text-xs uppercase tracking-[0.18em] font-bold text-[#173524] hover:from-[#C49E52] hover:to-[#B58F43] hover:text-white shadow-md transition-all active:scale-95 cursor-pointer border border-[#E0C582]/50"
          >
            Lưu cập nhật
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- TOAST -->
  <div id="order-toast" class="fixed bottom-6 right-6 z-50 hidden bg-walnut-900 text-sand-50 px-5 py-3 rounded shadow-lg text-xs uppercase tracking-[0.15em] flex items-center gap-3">
    <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="order-toast-msg">Đã cập nhật trạng thái đơn hàng!</span>
  </div>

</AdminLayout>

<script>
  const searchInput = document.getElementById('order-search') as HTMLInputElement;
  const statusFilter = document.getElementById('order-status-filter') as HTMLSelectElement;
  const shipFilter = document.getElementById('order-ship-filter') as HTMLSelectElement;
  const payFilter = document.getElementById('order-pay-filter') as HTMLSelectElement;
  const resetBtn = document.getElementById('btn-order-reset') as HTMLButtonElement;
  const countLabel = document.getElementById('order-count-label') as HTMLElement;
  const emptyLabel = document.getElementById('order-empty-label') as HTMLElement;
  const tableBody = document.getElementById('order-table-body') as HTMLElement;

  // Modal
  const modal = document.getElementById('order-detail-modal') as HTMLElement;
  const btnClose = document.getElementById('btn-close-order-modal') as HTMLButtonElement;
  const btnCancel = document.getElementById('btn-cancel-order-modal') as HTMLButtonElement;
  const btnSaveStatus = document.getElementById('btn-save-order-status') as HTMLButtonElement;
  const statusSelect = document.getElementById('update-order-status') as HTMLSelectElement;
  const paymentStatusSelect = document.getElementById('update-payment-status') as HTMLSelectElement;

  const toast = document.getElementById('order-toast') as HTMLElement;
  const toastMsg = document.getElementById('order-toast-msg') as HTMLElement;

  const showToast = (msg: string) => {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 3000);
  };

  const formatVndClient = (val: number) => val.toLocaleString('vi-VN') + ' ₫';

  let currentActiveRow: HTMLTableRowElement | null = null;

  if (tableBody) {
    const rows = Array.from(tableBody.querySelectorAll<HTMLTableRowElement>('[data-order-row]'));

    const render = () => {
      const q = (searchInput?.value ?? '').trim().toLowerCase();
      const st = statusFilter?.value ?? '';
      const sh = shipFilter?.value ?? '';
      const pay = payFilter?.value ?? '';

      let visibleCount = 0;

      rows.forEach((row) => {
        const code = (row.dataset.code ?? '').toLowerCase();
        const name = (row.dataset.name ?? '').toLowerCase();
        const rowSt = row.dataset.status ?? '';
        const rowSh = row.dataset.shipMethod ?? '';
        const rowPay = row.dataset.payStatus ?? '';
        const rowRawPay = row.dataset.rawPayMethod ?? '';

        const matchQ = !q || code.includes(q) || name.includes(q);
        const matchSt = !st || rowSt === st;
        const matchSh = !sh || rowSh === sh;
        const matchPay = !pay ||
          (pay === 'paid' && rowPay === 'paid') ||
          (pay === 'unpaid' && rowPay !== 'paid') ||
          (pay === 'bank' && (rowRawPay === 'bank' || rowRawPay === 'sepay' || rowRawPay === 'bank_transfer')) ||
          (pay === 'cod' && rowRawPay === 'cod');

        if (matchQ && matchSt && matchSh && matchPay) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (countLabel) countLabel.textContent = `${visibleCount} đơn hàng`;
      if (emptyLabel) emptyLabel.classList.toggle('hidden', visibleCount > 0);
    };

    searchInput?.addEventListener('input', render);
    statusFilter?.addEventListener('change', render);
    shipFilter?.addEventListener('change', render);
    payFilter?.addEventListener('change', render);
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (statusFilter) statusFilter.value = '';
      if (shipFilter) shipFilter.value = '';
      if (payFilter) payFilter.value = '';
      render();
    });

    // OPEN ORDER DETAIL
    tableBody.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-btn-view-order]');
      if (!btn) return;
      const row = btn.closest<HTMLTableRowElement>('[data-order-row]');
      if (!row) return;

      currentActiveRow = row;

      // Cập nhật thông tin thanh toán & hiển thị nút xác nhận
      const rawPayMethod = row.dataset.rawPayMethod || 'cod';
      const payStatus = row.dataset.payStatus || 'unpaid';
      const orderStatus = row.dataset.status || 'cho-xac-nhan';
      const cancelReason = row.dataset.cancelReason || '';

      const setVal = (id: string, val: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      setVal('modal-order-code', row.dataset.code || '');
      setVal('modal-cust-name', row.dataset.name || '');
      setVal('modal-cust-phone', row.dataset.phone || '');
      setVal('modal-cust-email', row.dataset.email || 'Chưa cập nhật');
      setVal('modal-cust-address', `${row.dataset.address || ''}, ${row.dataset.district || ''}, ${row.dataset.province || ''}`);
      setVal('modal-cust-note', row.dataset.note || 'Không có');

      setVal('modal-ship-method', row.dataset.shipLabel || '');
      setVal('modal-ship-fee', formatVndClient(Number(row.dataset.shipFee) || 0));
      setVal('modal-carrier', row.dataset.carrier || 'Đang điều phối');
      setVal('modal-tracking', row.dataset.tracking || 'Chưa tạo');

      if (statusSelect) {
        statusSelect.value = orderStatus;
      }
      if (paymentStatusSelect) {
        paymentStatusSelect.value = (payStatus === 'paid') ? 'paid' : 'unpaid';
      }

      // Items
      try {
        const items = JSON.parse(row.dataset.items || '[]');
        const tbody = document.getElementById('modal-items-tbody');
        if (tbody) {
          tbody.innerHTML = items.map((it: any) => `
            <tr class="border-b border-walnut-900/10">
              <td class="p-3 font-medium text-walnut-900">${it.name}</td>
              <td class="p-3 font-mono text-[11px] text-walnut-800/70">${it.sku}</td>
              <td class="p-3 text-right">${formatVndClient(it.price)}</td>
              <td class="p-3 text-center">${it.qty}</td>
              <td class="p-3 text-right font-medium">${formatVndClient(it.price * it.qty)}</td>
            </tr>
          `).join('');
        }
      } catch (parseErr) {
        console.warn('Lỗi đọc items đơn hàng:', parseErr);
      }

      setVal('modal-subtotal', formatVndClient(Number(row.dataset.subtotal) || 0));
      setVal('modal-fee', formatVndClient(Number(row.dataset.shipFee) || 0));
      setVal('modal-total', formatVndClient(Number(row.dataset.total) || 0));

      const payMethodNameEl = document.getElementById('modal-pay-method-name');
      const payBadgeEl = document.getElementById('modal-pay-status-badge');
      const payActionWrapper = document.getElementById('modal-pay-action-wrapper');
      const cancelBox = document.getElementById('modal-cancel-reason-box');
      const cancelText = document.getElementById('modal-cancel-reason-text');

      const isBankOrder = (rawPayMethod === 'bank' || rawPayMethod === 'sepay' || rawPayMethod === 'bank_transfer');

      if (payMethodNameEl) {
        payMethodNameEl.textContent = isBankOrder ? 'VietQR Chuyển khoản (SePay)' : 'Thanh toán COD khi nhận hàng';
      }

      if (payBadgeEl) {
        if (payStatus === 'paid') {
          payBadgeEl.textContent = 'ĐÃ THANH TOÁN';
          payBadgeEl.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300';
        } else {
          payBadgeEl.textContent = 'CHƯA THANH TOÁN';
          payBadgeEl.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300';
        }
      }

      if (payActionWrapper) {
        if (isBankOrder && payStatus !== 'paid' && orderStatus !== 'da-huy') {
          payActionWrapper.classList.remove('hidden');
        } else {
          payActionWrapper.classList.add('hidden');
        }
      }

      if (cancelBox && cancelText) {
        if (orderStatus === 'da-huy' && cancelReason) {
          cancelBox.classList.remove('hidden');
          cancelText.textContent = cancelReason;
        } else {
          cancelBox.classList.add('hidden');
          cancelText.textContent = '';
        }
      }

      modal.classList.remove('hidden');
    });

    const closeModal = () => modal.classList.add('hidden');
    btnClose?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);

    // 1. IN PHIẾU XUẤT KHO KIÊM GIAO HÀNG
    const btnPrint = document.getElementById('btn-print-order');
    btnPrint?.addEventListener('click', () => {
      if (!currentActiveRow) return;
      const code = currentActiveRow.dataset.code || '';
      const name = currentActiveRow.dataset.name || '';
      const phone = currentActiveRow.dataset.phone || '';
      const address = [currentActiveRow.dataset.address, currentActiveRow.dataset.district, currentActiveRow.dataset.province].filter(Boolean).join(', ');
      const note = currentActiveRow.dataset.note || 'Không có';
      const items = JSON.parse(currentActiveRow.dataset.items || '[]');
      const subtotal = Number(currentActiveRow.dataset.subtotal || 0);
      const shipFee = Number(currentActiveRow.dataset.shipFee || 0);
      const total = Number(currentActiveRow.dataset.total || 0);
      const time = currentActiveRow.dataset.time || new Date().toLocaleDateString('vi-VN');

      const printWindow = window.open('', '_blank', 'width=800,height=900');
      if (!printWindow) {
        alert('Trình duyệt chặn popup. Vui lòng cấp quyền mở tab mới để in phiếu!');
        return;
      }

      const rowsHtml = items.map((it: any, idx: number) => `
        <tr>
          <td style="border: 1px solid #ccc; padding: 8px; text-align: center;">${idx + 1}</td>
          <td style="border: 1px solid #ccc; padding: 8px;"><b>${it.name}</b><br><small style="color: #666;">SKU: ${it.sku || 'N/A'}</small></td>
          <td style="border: 1px solid #ccc; padding: 8px; text-align: right;">${formatVndClient(it.price)}</td>
          <td style="border: 1px solid #ccc; padding: 8px; text-align: center;"><b>${it.qty}</b></td>
          <td style="border: 1px solid #ccc; padding: 8px; text-align: right; font-weight: bold;">${formatVndClient(it.price * it.qty)}</td>
        </tr>
      `).join('');

      printWindow.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <title>Phiếu Giao Hàng - ${code}</title>
          <style>
            body { font-family: "Times New Roman", Times, serif; padding: 30px; color: #111; line-height: 1.5; }
            .header { display: flex; justify-content: space-between; border-bottom: 2px solid #173524; padding-bottom: 12px; margin-bottom: 20px; }
            .brand { font-size: 24px; font-weight: bold; text-transform: uppercase; color: #173524; letter-spacing: 1px; }
            .title { text-align: center; font-size: 20px; font-weight: bold; text-transform: uppercase; margin: 25px 0 15px 0; color: #173524; }
            table { width: 100%; border-collapse: collapse; margin-top: 15px; }
            .signatures { display: flex; justify-content: space-between; margin-top: 45px; text-align: center; }
            .signatures div { width: 30%; }
            @media print { body { padding: 0; } }
          </style>
        </head>
        <body>
          <div class="header">
            <div>
              <div class="brand">KTUFA LUXURY FURNITURE</div>
              <div style="font-size: 13px; color: #444; margin-top: 4px;">Showroom: 123 Nam Kỳ Khởi Nghĩa, Quận 1, TP. Hồ Chí Minh</div>
              <div style="font-size: 13px; color: #444;">Hotline CSKH: 1900 8888 · Website: www.noithat.vn</div>
            </div>
            <div style="text-align: right; font-size: 14px;">
              <div><b>MÃ ĐƠN: ${code}</b></div>
              <div style="color: #666; font-size: 12px; margin-top: 4px;">Ngày tạo: ${time}</div>
            </div>
          </div>

          <div class="title">PHIẾU XUẤT KHO KIÊM GIAO HÀNG & LẮP ĐẶT</div>

          <div style="margin-bottom: 15px; font-size: 14px; background: #fafafa; padding: 12px; border: 1px solid #e5e5e5; border-radius: 4px;">
            <div><b>Khách hàng:</b> ${name}</div>
            <div><b>Điện thoại:</b> ${phone}</div>
            <div><b>Địa chỉ giao hàng:</b> ${address}</div>
            <div><b>Ghi chú đơn hàng:</b> ${note}</div>
          </div>

          <table>
            <thead>
              <tr style="background: #f4ede4;">
                <th style="border: 1px solid #ccc; padding: 8px; width: 40px;">STT</th>
                <th style="border: 1px solid #ccc; padding: 8px; text-align: left;">Tên sản phẩm</th>
                <th style="border: 1px solid #ccc; padding: 8px; text-align: right; width: 110px;">Đơn giá</th>
                <th style="border: 1px solid #ccc; padding: 8px; text-align: center; width: 50px;">SL</th>
                <th style="border: 1px solid #ccc; padding: 8px; text-align: right; width: 120px;">Thành tiền</th>
              </tr>
            </thead>
            <tbody>
              ${rowsHtml}
            </tbody>
            <tfoot>
              <tr>
                <td colspan="4" style="border: 1px solid #ccc; padding: 8px; text-align: right;">Tạm tính:</td>
                <td style="border: 1px solid #ccc; padding: 8px; text-align: right;">${formatVndClient(subtotal)}</td>
              </tr>
              <tr>
                <td colspan="4" style="border: 1px solid #ccc; padding: 8px; text-align: right;">Phí vận chuyển & lắp đặt:</td>
                <td style="border: 1px solid #ccc; padding: 8px; text-align: right;">${formatVndClient(shipFee)}</td>
              </tr>
              <tr style="font-size: 15px; background: #fff8eb;">
                <td colspan="4" style="border: 1px solid #ccc; padding: 8px; text-align: right; font-weight: bold; color: #173524;">TỔNG THANH TOÁN:</td>
                <td style="border: 1px solid #ccc; padding: 8px; text-align: right; font-weight: bold; color: #b88e28;">${formatVndClient(total)}</td>
              </tr>
            </tfoot>
          </table>

          <div class="signatures">
            <div>
              <b>Người lập phiếu</b><br><br><br><br>
              <i style="font-size: 12px; color: #666;">(Ký & ghi rõ họ tên)</i>
            </div>
            <div>
              <b>Nhân viên giao nhận</b><br><br><br><br>
              <i style="font-size: 12px; color: #666;">(Ký & ghi rõ họ tên)</i>
            </div>
            <div>
              <b>Khách hàng nhận hàng</b><br><br><br><br>
              <i style="font-size: 12px; color: #666;">(Đã kiểm tra nguyên vẹn & ký nhận)</i>
            </div>
          </div>
        </body>
        </html>
      `);
      printWindow.document.close();
      printWindow.focus();
      setTimeout(() => {
        printWindow.print();
      }, 500);
    });

    // 1.5. NÚT XÁC NHẬN ĐÃ NHẬN TIỀN CHUYỂN KHOẢN (CHO ĐƠN BANK / SEPAY)
    const btnConfirmPaid = document.getElementById('btn-admin-confirm-paid') as HTMLButtonElement;
    btnConfirmPaid?.addEventListener('click', async () => {
      if (!currentActiveRow) return;
      const orderId = currentActiveRow.dataset.id;
      const code = currentActiveRow.dataset.code;
      const total = currentActiveRow.dataset.total;
      if (!orderId) return;

      const confirmed = confirm(`Xác nhận quý khách đã chuyển khoản số tiền ${formatVndClient(Number(total) || 0)} cho đơn hàng #${code}?\n\nHệ thống sẽ cập nhật trạng thái "Đã thanh toán", chuyển đơn sang "Đang chuẩn bị hàng" và tự động gửi Email Xác nhận Thanh toán đến khách hàng.`);
      if (!confirmed) return;

      btnConfirmPaid.disabled = true;
      btnConfirmPaid.textContent = 'Đang xác nhận...';

      try {
        const token = localStorage.getItem('admin_token') || localStorage.getItem('auth_token');
        const res = await fetch(`http://localhost:4000/api/orders/${orderId}/status`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
          },
          body: JSON.stringify({ paymentStatus: 'paid', orderStatus: 'dang-chuan-bi' }),
        });
        const json = await res.json();

        if (json.success) {
          currentActiveRow.dataset.payStatus = 'paid';
          currentActiveRow.dataset.status = 'dang-chuan-bi';

          // Cập nhật badge cột thanh toán trong bảng
          const payTd = currentActiveRow.children[3];
          if (payTd) {
            const payBadgeSpan = payTd.querySelector('span');
            if (payBadgeSpan) {
              payBadgeSpan.textContent = 'Đã thanh toán';
              payBadgeSpan.className = 'inline-block px-1.5 py-0.5 text-[9px] uppercase tracking-[0.1em] rounded bg-emerald-100 text-emerald-800';
            }
          }

          // Cập nhật badge trạng thái đơn trong bảng
          const statusBadge = currentActiveRow.querySelector('[data-status-badge]') as HTMLElement;
          if (statusBadge) {
            statusBadge.textContent = 'Đang chuẩn bị';
            statusBadge.className = 'inline-block px-2.5 py-1 text-[10px] uppercase tracking-[0.15em] rounded bg-blue-100 text-blue-900 border border-blue-300';
          }

          // Cập nhật giao diện bên trong modal
          statusSelect.value = 'dang-chuan-bi';
          const payBadge = document.getElementById('modal-pay-status-badge');
          if (payBadge) {
            payBadge.textContent = 'ĐÃ THANH TOÁN';
            payBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300';
          }
          const payActionWrapper = document.getElementById('modal-pay-action-wrapper');
          if (payActionWrapper) payActionWrapper.classList.add('hidden');

          showToast(`Đã xác nhận thanh toán thành công cho đơn #${code}! Email đã được gửi.`);
          render();
        } else {
          showToast(json.message || 'Lỗi khi xác nhận thanh toán');
        }
      } catch (err) {
        showToast('Không thể kết nối máy chủ backend!');
      } finally {
        btnConfirmPaid.disabled = false;
        btnConfirmPaid.textContent = '💳 Xác nhận đã nhận tiền chuyển khoản';
      }
    });

    // 2. LƯU CẬP NHẬT TRẠNG THÁI VÀO CSDL QUA API
    btnSaveStatus?.addEventListener('click', async () => {
      if (!currentActiveRow) return;
      const newSt = statusSelect.value;
      const newPaySt = paymentStatusSelect ? paymentStatusSelect.value : (newSt === 'hoan-thanh' ? 'paid' : undefined);
      const orderId = currentActiveRow.dataset.id;
      if (!orderId) return;

      let cancelReason = '';
      if (newSt === 'da-huy') {
        const promptVal = prompt('Nhập lý do hủy đơn hàng (sẽ hiển thị minh bạch cho khách hàng):', 'Đơn hàng bị hủy theo yêu cầu.');
        if (promptVal === null) return;
        cancelReason = promptVal.trim() || 'Đơn hàng bị hủy theo yêu cầu.';
      }

      btnSaveStatus.disabled = true;
      btnSaveStatus.textContent = 'Đang lưu...';

      try {
        const token = localStorage.getItem('admin_token') || localStorage.getItem('auth_token');
        const res = await fetch(`http://localhost:4000/api/orders/${orderId}/status`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
          },
          body: JSON.stringify({
            orderStatus: newSt,
            paymentStatus: newPaySt,
            cancelReason: cancelReason || undefined,
          }),
        });
        const json = await res.json();

        if (json.success) {
          currentActiveRow.dataset.status = newSt;
          if (newSt === 'da-huy' && cancelReason) {
            currentActiveRow.dataset.cancelReason = cancelReason;
          }
          if (newPaySt) {
            currentActiveRow.dataset.payStatus = newPaySt;
            const payTd = currentActiveRow.children[3];
            if (payTd) {
              const payBadgeSpan = payTd.querySelector('span');
              if (payBadgeSpan) {
                if (newPaySt === 'paid') {
                  payBadgeSpan.textContent = 'Đã thanh toán';
                  payBadgeSpan.className = 'inline-block px-1.5 py-0.5 text-[9px] uppercase tracking-[0.1em] rounded bg-emerald-100 text-emerald-800';
                } else {
                  payBadgeSpan.textContent = 'Chưa thanh toán';
                  payBadgeSpan.className = 'inline-block px-1.5 py-0.5 text-[9px] uppercase tracking-[0.1em] rounded bg-amber-100 text-amber-800';
                }
              }
            }

            const modalPayBadge = document.getElementById('modal-pay-status-badge');
            if (modalPayBadge) {
              if (newPaySt === 'paid') {
                modalPayBadge.textContent = 'ĐÃ THANH TOÁN';
                modalPayBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300';
              } else {
                modalPayBadge.textContent = 'CHƯA THANH TOÁN';
                modalPayBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300';
              }
            }

            const modalPayActionWrapper = document.getElementById('modal-pay-action-wrapper');
            if (modalPayActionWrapper && newPaySt === 'paid') {
              modalPayActionWrapper.classList.add('hidden');
            }
          }

          const badge = currentActiveRow.querySelector('[data-status-badge]') as HTMLElement;
          if (badge) {
            const labels: Record<string, string> = {
              'cho-xac-nhan': 'Chờ xác nhận',
              'dang-chuan-bi': 'Đang chuẩn bị',
              'dang-giao': 'Đang giao hàng',
              'hoan-thanh': 'Đã hoàn thành',
              'da-huy': 'Đã hủy',
            };
            const clses: Record<string, string> = {
              'cho-xac-nhan': 'bg-amber-100 text-amber-900 border border-amber-300',
              'dang-chuan-bi': 'bg-blue-100 text-blue-900 border border-blue-300',
              'dang-giao': 'bg-purple-100 text-purple-900 border border-purple-300',
              'hoan-thanh': 'bg-emerald-100 text-emerald-900 border border-emerald-300',
              'da-huy': 'bg-red-100 text-red-900 border border-red-300',
            };
            badge.textContent = labels[newSt] || newSt;
            badge.className = `inline-block px-2.5 py-1 text-[10px] uppercase tracking-[0.15em] rounded ${clses[newSt]}`;
            const parentTd = badge.parentElement;
            if (parentTd) {
              let reasonP = parentTd.querySelector('.cancel-reason-label');
              if (newSt === 'da-huy' && cancelReason) {
                if (!reasonP) {
                  reasonP = document.createElement('p');
                  reasonP.className = 'cancel-reason-label text-[11px] text-red-600 font-medium mt-1 leading-tight max-w-[170px]';
                  parentTd.appendChild(reasonP);
                }
                reasonP.textContent = `Lý do: ${cancelReason}`;
              } else if (reasonP) {
                reasonP.remove();
              }
            }
          }

          showToast(`Đã cập nhật đơn ${currentActiveRow.dataset.code} thành công!`);
          closeModal();
          render();
        } else {
          showToast(json.message || 'Lỗi khi cập nhật trạng thái đơn');
        }
      } catch (err) {
        showToast('Không thể kết nối máy chủ backend!');
      } finally {
        btnSaveStatus.disabled = false;
        btnSaveStatus.textContent = 'Lưu cập nhật';
      }
    });

    render();
  }
</script>
