          sku: it.sku || 'SKU',
          price: it.price,
          qty: it.qty,
        })) : [],
        subtotal: o.subtotal || 0,
        total: o.total || 0,
      }));
    }
  }
} catch {
  // Backend unavailable - use mock
}

const displayOrders: OrderRecord[] = liveOrders.length > 0 ? [...liveOrders, ...mockOrders] : mockOrders;

const totalRevenue = displayOrders
  .filter((o) => o.orderStatus !== 'da-huy')
  .reduce((acc, curr) => acc + curr.total, 0);
