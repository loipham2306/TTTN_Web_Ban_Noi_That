---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { products as initialProducts, categories as initialCategories, spaces, formatVnd } from '../../data/products';
import { productDetails } from '../../data/product-details';

// Lấy danh mục từ MySQL (kèm fallback)
let categories = initialCategories;
try {
  const catRes = await fetch('http://localhost:4000/api/categories', { signal: AbortSignal.timeout(2000) });
  if (catRes.ok) {
    const catJson = await catRes.json();
    if (catJson.success && Array.isArray(catJson.data) && catJson.data.length > 0) {
      categories = catJson.data.map((c: any) => ({
        key: c.slug,
        label: c.name,
        id: c.id,
      }));
    }
  }
} catch {}

const tonKhoDefault: Record<string, string> = {
  'ghe-ngoai-troi-go-teak': 'het-hang',
  'guong-trang-tri-vien-vang': 'nhap',
  'den-ban-gom': 'het-hang',
};

// Lấy sản phẩm từ MySQL (kèm fallback)
let rows: any[] = [];
try {
  const prodRes = await fetch('http://localhost:4000/api/products?limit=100', { signal: AbortSignal.timeout(2000) });
  if (prodRes.ok) {
    const prodJson = await prodRes.json();
    if (prodJson.success && Array.isArray(prodJson.data) && prodJson.data.length > 0) {
      rows = prodJson.data.map((p: any) => ({
        id: p.id,
        slug: p.slug,
        name: p.name,
        category: p.category,
        categoryLabel: p.categoryLabel,
        space: p.space || 'phong-khach',
        spaceLabel: p.spaceLabel || 'Phòng khách',
        price: p.price,
        comparePrice: p.comparePrice ? Number(p.comparePrice) : null,
        stock: p.stock !== undefined ? Number(p.stock) : 20,
        material: p.material || '',
        image: p.thumbnail || initialProducts.find((ip) => ip.slug === p.slug)?.image || 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=400&q=80',
        status: (p.stock === 0) ? 'het-hang' : (p.status === false ? 'nhap' : 'con-hang'),
        detail: {
          description: p.shortDescription || 'Sản phẩm nội thất thiết kế cao cấp.',
          dimensions: p.dimensions || 'Kích thước tiêu chuẩn',
          warranty: p.warranty || '12 tháng',
        },
      }));
    }
  }
} catch {}

if (rows.length === 0) {
  rows = initialProducts.map((product) => ({
    ...product,
    id: undefined,
    comparePrice: (product as any).comparePrice || null,
    image: (product as any).image || (product as any).thumbnail || 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=400&q=80',
    stock: tonKhoDefault[product.slug] === 'het-hang' ? 0 : 20,
    status: tonKhoDefault[product.slug] ?? 'con-hang',
    detail: productDetails[product.slug] ?? {
      description: 'Sản phẩm thủ công cao cấp.',
      dimensions: 'Kích thước tiêu chuẩn',
      warranty: '12 tháng',
    },
  }));
}

const NHAN: Record<string, { label: string; cls: string }> = {
  'con-hang': { label: 'Đang bán', cls: 'bg-olive-700/20 text-emerald-800 border border-emerald-300' },
  'het-hang': { label: 'Hết hàng', cls: 'bg-danger-600/10 text-danger-600 border border-red-200' },
  'nhap': { label: 'Nháp', cls: 'bg-walnut-900/10 text-walnut-800 border border-walnut-900/20' },
};

const perPage = 10;

const stats = [
  { label: 'Tổng sản phẩm', value: String(rows.length), desc: 'Đã đồng bộ từ CSDL MySQL' },
  { label: 'Đang bán', value: String(rows.filter((row) => row.status === 'con-hang').length), desc: 'Sẵn sàng giao ngay' },
  { label: 'Hết hàng', value: String(rows.filter((row) => row.status === 'het-hang').length), desc: 'Cần bổ sung kho' },
  { label: 'Danh mục', value: String(categories.length), desc: 'Đa dạng không gian nội thất' },
];
---

<AdminLayout title="Quản Lý Sản Phẩm - Kho Hàng | Nội Thất">

  <!-- PAGE HEADER -->
  <header class="flex flex-wrap items-end justify-between gap-4 border-b border-walnut-900/10 pb-6">
    <div>
      <p class="text-[11px] uppercase tracking-[0.25em] text-walnut-800">Bảng điều khiển</p>
      <h1 class="mt-2 font-display text-2xl tracking-tight sm:text-3xl text-walnut-900">Quản Lý Sản Phẩm</h1>
      <p class="mt-1 text-sm text-walnut-800">Thêm, sửa giá, tải lên hình ảnh sản phẩm và cập nhật trạng thái kho hàng.</p>
    </div>

    <button
      type="button"
      id="btn-open-add-modal"
      class="inline-flex items-center gap-2 bg-clay-600 px-6 py-3 text-xs uppercase tracking-[0.2em] text-sand-50 transition-all hover:bg-clay-500 shadow-sm cursor-pointer"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Thêm sản phẩm</span>
    </button>
  </header>

  <!-- STATS CARDS -->
  <section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {stats.map((item) => (
      <div class="border border-walnut-900/10 bg-sand-50 p-5 transition-shadow hover:shadow-sm">
        <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">{item.label}</p>
        <p class="mt-2 font-display text-3xl tracking-tight text-walnut-900">{item.value}</p>
        <p class="mt-1 text-xs text-walnut-800/70">{item.desc}</p>
      </div>
    ))}
  </section>

  <!-- PRODUCT LIST & FILTERS -->
  <section id="danh-sach-san-pham" class="mt-8">

    <div class="flex flex-wrap items-center gap-3 bg-sand-50 p-4 border border-walnut-900/10">
      <div class="relative w-full max-w-xs">
        <input
          data-adm-search
          type="search"
          placeholder="Tìm theo tên sản phẩm..."
          aria-label="Tìm theo tên sản phẩm"
          class="w-full border border-walnut-900/20 bg-sand-100/50 pl-9 pr-4 py-2.5 text-sm outline-none transition-colors placeholder:text-walnut-800/50 focus:border-clay-600 focus:bg-sand-50"
        />
        <svg class="absolute left-3 top-3 h-4 w-4 text-walnut-800/50 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <select
        data-adm-category
        aria-label="Lọc theo danh mục"
        class="border border-walnut-900/20 bg-sand-50 px-3 py-2.5 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600 cursor-pointer"
      >
        <option value="">Tất cả danh mục</option>
        {categories.map((item) => <option value={item.key}>{item.label}</option>)}
      </select>

      <select
        data-adm-status
        aria-label="Lọc theo trạng thái"
        class="border border-walnut-900/20 bg-sand-50 px-3 py-2.5 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600 cursor-pointer"
      >
        <option value="">Tất cả trạng thái</option>
        <option value="con-hang">Đang bán</option>
        <option value="het-hang">Hết hàng</option>
        <option value="nhap">Nháp</option>
      </select>

      <button
        type="button"
        data-adm-reset
        class="text-xs uppercase tracking-[0.18em] text-walnut-800 underline underline-offset-4 transition-colors hover:text-clay-600 cursor-pointer"
      >
        Xóa lọc
      </button>

      <p data-adm-count class="ml-auto text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium"></p>
    </div>

    <!-- TABLE -->
    <div class="mt-4 overflow-x-auto border border-walnut-900/10 bg-sand-50 shadow-sm">
      <table class="w-full min-w-[50rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-walnut-900/15 bg-sand-100/50 text-[11px] uppercase tracking-[0.18em] text-walnut-800">
            <th scope="col" class="px-4 py-3.5 font-medium">Ảnh</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Tên Sản phẩm</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Danh mục</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Không gian</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Đơn giá</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Tồn kho</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Trạng thái</th>
            <th scope="col" class="px-4 py-3.5 font-medium text-right">Thao tác</th>
          </tr>
        </thead>

        <tbody data-adm-body data-page-size={perPage}>
          {rows.map((row) => (
            <tr
              data-row
              data-id={row.id}
              data-slug={row.slug}
              data-name={row.name}
              data-category={row.category}
              data-space={row.space}
              data-price={row.price}
              data-compare-price={row.comparePrice || ''}
              data-stock={row.stock}
              data-material={row.material}
              data-status={row.status}
              data-desc={row.detail?.description}
              data-dimensions={row.detail?.dimensions}
              data-warranty={row.detail?.warranty}
              data-image={row.image}
              class="border-b border-walnut-900/10 last:border-b-0 hover:bg-sand-100/30 transition-colors"
            >
              <td class="px-4 py-3.5 align-middle">
                <img
                  src={row.image}
                  alt={row.name}
                  class="h-12 w-12 rounded object-cover border border-walnut-900/10"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=400&q=80';"
                />
              </td>
              <td class="px-4 py-3.5 align-middle">
                <p class="text-sm font-medium text-walnut-900">{row.name}</p>
                <p class="mt-0.5 text-xs text-walnut-800/70">/{row.slug}</p>
              </td>
              <td class="px-4 py-3.5 align-middle text-sm text-walnut-800">
                {categories.find((c) => c.key === row.category)?.label}
              </td>
              <td class="px-4 py-3.5 align-middle text-sm text-walnut-800">
                {spaces.find((s) => s.key === row.space)?.label}
              </td>
              <td class="px-4 py-3.5 align-middle text-sm" data-price-cell>
                <div class="flex flex-col gap-0.5">
                  <span class="font-semibold text-clay-600">{formatVnd(row.price)}</span>
                  {row.comparePrice && row.comparePrice > row.price ? (
                    <div class="flex items-center gap-1.5 text-xs">
                      <span class="text-walnut-800/50 line-through text-[11px]">{formatVnd(row.comparePrice)}</span>
                      <span class="text-[10px] font-bold text-red-600 bg-red-50 px-1 py-0.2 rounded border border-red-200">
                        -{Math.round((1 - row.price / row.comparePrice) * 100)}%
                      </span>
                    </div>
                  ) : null}
                </div>
              </td>
              <td class="px-4 py-3.5 align-middle">
                <span
                  data-stock-badge
                  class:list={[
                    'inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded',
                    row.stock > 0 ? 'text-emerald-800 bg-emerald-50 border border-emerald-200' : 'text-danger-600 bg-danger-600/10 border border-red-200'
                  ]}
                >
                  {row.stock > 0 ? `${row.stock} sp` : 'Hết hàng (0)'}
                </span>
              </td>
              <td class="px-4 py-3.5 align-middle">
                <button
                  type="button"
                  data-btn-toggle-status
                  data-current-status={row.status}
                  class:list={[
                    'inline-block px-2.5 py-1 text-[10px] uppercase tracking-[0.15em] rounded transition-transform active:scale-95 cursor-pointer',
                    NHAN[row.status]?.cls
                  ]}
                  title="Nhấp để đổi trạng thái"
                >
                  {NHAN[row.status]?.label}
                </button>
              </td>
              <td class="px-4 py-3.5 align-middle text-right">
                <div class="inline-flex items-center gap-2">
                  <button
                    type="button"
                    data-btn-edit
                    class="p-1.5 text-walnut-800 hover:text-clay-600 transition-colors cursor-pointer"
                    title="Chỉnh sửa sản phẩm"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    data-btn-delete
                    class="p-1.5 text-walnut-800 hover:text-danger-600 transition-colors cursor-pointer"
                    title="Xóa sản phẩm"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p data-adm-empty class="mt-8 hidden text-center text-sm text-walnut-800 py-10 bg-sand-50 border border-walnut-900/10">
      Không tìm thấy sản phẩm nào khớp với bộ lọc tìm kiếm.
    </p>

    <!-- PAGINATION -->
    <nav data-adm-pagination aria-label="Phân trang" class="mt-6 flex flex-wrap items-center justify-center gap-2"></nav>
  </section>

  <!-- MODAL: THÊM / SỬA SẢN PHẨM (THIẾT KẾ HOÀNG GIA KTUFA) -->
  <div id="product-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/30 w-full max-w-2xl shadow-2xl rounded-none relative my-4 max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- MODAL HEADER: XANH WALNUT #173524 + VIỀN VÀNG CHAMPAGNE -->
      <div class="relative bg-[#173524] px-6 py-4.5 sm:px-8 border-b border-[#D8B670]/40 flex items-center justify-between shrink-0 shadow-md">
        <!-- Đường line chỉ vàng Champagne trên đỉnh -->
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
        
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded bg-[#D8B670]/15 border border-[#D8B670]/30 flex items-center justify-center text-[#D8B670] shrink-0">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <div>
            <p class="text-[10px] uppercase tracking-[0.22em] text-[#D8B670] font-semibold flex items-center gap-1.5">
              <span>QUẢN TRỊ KHO HÀNG</span>
            </p>
            <h2 id="modal-title" class="text-lg sm:text-xl font-display font-bold text-white tracking-wide mt-0.5">
              Thêm sản phẩm mới
            </h2>
          </div>
        </div>

        <button 
          type="button" 
          id="btn-close-modal" 
          class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-sand-200 hover:text-white flex items-center justify-center transition-all hover:rotate-90 cursor-pointer border border-white/10" 
          aria-label="Đóng modal"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- FORM WRAPPER: BODY CUỘN MƯỢT + FOOTER CỐ ĐỊNH -->
      <form id="product-form" class="flex flex-col flex-1 overflow-hidden">
        <!-- MODAL BODY: CUỘN MƯỢT -->
        <div class="p-6 sm:p-8 overflow-y-auto flex-1 grid grid-cols-1 gap-4 sm:grid-cols-2 bg-[#FAF8F5]">
          <input type="hidden" id="form-mode" value="add" />
          <input type="hidden" id="form-original-slug" value="" />

          <div class="sm:col-span-2">
            <label for="prod-name" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Tên sản phẩm *</label>
            <input type="text" id="prod-name" required placeholder="Ví dụ: Sofa da Ý Milano" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors" />
          </div>

          <div>
            <label for="prod-slug" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Slug đường dẫn *</label>
            <input type="text" id="prod-slug" required placeholder="sofa-da-y-milano" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors" />
            <p class="mt-1 text-[11px] text-walnut-800/60">Tự động sinh từ tên sản phẩm để làm link URL.</p>
          </div>

          <div>
            <label for="prod-price" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Giá bán (VNĐ) *</label>
            <input type="number" id="prod-price" min="1000" step="1000" placeholder="Ví dụ: 2000 hoặc 15000000" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors" />
            <p class="mt-1 text-[11px] text-walnut-800/60">Giá thực tế khách hàng thanh toán.</p>
          </div>

          <div>
            <label for="prod-compare-price" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Giá gốc / Giá niêm yết (VNĐ)</label>
            <input type="number" id="prod-compare-price" min="0" step="1000" placeholder="Ví dụ: 25000000 (để trống nếu không giảm)" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors" />
            <p class="mt-1 text-[11px] text-walnut-800/60">Nhập cao hơn giá bán để tự động hiển thị giảm giá (%).</p>
          </div>

          <div>
            <label for="prod-stock" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Số lượng tồn kho *</label>
            <input type="number" id="prod-stock" required min="0" value="20" placeholder="Ví dụ: 50" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors" />
            <p class="mt-1 text-[11px] text-walnut-800/60">Nhập 0 sẽ tự động chuyển trạng thái thành hết hàng.</p>
          </div>

          <div>
            <label for="prod-category" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Danh mục *</label>
            <select id="prod-category" required class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] cursor-pointer">
              {categories.map((c) => <option value={c.key}>{c.label}</option>)}
            </select>
          </div>

          <div>
            <label for="prod-space" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Không gian *</label>
            <select id="prod-space" required class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] cursor-pointer">
              {spaces.map((s) => <option value={s.key}>{s.label}</option>)}
            </select>
          </div>

          <div>
            <label for="prod-material" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Chất liệu *</label>
            <input type="text" id="prod-material" required placeholder="Gỗ sồi, Da bò..." class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors" />
          </div>

          <div>
            <label for="prod-status" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Trạng thái kho</label>
            <select id="prod-status" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] cursor-pointer">
              <option value="con-hang">Đang bán</option>
              <option value="het-hang">Hết hàng</option>
              <option value="nhap">Nháp</option>
            </select>
          </div>

          <div>
            <label for="prod-dimensions" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Kích thước</label>
            <input type="text" id="prod-dimensions" placeholder="200 × 90 × 75 cm" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors" />
          </div>

          <div>
            <label for="prod-warranty" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Thời gian bảo hành</label>
            <input type="text" id="prod-warranty" placeholder="24 tháng" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors" />
          </div>

          <div class="sm:col-span-2">
            <label for="prod-desc" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-semibold">Mô tả sản phẩm</label>
            <textarea id="prod-desc" rows="2" placeholder="Chi tiết chế tác, đệm mút, chất liệu..." class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-sm outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors"></textarea>
          </div>

          <!-- KHU VỰC HÌNH ẢNH SẢN PHẨM -->
          <div class="sm:col-span-2 border-t border-walnut-900/10 pt-4 mt-1">
            <div class="flex items-center gap-2 mb-3">
              <svg class="h-4 w-4 text-clay-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="text-xs font-bold uppercase tracking-wider text-walnut-900">Hình ảnh sản phẩm</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- CỘT 1: ẢNH CHÍNH SẢN PHẨM -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="block text-[11px] font-bold uppercase tracking-wider text-walnut-800">Ảnh chính sản phẩm *</label>
                  <span id="upload-status-badge" class="hidden text-[10px] text-clay-600 font-medium">Đang tải lên...</span>
                </div>
                
                <input 
                  type="file" 
                  id="prod-main-img-file" 
                  accept="image/*"
                  class="hidden"
                />
                
                <!-- Khung nét đứt bấm để chọn ảnh hoặc hiển thị preview ảnh chính -->
                <div 
                  id="main-dropzone" 
                  class="border-2 border-dashed border-walnut-900/25 rounded p-3 text-center hover:border-clay-600 hover:bg-sand-100/50 transition-colors cursor-pointer flex flex-col items-center justify-center min-h-[120px] relative bg-sand-100/30"
                >
                  <!-- Placeholder khi chưa có ảnh -->
                  <div id="main-dropzone-placeholder" class="flex flex-col items-center gap-1.5 text-walnut-800/70">
                    <div class="h-8 w-8 rounded-full bg-sand-200 flex items-center justify-center text-clay-600">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <span class="text-xs font-medium text-walnut-900">Bấm để tải ảnh từ máy tính</span>
                    <span class="text-[10px] text-walnut-800/50">JPG, PNG, WEBP (Tối đa 10MB)</span>
                  </div>

                  <!-- Spinner tải ảnh -->
                  <div id="main-upload-spinner" class="hidden flex flex-col items-center gap-1.5 py-3">
                    <div class="h-5 w-5 border-2 border-clay-600 border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-xs text-clay-600 font-medium">Đang lưu ảnh lên hệ thống...</span>
                  </div>

                  <!-- Preview ảnh chính khi đã có -->
                  <div id="main-preview-wrapper" class="hidden flex flex-col items-center gap-1.5 w-full">
                    <img 
                      id="main-dropzone-preview" 
                      src="" 
                      alt="Xem trước ảnh chính" 
                      class="max-h-24 w-auto object-contain rounded shadow-sm border border-walnut-900/10"
                    />
                    <div class="flex items-center gap-3 mt-1">
                      <span id="btn-change-main-img" class="text-[11px] text-clay-600 hover:underline font-medium cursor-pointer">Đổi ảnh</span>
                      <span class="text-walnut-800/30">|</span>
                      <span id="btn-remove-main-img" class="text-[11px] text-danger-600 hover:underline font-medium cursor-pointer">Xóa ảnh</span>
                    </div>
                  </div>
                </div>

                <!-- Dán URL trực tiếp -->
                <div class="mt-2">
                  <input 
                    type="url" 
                    id="prod-main-img-url" 
                    placeholder="Hoặc dán link ảnh trực tiếp (https://...)" 
                    class="w-full border border-walnut-900/20 bg-sand-100/50 px-2.5 py-1.5 text-xs outline-none focus:border-clay-600 focus:bg-sand-50 rounded text-walnut-900"
                  />
                  <p id="prod-main-img-error" class="hidden mt-1.5 text-[11px] text-danger-600 font-medium leading-relaxed">
                    ⚠️ Link này không tải được ảnh. Hãy chuột phải vào ảnh trên mạng &rarr; chọn <strong>"Sao chép địa chỉ hình ảnh"</strong> (Copy image address) thay vì copy link cả trang web bài viết.
                  </p>
                </div>
              </div>

              <!-- CỘT 2: ẢNH CHI TIẾT (TỐI ĐA 3 ẢNH) -->
              <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-walnut-800 mb-1.5">Ảnh chi tiết (Tối đa 3 ảnh)</label>
                <input 
                  type="file" 
                  id="prod-detail-img-file" 
                  accept="image/*" 
                  multiple
                  class="block w-full text-xs text-walnut-800 file:mr-2 file:py-1.5 file:px-3 file:border file:border-walnut-900/20 file:text-xs file:bg-sand-100 file:text-walnut-900 hover:file:bg-sand-200 rounded border border-walnut-900/20 bg-sand-100/40 p-1 cursor-pointer"
                />

                <!-- Preview các ảnh chi tiết -->
                <div id="detail-previews-container" class="mt-2.5 grid grid-cols-3 gap-2 min-h-[120px] items-center border border-walnut-900/15 rounded p-2 bg-sand-50">
                  <p id="detail-previews-empty" class="col-span-3 text-center text-xs text-walnut-800/50 py-6">
                    Chưa có ảnh chi tiết nào được chọn
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- MODAL FOOTER CỐ ĐỊNH Ở ĐÁY: TIỆN THAO TÁC MỌI LÚC -->
        <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex items-center justify-end gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
          <button 
            type="button" 
            id="btn-cancel-modal" 
            class="border border-walnut-900/20 px-5 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer"
          >
            Hủy
          </button>
          <button 
            type="submit" 
            class="bg-gradient-to-r from-[#D8B670] via-[#E2C37E] to-[#C49E52] px-6 py-2.5 text-xs uppercase tracking-[0.18em] font-bold text-[#173524] hover:from-[#C49E52] hover:to-[#B58F43] hover:text-white shadow-md transition-all active:scale-95 cursor-pointer border border-[#E0C582]/50"
          >
            Lưu sản phẩm
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="admin-toast" class="fixed bottom-6 right-6 z-50 hidden translate-y-4 rounded bg-walnut-900 px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300">
    <span id="toast-message">Đã cập nhật sản phẩm thành công!</span>
  </div>

  <!-- MODAL CONFIRM DELETE (THIẾT KẾ CẢNH BÁO CAO CẤP) -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-white border border-red-900/30 w-full max-w-md shadow-2xl rounded-none overflow-hidden relative animate-in fade-in zoom-in-95 duration-200">
      <!-- HEADER CẢNH BÁO ĐỎ RƯỢU VANG -->
      <div class="relative bg-[#3b1212] px-6 py-4.5 border-b border-red-500/30 flex items-center justify-between">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-red-500"></div>
        <div class="flex items-center gap-3 text-red-100">
          <div class="h-9 w-9 rounded-full bg-red-500/20 text-red-300 flex items-center justify-center shrink-0 border border-red-500/30">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <p class="text-[10px] uppercase tracking-[0.2em] text-red-300 font-semibold">Cảnh báo hệ thống</p>
            <h3 class="font-display text-base font-bold text-white tracking-wide">Xác nhận xóa sản phẩm</h3>
          </div>
        </div>
      </div>
      
      <div class="p-6 bg-[#FAF8F5]">
        <p id="delete-item-name" class="text-sm text-walnut-900 leading-relaxed font-medium">Bạn có chắc chắn muốn xóa sản phẩm này không?</p>
        <p class="mt-2 text-xs text-walnut-800/70">Thao tác này sẽ gỡ sản phẩm khỏi danh sách và cập nhật vào cơ sở dữ liệu.</p>
      </div>

      <div class="px-6 py-3.5 bg-white border-t border-walnut-900/10 flex justify-end gap-3">
        <button type="button" id="btn-cancel-delete" class="border border-walnut-900/20 px-4 py-2 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 cursor-pointer">
          Hủy bỏ
        </button>
        <button type="button" id="btn-confirm-delete" class="bg-danger-600 px-5 py-2 text-xs uppercase tracking-[0.15em] text-white hover:bg-danger-500 font-bold shadow-md cursor-pointer">
          Xác nhận xóa
        </button>
      </div>
    </div>
  </div>

</AdminLayout>

<script>
  function formatVndClient(amount: number): string {
    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const tableBody = document.querySelector('[data-adm-body]') as HTMLElement | null;
    if (!tableBody) return;

    let rows = Array.from(tableBody.querySelectorAll<HTMLTableRowElement>('[data-row]'));
    const searchInput = document.querySelector('[data-adm-search]') as HTMLInputElement | null;
    const catSelect = document.querySelector('[data-adm-category]') as HTMLSelectElement | null;
    const statusSelect = document.querySelector('[data-adm-status]') as HTMLSelectElement | null;
    const resetBtn = document.querySelector('[data-adm-reset]') as HTMLButtonElement | null;
    const countEl = document.querySelector('[data-adm-count]') as HTMLElement | null;
    const emptyEl = document.querySelector('[data-adm-empty]') as HTMLElement | null;
    const paginationEl = document.querySelector('[data-adm-pagination]') as HTMLElement | null;

    const pageSize = Number(tableBody.dataset.pageSize) || 10;
    let currentPage = 1;
    let filteredRows = [...rows];

    // MODAL ELEMENTS
    const modal = document.getElementById('product-modal') as HTMLElement;
    const modalTitle = document.getElementById('modal-title') as HTMLElement;
    const form = document.getElementById('product-form') as HTMLFormElement;
    const btnOpenAdd = document.getElementById('btn-open-add-modal') as HTMLButtonElement;
    const btnCloseModal = document.getElementById('btn-close-modal') as HTMLButtonElement;
    const btnCancelModal = document.getElementById('btn-cancel-modal') as HTMLButtonElement;

    // IMAGE UPLOAD ELEMENTS
    const mainImgFileInput = document.getElementById('prod-main-img-file') as HTMLInputElement;
    const mainDropzone = document.getElementById('main-dropzone') as HTMLElement;
    const mainPlaceholder = document.getElementById('main-dropzone-placeholder') as HTMLElement;
    const mainUploadSpinner = document.getElementById('main-upload-spinner') as HTMLElement;
    const mainPreviewWrapper = document.getElementById('main-preview-wrapper') as HTMLElement;
    const mainPreview = document.getElementById('main-dropzone-preview') as HTMLImageElement;
    const mainImgUrlInput = document.getElementById('prod-main-img-url') as HTMLInputElement;
    const btnChangeMainImg = document.getElementById('btn-change-main-img') as HTMLElement;
    const btnRemoveMainImg = document.getElementById('btn-remove-main-img') as HTMLElement;
    const uploadStatusBadge = document.getElementById('upload-status-badge') as HTMLElement;
    const detailImgFileInput = document.getElementById('prod-detail-img-file') as HTMLInputElement;
    const detailContainer = document.getElementById('detail-previews-container') as HTMLElement;
    const detailEmpty = document.getElementById('detail-previews-empty') as HTMLElement;

    let currentUploadedMainUrl = '';
    let currentDetailImages: string[] = [];

    // Helper render ảnh chi tiết
    const renderDetailPreviews = (urls: string[]) => {
      detailContainer.innerHTML = '';
      if (!urls || urls.length === 0) {
        detailContainer.appendChild(detailEmpty);
        return;
      }
      urls.forEach((url, index) => {
        const thumb = document.createElement('div');
        thumb.className = 'relative h-20 rounded border border-walnut-900/15 overflow-hidden group bg-white shadow-xs';
        thumb.innerHTML = `
          <img src="${url}" alt="Ảnh chi tiết ${index + 1}" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=400&q=80'" />
          <button type="button" class="absolute top-1 right-1 h-5 w-5 rounded-full bg-black/75 hover:bg-danger-600 text-white flex items-center justify-center text-xs font-bold transition-colors cursor-pointer" title="Xóa ảnh này">
            &times;
          </button>
        `;
        const delBtn = thumb.querySelector('button');
        delBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          currentDetailImages.splice(index, 1);
          renderDetailPreviews(currentDetailImages);
        });
        detailContainer.appendChild(thumb);
      });
    };

    // Click dropzone to pick file
    mainDropzone?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#main-preview-wrapper')) return;
      mainImgFileInput?.click();
    });

    btnChangeMainImg?.addEventListener('click', (e) => {
      e.stopPropagation();
      mainImgFileInput?.click();
    });

    const mainImgError = document.getElementById('prod-main-img-error') as HTMLElement | null;

    mainPreview.onload = () => {
      if (mainPreview.src && !mainPreview.src.endsWith('/admin/san-pham') && mainPreview.src !== window.location.href) {
        mainImgError?.classList.add('hidden');
        mainPreviewWrapper?.classList.remove('hidden');
        mainPlaceholder?.classList.add('hidden');
      }
    };

    mainPreview.onerror = () => {
      if (mainImgUrlInput && mainImgUrlInput.value.trim()) {
        mainImgError?.classList.remove('hidden');
      }
      mainPreviewWrapper?.classList.add('hidden');
      mainPlaceholder?.classList.remove('hidden');
    };

    btnRemoveMainImg?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentUploadedMainUrl = '';
      mainPreview.src = '';
      mainImgFileInput.value = '';
      if (mainImgUrlInput) mainImgUrlInput.value = '';
      mainImgError?.classList.add('hidden');
      mainPreviewWrapper?.classList.add('hidden');
      mainPlaceholder?.classList.remove('hidden');
    });

    // Handle Direct URL Input
    mainImgUrlInput?.addEventListener('input', () => {
      const val = mainImgUrlInput.value.trim();
      mainImgError?.classList.add('hidden');
      if (val) {
        currentUploadedMainUrl = val;
        mainPreview.src = val;
      } else {
        currentUploadedMainUrl = '';
        mainPreview.src = '';
        mainPreviewWrapper?.classList.add('hidden');
        mainPlaceholder?.classList.remove('hidden');
      }
    });

    const getAuthHeaders = (contentType = 'application/json') => {
      const token = localStorage.getItem('auth_token') || '';
      const h: Record<string, string> = {};
      if (contentType) h['Content-Type'] = contentType;
      if (token) h['Authorization'] = `Bearer ${token}`;
      return h;
    };

    // Upload file function
    const uploadMainFile = async (file: File) => {
      // Immediate local preview
      const localUrl = URL.createObjectURL(file);
      mainPreview.src = localUrl;
      mainPlaceholder?.classList.add('hidden');
      mainPreviewWrapper?.classList.add('hidden');
      mainUploadSpinner?.classList.remove('hidden');
      if (uploadStatusBadge) uploadStatusBadge.classList.remove('hidden');

      try {
        const formData = new FormData();
        formData.append('image', file);
        const token = localStorage.getItem('auth_token') || '';
        const res = await fetch('http://localhost:4000/api/upload', {
          method: 'POST',
          headers: token ? { 'Authorization': `Bearer ${token}` } : {},
          body: formData,
        });
        const json = await res.json();
        if (json.success && json.url) {
          currentUploadedMainUrl = json.url;
          mainPreview.src = json.url;
          if (mainImgUrlInput) mainImgUrlInput.value = json.url;
          showToast('Đã tải và lưu ảnh lên máy chủ thành công!');
        } else {
          showToast('⚠️ Không thể lưu ảnh lên máy chủ. Hãy kiểm tra kết nối backend!');
          // Giữ preview cục bộ nhưng KHÔNG lưu base64 vào currentUploadedMainUrl
        }
      } catch (err) {
        showToast('⚠️ Backend offline! Không thể tải ảnh lên máy chủ.');
      } finally {
        mainUploadSpinner?.classList.add('hidden');
        mainPreviewWrapper?.classList.remove('hidden');
        if (uploadStatusBadge) uploadStatusBadge.classList.add('hidden');
      }
    };

    // Handle Main Image Selection via File Input
    mainImgFileInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) {
        uploadMainFile(file);
      }
    });

    // Drag and Drop support on dropzone
    mainDropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      mainDropzone.classList.add('border-clay-600', 'bg-sand-200/50');
    });

    mainDropzone?.addEventListener('dragleave', () => {
      mainDropzone.classList.remove('border-clay-600', 'bg-sand-200/50');
    });

    mainDropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      mainDropzone.classList.remove('border-clay-600', 'bg-sand-200/50');
      const file = e.dataTransfer?.files?.[0];
      if (file && file.type.startsWith('image/')) {
        uploadMainFile(file);
      }
    });

    // Handle Detail Images Selection
    detailImgFileInput?.addEventListener('change', async (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files.length > 0) {
        const remainingSlots = 3 - currentDetailImages.length;
        if (remainingSlots <= 0) {
          showToast('Đã đạt tối đa 3 ảnh chi tiết. Hãy xóa bớt ảnh cũ để thêm mới!');
          detailImgFileInput.value = '';
          return;
        }

        const maxFiles = Math.min(files.length, remainingSlots);

        // Hiển thị trạng thái đang tải
        const loadingThumb = document.createElement('div');
        loadingThumb.className = 'col-span-3 flex items-center justify-center py-4 gap-2 text-xs text-clay-600';
        loadingThumb.innerHTML = `<div class="h-4 w-4 border-2 border-clay-600 border-t-transparent rounded-full animate-spin"></div><span>Đang tải ${maxFiles} ảnh chi tiết lên...</span>`;
        detailContainer.appendChild(loadingThumb);

        // Upload to backend
        try {
          const formData = new FormData();
          for (let i = 0; i < maxFiles; i++) {
            formData.append('images', files[i]);
          }
          const token = localStorage.getItem('auth_token') || '';
          const res = await fetch('http://localhost:4000/api/upload/multiple', {
            method: 'POST',
            headers: token ? { 'Authorization': `Bearer ${token}` } : {},
            body: formData,
          });
          const json = await res.json();
          if (json.success && Array.isArray(json.urls)) {
            currentDetailImages = [...currentDetailImages, ...json.urls].slice(0, 3);
            renderDetailPreviews(currentDetailImages);
            showToast(`Đã thêm ${json.urls.length} ảnh chi tiết!`);
          } else {
            renderDetailPreviews(currentDetailImages);
          }
        } catch {
          renderDetailPreviews(currentDetailImages);
        }
        detailImgFileInput.value = '';
      }
    });

    // TOAST HELPER
    const toast = document.getElementById('admin-toast') as HTMLElement;
    const toastMessage = document.getElementById('toast-message') as HTMLElement;
    let toastTimeout: any;

    const showToast = (msg: string) => {
      if (toastTimeout) clearTimeout(toastTimeout);
      toastMessage.textContent = msg;
      toast.classList.remove('hidden');
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-4');
      });
      toastTimeout = setTimeout(() => {
        toast.classList.add('translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3000);
    };

    // RENDER FILTER & PAGINATION
    const render = () => {
      const q = (searchInput?.value ?? '').trim().toLowerCase();
      const cat = catSelect?.value ?? '';
      const st = statusSelect?.value ?? '';

      filteredRows = rows.filter((r) => {
        const name = (r.dataset.name ?? '').toLowerCase();
        const rowCat = r.dataset.category ?? '';
        const rowSt = r.dataset.status ?? '';

        if (q && !name.includes(q)) return false;
        if (cat && rowCat !== cat) return false;
        if (st && rowSt !== st) return false;
        return true;
      });

      const total = filteredRows.length;
      const totalPages = Math.max(1, Math.ceil(total / pageSize));
      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * pageSize;
      const end = start + pageSize;
      const pageRows = filteredRows.slice(start, end);

      tableBody.innerHTML = '';
      pageRows.forEach((r) => tableBody.appendChild(r));

      if (countEl) countEl.textContent = `Hiển thị ${total} sản phẩm`;
      if (emptyEl) emptyEl.classList.toggle('hidden', total > 0);

      if (paginationEl) {
        paginationEl.innerHTML = '';
        if (totalPages > 1) {
          for (let p = 1; p <= totalPages; p++) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = String(p);
            btn.className = `px-3 py-1.5 text-xs font-semibold cursor-pointer border transition-colors ${
              p === currentPage
                ? 'bg-clay-600 text-sand-50 border-clay-600'
                : 'bg-sand-50 text-walnut-900 border-walnut-900/15 hover:border-walnut-900'
            }`;
            btn.addEventListener('click', () => {
              currentPage = p;
              render();
            });
            paginationEl.appendChild(btn);
          }
        }
      }
    };

    // EVENTS FILTER
    searchInput?.addEventListener('input', () => { currentPage = 1; render(); });
    catSelect?.addEventListener('change', () => { currentPage = 1; render(); });
    statusSelect?.addEventListener('change', () => { currentPage = 1; render(); });
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (catSelect) catSelect.value = '';
      if (statusSelect) statusSelect.value = '';
      currentPage = 1;
      render();
    });

    // OPEN ADD MODAL
    btnOpenAdd?.addEventListener('click', () => {
      form.reset();
      modalTitle.textContent = 'Thêm sản phẩm mới';
      (document.getElementById('form-mode') as HTMLInputElement).value = 'add';
      (document.getElementById('form-original-slug') as HTMLInputElement).value = '';
      (document.getElementById('prod-stock') as HTMLInputElement).value = '20';
      (document.getElementById('prod-price') as HTMLInputElement).value = '';
      (document.getElementById('prod-compare-price') as HTMLInputElement).value = '';
      
      // Reset image preview
      currentUploadedMainUrl = '';
      currentDetailImages = [];
      mainPreview.src = '';
      mainImgFileInput.value = '';
      detailImgFileInput.value = '';
      if (mainImgUrlInput) mainImgUrlInput.value = '';
      mainImgError?.classList.add('hidden');
      mainPreviewWrapper?.classList.add('hidden');
      mainUploadSpinner?.classList.add('hidden');
      mainPlaceholder?.classList.remove('hidden');
      renderDetailPreviews([]);

      modal.classList.remove('hidden');
    });

    const closeModal = () => modal.classList.add('hidden');
    btnCloseModal?.addEventListener('click', closeModal);
    btnCancelModal?.addEventListener('click', closeModal);

    // AUTO SLUG FROM NAME
    const nameInput = document.getElementById('prod-name') as HTMLInputElement;
    const slugInput = document.getElementById('prod-slug') as HTMLInputElement;
    nameInput?.addEventListener('input', () => {
      const mode = (document.getElementById('form-mode') as HTMLInputElement).value;
      if (mode === 'add') {
        const slug = nameInput.value
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[đĐ]/g, 'd')
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-');
        slugInput.value = slug;
      }
    });

    // SUBMIT FORM (ADD / EDIT) – ket noi API backend
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const mode = (document.getElementById('form-mode') as HTMLInputElement).value;
      const origSlug = (document.getElementById('form-original-slug') as HTMLInputElement).value;
      const name = (document.getElementById('prod-name') as HTMLInputElement).value.trim();
      const slug = (document.getElementById('prod-slug') as HTMLInputElement).value.trim();
      
      const targetRow = mode === 'edit' ? rows.find((r) => r.dataset.slug === origSlug) : null;
      const priceInput = (document.getElementById('prod-price') as HTMLInputElement).value.trim();
      const comparePriceInput = (document.getElementById('prod-compare-price') as HTMLInputElement).value.trim();

      // Nếu người dùng không sửa giá khi chỉnh sửa, giữ nguyên giá gốc ban đầu
      let price = priceInput ? Number(priceInput) : (mode === 'edit' && targetRow ? Number(targetRow.dataset.price || 0) : 0);
      if (!price || price <= 0) {
        showToast('⚠️ Vui lòng nhập giá bán hợp lệ (> 0đ)!');
        return;
      }

      // Xử lý giá gốc / giá niêm yết (comparePrice)
      const comparePrice = comparePriceInput ? Number(comparePriceInput) : null;

      const stock = Math.max(0, parseInt((document.getElementById('prod-stock') as HTMLInputElement).value) || 0);
      const catSelectEl = document.getElementById('prod-category') as HTMLSelectElement;
      const cat = catSelectEl.value;
      const catLabel = catSelectEl.options[catSelectEl.selectedIndex].text;
      const spaceSelectEl = document.getElementById('prod-space') as HTMLSelectElement;
      const space = spaceSelectEl.value;
      const spaceLabel = spaceSelectEl.options[spaceSelectEl.selectedIndex].text;
      const material = (document.getElementById('prod-material') as HTMLInputElement).value.trim();
      let status = (document.getElementById('prod-status') as HTMLSelectElement).value;
      if (stock === 0) {
        status = 'het-hang';
      } else if (status === 'het-hang' && stock > 0) {
        status = 'con-hang';
      }
      const dimensions = (document.getElementById('prod-dimensions') as HTMLInputElement).value.trim();
      const warranty = (document.getElementById('prod-warranty') as HTMLInputElement).value.trim();
      const desc = (document.getElementById('prod-desc') as HTMLTextAreaElement).value.trim();
      const mainImgSrc = currentUploadedMainUrl || '';
      const CAT_MAP: Record<string, number> = { 'sofa': 1, 'ban-an': 2, 'ghe': 3, 'giuong': 4, 'tu-ke': 5, 'den': 6, 'trang-tri': 7 };
      const API = 'http://localhost:4000/api';

      let newIdFromApi = '';

      try {
        if (mode === 'edit') {
          const productId = targetRow?.dataset.id;
          if (productId) {
            const res = await fetch(`${API}/products/${productId}`, {
              method: 'PUT',
              headers: getAuthHeaders(),
              body: JSON.stringify({
                name,
                slug,
                categoryId: CAT_MAP[cat] ?? 1,
                shortDescription: desc,
                status: status === 'con-hang',
                price,
                comparePrice: comparePrice !== null ? comparePrice : null,
                stock,
                material,
                imageUrl: currentUploadedMainUrl || undefined,
                detailImages: currentDetailImages,
              }),
            });
            const json = await res.json();
            if (!res.ok || !json.success) {
              showToast(json.message || '⚠️ Lỗi khi cập nhật sản phẩm trên máy chủ!');
              return;
            }
          }
        } else {
          const res = await fetch(`${API}/products`, {
            method: 'POST',
            headers: getAuthHeaders(),
            body: JSON.stringify({
              name,
              slug,
              categoryId: CAT_MAP[cat] ?? 1,
              shortDescription: desc,
              price,
              comparePrice: comparePrice || undefined,
              stock,
              material,
              imageUrl: mainImgSrc || null,
              detailImages: currentDetailImages.length > 0 ? currentDetailImages : undefined,
            }),
          });
          const json = await res.json();
          if (!res.ok || !json.success) {
            showToast(json.message || '⚠️ Không thể thêm sản phẩm vào cơ sở dữ liệu!');
            return;
          }
          if (json.data?.id) {
            newIdFromApi = String(json.data.id);
          }
        }
      } catch (err) {
        console.error('Lỗi lưu sản phẩm:', err);
        showToast('⚠️ Không thể kết nối tới máy chủ. Kiểm tra backend có đang chạy không!');
        return;
      }

      if (mode === 'edit') {
        if (targetRow) {
          targetRow.dataset.name = name;
          targetRow.dataset.slug = slug;
          targetRow.dataset.price = String(price);
          targetRow.dataset.comparePrice = comparePrice ? String(comparePrice) : '';
          targetRow.dataset.stock = String(stock);
          targetRow.dataset.category = cat;
          targetRow.dataset.space = space;
          targetRow.dataset.material = material;
          targetRow.dataset.status = status;
          targetRow.dataset.dimensions = dimensions;
          targetRow.dataset.warranty = warranty;
          targetRow.dataset.desc = desc;
          if (currentUploadedMainUrl) {
            targetRow.dataset.image = currentUploadedMainUrl;
            const imgEl = targetRow.querySelector('img');
            if (imgEl) imgEl.src = currentUploadedMainUrl;
          }
          targetRow.querySelector('td:nth-child(2) p:first-child')!.textContent = name;
          targetRow.querySelector('td:nth-child(2) p:last-child')!.textContent = '/' + slug;
          targetRow.querySelector('td:nth-child(3)')!.textContent = catLabel;
          targetRow.querySelector('td:nth-child(4)')!.textContent = spaceLabel;
          
          const priceCell = targetRow.querySelector('[data-price-cell]') || targetRow.querySelector('td:nth-child(5)');
          if (priceCell) {
            priceCell.setAttribute('data-price-cell', '');
            if (comparePrice && comparePrice > price) {
              const discountPct = Math.round((1 - price / comparePrice) * 100);
              priceCell.innerHTML = `
                <div class="flex flex-col gap-0.5">
                  <span class="font-semibold text-clay-600">${formatVndClient(price)}</span>
                  <div class="flex items-center gap-1.5 text-xs">
                    <span class="text-walnut-800/50 line-through text-[11px]">${formatVndClient(comparePrice)}</span>
                    <span class="text-[10px] font-bold text-red-600 bg-red-50 px-1 py-0.2 rounded border border-red-200">-${discountPct}%</span>
                  </div>
                </div>
              `;
            } else {
              priceCell.innerHTML = `<span class="font-semibold text-clay-600">${formatVndClient(price)}</span>`;
            }
          }
          
          const stockBadge = targetRow.querySelector('[data-stock-badge]');
          if (stockBadge) {
            stockBadge.textContent = stock > 0 ? `${stock} sp` : 'Hết hàng (0)';
            stockBadge.className = `inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded ${
              stock > 0 ? 'text-emerald-800 bg-emerald-50 border border-emerald-200' : 'text-danger-600 bg-danger-600/10 border border-red-200'
            }`;
          }

          const statusBtn = targetRow.querySelector('[data-btn-toggle-status]') as HTMLButtonElement;
          statusBtn.textContent = status === 'con-hang' ? 'Đang bán' : status === 'het-hang' ? 'Hết hàng' : 'Nháp';
          statusBtn.className = `inline-block px-2.5 py-1 text-[10px] uppercase tracking-[0.15em] rounded transition-transform active:scale-95 cursor-pointer ${
            status === 'con-hang' ? 'bg-olive-700/20 text-emerald-800 border border-emerald-300' : status === 'het-hang' ? 'bg-danger-600/10 text-danger-600 border border-red-200' : 'bg-walnut-900/10 text-walnut-800 border border-walnut-900/20'
          }`;
          showToast(`Đã cập nhật sản phẩm "${name}" thành công!`);
        }
      } else {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-walnut-900/10 last:border-b-0 hover:bg-sand-100/30 transition-colors';
        tr.dataset.row = '';
        if (newIdFromApi) tr.dataset.id = newIdFromApi;
        tr.dataset.slug = slug;
        tr.dataset.name = name;
        tr.dataset.category = cat;
        tr.dataset.space = space;
        tr.dataset.price = String(price);
        tr.dataset.comparePrice = comparePrice ? String(comparePrice) : '';
        tr.dataset.stock = String(stock);
        tr.dataset.material = material;
        tr.dataset.status = status;
        tr.dataset.dimensions = dimensions;
        tr.dataset.warranty = warranty;
        tr.dataset.desc = desc;
        tr.dataset.image = mainImgSrc;

        tr.innerHTML = `
          <td class="px-4 py-3.5 align-middle">
            <img 
              src="${mainImgSrc || 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=400&q=80'}" 
              alt="${name}" 
              class="h-12 w-12 rounded object-cover border border-walnut-900/10" 
              loading="lazy" 
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=400&q=80';"
            />
          </td>
          <td class="px-4 py-3.5 align-middle">
            <p class="text-sm font-medium text-walnut-900">${name}</p>
            <p class="mt-0.5 text-xs text-walnut-800/70">/${slug}</p>
          </td>
          <td class="px-4 py-3.5 align-middle text-sm text-walnut-800">${catLabel}</td>
          <td class="px-4 py-3.5 align-middle text-sm text-walnut-800">${spaceLabel}</td>
          <td class="px-4 py-3.5 align-middle text-sm" data-price-cell>
            ${comparePrice && comparePrice > price ? `
              <div class="flex flex-col gap-0.5">
                <span class="font-semibold text-clay-600">${formatVndClient(price)}</span>
                <div class="flex items-center gap-1.5 text-xs">
                  <span class="text-walnut-800/50 line-through text-[11px]">${formatVndClient(comparePrice)}</span>
                  <span class="text-[10px] font-bold text-red-600 bg-red-50 px-1 py-0.2 rounded border border-red-200">-${Math.round((1 - price / comparePrice) * 100)}%</span>
                </div>
              </div>
            ` : `
              <span class="font-semibold text-clay-600">${formatVndClient(price)}</span>
            `}
          </td>
          <td class="px-4 py-3.5 align-middle">
            <span data-stock-badge class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded ${
              stock > 0 ? 'text-emerald-800 bg-emerald-50 border border-emerald-200' : 'text-danger-600 bg-danger-600/10 border border-red-200'
            }">
              ${stock > 0 ? `${stock} sp` : 'Hết hàng (0)'}
            </span>
          </td>
          <td class="px-4 py-3.5 align-middle">
            <button type="button" data-btn-toggle-status class="inline-block px-2.5 py-1 text-[10px] uppercase tracking-[0.15em] rounded transition-transform active:scale-95 cursor-pointer ${
              status === 'con-hang' ? 'bg-olive-700/20 text-emerald-800 border border-emerald-300' : status === 'het-hang' ? 'bg-danger-600/10 text-danger-600 border border-red-200' : 'bg-walnut-900/10 text-walnut-800 border border-walnut-900/20'
            }">${status === 'con-hang' ? 'Đang bán' : status === 'het-hang' ? 'Hết hàng' : 'Nháp'}</button>
          </td>
          <td class="px-4 py-3.5 align-middle text-right">
            <div class="inline-flex items-center gap-2">
              <button type="button" data-btn-edit class="p-1.5 text-walnut-800 hover:text-clay-600 transition-colors cursor-pointer" title="Sửa sản phẩm">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
              </button>
              <button type="button" data-btn-delete class="p-1.5 text-walnut-800 hover:text-danger-600 transition-colors cursor-pointer" title="Xóa sản phẩm">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </div>
          </td>
        `;
        attachRowEvents(tr);
        rows.unshift(tr);
        showToast(`Đã thêm sản phẩm "${name}" thành công!`);
      }
      closeModal();
      render();
    });

    // ATTACH ROW EVENTS (EDIT, DELETE, TOGGLE)
    const attachRowEvents = (rowEl: HTMLTableRowElement) => {
      // TOGGLE STATUS
      const toggleBtn = rowEl.querySelector('[data-btn-toggle-status]') as HTMLButtonElement | null;
      toggleBtn?.addEventListener('click', async () => {
        const cur = rowEl.dataset.status ?? 'con-hang';
        const next = cur === 'con-hang' ? 'het-hang' : cur === 'het-hang' ? 'nhap' : 'con-hang';
        rowEl.dataset.status = next;
        toggleBtn.textContent = next === 'con-hang' ? 'Đang bán' : next === 'het-hang' ? 'Hết hàng' : 'Nháp';
        toggleBtn.className = `inline-block px-2.5 py-1 text-[10px] uppercase tracking-[0.15em] rounded transition-transform active:scale-95 cursor-pointer ${
          next === 'con-hang' ? 'bg-olive-700/20 text-emerald-800 border border-emerald-300' : next === 'het-hang' ? 'bg-danger-600/10 text-danger-600 border border-red-200' : 'bg-walnut-900/10 text-walnut-800 border border-walnut-900/20'
        }`;
        
        let newStock = Number(rowEl.dataset.stock) || 20;
        if (next === 'het-hang') {
          newStock = 0;
        } else if (next === 'con-hang' && newStock === 0) {
          newStock = 20;
        }
        rowEl.dataset.stock = String(newStock);
        const stockBadge = rowEl.querySelector('[data-stock-badge]');
        if (stockBadge) {
          stockBadge.textContent = newStock > 0 ? `${newStock} sp` : 'Hết hàng (0)';
          stockBadge.className = `inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded ${
            newStock > 0 ? 'text-emerald-800 bg-emerald-50 border border-emerald-200' : 'text-danger-600 bg-danger-600/10 border border-red-200'
          }`;
        }

        const productId = rowEl.dataset.id;
        if (productId) {
          try {
            await fetch(`http://localhost:4000/api/products/${productId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                status: next === 'con-hang',
                stock: newStock,
              }),
            });
          } catch {}
        }
        showToast(`Đã đổi trạng thái sang "${toggleBtn.textContent}"`);
      });

      // EDIT
      const editBtn = rowEl.querySelector('[data-btn-edit]') as HTMLButtonElement | null;
      editBtn?.addEventListener('click', async () => {
        form.reset();
        modalTitle.textContent = 'Chỉnh sửa sản phẩm';
        (document.getElementById('form-mode') as HTMLInputElement).value = 'edit';
        (document.getElementById('form-original-slug') as HTMLInputElement).value = rowEl.dataset.slug ?? '';

        (document.getElementById('prod-name') as HTMLInputElement).value = rowEl.dataset.name ?? '';
        (document.getElementById('prod-slug') as HTMLInputElement).value = rowEl.dataset.slug ?? '';
        (document.getElementById('prod-price') as HTMLInputElement).value = rowEl.dataset.price ?? '';
        (document.getElementById('prod-compare-price') as HTMLInputElement).value = rowEl.dataset.comparePrice ?? '';
        (document.getElementById('prod-stock') as HTMLInputElement).value = rowEl.dataset.stock || '20';
        (document.getElementById('prod-category') as HTMLSelectElement).value = rowEl.dataset.category ?? '';
        (document.getElementById('prod-space') as HTMLSelectElement).value = rowEl.dataset.space ?? '';
        (document.getElementById('prod-material') as HTMLInputElement).value = rowEl.dataset.material ?? '';
        (document.getElementById('prod-status') as HTMLSelectElement).value = rowEl.dataset.status ?? 'con-hang';
        (document.getElementById('prod-dimensions') as HTMLInputElement).value = rowEl.dataset.dimensions ?? '';
        (document.getElementById('prod-warranty') as HTMLInputElement).value = rowEl.dataset.warranty ?? '';
        (document.getElementById('prod-desc') as HTMLTextAreaElement).value = rowEl.dataset.desc ?? '';

        // Pre-fill image preview
        const currentImg = rowEl.dataset.image || rowEl.querySelector('img')?.src;
        if (currentImg && currentImg.trim() !== '' && !currentImg.includes('broken')) {
          currentUploadedMainUrl = currentImg;
          mainPreview.src = currentImg;
          if (mainImgUrlInput) mainImgUrlInput.value = currentImg;
          mainPreviewWrapper?.classList.remove('hidden');
          mainPlaceholder?.classList.add('hidden');
        } else {
          currentUploadedMainUrl = '';
          mainPreview.src = '';
          if (mainImgUrlInput) mainImgUrlInput.value = '';
          mainPreviewWrapper?.classList.add('hidden');
          mainPlaceholder?.classList.remove('hidden');
        }

        detailImgFileInput.value = '';
        currentDetailImages = [];
        renderDetailPreviews([]);
        mainImgError?.classList.add('hidden');

        modal.classList.remove('hidden');

        // Fetch chi tiết sản phẩm từ API để lấy toàn bộ ảnh chi tiết và giá chuẩn đã lưu trong DB
        const editSlug = rowEl.dataset.slug;
        if (editSlug) {
          detailContainer.innerHTML = `
            <div class="col-span-3 flex items-center justify-center py-4 gap-2 text-xs text-clay-600">
              <div class="h-4 w-4 border-2 border-clay-600 border-t-transparent rounded-full animate-spin"></div>
              <span>Đang tải ảnh chi tiết...</span>
            </div>
          `;
          try {
            const res = await fetch(`http://localhost:4000/api/products/${editSlug}`);
            if (res.ok) {
              const json = await res.json();
              if (json.success && json.data) {
                const prodData = json.data;
                const mainUrl = currentUploadedMainUrl || prodData.images?.find((i: any) => i.isThumbnail)?.url;
                const detailUrls: string[] = (prodData.images || [])
                  .filter((i: any) => !i.isThumbnail && i.url && i.url !== mainUrl)
                  .map((i: any) => i.url);

                currentDetailImages = detailUrls;
                renderDetailPreviews(currentDetailImages);

                if (prodData.variants?.[0]) {
                  const v = prodData.variants[0];
                  if (v.price && !(document.getElementById('prod-price') as HTMLInputElement).value) {
                    (document.getElementById('prod-price') as HTMLInputElement).value = String(v.price);
                    rowEl.dataset.price = String(v.price);
                  }
                  if (v.comparePrice) {
                    (document.getElementById('prod-compare-price') as HTMLInputElement).value = String(v.comparePrice);
                    rowEl.dataset.comparePrice = String(v.comparePrice);
                  } else if (v.comparePrice === null) {
                    (document.getElementById('prod-compare-price') as HTMLInputElement).value = '';
                    rowEl.dataset.comparePrice = '';
                  }
                  if (v.dimensions && !(document.getElementById('prod-dimensions') as HTMLInputElement).value) {
                    (document.getElementById('prod-dimensions') as HTMLInputElement).value = v.dimensions;
                  }
                }
              } else {
                renderDetailPreviews([]);
              }
            } else {
              renderDetailPreviews([]);
            }
          } catch {
            renderDetailPreviews([]);
          }
        }
      });

      // DELETE
      const deleteBtn = rowEl.querySelector('[data-btn-delete]') as HTMLButtonElement | null;
      deleteBtn?.addEventListener('click', () => {
        const slug = rowEl.dataset.slug;
        const name = rowEl.dataset.name ?? 'sản phẩm này';
        targetSlugToDelete = slug || null;
        deleteItemNameEl.textContent = `Bạn có chắc chắn muốn xóa "${name}" không? Thao tác này không thể hoàn tác.`;
        deleteModal.classList.remove('hidden');
      });
    };

    // DELETE MODAL LOGIC
    const deleteModal = document.getElementById('delete-modal') as HTMLElement;
    const deleteItemNameEl = document.getElementById('delete-item-name') as HTMLElement;
    const btnCancelDelete = document.getElementById('btn-cancel-delete') as HTMLButtonElement;
    const btnConfirmDelete = document.getElementById('btn-confirm-delete') as HTMLButtonElement;
    let targetSlugToDelete: string | null = null;

    btnCancelDelete?.addEventListener('click', () => {
      deleteModal.classList.add('hidden');
      targetSlugToDelete = null;
    });

    btnConfirmDelete?.addEventListener('click', async () => {
      if (!targetSlugToDelete) return;
      const idx = rows.findIndex((r) => r.dataset.slug === targetSlugToDelete);
      if (idx !== -1) {
        const removed = rows[idx];
        const productId = removed.dataset.id;
        if (productId) {
          try {
            const res = await fetch(`http://localhost:4000/api/products/${productId}`, {
              method: 'DELETE',
              headers: getAuthHeaders(),
            });
            const json = await res.json();
            if (!res.ok || !json.success) {
              showToast(json.message || '⚠️ Không thể xóa sản phẩm khỏi cơ sở dữ liệu!');
              deleteModal.classList.add('hidden');
              targetSlugToDelete = null;
              return;
            }
          } catch (err) {
            console.error('Lỗi khi xóa sản phẩm:', err);
            showToast('⚠️ Không thể kết nối tới máy chủ để xóa sản phẩm!');
            deleteModal.classList.add('hidden');
            targetSlugToDelete = null;
            return;
          }
        }
        rows.splice(idx, 1);
        showToast(`Đã xóa "${removed.dataset.name}" khỏi danh sách!`);
        deleteModal.classList.add('hidden');
        targetSlugToDelete = null;
        render();
      }
    });


    // ATTACH TO INITIAL ROWS
    rows.forEach(attachRowEvents);

    // FIRST RENDER
    render();
  });
</script>
