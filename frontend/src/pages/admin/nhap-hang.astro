        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        padding: 0;
        margin: 0;
      }
      .no-print { display: none !important; }
    }
  </style>

  <script define:vars={{ initialSlips, initialSuppliers, productList }}>
    // Biến toàn cục từ SSR
    window.__SLIPS = initialSlips || [];
    window.__SUPPLIERS = initialSuppliers || [];
    window.__PRODUCTS = productList || [];

    const formatMoney = (amount) => {
      return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount || 0);
    };

    document.addEventListener('DOMContentLoaded', () => {
      // 1. Chuyển Tab
      const tabBtns = document.querySelectorAll('.tab-trigger');
      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabBtns.forEach((b) => {
            b.classList.remove('bg-[#173524]', 'text-white');
            b.classList.add('text-walnut-800/80');
          });
          btn.classList.add('bg-[#173524]', 'text-white');
          btn.classList.remove('text-walnut-800/80');

          const targetId = btn.getAttribute('data-target');
          document.querySelectorAll('.tab-pane').forEach((p) => p.classList.add('hidden'));
          document.getElementById(targetId)?.classList.remove('hidden');
        });
      });

      // 2. Tìm kiếm phiếu nhập
      const searchInput = document.getElementById('search-slips-input');
      const filterPay = document.getElementById('filter-payment-status');
      const filterSlips = () => {
        const q = searchInput?.value.toLowerCase().trim() || '';
        const pay = filterPay?.value || '';
        document.querySelectorAll('.slip-row').forEach((row) => {
          const code = row.getAttribute('data-code')?.toLowerCase() || '';
          const ncc = row.getAttribute('data-ncc')?.toLowerCase() || '';
          const matchQ = !q || code.includes(q) || ncc.includes(q);
          row.style.display = matchQ ? '' : 'none';
        });
      };
      searchInput?.addEventListener('input', filterSlips);
      filterPay?.addEventListener('change', filterSlips);

      // 3. Đóng mở modals
      const openModal = (id) => document.getElementById(id)?.classList.remove('hidden');
      const closeModal = (id) => document.getElementById(id)?.classList.add('hidden');
      document.querySelectorAll('.btn-close-modal').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('[id^="modal-"]').forEach((m) => m.classList.add('hidden'));
        });
      });

      // Mở modal tạo phiếu nhập
      const btnOpenCreate = document.getElementById('btn-open-create-slip');
      btnOpenCreate?.addEventListener('click', () => {
        const dateInput = document.getElementById('slip-import-date');
        if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];
        // Xóa các dòng cũ và tạo 1 dòng trống
        const body = document.getElementById('slip-items-body');
        if (body) {
          body.innerHTML = '';
          addRow();
        }
        updateSlipCalculations();
        openModal('modal-create-slip');
      });

      // Mở modal thêm nhà cung cấp
      document.getElementById('btn-open-add-supplier')?.addEventListener('click', () => {
        openModal('modal-add-supplier');
      });

      // Đóng dropdown khi click bên ngoài
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.product-picker')) {
          document.querySelectorAll('.picker-dropdown').forEach((d) => d.classList.add('hidden'));
          document.querySelectorAll('.chevron-icon').forEach((c) => c.classList.remove('rotate-180'));
        }
      });

      // Tạo dòng sản phẩm trong phiếu nhập (Searchable Dropdown có ảnh & SKU)
      const addRow = () => {
        const body = document.getElementById('slip-items-body');
        if (!body) return;
        const tr = document.createElement('tr');
        tr.className = 'item-row hover:bg-sand-50/50 relative';

        // Tạo danh sách sản phẩm dạng item card đẹp mắt
        let itemsListHtml = '';
        if (window.__PRODUCTS && window.__PRODUCTS.length > 0) {
          window.__PRODUCTS.forEach((p) => {
            const thumb = p.thumbnail || '/placeholder.png';
            if (p.variants && p.variants.length > 0) {
              p.variants.forEach((v) => {
                const cost = v.cost_price || Math.round(v.price * 0.6);
                const subInfo = [v.sku, v.color, v.dimensions].filter(Boolean).join(' • ');
                itemsListHtml += `
                  <div class="picker-item p-2.5 hover:bg-sand-100 cursor-pointer transition-colors flex items-center justify-between gap-2.5 group"
                       data-val="${v.id}"
                       data-type="variant"
                       data-name="${p.name}"
                       data-sku="${v.sku || ''}"
                       data-thumb="${thumb}"
                       data-price="${v.price || 0}"
                       data-cost="${cost}">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <img src="${thumb}" class="w-9 h-9 object-cover rounded-none border border-walnut-900/15 bg-white shrink-0" onerror="this.src='/placeholder.png'" />
                      <div class="min-w-0">
                        <p class="text-xs font-bold text-walnut-900 group-hover:text-[#173524] truncate">${p.name}</p>
                        <p class="text-[10px] text-walnut-800/70 truncate mt-0.5">${subInfo}</p>
                      </div>
                    </div>
                    <div class="text-right shrink-0">
                      <p class="text-xs font-bold text-emerald-800">${formatMoney(v.price)}</p>
                      <p class="text-[10px] text-walnut-800/60">Vốn gợi ý: ${formatMoney(cost)}</p>
                    </div>
                  </div>
                `;
              });
            } else {
              const cost = Math.round((p.price || 0) * 0.6);
              const subInfo = p.categoryLabel || p.category || 'Nội thất';
              itemsListHtml += `
                <div class="picker-item p-2.5 hover:bg-sand-100 cursor-pointer transition-colors flex items-center justify-between gap-2.5 group"
                     data-val="p_${p.id}"
                     data-type="product"
                     data-name="${p.name}"
                     data-sku="${p.slug || ''}"
                     data-thumb="${thumb}"
                     data-price="${p.price || 0}"
                     data-cost="${cost}">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <img src="${thumb}" class="w-9 h-9 object-cover rounded-none border border-walnut-900/15 bg-white shrink-0" onerror="this.src='/placeholder.png'" />
                    <div class="min-w-0">
                      <p class="text-xs font-bold text-walnut-900 group-hover:text-[#173524] truncate">${p.name}</p>
                      <p class="text-[10px] text-walnut-800/70 truncate mt-0.5">${subInfo}</p>
                    </div>
                  </div>
                  <div class="text-right shrink-0">
                    <p class="text-xs font-bold text-emerald-800">${formatMoney(p.price)}</p>
                    <p class="text-[10px] text-walnut-800/60">Vốn gợi ý: ${formatMoney(cost)}</p>
                  </div>
                </div>
              `;
            }
          });
        } else {
          itemsListHtml = '<p class="p-4 text-xs text-center text-walnut-800/60">Chưa có dữ liệu sản phẩm trong hệ thống</p>';
        }

        tr.innerHTML = `
          <td class="py-2.5 px-3 relative align-middle">
            <div class="product-picker relative">
              <!-- Trigger Box -->
              <button
                type="button"
                class="btn-trigger-picker w-full flex items-center justify-between gap-2 px-3 py-2 border border-walnut-900/20 bg-white hover:border-[#173524] transition-all text-left rounded-none shadow-xs cursor-pointer group"
              >
                <div class="flex items-center gap-2.5 min-w-0 flex-1">
                  <div class="w-8 h-8 rounded-none border border-walnut-900/15 bg-sand-100 overflow-hidden flex items-center justify-center shrink-0">
                    <img class="picker-thumb hidden w-full h-full object-cover" src="" alt="" />
                    <span class="picker-placeholder text-walnut-800/40">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                      </svg>
                    </span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="picker-title text-xs font-bold text-walnut-900 truncate">-- Nhấn để chọn sản phẩm --</p>
                    <p class="picker-subtitle text-[10px] text-walnut-800/60 truncate">Tìm kiếm theo tên hoặc mã SKU</p>
                  </div>
                </div>
                <svg class="w-4 h-4 text-walnut-800/60 group-hover:text-[#173524] transition-transform duration-200 chevron-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <input type="hidden" class="item-select-val" value="" />
              <input type="hidden" class="item-name-val" value="" />
              <input type="hidden" class="item-sku-val" value="" />
              <input type="hidden" class="item-price-val" value="0" />

              <!-- Dropdown Menu nổi -->
              <div class="picker-dropdown hidden absolute top-full left-0 z-50 mt-1 w-[380px] bg-white border border-walnut-900/30 shadow-2xl rounded-none flex flex-col">
                <!-- Thanh tìm kiếm ghim trên đầu -->
                <div class="p-2 border-b border-walnut-900/15 bg-sand-50/90">
                  <div class="relative">
                    <svg class="w-3.5 h-3.5 text-walnut-800/50 absolute left-2.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input
                      type="text"
                      placeholder="Gõ tên hoặc mã sản phẩm..."
                      class="picker-search w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-walnut-900/20 rounded-none outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] transition-colors"
                    />
                  </div>
                </div>

                <!-- Danh sách sản phẩm cuộn được -->
                <div class="picker-list max-h-56 overflow-y-auto divide-y divide-walnut-900/10">
                  ${itemsListHtml}
                </div>
              </div>
            </div>
          </td>
          <td class="py-2.5 px-3 text-center align-middle">
            <input type="number" min="1" value="1" class="item-qty w-20 px-2.5 py-2 rounded-none border border-walnut-900/20 text-center font-bold text-xs bg-white outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] shadow-xs" />
          </td>
          <td class="py-2.5 px-3 text-right align-middle">
            <input type="number" min="0" step="1000" value="0" class="item-cost w-36 px-2.5 py-2 rounded-none border border-walnut-900/20 text-right font-bold text-xs bg-white text-[#173524] outline-none focus:border-[#173524] focus:ring-1 focus:ring-[#173524] shadow-xs" />
          </td>
          <td class="py-2.5 px-3 text-right font-bold text-walnut-900 item-total align-middle">
            0 đ
          </td>
          <td class="py-2.5 px-3 text-center align-middle">
            <button type="button" class="btn-remove-row text-red-600 hover:text-red-800 p-1.5 font-bold text-base cursor-pointer hover:scale-110 transition-transform" title="Xóa dòng này">✕</button>
          </td>
        `;

        const picker = tr.querySelector('.product-picker');
        const triggerBtn = tr.querySelector('.btn-trigger-picker');
        const dropdown = tr.querySelector('.picker-dropdown');
        const chevron = tr.querySelector('.chevron-icon');
        const searchInput = tr.querySelector('.picker-search');
        const listContainer = tr.querySelector('.picker-list');
        const titleEl = tr.querySelector('.picker-title');
        const subEl = tr.querySelector('.picker-subtitle');
        const thumbEl = tr.querySelector('.picker-thumb');
        const placeholderEl = tr.querySelector('.picker-placeholder');
        const valInput = tr.querySelector('.item-select-val');
        const nameInput = tr.querySelector('.item-name-val');
        const skuInput = tr.querySelector('.item-sku-val');
        const priceInput = tr.querySelector('.item-price-val');
        const costInput = tr.querySelector('.item-cost');
        const qtyInput = tr.querySelector('.item-qty');
        const btnRemove = tr.querySelector('.btn-remove-row');

        // Bật/tắt dropdown
        triggerBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          const isClosed = dropdown?.classList.contains('hidden');
          // Đóng các dropdown khác trước
          document.querySelectorAll('.picker-dropdown').forEach((d) => d.classList.add('hidden'));
          document.querySelectorAll('.chevron-icon').forEach((c) => c.classList.remove('rotate-180'));

          if (isClosed) {
            dropdown?.classList.remove('hidden');
            chevron?.classList.add('rotate-180');
            searchInput?.focus();
          }
        });

        // Tìm kiếm sản phẩm realtime trong menu
        searchInput?.addEventListener('input', () => {
          const q = searchInput.value.toLowerCase().trim();
          const items = listContainer?.querySelectorAll('.picker-item') || [];
          let matchCount = 0;
          items.forEach((item) => {
            const text = item.textContent?.toLowerCase() || '';
            const match = !q || text.includes(q);
            item.style.display = match ? 'flex' : 'none';
            if (match) matchCount++;
          });
        });

        // Xử lý khi click chọn 1 sản phẩm
        listContainer?.querySelectorAll('.picker-item').forEach((item) => {
          item.addEventListener('click', () => {
            const val = item.getAttribute('data-val') || '';
            const name = item.getAttribute('data-name') || '';
            const sku = item.getAttribute('data-sku') || '';
            const thumb = item.getAttribute('data-thumb') || '';
            const price = parseFloat(item.getAttribute('data-price') || '0');
            const cost = parseFloat(item.getAttribute('data-cost') || '0');

            if (titleEl) titleEl.textContent = name;
            if (subEl) subEl.textContent = `${sku ? 'Mã: ' + sku + ' • ' : ''}Bán: ${formatMoney(price)}`;
            if (thumb && thumbEl && placeholderEl) {
              thumbEl.src = thumb;
              thumbEl.classList.remove('hidden');
              placeholderEl.classList.add('hidden');
            }
            if (valInput) valInput.value = val;
            if (nameInput) nameInput.value = name;
            if (skuInput) skuInput.value = sku;
            if (priceInput) priceInput.value = price;
            if (costInput) costInput.value = cost;

            dropdown?.classList.add('hidden');
            chevron?.classList.remove('rotate-180');

            updateSlipCalculations();
          });
        });

        costInput?.addEventListener('input', updateSlipCalculations);
        qtyInput?.addEventListener('input', updateSlipCalculations);

        btnRemove?.addEventListener('click', () => {
          if (document.querySelectorAll('.item-row').length > 1) {
            tr.remove();
            updateSlipCalculations();
          } else {
            alert('Phiếu nhập phải có ít nhất 1 mặt hàng.');
          }
        });

        body.appendChild(tr);
      };

      document.getElementById('btn-add-item-row')?.addEventListener('click', addRow);

      // Cập nhật tính toán tổng tiền
      const updateSlipCalculations = () => {
        let subtotal = 0;
        document.querySelectorAll('.item-row').forEach((row) => {
          const qty = parseInt(row.querySelector('.item-qty')?.value || '0', 10);
          const cost = parseFloat(row.querySelector('.item-cost')?.value || '0');
          const rowTotal = qty * cost;
          subtotal += rowTotal;
          const totalEl = row.querySelector('.item-total');
          if (totalEl) totalEl.textContent = formatMoney(rowTotal);
        });

        const subtotalEl = document.getElementById('slip-subtotal-display');
        if (subtotalEl) subtotalEl.textContent = formatMoney(subtotal);

        const paidInput = document.getElementById('slip-paid-amount');
        const paid = parseFloat(paidInput?.value || '0');
        const debt = Math.max(0, subtotal - paid);

        const debtEl = document.getElementById('slip-debt-display');
        if (debtEl) debtEl.textContent = formatMoney(debt);
      };

      document.getElementById('slip-paid-amount')?.addEventListener('input', updateSlipCalculations);

      // Submit Form Tạo Phiếu Nhập
      const formCreate = document.getElementById('form-create-slip');
      formCreate?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const supplierSelect = document.getElementById('slip-supplier-id');
        const supplierId = parseInt(supplierSelect?.value, 10);

        if (!supplierId || isNaN(supplierId)) {
          alert('Vui lòng chọn một nhà cung cấp từ danh sách!');
          supplierSelect?.focus();
          return;
        }

        const importDate = document.getElementById('slip-import-date')?.value;
        const referenceCode = document.getElementById('slip-reference-code')?.value;
        const note = document.getElementById('slip-note')?.value;
        const paidAmount = parseFloat(document.getElementById('slip-paid-amount')?.value || '0');
        const paymentMethod = document.getElementById('slip-payment-method')?.value;

        const items = [];
        let hasError = false;

        document.querySelectorAll('.item-row').forEach((row) => {
          const selectVal = row.querySelector('.item-select-val')?.value;
          const qty = parseInt(row.querySelector('.item-qty')?.value || '0', 10);
          const costPrice = parseFloat(row.querySelector('.item-cost')?.value || '0');
          const prodName = row.querySelector('.item-name-val')?.value || '';
          const prodSku = row.querySelector('.item-sku-val')?.value || '';
          const prodPrice = parseFloat(row.querySelector('.item-price-val')?.value || '0');

          if (!selectVal) {
            hasError = true;
            return;
          }

          items.push({
            variantId: selectVal.startsWith('p_') ? null : parseInt(selectVal, 10),
            productId: selectVal.startsWith('p_') ? parseInt(selectVal.replace('p_', ''), 10) : null,
            product_id: selectVal.startsWith('p_') ? parseInt(selectVal.replace('p_', ''), 10) : null,
            variant_id: selectVal.startsWith('p_') ? null : parseInt(selectVal, 10),
            quantity: qty,
            costPrice: costPrice,
            import_price: costPrice,
            productName: prodName,
            product_name: prodName,
            sku: prodSku,
            sellingPrice: prodPrice,
            selling_price: prodPrice,
          });
        });

        if (hasError || items.length === 0) {
          alert('Vui lòng chọn đầy đủ sản phẩm cho mỗi dòng trước khi lưu phiếu.');
          return;
        }

        try {
          const token = localStorage.getItem('admin_token') || localStorage.getItem('auth_token');
          const submitBtn = document.getElementById('btn-submit-create-slip');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Đang lưu...';
          }

          const res = await fetch('http://localhost:4000/api/import-slips', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({
              supplierId,
              supplier_id: supplierId,
              importDate,
              import_date: importDate,
              referenceCode,
              note,
              paidAmount,
              paid_amount: paidAmount,
              paymentMethod,
              payment_method: paymentMethod,
              items
            })
          });

          const data = await res.json();
          if (data.success) {
            alert(data.message || 'Tạo phiếu nhập kho thành công! Đã tự động cập nhật số lượng tồn kho và giá vốn.');
            window.location.reload();
          } else {
            alert(data.message || 'Lỗi khi tạo phiếu nhập.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Lưu & Nhập Kho';
            }
          }
        } catch (err) {
          alert('Lỗi kết nối máy chủ backend.');
        }
      });

      // Hàm xem chi tiết phiếu nhập kho
      const openViewSlip = async (code) => {
        if (!code) return;

        // Tìm trong dữ liệu SSR hiện có trước
        let slip = window.__SLIPS.find((s) => s.code === code || s.slipCode === code || String(s.id) === code);

        // Fetch API chi tiết để luôn lấy dữ liệu mới nhất
        try {
          const res = await fetch(`http://localhost:4000/api/import-slips/${code}`);
          if (res.ok) {
            const resData = await res.json();
            if (resData.success && resData.data) {
              slip = resData.data;
            }
          }
        } catch (e) {
          console.warn('Lỗi fetch chi tiết phiếu, dùng cache:', e);
        }

        if (!slip) {
          alert('Không tìm thấy thông tin phiếu nhập: ' + code);
          return;
        }

        const slipCode = slip.code || slip.slipCode || code;
        const total = Number(slip.totalAmount || 0);
        const paid = Number(slip.paidAmount || 0);
        const debt = Number(slip.debtAmount || Math.max(0, total - paid));
        const isPaid = slip.paymentStatus === 'paid' || debt === 0;
        const isPartial = slip.paymentStatus === 'partial' || (paid > 0 && debt > 0);

        // Header & Mã phiếu
        const codeHeaderEl = document.getElementById('view-slip-code-header');
        if (codeHeaderEl) codeHeaderEl.textContent = slipCode;

        const codeEl = document.getElementById('view-slip-code');
        if (codeEl) codeEl.textContent = slipCode;

        const footerCodeEl = document.getElementById('view-slip-footer-code');
        if (footerCodeEl) footerCodeEl.textContent = slipCode;

        // Ngày & Người tạo
        const dateEl = document.getElementById('view-slip-date');
        if (dateEl) {
          const d = slip.importDate || slip.createdAt;
          dateEl.textContent = d ? `Ngày: ${new Date(d).toLocaleDateString('vi-VN', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' })}` : '--';
        }

        const creatorName = slip.creator?.fullName || slip.creator?.name || 'Quản Trị Viên';
        const creatorEl = document.getElementById('view-slip-creator');
        if (creatorEl) creatorEl.textContent = creatorName;
        const creatorSignEl = document.getElementById('view-slip-creator-sign');
        if (creatorSignEl) creatorSignEl.textContent = creatorName;

        const methodEl = document.getElementById('view-slip-payment-method');
        if (methodEl) {
          methodEl.textContent = slip.paymentMethod === 'cash' ? 'Tiền mặt (Két quỹ showroom)' : 'Chuyển khoản (Ngân hàng)';
        }

        const refEl = document.getElementById('view-slip-ref');
        if (refEl) refEl.textContent = slip.referenceCode || slipCode;

        // Nhà cung cấp
        const suppEl = document.getElementById('view-slip-supplier');
        if (suppEl) suppEl.textContent = slip.supplier?.name || 'Nhà cung cấp';

        const contactEl = document.getElementById('view-slip-contact');
        if (contactEl) {
          const contact = slip.supplier?.contactPerson || slip.supplier?.contact_person || 'Đại diện';
          const phone = slip.supplier?.phone || '';
          contactEl.textContent = `${contact}${phone ? ' • ' + phone : ''}`;
        }

        const emailEl = document.getElementById('view-slip-email');
        if (emailEl) emailEl.textContent = slip.supplier?.email || '—';

        const addressEl = document.getElementById('view-slip-address');
        if (addressEl) addressEl.textContent = slip.supplier?.address || '—';

        // Badge công nợ
        const badgeEl = document.getElementById('view-slip-status-badge');
        if (badgeEl) {
          if (isPaid) {
            badgeEl.className = 'px-2.5 py-1 rounded-none text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300';
            badgeEl.textContent = 'Đã thanh toán đủ';
          } else if (isPartial) {
            badgeEl.className = 'px-2.5 py-1 rounded-none text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300';
            badgeEl.textContent = 'Trả một phần';
          } else {
            badgeEl.className = 'px-2.5 py-1 rounded-none text-[10px] font-bold uppercase tracking-wider bg-red-100 text-red-800 border border-red-300';
            badgeEl.textContent = 'Chưa thanh toán';
          }
        }

        // Bảng danh sách mặt hàng
        const tbody = document.getElementById('view-slip-items-body');
        if (tbody) {
          tbody.innerHTML = '';
          const items = slip.items || slip.import_slip_items || [];
          if (items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-xs text-walnut-800/60">Không có dữ liệu mặt hàng</td></tr>';
          } else {
            items.forEach((item, idx) => {
              const tr = document.createElement('tr');
              tr.className = 'hover:bg-sand-50/50';
              const name = item.productName || item.product_name || item.productVariant?.sku || 'Sản phẩm';
              const sku = item.sku || '—';
              const variantName = item.variantName || item.variant_name || '';
              const qty = item.quantity || 1;
              const cost = item.costPrice || item.importPrice || item.import_price || 0;
              const lineTotal = item.totalPrice || item.total_price || (qty * cost);

              tr.innerHTML = `
                <td class="py-2.5 px-3 border-r border-walnut-900/15 text-center text-walnut-800/70 font-mono">${idx + 1}</td>
                <td class="py-2.5 px-3 border-r border-walnut-900/15">
                  <p class="font-bold text-walnut-900 text-xs">${name}</p>
                  ${variantName ? `<p class="text-[10px] text-walnut-800/60 mt-0.5">${variantName}</p>` : ''}
                </td>
                <td class="py-2.5 px-3 border-r border-walnut-900/15 text-center font-mono text-[11px] text-walnut-800">${sku}</td>
                <td class="py-2.5 px-3 border-r border-walnut-900/15 text-center font-bold text-xs text-[#173524]">${qty}</td>
                <td class="py-2.5 px-3 border-r border-walnut-900/15 text-right font-mono text-xs">${formatMoney(cost)}</td>
                <td class="py-2.5 px-3 text-right font-bold font-mono text-xs text-[#173524]">${formatMoney(lineTotal)}</td>
              `;
              tbody.appendChild(tr);
            });
          }
        }

        // Summary
        const subtotalEl = document.getElementById('view-slip-subtotal');
        if (subtotalEl) subtotalEl.textContent = formatMoney(slip.subtotalAmount || total);

        const totalEl = document.getElementById('view-slip-total');
        if (totalEl) totalEl.textContent = formatMoney(total);

        const paidEl = document.getElementById('view-slip-paid');
        if (paidEl) paidEl.textContent = formatMoney(paid);

        const debtEl = document.getElementById('view-slip-debt');
        if (debtEl) {
          debtEl.textContent = formatMoney(debt);
          debtEl.className = debt > 0 ? 'font-mono text-amber-700 font-bold' : 'font-mono text-emerald-700 font-bold';
        }

        // Ghi chú
        const noteEl = document.getElementById('view-slip-note');
        const noteBox = document.getElementById('view-slip-note-box');
        if (noteEl && noteBox) {
          if (slip.note && slip.note.trim()) {
            noteEl.textContent = slip.note;
            noteBox.classList.remove('hidden');
          } else {
            noteBox.classList.add('hidden');
          }
        }

        // Nút trả nợ trực tiếp từ popup xem chi tiết
        const btnPayInModal = document.getElementById('btn-modal-pay-debt');
        if (btnPayInModal) {
          btnPayInModal.classList.remove('hidden');
          if (debt > 0) {
            btnPayInModal.onclick = () => {
              closeModal('modal-view-slip');
              document.getElementById('pay-slip-code').value = slipCode;
              document.getElementById('pay-ncc-name').textContent = slip.supplier?.name || '';
              document.getElementById('pay-debt-amount').textContent = formatMoney(debt);
              document.getElementById('pay-amount-input').value = debt;
              openModal('modal-pay-debt');
            };
          } else {
            // Đối với các phiếu nhập đã thanh toán, ấn nút trả nợ sẽ hiện thông báo
            btnPayInModal.onclick = () => {
              alert(`Thông báo: Phiếu nhập "${slipCode}" đã được thanh toán đầy đủ!\n\n• Tổng giá trị: ${formatMoney(total)}\n• Đã thanh toán: ${formatMoney(paid)}\n• Công nợ hiện tại: 0 đ\n\nPhiếu nhập này không còn công nợ, bạn không cần phải trả thêm cho phiếu này.`);
            };
          }
        }

        openModal('modal-view-slip');
      };

      // Gán sự kiện click cho các nút Chi Tiết
      document.querySelectorAll('.btn-view-slip').forEach((btn) => {
        btn.addEventListener('click', () => {
          const code = btn.getAttribute('data-code');
          openViewSlip(code);
        });
      });

      // Nút In
      document.getElementById('btn-print-slip')?.addEventListener('click', () => {
        window.print();
      });

      // Nút Trả Nợ
      document.querySelectorAll('.btn-pay-debt').forEach((btn) => {
        btn.addEventListener('click', () => {
          const code = btn.getAttribute('data-code');
          const debt = parseFloat(btn.getAttribute('data-debt') || '0');
          const ncc = btn.getAttribute('data-ncc');

          if (debt <= 0) {
            alert(`Thông báo: Phiếu nhập "${code}" đã được thanh toán đầy đủ (Công nợ: 0 đ).\n\nKhông cần thực hiện chi trả nợ thêm cho phiếu này.`);
            return;
          }

          document.getElementById('pay-slip-code').value = code;
          document.getElementById('pay-ncc-name').textContent = ncc;
          document.getElementById('pay-debt-amount').textContent = formatMoney(debt);
          document.getElementById('pay-amount-input').value = debt;

          openModal('modal-pay-debt');
        });
      });

      // Submit Trả Nợ
      document.getElementById('form-pay-debt')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = document.getElementById('pay-slip-code')?.value;
        const amount = parseFloat(document.getElementById('pay-amount-input')?.value || '0');
        const paymentMethod = document.getElementById('pay-method-select')?.value;
        const note = document.getElementById('pay-note-input')?.value;

        try {
          const token = localStorage.getItem('admin_token') || localStorage.getItem('auth_token');
          const res = await fetch(`http://localhost:4000/api/import-slips/${code}/pay`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ amount, paymentMethod, note })
          });
          const data = await res.json();
          if (data.success) {
            alert('Thanh toán nợ thành công! Đã tự động tạo phiếu chi trong Sổ Quỹ.');
            window.location.reload();
          } else {
            alert(data.message || 'Lỗi thanh toán.');
          }
        } catch {
          alert('Lỗi kết nối máy chủ.');
        }
      });

      // Submit Thêm Nhà Cung Cấp
      document.getElementById('form-add-supplier')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('new-supp-name')?.value;
        const contactPerson = document.getElementById('new-supp-contact')?.value;
        const phone = document.getElementById('new-supp-phone')?.value;
        const email = document.getElementById('new-supp-email')?.value;
        const address = document.getElementById('new-supp-address')?.value;
        const taxCode = document.getElementById('new-supp-tax')?.value;

        try {
          const token = localStorage.getItem('admin_token') || localStorage.getItem('auth_token');
          const res = await fetch('http://localhost:4000/api/suppliers', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ name, contactPerson, phone, email, address, taxCode })
          });
          const data = await res.json();
          if (data.success) {
            alert('Thêm nhà cung cấp thành công!');
            window.location.reload();
          } else {
            alert(data.message || 'Lỗi thêm NCC.');
          }
        } catch {
          alert('Lỗi kết nối máy chủ.');
        }
      });

      // Mở Modal Chỉnh Sửa Nhà Cung Cấp
      document.querySelectorAll('.btn-edit-supplier').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const code = btn.getAttribute('data-code');
          const name = btn.getAttribute('data-name');
          const contact = btn.getAttribute('data-contact');
          const phone = btn.getAttribute('data-phone');
          const email = btn.getAttribute('data-email');
          const address = btn.getAttribute('data-address');
          const status = btn.getAttribute('data-status');

          const idEl = document.getElementById('edit-supp-id');
          const codeEl = document.getElementById('edit-supp-code-badge');
          const nameEl = document.getElementById('edit-supp-name');
          const contactEl = document.getElementById('edit-supp-contact');
          const phoneEl = document.getElementById('edit-supp-phone');
          const emailEl = document.getElementById('edit-supp-email');
          const addressEl = document.getElementById('edit-supp-address');
          const statusEl = document.getElementById('edit-supp-status');

          if (idEl) idEl.value = id;
          if (codeEl) codeEl.textContent = `Mã: ${code}`;
          if (nameEl) nameEl.value = name;
          if (contactEl) contactEl.value = contact;
          if (phoneEl) phoneEl.value = phone;
          if (emailEl) emailEl.value = email;
          if (addressEl) addressEl.value = address;
          if (statusEl) statusEl.value = status;

          openModal('modal-edit-supplier');
        });
      });

      // Submit Cập Nhật Nhà Cung Cấp
      document.getElementById('form-edit-supplier')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('edit-supp-id')?.value;
        const name = document.getElementById('edit-supp-name')?.value;
        const contactPerson = document.getElementById('edit-supp-contact')?.value;
        const phone = document.getElementById('edit-supp-phone')?.value;
        const email = document.getElementById('edit-supp-email')?.value;
        const address = document.getElementById('edit-supp-address')?.value;
        const status = document.getElementById('edit-supp-status')?.value === '1';

        try {
          const token = localStorage.getItem('admin_token') || localStorage.getItem('auth_token');
          const res = await fetch(`http://localhost:4000/api/suppliers/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ name, contactPerson, phone, email, address, status })
          });
          const data = await res.json();
          if (data.success) {
            alert('Cập nhật thông tin nhà cung cấp thành công!');
            window.location.reload();
          } else {
            alert(data.message || 'Lỗi cập nhật NCC.');
          }
        } catch {
          alert('Lỗi kết nối máy chủ.');
        }
      });

      // Xóa / Ngừng Hợp Tác Nhà Cung Cấp
      document.querySelectorAll('.btn-delete-supplier').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          const name = btn.getAttribute('data-name');
          const slipCount = parseInt(btn.getAttribute('data-slips') || '0', 10);

          let confirmMsg = `Bạn có chắc chắn muốn xóa nhà cung cấp "${name}"?`;
          if (slipCount > 0) {
            confirmMsg = `Nhà cung cấp "${name}" hiện có ${slipCount} phiếu nhập kho liên kết trong CSDL.\n\nHệ thống sẽ chuyển trạng thái đối tác sang "Ngừng hợp tác" để bảo toàn số liệu kế toán. Bạn có muốn tiếp tục?`;
          }

          if (!confirm(confirmMsg)) return;

          try {
            const token = localStorage.getItem('admin_token') || localStorage.getItem('auth_token');
            const res = await fetch(`http://localhost:4000/api/suppliers/${id}`, {
              method: 'DELETE',
              headers: {
                'Authorization': `Bearer ${token}`
              }
            });
            const data = await res.json();
            if (data.success) {
              alert(data.message || 'Thao tác thành công!');
              window.location.reload();
            } else {
              alert(data.message || 'Lỗi khi xóa nhà cung cấp.');
            }
          } catch {
            alert('Lỗi kết nối máy chủ.');
          }
        });
      });
    });
  </script>
</AdminLayout>
