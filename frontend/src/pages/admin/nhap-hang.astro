---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatVnd } from '../../data/products';

// Fetch dữ liệu khởi tạo server-side
let initialSlips: any[] = [];
let initialSuppliers: any[] = [];
let initialKpis = {
  totalSlips: 0,
  totalImportValue: 0,
  totalPaid: 0,
  totalDebt: 0,
  totalItemsImported: 0
};
let productList: any[] = [];

try {
  const [slipsRes, suppRes, prodRes] = await Promise.all([
    fetch('http://localhost:4000/api/import-slips', { signal: AbortSignal.timeout(3000) }),
    fetch('http://localhost:4000/api/suppliers', { signal: AbortSignal.timeout(3000) }),
    fetch('http://localhost:4000/api/products?limit=100', { signal: AbortSignal.timeout(3000) }),
  ]);

  if (slipsRes.ok) {
    const slipsData = await slipsRes.json();
    if (slipsData.success) {
      initialSlips = slipsData.data || [];
      initialKpis = slipsData.kpis || initialKpis;
    }
  }

  if (suppRes.ok) {
    const suppData = await suppRes.json();
    if (suppData.success) {
      initialSuppliers = suppData.data || [];
    }
  }

  if (prodRes.ok) {
    const prodData = await prodRes.json();
    if (prodData.success) {
      productList = prodData.data || [];
    }
  }
} catch (e) {
  console.error('Lỗi SSR tải dữ liệu nhập hàng:', e);
}
---

<AdminLayout title="Quản lý Nhập Hàng & Nhà Cung Cấp | KTUFA Admin">
  <div class="space-y-6 max-w-7xl mx-auto pb-12">
    
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl border border-walnut-900/10 shadow-sm">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-[#173524]/10 text-[#173524]">
            <span class="w-2 h-2 rounded-full bg-[#173524] animate-pulse"></span>
            Kho Vận & Giá Vốn
          </span>
          <span class="text-xs text-walnut-800/60">• Cập nhật tồn kho tự động</span>
        </div>
        <h1 class="text-2xl font-bold font-display text-[#173524] mt-1">Quản Lý Nhập Hàng & Nhà Cung Cấp</h1>
        <p class="text-xs text-walnut-800/70 mt-0.5">Theo dõi lịch sử nhập kho, cập nhật giá vốn (COGS) chuẩn xác và quản lý công nợ nhà cung cấp</p>
      </div>

      <div class="flex items-center gap-2.5">
        <button
          id="btn-open-add-supplier"
          type="button"
          class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl border border-walnut-900/15 bg-white text-xs font-bold text-[#173524] hover:bg-sand-50 transition-colors shadow-sm"
        >
          <svg class="w-4 h-4 text-[#D8B670]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          Thêm Nhà Cung Cấp
        </button>

        <button
          id="btn-open-create-slip"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#173524] text-xs font-bold text-white hover:bg-[#1f4730] transition-colors shadow-md shadow-[#173524]/15"
        >
          <svg class="w-4 h-4 text-[#D8B670]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Tạo Phiếu Nhập Mới
        </button>
      </div>
    </div>

    <!-- Bento 4 KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- KPI 1: Tổng tiền nhập kho -->
      <div class="bg-white p-5 rounded-2xl border border-walnut-900/10 shadow-sm relative overflow-hidden group hover:border-[#D8B670] transition-all">
        <div class="absolute -right-4 -bottom-4 w-20 h-20 bg-blue-50 rounded-full group-hover:scale-110 transition-transform -z-0"></div>
        <div class="relative z-10">
          <p class="text-[11px] font-bold uppercase tracking-wider text-walnut-800/60">Tổng Tiền Nhập Hàng</p>
          <p id="kpi-total-import" class="text-xl font-bold font-display text-[#173524] mt-2">
            {formatVnd(initialKpis.totalImportValue)}
          </p>
          <div class="mt-2 flex items-center gap-1.5 text-xs text-blue-700">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <span>{initialKpis.totalSlips} phiếu nhập đã ghi nhận</span>
          </div>
        </div>
      </div>

      <!-- KPI 2: Đã thanh toán -->
      <div class="bg-white p-5 rounded-2xl border border-walnut-900/10 shadow-sm relative overflow-hidden group hover:border-emerald-500 transition-all">
        <div class="absolute -right-4 -bottom-4 w-20 h-20 bg-emerald-50 rounded-full group-hover:scale-110 transition-transform -z-0"></div>
        <div class="relative z-10">
          <p class="text-[11px] font-bold uppercase tracking-wider text-walnut-800/60">Đã Thanh Toán NCC</p>
          <p id="kpi-total-paid" class="text-xl font-bold font-display text-emerald-700 mt-2">
            {formatVnd(initialKpis.totalPaid)}
          </p>
          <div class="mt-2 flex items-center gap-1.5 text-xs text-emerald-700">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Dòng tiền chi trả thực tế</span>
          </div>
        </div>
      </div>

      <!-- KPI 3: Còn nợ NCC -->
      <div class="bg-white p-5 rounded-2xl border border-walnut-900/10 shadow-sm relative overflow-hidden group hover:border-amber-500 transition-all">
        <div class="absolute -right-4 -bottom-4 w-20 h-20 bg-amber-50 rounded-full group-hover:scale-110 transition-transform -z-0"></div>
        <div class="relative z-10">
          <p class="text-[11px] font-bold uppercase tracking-wider text-walnut-800/60">Nợ Nhà Cung Cấp</p>
          <p id="kpi-total-debt" class="text-xl font-bold font-display text-amber-700 mt-2">
            {formatVnd(initialKpis.totalDebt)}
          </p>
          <div class="mt-2 flex items-center gap-1.5 text-xs text-amber-700">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>Công nợ phải trả theo hạn</span>
          </div>
        </div>
      </div>

      <!-- KPI 4: Mặt hàng nhập kho -->
      <div class="bg-white p-5 rounded-2xl border border-walnut-900/10 shadow-sm relative overflow-hidden group hover:border-[#173524] transition-all">
        <div class="absolute -right-4 -bottom-4 w-20 h-20 bg-[#173524]/5 rounded-full group-hover:scale-110 transition-transform -z-0"></div>
        <div class="relative z-10">
          <p class="text-[11px] font-bold uppercase tracking-wider text-walnut-800/60">Hàng Hóa Nhập Kho</p>
          <p id="kpi-total-items" class="text-xl font-bold font-display text-[#173524] mt-2">
            {initialKpis.totalItemsImported} <span class="text-sm font-normal text-walnut-800/60">sản phẩm</span>
          </p>
          <div class="mt-2 flex items-center gap-1.5 text-xs text-[#173524]">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
            <span>Cập nhật số lượng tồn kho tự động</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center gap-2 border-b border-walnut-900/10 pb-2">
      <button
        id="tab-btn-slips"
        type="button"
        class="tab-trigger px-4 py-2 text-xs font-bold rounded-lg transition-colors bg-[#173524] text-white"
        data-target="tab-content-slips"
      >
        Lịch Sử Phiếu Nhập Kho ({initialSlips.length})
      </button>
      <button
        id="tab-btn-suppliers"
        type="button"
        class="tab-trigger px-4 py-2 text-xs font-bold rounded-lg transition-colors text-walnut-800/80 hover:bg-walnut-900/5"
        data-target="tab-content-suppliers"
      >
        Danh Sách Nhà Cung Cấp ({initialSuppliers.length})
      </button>
    </div>

    <!-- TAB 1: Danh Sách Phiếu Nhập -->
    <div id="tab-content-slips" class="tab-pane space-y-4">
      <div class="bg-white rounded-2xl border border-walnut-900/10 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-walnut-900/10 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-sand-50/50">
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-[#173524] uppercase tracking-wider">Danh Sách Phiếu Nhập</span>
            <span class="text-xs text-walnut-800/60">|</span>
            <input
              id="search-slips-input"
              type="text"
              placeholder="Tìm theo mã phiếu, NCC..."
              class="px-3 py-1.5 rounded-lg border border-walnut-900/15 text-xs bg-white focus:outline-none focus:border-[#173524] w-64"
            />
          </div>

          <div class="flex items-center gap-2">
            <select id="filter-payment-status" class="px-3 py-1.5 rounded-lg border border-walnut-900/15 text-xs bg-white text-walnut-800 focus:outline-none">
              <option value="">Tất cả thanh toán</option>
              <option value="paid">Đã thanh toán đủ</option>
              <option value="partial">Thanh toán 1 phần</option>
              <option value="unpaid">Chưa thanh toán</option>
            </select>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-walnut-900">
            <thead class="bg-sand-100/70 border-b border-walnut-900/10 text-[11px] uppercase tracking-wider text-walnut-800/70">
              <tr>
                <th class="py-3 px-4 font-bold">Mã Phiếu</th>
                <th class="py-3 px-4 font-bold">Ngày Nhập</th>
                <th class="py-3 px-4 font-bold">Nhà Cung Cấp</th>
                <th class="py-3 px-4 font-bold text-center">Mặt Hàng</th>
                <th class="py-3 px-4 font-bold text-right">Tổng Tiền</th>
                <th class="py-3 px-4 font-bold text-right">Đã Trả</th>
                <th class="py-3 px-4 font-bold text-right">Còn Nợ</th>
                <th class="py-3 px-4 font-bold text-center">Thanh Toán</th>
                <th class="py-3 px-4 font-bold text-right">Thao Tác</th>
              </tr>
            </thead>
            <tbody id="slips-table-body" class="divide-y divide-walnut-900/5">
              {initialSlips.length === 0 ? (
                <tr>
                  <td colspan="9" class="py-8 text-center text-xs text-walnut-800/60">
                    Chưa có phiếu nhập hàng nào. Bấm "Tạo Phiếu Nhập Mới" để bắt đầu.
                  </td>
                </tr>
              ) : (
                initialSlips.map((slip) => {
                  const slipCode = slip.code || slip.slipCode || '';
                  const total = Number(slip.totalAmount || 0);
                  const paid = Number(slip.paidAmount || 0);
                  const debt = Number(slip.debtAmount || Math.max(0, total - paid));
                  const isPaid = slip.paymentStatus === 'paid' || debt === 0;
                  const isPartial = slip.paymentStatus === 'partial' || (paid > 0 && debt > 0);
                  return (
                    <tr class="hover:bg-sand-50/60 transition-colors slip-row" data-code={slipCode} data-ncc={slip.supplier?.name || ''}>
                      <td class="py-3 px-4 font-mono font-bold text-[#173524]">{slipCode}</td>
                      <td class="py-3 px-4 text-walnut-800/80">
                        {new Date(slip.importDate || slip.createdAt).toLocaleDateString('vi-VN')}
                      </td>
                      <td class="py-3 px-4">
                        <p class="font-bold text-[#173524]">{slip.supplier?.name || 'NCC không xác định'}</p>
                        <p class="text-[10px] text-walnut-800/60">{slip.supplier?.phone || ''}</p>
                      </td>
                      <td class="py-3 px-4 text-center">
                        <span class="inline-block px-2 py-0.5 rounded-none bg-sand-100 text-[11px] font-semibold text-walnut-800 border border-walnut-900/10">
                          {slip.items?.length || slip.itemsCount || 0} mặt hàng
                        </span>
                      </td>
                      <td class="py-3 px-4 text-right font-bold text-walnut-900">
                        {formatVnd(total)}
                      </td>
                      <td class="py-3 px-4 text-right font-semibold text-emerald-700">
                        {formatVnd(paid)}
                      </td>
                      <td class="py-3 px-4 text-right font-bold text-amber-700">
                        {formatVnd(debt)}
                      </td>
                      <td class="py-3 px-4 text-center">
                        <span class={`inline-flex px-2 py-0.5 rounded-none text-[10px] font-bold uppercase tracking-wider ${
                          isPaid ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : (isPartial ? 'bg-amber-100 text-amber-800 border border-amber-300' : 'bg-red-100 text-red-800 border border-red-300')
                        }`}>
                          {isPaid ? 'Đã thanh toán' : (isPartial ? 'Trả 1 phần' : 'Chưa trả')}
                        </span>
                      </td>
                      <td class="py-3 px-4 text-right space-x-1.5 whitespace-nowrap">
                        <button
                          type="button"
                          class="btn-view-slip px-2.5 py-1.5 rounded-none bg-[#173524]/10 text-[#173524] hover:bg-[#173524] hover:text-white transition-colors text-[11px] font-bold border border-[#173524]/20 cursor-pointer shadow-xs inline-flex items-center gap-1"
                          data-code={slipCode}
                        >
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                          </svg>
                          Chi Tiết
                        </button>
                        {debt > 0 && (
                          <button
                            type="button"
                            class="btn-pay-debt px-2.5 py-1.5 rounded-none bg-amber-100 text-amber-900 hover:bg-amber-200 transition-colors text-[11px] font-bold border border-amber-300 cursor-pointer shadow-xs inline-flex items-center gap-1"
                            data-code={slipCode}
                            data-debt={debt}
                            data-ncc={slip.supplier?.name || ''}
                          >
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                            Trả Nợ
                          </button>
                        )}
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 2: Danh Sách Nhà Cung Cấp -->
    <div id="tab-content-suppliers" class="tab-pane hidden space-y-4">
      <div class="bg-white rounded-2xl border border-walnut-900/10 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-walnut-900/10 bg-sand-50/50 flex items-center justify-between">
          <span class="text-xs font-bold text-[#173524] uppercase tracking-wider">Hồ Sơ Đối Tác Cung Ứng</span>
          <span class="text-xs text-walnut-800/60">{initialSuppliers.length} nhà cung ứng chiến lược</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-walnut-900">
            <thead class="bg-sand-100/70 border-b border-walnut-900/10 text-[11px] uppercase tracking-wider text-walnut-800/70">
              <tr>
                <th class="py-3 px-4 font-bold">Mã NCC</th>
                <th class="py-3 px-4 font-bold">Tên Nhà Cung Cấp</th>
                <th class="py-3 px-4 font-bold">Người Liên Hệ</th>
                <th class="py-3 px-4 font-bold">SĐT / Email</th>
                <th class="py-3 px-4 font-bold">Địa Chỉ Xưởng / Kho</th>
                <th class="py-3 px-4 font-bold text-right">Tổng Mua</th>
                <th class="py-3 px-4 font-bold text-right">Đang Nợ</th>
                <th class="py-3 px-4 font-bold text-center">Trạng Thái</th>
                <th class="py-3 px-4 font-bold text-right">Thao Tác</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-walnut-900/5">
              {initialSuppliers.length === 0 ? (
                <tr>
                  <td colspan="9" class="py-8 text-center text-xs text-walnut-800/60">
                    Chưa có nhà cung cấp nào. Bấm "Thêm Nhà Cung Cấp" để bắt đầu.
                  </td>
                </tr>
              ) : (
                initialSuppliers.map((s) => (
                  <tr class="hover:bg-sand-50/60 transition-colors">
                    <td class="py-3 px-4 font-mono font-bold text-[#173524]">{s.code}</td>
                    <td class="py-3 px-4 font-bold text-walnut-900">{s.name}</td>
                    <td class="py-3 px-4 text-walnut-800">{s.contactPerson || '—'}</td>
                    <td class="py-3 px-4">
                      <p class="font-semibold text-[#173524]">{s.phone || '—'}</p>
                      <p class="text-[10px] text-walnut-800/60">{s.email || ''}</p>
                    </td>
                    <td class="py-3 px-4 text-walnut-800/80 max-w-xs truncate">{s.address || '—'}</td>
                    <td class="py-3 px-4 text-right font-bold text-[#173524]">{formatVnd(s.stats?.totalPurchased || 0)}</td>
                    <td class="py-3 px-4 text-right font-bold text-amber-700">{formatVnd(s.stats?.totalDebt || 0)}</td>
                    <td class="py-3 px-4 text-center">
                      <span class={`inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                        s.status ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
                      }`}>
                        {s.status ? 'Đang hợp tác' : 'Ngừng hợp tác'}
                      </span>
                    </td>
                    <td class="py-3 px-4 text-right space-x-1.5 whitespace-nowrap">
                      <button
                        type="button"
                        class="btn-edit-supplier px-2.5 py-1 rounded-none bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors text-[11px] font-bold border border-blue-200 cursor-pointer"
                        data-id={s.id}
                        data-code={s.code}
                        data-name={s.name}
                        data-contact={s.contactPerson || ''}
                        data-phone={s.phone || ''}
                        data-email={s.email || ''}
                        data-address={s.address || ''}
                        data-status={s.status ? '1' : '0'}
                      >
                        Sửa
                      </button>
                      <button
                        type="button"
                        class="btn-delete-supplier px-2.5 py-1 rounded-none bg-red-50 text-red-700 hover:bg-red-100 transition-colors text-[11px] font-bold border border-red-200 cursor-pointer"
                        data-id={s.id}
                        data-name={s.name}
                        data-slips={s.stats?.totalOrders || 0}
                      >
                        Xóa
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <!-- ============================================================== -->
  <!-- MODAL 1: TẠO PHIẾU NHẬP MỚI -->
  <!-- ============================================================== -->
  <div id="modal-create-slip" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden p-4 flex items-center justify-center overflow-y-auto">
    <div class="bg-sand-50 border border-walnut-900/30 w-full max-w-4xl shadow-2xl rounded-none relative my-4 max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- MODAL HEADER -->
      <div class="relative bg-[#173524] px-6 py-4.5 sm:px-8 border-b border-[#D8B670]/40 flex items-center justify-between shrink-0 shadow-md">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
        
        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#D8B670]/25 to-[#D8B670]/5 border border-[#D8B670]/40 flex items-center justify-center shrink-0 shadow-inner text-[#E6CA85]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
