---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatVnd } from '../../data/products';

let liveOrders: any[] = [];
try {
  const res = await fetch('http://localhost:4000/api/orders', {
    signal: AbortSignal.timeout(2000),
  });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data)) {
      liveOrders = json.data;
    }
  }
} catch {
  liveOrders = [];
}

const totalRevenue = liveOrders
  .filter((o: any) => o.orderStatus !== 'da-huy')
  .reduce((acc: number, curr: any) => acc + (curr.total || 0), 0);

const totalOrders = liveOrders.length;
const profit = Math.round(totalRevenue * 0.45);
const cost = totalRevenue - profit;
const margin = totalRevenue > 0 ? '45.0%' : '0.0%';

const monthlyStats = totalRevenue > 0 ? [
  { 
    month: 'Tháng 10/2026 (Hiện tại)', 
    revenue: formatVnd(totalRevenue), 
    cost: formatVnd(cost), 
    profit: formatVnd(profit), 
    margin: margin, 
    orders: totalOrders 
  }
] : [];
---

<AdminLayout title="Báo Cáo Doanh Thu & Lợi Nhuận - Nội Thất">
  <div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl text-walnut-900">Báo Cáo Doanh Thu & Lợi Nhuận</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Phân tích dòng tiền, chi phí giá vốn và biên độ lợi nhuận của doanh nghiệp.</p>
      </div>

      <div class="flex items-center gap-2">
        <button 
          type="button" 
          onclick="alert('Chưa có phát sinh dữ liệu doanh thu để xuất báo cáo PDF')"
          class="inline-flex items-center gap-1.5 bg-walnut-900 px-4 py-2 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Xuất Báo Cáo Tài Chính
        </button>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Doanh thu năm 2026</p>
        <p class="text-2xl font-bold text-walnut-900 mt-1">{formatVnd(totalRevenue)}</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Lợi nhuận gộp</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1">{formatVnd(profit)}</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Biên lợi nhuận trung bình</p>
        <p class="text-2xl font-bold text-clay-600 mt-1">{margin}</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tăng trưởng so với cùng kỳ</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1">{totalRevenue > 0 ? '+100%' : '0%'}</p>
      </div>
    </div>

    <!-- Revenue Breakdown Chart -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
        <h2 class="text-base font-bold text-walnut-900 mb-2">Tăng Trưởng Doanh Thu 5 Tháng Gần Nhất</h2>
        <p class="text-xs text-walnut-800/70 mb-6">Đơn vị: Triệu VNĐ</p>

        {totalRevenue === 0 ? (
          <div class="flex flex-col items-center justify-center h-48 border-b border-walnut-900/10 text-center text-xs text-walnut-800/70 py-10">
            <svg class="h-10 w-10 text-walnut-800/30 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Chưa có phát sinh dữ liệu doanh thu tháng.</span>
          </div>
        ) : (
          <div class="grid grid-cols-5 gap-4 items-end h-48 border-b border-walnut-900/10 pb-2">
            {[
              { m: 'Tháng 6', v: 0, h: '0%' },
              { m: 'Tháng 7', v: 0, h: '0%' },
              { m: 'Tháng 8', v: 0, h: '0%' },
              { m: 'Tháng 9', v: 0, h: '0%' },
              { m: 'Tháng 10', v: Math.round(totalRevenue / 1000000), h: '100%' },
            ].map((bar) => (
              <div class="flex flex-col items-center gap-2 h-full justify-end">
                <span class="text-xs font-bold text-walnut-900">{bar.v}M</span>
                <div class="w-full rounded-t bg-walnut-900 hover:bg-clay-600 transition-colors" style={`height: ${bar.h};`}></div>
                <span class="text-xs font-medium text-walnut-800 mt-1">{bar.m}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
        <h2 class="text-base font-bold text-walnut-900 mb-2">Cơ Cấu Chi Phí</h2>
        <p class="text-xs text-walnut-800/70 mb-5">Tỷ lệ trên tổng doanh thu</p>

        <div class="space-y-4 text-xs">
          <div>
            <div class="flex justify-between mb-1">
              <span class="font-medium text-walnut-900">Giá vốn hàng hóa (COGS)</span>
              <span class="font-bold text-walnut-900">{totalRevenue > 0 ? '55%' : '0%'}</span>
            </div>
            <div class="h-2 bg-sand-200 rounded-full overflow-hidden">
              <div class="h-full bg-walnut-900 rounded-full" style={`width: ${totalRevenue > 0 ? '55%' : '0%'};`}></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span class="font-medium text-walnut-900">Lợi nhuận ròng</span>
              <span class="font-bold text-emerald-700">{totalRevenue > 0 ? '32%' : '0%'}</span>
            </div>
            <div class="h-2 bg-sand-200 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-600 rounded-full" style={`width: ${totalRevenue > 0 ? '32%' : '0%'};`}></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span class="font-medium text-walnut-900">Chi phí Marketing / Ads</span>
              <span class="font-bold text-clay-600">{totalRevenue > 0 ? '8%' : '0%'}</span>
            </div>
            <div class="h-2 bg-sand-200 rounded-full overflow-hidden">
              <div class="h-full bg-clay-600 rounded-full" style={`width: ${totalRevenue > 0 ? '8%' : '0%'};`}></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span class="font-medium text-walnut-900">Vận chuyển & Đóng gói</span>
              <span class="font-bold text-amber-700">{totalRevenue > 0 ? '5%' : '0%'}</span>
            </div>
            <div class="h-2 bg-sand-200 rounded-full overflow-hidden">
              <div class="h-full bg-amber-600 rounded-full" style={`width: ${totalRevenue > 0 ? '5%' : '0%'};`}></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Monthly table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Kỳ báo cáo</th>
              <th class="py-3 px-4 font-semibold">Tổng doanh thu</th>
              <th class="py-3 px-4 font-semibold">Chi phí giá vốn</th>
              <th class="py-3 px-4 font-semibold">Lợi nhuận gộp</th>
              <th class="py-3 px-4 font-semibold">Biên lợi nhuận</th>
              <th class="py-3 px-4 font-semibold">Số đơn hàng</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-walnut-900/10">
            {monthlyStats.length === 0 ? (
              <tr>
                <td colspan="6" class="py-10 text-center text-xs text-walnut-800/70">
                  Chưa có dữ liệu báo cáo tài chính nào.
                </td>
              </tr>
            ) : (
              monthlyStats.map((s) => (
                <tr class="hover:bg-sand-100/50">
                  <td class="py-3 px-4 font-bold text-walnut-900">{s.month}</td>
                  <td class="py-3 px-4 font-bold text-walnut-900">{s.revenue}</td>
                  <td class="py-3 px-4 text-walnut-800">{s.cost}</td>
                  <td class="py-3 px-4 font-bold text-emerald-700">{s.profit}</td>
                  <td class="py-3 px-4 font-semibold text-clay-600">{s.margin}</td>
                  <td class="py-3 px-4 text-walnut-900 font-medium">{s.orders} đơn</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
