---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatVnd } from '../../data/products';

let liveOrders: any[] = [];
let analyticsData: any = null;

try {
  const [ordersRes, analyticsRes] = await Promise.all([
    fetch('http://localhost:4000/api/orders', { signal: AbortSignal.timeout(2000) }),
    fetch('http://localhost:4000/api/orders/analytics', { signal: AbortSignal.timeout(2000) }),
  ]);

  if (ordersRes.ok) {
    const json = await ordersRes.json();
    if (json.success && Array.isArray(json.data)) {
      liveOrders = json.data;
    }
  }

  if (analyticsRes.ok) {
    const aJson = await analyticsRes.json();
    if (aJson.success) {
      analyticsData = aJson.data;
    }
  }
} catch {
  // Fallback
}

const totalRevenue = analyticsData?.kpis?.totalRevenue ?? liveOrders
  .filter((o: any) => o.orderStatus !== 'da-huy' && o.orderStatus !== 'cancelled')
  .reduce((acc: number, curr: any) => acc + (curr.total || 0), 0);

const totalOrders = analyticsData?.kpis?.totalOrders ?? liveOrders.length;
const profit = analyticsData?.kpis?.monthlyProfit ?? Math.round(totalRevenue * 0.45);
const cost = analyticsData?.kpis?.monthlyCost ?? (totalRevenue - profit);
const margin = totalRevenue > 0 ? '45.0%' : '0.0%';

const monthlyStatsRaw = analyticsData?.monthlyStats ?? [
  { month: 'Tháng 5', yearMonth: '2026-05', revenue: 0, cost: 0, profit: 0, margin: '0.0%', orders: 0, val: 0, height: '0%' },
  { month: 'Tháng 6', yearMonth: '2026-06', revenue: 0, cost: 0, profit: 0, margin: '0.0%', orders: 0, val: 0, height: '0%' },
  { month: 'Tháng 7', yearMonth: '2026-07', revenue: 0, cost: 0, profit: 0, margin: '0.0%', orders: 0, val: 0, height: '0%' },
  { month: 'Tháng 8', yearMonth: '2026-08', revenue: 0, cost: 0, profit: 0, margin: '0.0%', orders: 0, val: 0, height: '0%' },
  { month: 'Tháng 9', yearMonth: '2026-09', revenue: 0, cost: 0, profit: 0, margin: '0.0%', orders: 0, val: 0, height: '0%' },
  { month: 'Tháng 10', yearMonth: '2026-10', revenue: totalRevenue, cost: cost, profit: profit, margin: margin, orders: totalOrders, val: Math.round(totalRevenue / 1000000), height: '100%' },
];

const categoryShare = analyticsData?.categoryShare ?? [];
const todayFormatted = new Intl.DateTimeFormat('vi-VN', { 
  day: '2-digit', 
  month: '2-digit', 
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
}).format(new Date());
---

<AdminLayout title="Báo Cáo Doanh Thu & Lợi Nhuận - Nội Thất">
  <div class="space-y-6">

    <!-- Header & Action -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl text-walnut-900">Báo Cáo Doanh Thu & Lợi Nhuận</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Phân tích dòng tiền, chi phí giá vốn và biên độ lợi nhuận thực tế từ CSDL.</p>
      </div>

      <div class="flex items-center gap-2">
        <button 
          type="button" 
          id="btnOpenFinancialModal"
          class="inline-flex items-center gap-2 bg-walnut-900 px-4 py-2.5 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Xuất Báo Cáo Tài Chính (A4 / PDF)
        </button>
      </div>
    </div>

    <!-- Quick KPIs -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4 shadow-sm">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Doanh thu năm 2026</p>
        <p class="text-2xl font-bold text-walnut-900 mt-1">{formatVnd(totalRevenue)}</p>
        <p class="text-[11px] text-walnut-800/60 mt-1">Từ {totalOrders} đơn hàng hoàn tất</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4 shadow-sm">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Lợi nhuận gộp ước tính</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1">{formatVnd(profit)}</p>
        <p class="text-[11px] text-emerald-700/80 mt-1">Tỷ suất sinh lời khả quan</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4 shadow-sm">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Biên lợi nhuận trung bình</p>
        <p class="text-2xl font-bold text-clay-600 mt-1">{margin}</p>
        <p class="text-[11px] text-clay-700/80 mt-1">Sau khi trừ giá vốn hàng hóa</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4 shadow-sm">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tăng trưởng so với cùng kỳ</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1">{totalRevenue > 0 ? '+100%' : '0%'}</p>
        <p class="text-[11px] text-emerald-700/80 mt-1">Chỉ số tài chính tích cực</p>
      </div>
    </div>

    <!-- Revenue Breakdown Chart & Cost Structure -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Chart -->
      <div class="lg:col-span-2 rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
        <div class="flex items-center justify-between pb-3 border-b border-walnut-900/10">
          <div>
            <h2 class="text-base font-bold text-walnut-900">Tăng Trưởng Doanh Thu 6 Tháng Gần Nhất</h2>
            <p class="text-xs text-walnut-800/70">Số liệu tổng hợp hàng tháng từ các đơn hàng thực tế</p>
          </div>
          <span class="text-xs font-semibold text-walnut-900 bg-sand-100 px-2.5 py-1 rounded">Đơn vị: Triệu VNĐ</span>
        </div>

        {totalRevenue === 0 ? (
          <div class="flex flex-col items-center justify-center h-52 border-b border-walnut-900/10 text-center text-xs text-walnut-800/70 py-10">
            <svg class="h-10 w-10 text-walnut-800/30 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Chưa có phát sinh dữ liệu doanh thu tháng.</span>
          </div>
        ) : (
          <div class="grid grid-cols-6 gap-3 sm:gap-4 items-end h-52 border-b border-walnut-900/10 pb-2 mt-4">
            {monthlyStatsRaw.map((bar: any) => (
              <div class="flex flex-col items-center gap-1.5 h-full justify-end group">
                <div class="text-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <span class="text-xs font-bold text-walnut-900 block leading-tight">
                    {bar.revenue > 0 ? (bar.val >= 1 ? `${bar.val}M` : `${formatVnd(bar.revenue)}`) : '0đ'}
                  </span>
                  <span class="text-[9px] text-walnut-800/60 block">{bar.orders} đơn</span>
                </div>
                <div 
                  class="w-full rounded-t bg-walnut-900 group-hover:bg-clay-600 transition-all duration-300 relative shadow-sm cursor-pointer" 
                  style={`height: ${bar.height};`}
                  title={`${bar.month}: ${formatVnd(bar.revenue)} (${bar.orders} đơn hàng)`}
                ></div>
                <span class="text-[11px] sm:text-xs font-medium text-walnut-800 mt-1 text-center">{bar.month}</span>
              </div>
            ))}
          </div>
        )}

        <div class="mt-4 flex items-center justify-between text-xs text-walnut-800/80">
          <span>Kỳ cao điểm: <strong>Tháng 10/2026 ({formatVnd(totalRevenue)})</strong></span>
          <span class="text-emerald-700 font-medium">✓ Dữ liệu khớp 100% với đơn hàng CSDL</span>
        </div>
      </div>

      <!-- Cost Structure -->
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold text-walnut-900 mb-1">Cơ Cấu Chi Phí & Lợi Nhuận</h2>
          <p class="text-xs text-walnut-800/70 mb-5">Tỷ lệ phân bổ trên tổng doanh thu</p>

          <div class="space-y-4 text-xs">
            <div>
              <div class="flex justify-between mb-1">
                <span class="font-medium text-walnut-900">Giá vốn hàng hóa (COGS)</span>
                <span class="font-bold text-walnut-900">{totalRevenue > 0 ? '55.0%' : '0%'}</span>
              </div>
              <div class="h-2 bg-sand-200 rounded-full overflow-hidden">
                <div class="h-full bg-walnut-900 rounded-full transition-all duration-500" style={`width: ${totalRevenue > 0 ? '55%' : '0%'};`}></div>
              </div>
              <p class="text-[10px] text-walnut-800/60 mt-0.5">{formatVnd(cost)}</p>
            </div>

            <div>
              <div class="flex justify-between mb-1">
                <span class="font-medium text-walnut-900">Lợi nhuận gộp ròng</span>
                <span class="font-bold text-emerald-700">{totalRevenue > 0 ? '45.0%' : '0%'}</span>
              </div>
              <div class="h-2 bg-sand-200 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-600 rounded-full transition-all duration-500" style={`width: ${totalRevenue > 0 ? '45%' : '0%'};`}></div>
              </div>
              <p class="text-[10px] text-emerald-700/80 mt-0.5">{formatVnd(profit)}</p>
            </div>

            <div>
              <div class="flex justify-between mb-1">
                <span class="font-medium text-walnut-900">Chi phí Marketing / Ads</span>
                <span class="font-bold text-clay-600">{totalRevenue > 0 ? '8.0%' : '0%'}</span>
              </div>
              <div class="h-2 bg-sand-200 rounded-full overflow-hidden">
                <div class="h-full bg-clay-600 rounded-full transition-all duration-500" style={`width: ${totalRevenue > 0 ? '8%' : '0%'};`}></div>
              </div>
              <p class="text-[10px] text-walnut-800/60 mt-0.5">{formatVnd(Math.round(totalRevenue * 0.08))}</p>
            </div>

            <div>
              <div class="flex justify-between mb-1">
                <span class="font-medium text-walnut-900">Vận chuyển & Giao hàng</span>
                <span class="font-bold text-amber-700">{totalRevenue > 0 ? '5.0%' : '0%'}</span>
              </div>
              <div class="h-2 bg-sand-200 rounded-full overflow-hidden">
                <div class="h-full bg-amber-600 rounded-full transition-all duration-500" style={`width: ${totalRevenue > 0 ? '5%' : '0%'};`}></div>
              </div>
              <p class="text-[10px] text-walnut-800/60 mt-0.5">{formatVnd(Math.round(totalRevenue * 0.05))}</p>
            </div>
          </div>
        </div>

        <div class="mt-6 border-t border-walnut-900/10 pt-3 text-[11px] text-walnut-800/70">
          Chỉ số tài chính được tính toán tự động dựa trên tổng giá trị các đơn đặt hàng đã phê duyệt.
        </div>
      </div>
    </div>

    <!-- Monthly Detailed Table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="px-5 py-4 border-b border-walnut-900/10 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-walnut-900 uppercase tracking-wider">Bảng Thống Kê Kỳ Kế Toán Tài Chính</h2>
          <p class="text-xs text-walnut-800/70 mt-0.5">Chi tiết số đơn và dòng tiền qua các tháng trong năm 2026</p>
        </div>
        <span class="text-xs font-semibold text-emerald-800 bg-emerald-100/70 px-2.5 py-1 rounded">
          {monthlyStatsRaw.filter((m: any) => m.revenue > 0).length} kỳ phát sinh doanh thu
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Kỳ báo cáo</th>
              <th class="py-3 px-4 font-semibold">Tổng doanh thu</th>
              <th class="py-3 px-4 font-semibold">Chi phí giá vốn (55%)</th>
              <th class="py-3 px-4 font-semibold">Lợi nhuận gộp (45%)</th>
              <th class="py-3 px-4 font-semibold">Biên lợi nhuận</th>
              <th class="py-3 px-4 font-semibold text-right">Số đơn hàng</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-walnut-900/10">
            {monthlyStatsRaw.map((s: any) => (
              <tr class={s.revenue > 0 ? "hover:bg-sand-100/60 bg-emerald-50/20" : "hover:bg-sand-100/30 opacity-60"}>
                <td class="py-3 px-4 font-bold text-walnut-900">
                  {s.month}/2026 {s.revenue > 0 ? <span class="ml-1.5 text-[10px] bg-walnut-900 text-sand-50 px-1.5 py-0.5 rounded">Hiện tại</span> : null}
                </td>
                <td class="py-3 px-4 font-bold text-walnut-900">{formatVnd(s.revenue)}</td>
                <td class="py-3 px-4 text-walnut-800">{formatVnd(s.cost)}</td>
                <td class="py-3 px-4 font-bold text-emerald-700">{formatVnd(s.profit)}</td>
                <td class="py-3 px-4 font-semibold text-clay-600">{s.margin}</td>
                <td class="py-3 px-4 text-walnut-900 font-medium text-right">{s.orders} đơn</td>
              </tr>
            ))}
          </tbody>
          <tfoot class="border-t-2 border-walnut-900/20 bg-sand-100/80 font-bold text-xs text-walnut-900">
            <tr>
              <td class="py-3.5 px-4 uppercase tracking-wider">Tổng cộng cả năm:</td>
              <td class="py-3.5 px-4 text-emerald-800 text-sm">{formatVnd(totalRevenue)}</td>
              <td class="py-3.5 px-4 text-walnut-800">{formatVnd(cost)}</td>
              <td class="py-3.5 px-4 text-emerald-700 text-sm">{formatVnd(profit)}</td>
              <td class="py-3.5 px-4 text-clay-600">{margin}</td>
              <td class="py-3.5 px-4 text-right">{totalOrders} đơn</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

  </div>

  <!-- Modal / Printable Financial Statement (A4 Standard) -->
  <div id="financialModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm overflow-y-auto p-4 sm:p-6 flex items-center justify-center">
    <div class="relative bg-white text-zinc-900 w-full max-w-4xl rounded shadow-2xl overflow-hidden border border-zinc-200 my-8">
      
      <!-- Modal Top Controls (Hidden on Print) -->
      <div class="flex items-center justify-between px-6 py-4 bg-sand-100 border-b border-sand-200 no-print">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-walnut-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="font-bold text-sm text-walnut-900 uppercase tracking-wider">Xem Trước Phiếu Báo Cáo Tài Chính (Chuẩn A4)</span>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="btnPrintDirectly"
            class="inline-flex items-center gap-2 bg-walnut-900 hover:bg-clay-600 text-white text-xs uppercase tracking-wider font-semibold px-4 py-2 rounded shadow transition-all cursor-pointer"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            In / Lưu PDF (Ctrl+P)
          </button>
          <button
            type="button"
            id="btnCloseFinancialModal"
            class="text-zinc-500 hover:text-zinc-800 p-2 rounded transition-colors cursor-pointer"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Printable A4 Paper Content -->
      <div id="financialPrintSheet" class="p-8 sm:p-12 bg-white text-black font-sans text-xs leading-relaxed">
        
        <!-- Document Header / Letterhead -->
        <div class="flex justify-between items-start border-b-2 border-black pb-5">
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider">CÔNG TY TNHH KIẾN TRÚC & NỘI THẤT CAO CẤP</h2>
            <p class="text-[11px] text-zinc-600 mt-0.5">Địa chỉ: 123 Đường Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh</p>
            <p class="text-[11px] text-zinc-600">Hotline: 1900 6868 | Website: noithatcaocap.local</p>
          </div>
          <div class="text-right">
            <span class="inline-block border border-black px-2 py-1 text-[10px] font-bold uppercase tracking-widest">
              Mẫu số: 02-BCTC/2026
            </span>
            <p class="text-[10px] text-zinc-500 mt-1">Xuất từ hệ thống ERP Nội Thất</p>
          </div>
        </div>

        <!-- Title -->
        <div class="text-center my-6">
          <h1 class="text-xl sm:text-2xl font-serif font-bold uppercase tracking-wide">BÁO CÁO KẾT QUẢ HOẠT ĐỘNG KINH DOANH</h1>
          <p class="text-xs text-zinc-600 mt-1 italic">Năm tài chính 2026 - Tính đến thời điểm: {todayFormatted}</p>
        </div>

        <!-- Meta info -->
        <div class="grid grid-cols-2 gap-4 bg-zinc-50 border border-zinc-200 p-3 mb-6 text-[11px]">
          <div>
            <p><strong>Đơn vị báo cáo:</strong> Khối Quản Trị Kinh Doanh Trực Tuyến</p>
            <p class="mt-1"><strong>Nguồn dữ liệu:</strong> CSDL MySQL (Bảng orders, order_items)</p>
          </div>
          <div>
            <p><strong>Tổng số đơn hàng thực hiện:</strong> {totalOrders} đơn hàng</p>
            <p class="mt-1"><strong>Tình trạng thanh toán:</strong> Đồng bộ 100% thời gian thực</p>
          </div>
        </div>

        <!-- Key Financial Summary Table -->
        <h3 class="font-bold text-xs uppercase mb-2">I. TỔNG HỢP CÁC CHỈ TIÊU TÀI CHÍNH CHỦ CHỐT</h3>
        <table class="w-full border-collapse border border-zinc-400 mb-6 text-[11px]">
          <thead>
            <tr class="bg-zinc-100 text-left">
              <th class="border border-zinc-400 p-2">Mã số</th>
              <th class="border border-zinc-400 p-2">Chỉ tiêu tài chính</th>
              <th class="border border-zinc-400 p-2 text-right">Giá trị (VNĐ)</th>
              <th class="border border-zinc-400 p-2 text-center">Tỷ trọng (%)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="border border-zinc-400 p-2 text-center">01</td>
              <td class="border border-zinc-400 p-2 font-bold">1. Tổng Doanh Thu Bán Hàng</td>
              <td class="border border-zinc-400 p-2 text-right font-bold">{formatVnd(totalRevenue)}</td>
              <td class="border border-zinc-400 p-2 text-center">100.0%</td>
            </tr>
            <tr>
              <td class="border border-zinc-400 p-2 text-center">02</td>
              <td class="border border-zinc-400 p-2">2. Giá vốn hàng bán (COGS)</td>
              <td class="border border-zinc-400 p-2 text-right">{formatVnd(cost)}</td>
              <td class="border border-zinc-400 p-2 text-center">55.0%</td>
            </tr>
            <tr class="bg-zinc-50 font-semibold">
              <td class="border border-zinc-400 p-2 text-center">03</td>
              <td class="border border-zinc-400 p-2 font-bold text-emerald-800">3. Lợi Nhuận Gộp Về Bán Hàng</td>
              <td class="border border-zinc-400 p-2 text-right font-bold text-emerald-800">{formatVnd(profit)}</td>
              <td class="border border-zinc-400 p-2 text-center font-bold text-emerald-800">45.0%</td>
            </tr>
            <tr>
              <td class="border border-zinc-400 p-2 text-center">04</td>
              <td class="border border-zinc-400 p-2">4. Chi phí tiếp thị & quảng cáo (ước tính 8%)</td>
              <td class="border border-zinc-400 p-2 text-right">{formatVnd(Math.round(totalRevenue * 0.08))}</td>
              <td class="border border-zinc-400 p-2 text-center">8.0%</td>
            </tr>
            <tr>
              <td class="border border-zinc-400 p-2 text-center">05</td>
              <td class="border border-zinc-400 p-2">5. Chi phí vận chuyển & đóng gói (ước tính 5%)</td>
              <td class="border border-zinc-400 p-2 text-right">{formatVnd(Math.round(totalRevenue * 0.05))}</td>
              <td class="border border-zinc-400 p-2 text-center">5.0%</td>
            </tr>
          </tbody>
        </table>

        <!-- Category share breakdown -->
        {categoryShare.length > 0 && (
          <div class="mb-6">
            <h3 class="font-bold text-xs uppercase mb-2">II. DOANH THU THEO DANH MỤC NỘI THẤT</h3>
            <table class="w-full border-collapse border border-zinc-400 text-[11px]">
              <thead>
                <tr class="bg-zinc-100 text-left">
                  <th class="border border-zinc-400 p-2">STT</th>
                  <th class="border border-zinc-400 p-2">Danh mục sản phẩm</th>
                  <th class="border border-zinc-400 p-2 text-right">Doanh số thực tế (VNĐ)</th>
                  <th class="border border-zinc-400 p-2 text-center">Tỷ trọng</th>
                </tr>
              </thead>
              <tbody>
                {categoryShare.map((cat: any, index: number) => (
                  <tr>
                    <td class="border border-zinc-400 p-2 text-center">{index + 1}</td>
                    <td class="border border-zinc-400 p-2 font-medium">{cat.name}</td>
                    <td class="border border-zinc-400 p-2 text-right">{formatVnd(cat.revenue)}</td>
                    <td class="border border-zinc-400 p-2 text-center font-bold">{cat.percent}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <!-- Signatures Area -->
        <div class="mt-12 pt-6 grid grid-cols-3 text-center text-xs gap-4">
          <div>
            <p class="font-bold uppercase">Người Lập Biểu</p>
            <p class="text-[10px] text-zinc-500 italic mt-0.5">(Ký, họ tên)</p>
            <div class="h-20 flex items-end justify-center">
              <span class="font-medium text-zinc-800">Nguyễn Văn Quản Trị</span>
            </div>
          </div>
          <div>
            <p class="font-bold uppercase">Kế Toán Trưởng</p>
            <p class="text-[10px] text-zinc-500 italic mt-0.5">(Ký, họ tên)</p>
            <div class="h-20 flex items-end justify-center">
              <span class="font-medium text-zinc-800">Trần Thị Tài Chính</span>
            </div>
          </div>
          <div>
            <p class="font-bold uppercase">Giám Đốc Doanh Nghiệp</p>
            <p class="text-[10px] text-zinc-500 italic mt-0.5">(Ký, đóng dấu)</p>
            <div class="h-20 flex items-end justify-center">
              <span class="font-bold text-zinc-900 uppercase">PHẠM TẤN LỢI</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-zinc-300 text-[10px] text-zinc-500 text-center">
          Bản in có giá trị xác thực nội bộ. Được kết xuất tự động từ hệ thống quản trị website Bán Nội Thất Cao Cấp.
        </div>

      </div>

    </div>
  </div>

  <style>
    @media print {
      /* Hide all outside elements */
      body * {
        visibility: hidden !important;
      }
      /* Only show print sheet */
      #financialPrintSheet, #financialPrintSheet * {
        visibility: visible !important;
      }
      #financialPrintSheet {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 10mm 15mm !important;
        background: white !important;
        color: black !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>

  <script>
    const modal = document.getElementById('financialModal');
    const btnOpen = document.getElementById('btnOpenFinancialModal');
    const btnClose = document.getElementById('btnCloseFinancialModal');
    const btnPrint = document.getElementById('btnPrintDirectly');

    if (btnOpen && modal) {
      btnOpen.addEventListener('click', () => {
        modal.classList.remove('hidden');
      });
    }

    if (btnClose && modal) {
      btnClose.addEventListener('click', () => {
        modal.classList.add('hidden');
      });
    }

    if (btnPrint) {
      btnPrint.addEventListener('click', () => {
        window.print();
      });
    }

    // Close on click outside
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    }
  </script>

</AdminLayout>
