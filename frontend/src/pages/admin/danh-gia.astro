---
import AdminLayout from '../../layouts/AdminLayout.astro';

interface ReviewItem {
  id: number;
  customer: string;
  product: string;
  rating: number;
  comment: string;
  date: string;
  status: string;
  statusColor: string;
  adminReply: string;
}

let reviews: ReviewItem[] = [];
try {
  const res = await fetch('http://localhost:4000/api/reviews', {
    signal: AbortSignal.timeout(2000),
  });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data)) {
      reviews = json.data.map((r: any) => ({
        id: r.id,
        customer: r.userName || 'Khách hàng',
        product: r.productName || r.productSlug || 'Sản phẩm',
        rating: r.rating || 5,
        comment: r.comment || '',
        date: new Date(r.createdAt).toLocaleDateString('vi-VN'),
        status: r.isApproved ? 'Đã duyệt' : 'Chờ duyệt',
        statusColor: r.isApproved ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : 'bg-amber-100 text-amber-800 border-amber-300',
        adminReply: r.adminReply || '',
      }));
    }
  }
} catch {
  reviews = [];
}

const totalReviews = reviews.length;
const fiveStarCount = reviews.filter((r) => r.rating === 5).length;
const fiveStarPercent = totalReviews > 0 ? Math.round((fiveStarCount / totalReviews) * 100) : 0;
const pendingCount = reviews.filter((r) => r.status === 'Chờ duyệt').length;
const repliedCount = reviews.filter((r) => Boolean(r.adminReply)).length;
const replyRate = totalReviews > 0 ? ((repliedCount / totalReviews) * 100).toFixed(1) + '%' : '0%';
const avgRating = totalReviews > 0 ? (reviews.reduce((acc, r) => acc + r.rating, 0) / totalReviews).toFixed(1) : '5.0';
---

<AdminLayout title="Quản Lý Đánh Giá & Phản Hồi - Nội Thất">
  <div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-sans font-bold text-2xl sm:text-3xl text-walnut-900">Đánh Giá & Phản Hồi Khách Hàng</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Kiểm duyệt nhận xét, số sao đánh giá và tương tác giải đáp thắc mắc người mua.</p>
      </div>

      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 bg-amber-500/10 text-amber-900 border border-amber-500/30 px-3.5 py-2 rounded text-xs font-bold">
          <span>⭐</span> Điểm trung bình: {avgRating} / 5.0 ({totalReviews} đánh giá)
        </span>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tổng nhận xét</p>
        <p id="stat-total-reviews" class="text-2xl font-bold text-walnut-900 mt-1">{totalReviews} lượt</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Đánh giá 5 sao</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1">{fiveStarCount} lượt ({fiveStarPercent}%)</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Chờ duyệt</p>
        <p id="stat-pending-reviews" class="text-2xl font-bold text-amber-700 mt-1">{pendingCount} nhận xét mới</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tỷ lệ phản hồi</p>
        <p id="stat-reply-rate" class="text-2xl font-bold text-clay-600 mt-1">{replyRate}</p>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Khách hàng</th>
              <th class="py-3 px-4 font-semibold">Sản phẩm</th>
              <th class="py-3 px-4 font-semibold">Số sao</th>
              <th class="py-3 px-4 font-semibold">Nội dung đánh giá</th>
              <th class="py-3 px-4 font-semibold">Thời gian</th>
              <th class="py-3 px-4 font-semibold">Trạng thái</th>
              <th class="py-3 px-4 font-semibold text-right">Hành động</th>
            </tr>
          </thead>
          <tbody id="review-table-body" class="divide-y divide-walnut-900/10">
            {reviews.length === 0 ? (
              <tr>
                <td colspan="7" class="py-12 text-center text-walnut-800 text-sm">
                  Chưa có đánh giá nào trong hệ thống.
                </td>
              </tr>
            ) : (
              reviews.map((r) => (
              <tr 
                class="hover:bg-sand-100/50 transition-colors"
                data-review-row
                data-id={r.id}
                data-customer={r.customer}
                data-product={r.product}
                data-rating={r.rating}
                data-comment={r.comment}
                data-reply={r.adminReply}
                data-status={r.status}
              >
                <td class="py-3 px-4">
                  <div class="flex items-center gap-2">
                    <div class="h-7 w-7 rounded-full bg-walnut-900 text-sand-50 flex items-center justify-center font-bold text-[10px]">
                      {r.customer.split(' ').map(n => n[0]).slice(-2).join('')}
                    </div>
                    <span class="font-bold text-walnut-900">{r.customer}</span>
                  </div>
                </td>
                <td class="py-3 px-4 font-medium text-clay-600 max-w-[180px] truncate">{r.product}</td>
                <td class="py-3 px-4">
                  <div class="flex text-amber-500 text-sm">
                    {Array.from({ length: r.rating }).map(() => (
                      <span>★</span>
                    ))}
                    {Array.from({ length: 5 - r.rating }).map(() => (
                      <span class="text-walnut-900/20">★</span>
                    ))}
                  </div>
                </td>
                <td class="py-3 px-4 text-walnut-900 max-w-sm">
                  <p>{r.comment}</p>
                  <div class={`mt-1.5 p-2 bg-sand-100/80 rounded border-l-2 border-clay-600 text-[11px] text-walnut-800 ${r.adminReply ? '' : 'hidden'}`} data-col="reply-box">
                    <p class="font-semibold text-clay-700 text-[10px] uppercase">Phản hồi từ Admin:</p>
                    <p class="mt-0.5" data-col="reply-text">{r.adminReply}</p>
                  </div>
                </td>
                <td class="py-3 px-4 text-walnut-800/70">{r.date}</td>
                <td class="py-3 px-4" data-col="status">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${r.statusColor}`}>
                    {r.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button 
                      type="button" 
                      data-btn-approve
                      class={`text-xs font-semibold cursor-pointer hover:underline ${r.status === 'Chờ duyệt' ? 'text-emerald-700 font-bold' : 'text-walnut-800/60'}`}
                    >
                      {r.status === 'Chờ duyệt' ? 'Duyệt' : 'Đã duyệt'}
                    </button>
                    <span class="text-walnut-800/30">|</span>
                    <button 
                      type="button" 
                      data-btn-reply
                      class="text-xs font-semibold text-clay-600 hover:underline cursor-pointer"
                    >
                      Phản hồi
                    </button>
                    <span class="text-walnut-800/30">|</span>
                    <button 
                      type="button" 
                      data-btn-toggle-hide
                      class={`text-xs font-semibold cursor-pointer hover:underline ${r.status === 'Đã ẩn' ? 'text-emerald-700' : 'text-red-600'}`}
                    >
                      {r.status === 'Đã ẩn' ? 'Hiện' : 'Ẩn'}
                    </button>
                  </div>
                </td>
              </tr>
            )))}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- MODAL: PHẢN HỒI ĐÁNH GIÁ -->
  <div id="reply-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/30 w-full max-w-lg shadow-2xl rounded-none relative my-4 max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- HEADER WALNUT XANH ĐẬM VỚI DẢI VÀNG CHAMPAGNE -->
      <div class="relative bg-[#173524] px-6 py-5 sm:px-8 border-b border-[#D8B670]/30 shrink-0">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#D8B670]/25 to-[#D8B670]/5 border border-[#D8B670]/40 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 text-[#E6CA85]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.22em] text-[#D8B670] font-semibold">TƯƠNG TÁC KHÁCH HÀNG</p>
              <h2 id="reply-modal-title" class="text-lg sm:text-xl font-display font-bold text-white tracking-wide mt-0.5">Phản Hồi Đánh Giá</h2>
            </div>
          </div>

          <button 
            type="button" 
            id="btn-close-reply-modal" 
            class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-sand-200 hover:text-white flex items-center justify-center transition-all hover:rotate-90 cursor-pointer border border-white/10"
            title="Đóng cửa sổ"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <form id="reply-form" class="flex flex-col flex-1 overflow-hidden">
        <input type="hidden" id="reply-hidden-id" value="" />

        <!-- MODAL BODY (SCROLLABLE) -->
        <div class="p-6 sm:p-8 space-y-4 overflow-y-auto flex-1 bg-[#FAF8F5]">
          <!-- Customer review quote -->
          <div class="p-4 bg-white border border-walnut-900/15 shadow-xs">
            <div class="flex items-center justify-between text-xs border-b border-walnut-900/10 pb-2">
              <span id="reply-customer-name" class="font-bold text-walnut-900 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#173524]"></span>
                Khách hàng
              </span>
              <span id="reply-product-name" class="text-clay-600 font-semibold">Sản phẩm</span>
            </div>
            <p id="reply-comment-quote" class="mt-2.5 text-xs text-walnut-800 italic leading-relaxed">"Nội dung nhận xét..."</p>
          </div>

          <div>
            <label for="reply-content-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Nội dung phản hồi từ Cửa hàng *</label>
            <textarea 
              id="reply-content-input" 
              required 
              rows="4" 
              placeholder="Cảm ơn quý khách đã tin tưởng và ủng hộ sản phẩm của Nội Thất..." 
              class="mt-1.5 w-full border border-walnut-900/20 bg-white p-3.5 text-xs outline-none focus:border-clay-600 leading-relaxed shadow-xs"
            ></textarea>
          </div>
        </div>

        <!-- MODAL FOOTER (STICKY BOTTOM) -->
        <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex items-center justify-end gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
          <button 
            type="button" 
            id="btn-cancel-reply-modal" 
            class="border border-walnut-900/20 px-5 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer"
          >
            Đóng
          </button>
          <button 
            type="submit" 
            class="bg-gradient-to-r from-[#D8B670] via-[#E2C37E] to-[#C49E52] px-6 py-2.5 text-xs uppercase tracking-[0.18em] font-bold text-[#173524] hover:from-[#C49E52] hover:to-[#B58F43] hover:text-white shadow-md transition-all active:scale-95 cursor-pointer border border-[#E0C582]/50"
          >
            Gửi phản hồi
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOAST -->
  <div id="review-toast" class="fixed bottom-6 right-6 z-50 hidden translate-y-4 rounded bg-walnut-900 px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300 border border-emerald-500/40">
    <span id="review-toast-msg">Thao tác thành công!</span>
  </div>

</AdminLayout>

<script>
  const initReviewPage = () => {
    const tableBody = document.getElementById('review-table-body') as HTMLElement;
    const pendingEl = document.getElementById('stat-pending-reviews') as HTMLElement;

    // Modal
    const replyModal = document.getElementById('reply-modal') as HTMLElement;
    const btnCloseReplyModal = document.getElementById('btn-close-reply-modal') as HTMLButtonElement;
    const btnCancelReplyModal = document.getElementById('btn-cancel-reply-modal') as HTMLButtonElement;
    const replyForm = document.getElementById('reply-form') as HTMLFormElement;
    const replyHiddenId = document.getElementById('reply-hidden-id') as HTMLInputElement;
    const replyCustomerName = document.getElementById('reply-customer-name') as HTMLElement;
    const replyProductName = document.getElementById('reply-product-name') as HTMLElement;
    const replyCommentQuote = document.getElementById('reply-comment-quote') as HTMLElement;
    const replyContentInput = document.getElementById('reply-content-input') as HTMLTextAreaElement;

    // Toast
    const toast = document.getElementById('review-toast') as HTMLElement;
    const toastMsg = document.getElementById('review-toast-msg') as HTMLElement;

    const showToast = (msg: string) => {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove('hidden');
      requestAnimationFrame(() => toast.classList.remove('translate-y-4'));
      setTimeout(() => {
        toast.classList.add('translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3000);
    };

    const updateStats = () => {
      if (tableBody && pendingEl) {
        let pending = 0;
        tableBody.querySelectorAll<HTMLTableRowElement>('[data-review-row]').forEach((r) => {
          if (r.dataset.status === 'Chờ duyệt') pending++;
        });
        pendingEl.textContent = pending > 0 ? `${pending} nhận xét mới` : '0 nhận xét chờ duyệt';
      }
    };

    const closeReplyModal = () => replyModal?.classList.add('hidden');
    btnCloseReplyModal?.addEventListener('click', closeReplyModal);
    btnCancelReplyModal?.addEventListener('click', closeReplyModal);
    replyModal?.addEventListener('click', (e) => {
      if (e.target === replyModal) closeReplyModal();
    });

    // Attach Row Actions
    const attachRowActions = (row: HTMLTableRowElement) => {
      const approveBtn = row.querySelector('[data-btn-approve]') as HTMLButtonElement | null;
      const replyBtn = row.querySelector('[data-btn-reply]') as HTMLButtonElement | null;
      const hideBtn = row.querySelector('[data-btn-toggle-hide]') as HTMLButtonElement | null;
      const id = row.dataset.id;

      // 1. Duyệt đánh giá qua API
      approveBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!id) return;
        try {
          const res = await fetch(`http://localhost:4000/api/reviews/${id}/status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: true }),
          });
          const json = await res.json();
          if (json.success) {
            row.dataset.status = 'Đã duyệt';
            const statusCol = row.querySelector('[data-col="status"]');
            if (statusCol) {
              statusCol.innerHTML = '<span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border bg-emerald-100 text-emerald-800 border-emerald-300">Đã duyệt</span>';
            }
            approveBtn.textContent = 'Đã duyệt';
            approveBtn.className = 'text-xs font-semibold cursor-pointer text-walnut-800/60';
            updateStats();
            showToast(`Đã duyệt và hiển thị đánh giá của "${row.dataset.customer}"!`);
          } else {
            showToast(json.message || 'Lỗi khi duyệt');
          }
        } catch {
          showToast('Lỗi kết nối máy chủ backend!');
        }
      });

      // 2. Mở Modal phản hồi
      replyBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        replyHiddenId.value = row.dataset.id || '';
        replyCustomerName.textContent = `Khách hàng: ${row.dataset.customer}`;
        replyProductName.textContent = row.dataset.product || '';
        replyCommentQuote.textContent = `"${row.dataset.comment}"`;
        replyContentInput.value = row.dataset.reply || '';
        replyModal?.classList.remove('hidden');
        replyContentInput.focus();
      });

      // 3. Ẩn / Hiện đánh giá qua API
      hideBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        if (!id) return;
        const isCurrentlyHidden = row.dataset.status === 'Đã ẩn';
        const targetActive = isCurrentlyHidden; // if hidden, unhide it

        try {
          const res = await fetch(`http://localhost:4000/api/reviews/${id}/status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: targetActive }),
          });
          const json = await res.json();
          if (json.success) {
            const nextStatus = targetActive ? 'Đã duyệt' : 'Đã ẩn';
            const nextColor = targetActive 
              ? 'bg-emerald-100 text-emerald-800 border-emerald-300' 
              : 'bg-red-100 text-red-800 border-red-300';

            row.dataset.status = nextStatus;
            const statusCol = row.querySelector('[data-col="status"]');
            if (statusCol) {
              statusCol.innerHTML = `<span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${nextColor}">${nextStatus}</span>`;
            }

            hideBtn.textContent = targetActive ? 'Ẩn' : 'Hiện';
            hideBtn.className = `text-xs font-semibold cursor-pointer hover:underline ${targetActive ? 'text-red-600' : 'text-emerald-700'}`;

            updateStats();
            showToast(targetActive 
              ? `Đã hiển thị lại đánh giá của "${row.dataset.customer}" trên website!` 
              : `Đã tạm ẩn đánh giá của "${row.dataset.customer}" khỏi website!`
            );
          } else {
            showToast(json.message || 'Lỗi khi đổi trạng thái');
          }
        } catch {
          showToast('Lỗi kết nối máy chủ backend!');
        }
      });
    };

    if (tableBody) {
      tableBody.querySelectorAll<HTMLTableRowElement>('[data-review-row]').forEach(attachRowActions);
    }

    // Submit reply qua API
    replyForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = replyHiddenId.value;
      const replyText = replyContentInput.value.trim();
      if (!id || !tableBody) return;

      const submitBtn = replyForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang lưu...';
      }

      try {
        const res = await fetch(`http://localhost:4000/api/reviews/${id}/reply`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reply: replyText }),
        });
        const json = await res.json();
        if (json.success) {
          const targetRow = tableBody.querySelector<HTMLTableRowElement>(`[data-id="${id}"]`);
          if (targetRow) {
            targetRow.dataset.reply = replyText;
            const replyBox = targetRow.querySelector('[data-col="reply-box"]');
            const replyContentEl = targetRow.querySelector('[data-col="reply-text"]');
            if (replyBox && replyContentEl) {
              replyContentEl.textContent = replyText;
              replyBox.classList.toggle('hidden', !replyText);
            }
          }
          closeReplyModal();
          showToast(`Đã lưu phản hồi vào cơ sở dữ liệu thành công!`);
        } else {
          showToast(json.message || 'Lỗi khi gửi phản hồi');
        }
      } catch {
        showToast('Lỗi kết nối máy chủ backend!');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Gửi Phản Hồi';
        }
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReviewPage);
  } else {
    initReviewPage();
  }
</script>
