---
import AdminLayout from '../../layouts/AdminLayout.astro';

const coupons = [
  { code: 'NOITHATVIP20', discount: 'Giảm 20%', minOrder: '20.000.000 ₫', maxDiscount: '5.000.000 ₫', used: '34 / 50', expiry: '31/12/2026', status: 'Đang áp dụng', statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300' },
  { code: 'FREESHIP2026', discount: 'Freeship toàn quốc', minOrder: '10.000.000 ₫', maxDiscount: '500.000 ₫', used: '89 / 100', expiry: '30/11/2026', status: 'Đang áp dụng', statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300' },
  { code: 'TANXUAN10', discount: 'Giảm 10%', minOrder: '5.000.000 ₫', maxDiscount: '2.000.000 ₫', used: '50 / 50', expiry: '15/10/2026', status: 'Hết lượt', statusColor: 'bg-amber-100 text-amber-800 border-amber-300' },
  { code: 'WELCOME100K', discount: 'Giảm 100.000 ₫', minOrder: '2.000.000 ₫', maxDiscount: '100.000 ₫', used: '128 / 200', expiry: '31/12/2026', status: 'Đang áp dụng', statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300' },
];
---

<AdminLayout title="Quản Lý Mã Giảm Giá - Nội Thất">
  <div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl text-walnut-900">Mã Giảm Giá & Phiếu Ưu Đãi</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Thiết lập các chiến dịch khuyến mãi, mã voucher và hạn mức áp dụng.</p>
      </div>

      <button 
        type="button" 
        onclick="alert('Mở form tạo mã giảm giá mới')"
        class="inline-flex items-center gap-2 bg-walnut-900 px-4 py-2 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Tạo Mã Mới</span>
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tổng voucher</p>
        <p class="text-2xl font-bold text-walnut-900 mt-1">4 mã</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Lượt đã kích hoạt</p>
        <p class="text-2xl font-bold text-clay-600 mt-1">301 lượt</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Chi phí trợ giá</p>
        <p class="text-2xl font-bold text-walnut-900 mt-1">42.500.000 ₫</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Trạng thái áp dụng</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1">3 mã còn hạn</p>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Mã Voucher</th>
              <th class="py-3 px-4 font-semibold">Mức giảm</th>
              <th class="py-3 px-4 font-semibold">Đơn tối thiểu</th>
              <th class="py-3 px-4 font-semibold">Giảm tối đa</th>
              <th class="py-3 px-4 font-semibold">Lượt dùng</th>
              <th class="py-3 px-4 font-semibold">Hạn sử dụng</th>
              <th class="py-3 px-4 font-semibold">Trạng thái</th>
              <th class="py-3 px-4 font-semibold text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-walnut-900/10">
            {coupons.map((c) => (
              <tr class="hover:bg-sand-100/50">
                <td class="py-3 px-4">
                  <span class="font-mono font-bold text-xs bg-sand-100 border border-walnut-900/20 px-2 py-1 rounded text-walnut-900">
                    {c.code}
                  </span>
                </td>
                <td class="py-3 px-4 font-bold text-clay-600">{c.discount}</td>
                <td class="py-3 px-4 text-walnut-900">{c.minOrder}</td>
                <td class="py-3 px-4 text-walnut-800">{c.maxDiscount}</td>
                <td class="py-3 px-4 font-medium text-walnut-900">{c.used}</td>
                <td class="py-3 px-4 text-walnut-800">{c.expiry}</td>
                <td class="py-3 px-4">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${c.statusColor}`}>
                    {c.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button type="button" class="text-xs font-semibold text-clay-600 hover:underline">Sửa</button>
                    <span class="text-walnut-800/30">|</span>
                    <button type="button" class="text-xs font-semibold text-red-600 hover:underline">Tắt</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
