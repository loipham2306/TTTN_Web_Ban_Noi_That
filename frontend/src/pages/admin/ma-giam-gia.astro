---
import AdminLayout from '../../layouts/AdminLayout.astro';

let coupons: any[] = [];
try {
  const res = await fetch('http://localhost:4000/api/coupons', { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data)) {
      coupons = json.data.map((c: any) => {
        const isFreeShip = c.discountType === 'free_shipping';
        const isPercent = c.discountType === 'percent' || c.discountType === 'percentage';
        const isExpired = c.endDate && new Date(c.endDate) < new Date();
        const isExhausted = c.usageLimit && c.usedCount >= c.usageLimit;

        let statusText = 'Đang áp dụng';
        let statusColor = 'bg-emerald-100 text-emerald-800 border-emerald-300';

        if (!c.status) {
          statusText = 'Đã tắt';
          statusColor = 'bg-slate-100 text-slate-800 border-slate-300';
        } else if (isExpired) {
          statusText = 'Hết hạn';
          statusColor = 'bg-red-100 text-red-800 border-red-300';
        } else if (isExhausted) {
          statusText = 'Hết lượt';
          statusColor = 'bg-amber-100 text-amber-800 border-amber-300';
        }

        let discountDisplay = '';
        if (isFreeShip) {
          discountDisplay = c.discountValue > 0 ? `Freeship tối đa ${Number(c.discountValue).toLocaleString('vi-VN')} ₫` : 'Freeship 100%';
        } else if (isPercent) {
          discountDisplay = `Giảm ${c.discountValue}%`;
        } else {
          discountDisplay = `Giảm ${Number(c.discountValue).toLocaleString('vi-VN')} ₫`;
        }

        return {
          id: c.id,
          code: c.code,
          discountType: c.discountType,
          discountValue: c.discountValue,
          discount: discountDisplay,
          minOrder: c.minOrderValue ? `${Number(c.minOrderValue).toLocaleString('vi-VN')} ₫` : '0 ₫',
          minOrderValue: c.minOrderValue || 0,
          maxDiscount: c.maxDiscountAmount ? `${Number(c.maxDiscountAmount).toLocaleString('vi-VN')} ₫` : 'Không giới hạn',
          maxDiscountAmount: c.maxDiscountAmount || null,
          limit: c.usageLimit || 100,
          used: c.usedCount || 0,
          expiry: c.endDate ? new Date(c.endDate).toISOString().split('T')[0] : '',
          expiryDisplay: c.endDate ? new Date(c.endDate).toLocaleDateString('vi-VN') : 'Vô thời hạn',
          status: statusText,
          statusColor,
          isActive: c.status,
        };
      });
    }
  }
} catch (err) {
  console.error('Không thể tải mã giảm giá từ backend:', err);
}

const totalUsed = coupons.reduce((sum, c) => sum + (c.used || 0), 0);
const activeCount = coupons.filter((c) => c.status === 'Đang áp dụng').length;
---

<AdminLayout title="Quản Lý Mã Giảm Giá - Nội Thất">
  <div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-sans font-bold text-2xl sm:text-3xl text-walnut-900">Mã Giảm Giá & Phiếu Ưu Đãi</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Thiết lập các chiến dịch khuyến mãi, mã voucher kết nối trực tiếp MySQL.</p>
      </div>

      <button 
        type="button" 
        id="btn-open-add-coupon"
        class="inline-flex items-center gap-2 bg-walnut-900 px-4 py-2.5 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm cursor-pointer font-medium"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Tạo Mã Mới</span>
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tổng voucher</p>
        <p id="stat-total-coupons" class="text-2xl font-bold text-walnut-900 mt-1">{coupons.length} mã</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Lượt đã sử dụng</p>
        <p id="stat-used-coupons" class="text-2xl font-bold text-clay-600 mt-1">{totalUsed} lượt</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Nguồn dữ liệu</p>
        <p class="text-2xl font-bold text-walnut-900 mt-1 flex items-center gap-1.5 text-emerald-700">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          MySQL Live
        </p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Trạng thái áp dụng</p>
        <p id="stat-active-coupons" class="text-2xl font-bold text-emerald-700 mt-1">{activeCount} mã hoạt động</p>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
