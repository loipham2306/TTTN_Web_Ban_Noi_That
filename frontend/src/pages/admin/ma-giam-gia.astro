---
import AdminLayout from '../../layouts/AdminLayout.astro';

const fallbackCoupons = [
  { 
    id: 1,
    code: 'NOITHATVIP20', 
    discount: 'Giảm 20%', 
    minOrder: '20.000.000 ₫', 
    maxDiscount: '5.000.000 ₫', 
    limit: 50, 
    used: 34, 
    expiry: '2026-12-31', 
    expiryDisplay: '31/12/2026', 
    status: 'Đang áp dụng', 
    statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300' 
  },
  { 
    id: 2,
    code: 'FREESHIP2026', 
    discount: 'Freeship toàn quốc', 
    minOrder: '10.000.000 ₫', 
    maxDiscount: '500.000 ₫', 
    limit: 100, 
    used: 89, 
    expiry: '2026-11-30', 
    expiryDisplay: '30/11/2026', 
    status: 'Đang áp dụng', 
    statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300' 
  },
  { 
    id: 3,
    code: 'TANXUAN10', 
    discount: 'Giảm 10%', 
    minOrder: '5.000.000 ₫', 
    maxDiscount: '2.000.000 ₫', 
    limit: 50, 
    used: 50, 
    expiry: '2026-10-15', 
    expiryDisplay: '15/10/2026', 
    status: 'Hết lượt', 
    statusColor: 'bg-amber-100 text-amber-800 border-amber-300' 
  },
  { 
    id: 4,
    code: 'WELCOME100K', 
    discount: 'Giảm 100.000 ₫', 
    minOrder: '2.000.000 ₫', 
    maxDiscount: '100.000 ₫', 
    limit: 200, 
    used: 128, 
    expiry: '2026-12-31', 
    expiryDisplay: '31/12/2026', 
    status: 'Đang áp dụng', 
    statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300' 
  },
];

let coupons = fallbackCoupons;
try {
  const res = await fetch('http://localhost:4000/api/coupons', { signal: AbortSignal.timeout(2000) });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data) && json.data.length > 0) {
      coupons = json.data.map((c: any) => ({
        id: c.id,
        code: c.code,
        discount: c.discountType === 'percentage' ? `Giảm ${c.discountValue}%` : `Giảm ${Number(c.discountValue).toLocaleString('vi-VN')} ₫`,
        minOrder: c.minOrderValue ? `${Number(c.minOrderValue).toLocaleString('vi-VN')} ₫` : '0 ₫',
        maxDiscount: c.maxDiscountAmount ? `${Number(c.maxDiscountAmount).toLocaleString('vi-VN')} ₫` : 'Không giới hạn',
        limit: c.usageLimit || 100,
        used: c.usedCount || 0,
        expiry: c.endDate ? new Date(c.endDate).toISOString().split('T')[0] : '2026-12-31',
        expiryDisplay: c.endDate ? new Date(c.endDate).toLocaleDateString('vi-VN') : '31/12/2026',
        status: !c.status ? 'Tạm ngưng' : (c.usedCount >= c.usageLimit ? 'Hết lượt' : 'Đang áp dụng'),
        statusColor: !c.status ? 'bg-slate-100 text-slate-800 border-slate-300' : (c.usedCount >= c.usageLimit ? 'bg-amber-100 text-amber-800 border-amber-300' : 'bg-emerald-100 text-emerald-800 border-emerald-300'),
      }));
    }
  }
} catch {}
---

<AdminLayout title="Quản Lý Mã Giảm Giá - Nội Thất">
  <div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-sans font-bold text-2xl sm:text-3xl text-walnut-900">Mã Giảm Giá & Phiếu Ưu Đãi</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Thiết lập các chiến dịch khuyến mãi, mã voucher và hạn mức áp dụng.</p>
      </div>

      <button 
        type="button" 
        id="btn-open-add-coupon"
        class="inline-flex items-center gap-2 bg-walnut-900 px-4 py-2.5 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm cursor-pointer font-medium"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Tạo Mã Mới</span>
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tổng voucher</p>
        <p id="stat-total-coupons" class="text-2xl font-bold text-walnut-900 mt-1">{coupons.length} mã</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Lượt đã kích hoạt</p>
        <p id="stat-used-coupons" class="text-2xl font-bold text-clay-600 mt-1">301 lượt</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Chi phí trợ giá</p>
        <p class="text-2xl font-bold text-walnut-900 mt-1">42.500.000 ₫</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Trạng thái áp dụng</p>
        <p id="stat-active-coupons" class="text-2xl font-bold text-emerald-700 mt-1">3 mã còn hạn</p>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Mã Voucher</th>
              <th class="py-3 px-4 font-semibold">Mức giảm</th>
              <th class="py-3 px-4 font-semibold">Đơn tối thiểu</th>
              <th class="py-3 px-4 font-semibold">Giảm tối đa</th>
              <th class="py-3 px-4 font-semibold">Lượt dùng</th>
              <th class="py-3 px-4 font-semibold">Hạn sử dụng</th>
              <th class="py-3 px-4 font-semibold">Trạng thái</th>
              <th class="py-3 px-4 font-semibold text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody id="coupon-table-body" class="divide-y divide-walnut-900/10">
            {coupons.map((c) => (
              <tr 
                class="hover:bg-sand-100/50 transition-colors"
                data-coupon-row
                data-id={c.id}
                data-code={c.code}
                data-discount={c.discount}
                data-min-order={c.minOrder}
                data-max-discount={c.maxDiscount}
                data-used={c.used}
                data-limit={c.limit}
                data-expiry={c.expiry}
                data-expiry-display={c.expiryDisplay}
                data-status={c.status}
              >
                <td class="py-3 px-4">
                  <span class="font-mono font-bold text-xs bg-sand-100 border border-walnut-900/20 px-2.5 py-1 rounded text-walnut-900" data-col="code">
                    {c.code}
                  </span>
                </td>
                <td class="py-3 px-4 font-bold text-clay-600" data-col="discount">{c.discount}</td>
                <td class="py-3 px-4 text-walnut-900 font-medium" data-col="min-order">{c.minOrder}</td>
                <td class="py-3 px-4 text-walnut-800" data-col="max-discount">{c.maxDiscount}</td>
                <td class="py-3 px-4 font-medium text-walnut-900" data-col="used">{c.used} / {c.limit}</td>
                <td class="py-3 px-4 text-walnut-800" data-col="expiry">{c.expiryDisplay}</td>
                <td class="py-3 px-4" data-col="status">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${c.statusColor}`}>
                    {c.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button 
                      type="button" 
                      data-btn-edit-coupon
                      class="text-xs font-semibold text-clay-600 hover:underline cursor-pointer"
                    >
                      Sửa
                    </button>
                    <span class="text-walnut-800/30">|</span>
                    <button 
                      type="button" 
                      data-btn-toggle-coupon
                      class={`text-xs font-semibold cursor-pointer hover:underline ${c.status === 'Đang áp dụng' ? 'text-red-600' : 'text-emerald-700'}`}
                    >
                      {c.status === 'Đang áp dụng' ? 'Tắt' : 'Bật'}
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- MODAL: TẠO / SỬA MÃ GIẢM GIÁ -->
  <div id="coupon-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/30 w-full max-w-lg shadow-2xl rounded-none relative my-4 max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- HEADER WALNUT XANH ĐẬM VỚI DẢI VÀNG CHAMPAGNE -->
      <div class="relative bg-[#173524] px-6 py-5 sm:px-8 border-b border-[#D8B670]/30 shrink-0">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#D8B670]/25 to-[#D8B670]/5 border border-[#D8B670]/40 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 text-[#E6CA85]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
              </svg>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.22em] text-[#D8B670] font-semibold">QUẢN TRỊ KHUYẾN MÃI</p>
              <h2 id="coupon-modal-title" class="text-lg sm:text-xl font-display font-bold text-white tracking-wide mt-0.5">Tạo Mã Giảm Giá Mới</h2>
            </div>
          </div>

          <button 
            type="button" 
            id="btn-close-coupon-modal" 
            class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-sand-200 hover:text-white flex items-center justify-center transition-all hover:rotate-90 cursor-pointer border border-white/10"
            title="Đóng cửa sổ"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <form id="coupon-form" class="flex flex-col flex-1 overflow-hidden">
        <input type="hidden" id="coupon-edit-origin-code" value="" />

        <!-- MODAL BODY (SCROLLABLE) -->
        <div class="p-6 sm:p-8 space-y-4 overflow-y-auto flex-1 bg-[#FAF8F5]">
          <div>
            <label for="coupon-code-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Mã Voucher (Viết hoa không dấu) *</label>
            <div class="mt-1.5 flex gap-2">
              <input 
                type="text" 
                id="coupon-code-input" 
                required 
                placeholder="VD: NOITHAT2026" 
                class="w-full uppercase font-mono tracking-wider border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 font-bold shadow-xs"
              />
              <button 
                type="button" 
                id="btn-gen-coupon-code" 
                class="shrink-0 border border-walnut-900/20 bg-sand-100 hover:bg-sand-200 px-3 py-2 text-[10px] font-semibold text-walnut-900 cursor-pointer uppercase tracking-wider transition-colors shadow-xs"
              >
                Tạo tự động
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="coupon-discount-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Mức giảm *</label>
              <input 
                type="text" 
                id="coupon-discount-input" 
                required 
                placeholder="VD: Giảm 20% hoặc 500.000 ₫" 
                class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs"
              />
            </div>
            <div>
              <label for="coupon-min-order-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Đơn tối thiểu *</label>
              <input 
                type="text" 
                id="coupon-min-order-input" 
                required 
                placeholder="VD: 5.000.000 ₫" 
                class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="coupon-max-discount-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Giảm tối đa</label>
              <input 
                type="text" 
                id="coupon-max-discount-input" 
                placeholder="VD: 1.000.000 ₫ hoặc Không giới hạn" 
                class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs"
              />
            </div>
            <div>
              <label for="coupon-limit-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Số lượt phát hành *</label>
              <input 
                type="number" 
                id="coupon-limit-input" 
                required 
                min="1" 
                placeholder="100" 
                class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="coupon-expiry-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Hạn sử dụng *</label>
              <input 
                type="date" 
                id="coupon-expiry-input" 
                required 
                class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs"
              />
            </div>
            <div>
              <label for="coupon-status-select" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Trạng thái áp dụng</label>
              <select 
                id="coupon-status-select" 
                class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3 py-2.5 text-xs outline-none focus:border-clay-600 cursor-pointer shadow-xs"
              >
                <option value="Đang áp dụng">Đang áp dụng</option>
                <option value="Đã tắt">Tạm tắt</option>
                <option value="Hết lượt">Hết lượt</option>
              </select>
            </div>
          </div>
        </div>

        <!-- MODAL FOOTER (STICKY BOTTOM) -->
        <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex items-center justify-end gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
          <button 
            type="button" 
            id="btn-cancel-coupon-modal" 
            class="border border-walnut-900/20 px-5 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer"
          >
            Hủy
          </button>
          <button 
            type="submit" 
            class="bg-gradient-to-r from-[#D8B670] via-[#E2C37E] to-[#C49E52] px-6 py-2.5 text-xs uppercase tracking-[0.18em] font-bold text-[#173524] hover:from-[#C49E52] hover:to-[#B58F43] hover:text-white shadow-md transition-all active:scale-95 cursor-pointer border border-[#E0C582]/50"
          >
            Lưu mã giảm giá
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOAST -->
  <div id="coupon-toast" class="fixed bottom-6 right-6 z-50 hidden translate-y-4 rounded bg-walnut-900 px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300 border border-emerald-500/40">
    <span id="coupon-toast-msg">Đã cập nhật mã giảm giá thành công!</span>
  </div>

</AdminLayout>

<script>
  const initCouponPage = () => {
    const tableBody = document.getElementById('coupon-table-body') as HTMLElement;
    const totalCouponsEl = document.getElementById('stat-total-coupons') as HTMLElement;
    const activeCouponsEl = document.getElementById('stat-active-coupons') as HTMLElement;

    // Modals
    const modal = document.getElementById('coupon-modal') as HTMLElement;
    const modalTitle = document.getElementById('coupon-modal-title') as HTMLElement;
    const btnOpenAdd = document.getElementById('btn-open-add-coupon') as HTMLButtonElement;
    const btnCloseModal = document.getElementById('btn-close-coupon-modal') as HTMLButtonElement;
    const btnCancelModal = document.getElementById('btn-cancel-coupon-modal') as HTMLButtonElement;
    const form = document.getElementById('coupon-form') as HTMLFormElement;

    // Form inputs
    const originCodeInput = document.getElementById('coupon-edit-origin-code') as HTMLInputElement;
    const codeInput = document.getElementById('coupon-code-input') as HTMLInputElement;
    const discountInput = document.getElementById('coupon-discount-input') as HTMLInputElement;
    const minOrderInput = document.getElementById('coupon-min-order-input') as HTMLInputElement;
    const maxDiscountInput = document.getElementById('coupon-max-discount-input') as HTMLInputElement;
    const limitInput = document.getElementById('coupon-limit-input') as HTMLInputElement;
    const expiryInput = document.getElementById('coupon-expiry-input') as HTMLInputElement;
    const statusSelect = document.getElementById('coupon-status-select') as HTMLSelectElement;
    const btnGenCode = document.getElementById('btn-gen-coupon-code') as HTMLButtonElement;

    // Toast
    const toast = document.getElementById('coupon-toast') as HTMLElement;
    const toastMsg = document.getElementById('coupon-toast-msg') as HTMLElement;

    const showToast = (msg: string) => {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove('hidden');
      requestAnimationFrame(() => toast.classList.remove('translate-y-4'));
      setTimeout(() => {
        toast.classList.add('translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3000);
    };

    const updateStats = () => {
      if (tableBody) {
        const rows = tableBody.querySelectorAll<HTMLTableRowElement>('[data-coupon-row]');
        if (totalCouponsEl) totalCouponsEl.textContent = `${rows.length} mã`;

        let activeCount = 0;
        rows.forEach((r) => {
          if (r.dataset.status === 'Đang áp dụng') activeCount++;
        });
        if (activeCouponsEl) activeCouponsEl.textContent = `${activeCount} mã còn hạn`;
      }
    };

    const openModal = (isEdit: boolean, row?: HTMLTableRowElement) => {
      if (!modal) return;
      if (isEdit && row) {
        modalTitle.textContent = `Chỉnh sửa mã: ${row.dataset.code}`;
        originCodeInput.value = row.dataset.code || '';
        codeInput.value = row.dataset.code || '';
        discountInput.value = row.dataset.discount || '';
        minOrderInput.value = row.dataset.minOrder || '';
        maxDiscountInput.value = row.dataset.maxDiscount || '';
        limitInput.value = row.dataset.limit || '100';
        expiryInput.value = row.dataset.expiry || new Date().toISOString().split('T')[0];
        statusSelect.value = row.dataset.status || 'Đang áp dụng';
      } else {
        modalTitle.textContent = 'Tạo Mã Giảm Giá Mới';
        form.reset();
        originCodeInput.value = '';
        limitInput.value = '100';
        // default 30 days expiry
        const d = new Date();
        d.setDate(d.getDate() + 30);
        expiryInput.value = d.toISOString().split('T')[0];
        statusSelect.value = 'Đang áp dụng';
      }
      modal.classList.remove('hidden');
    };

    const closeModal = () => modal?.classList.add('hidden');

    btnOpenAdd?.addEventListener('click', () => openModal(false));
    btnCloseModal?.addEventListener('click', closeModal);
    btnCancelModal?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Auto generator
    btnGenCode?.addEventListener('click', () => {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      let res = 'NT';
      for (let i = 0; i < 6; i++) {
        res += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      codeInput.value = res;
    });

    const formatVnDate = (isoDate: string) => {
      if (!isoDate) return '';
      const parts = isoDate.split('-');
      if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
      return isoDate;
    };

    // Attach Row Actions
    const attachRowActions = (row: HTMLTableRowElement) => {
      const editBtn = row.querySelector('[data-btn-edit-coupon]');
      const toggleBtn = row.querySelector('[data-btn-toggle-coupon]') as HTMLButtonElement | null;

      editBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(true, row);
      });

      toggleBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        const current = row.dataset.status || 'Đang áp dụng';
        const isCurrentlyActive = current === 'Đang áp dụng';
        const nextStatus = isCurrentlyActive ? 'Đã tắt' : 'Đang áp dụng';
        const nextColor = isCurrentlyActive 
          ? 'bg-slate-100 text-slate-800 border-slate-300' 
          : 'bg-emerald-100 text-emerald-800 border-emerald-300';

        row.dataset.status = nextStatus;
        const statusEl = row.querySelector('[data-col="status"]');
        if (statusEl) {
          statusEl.innerHTML = `<span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${nextColor}">${nextStatus}</span>`;
        }

        toggleBtn.textContent = isCurrentlyActive ? 'Bật' : 'Tắt';
        toggleBtn.className = `text-xs font-semibold cursor-pointer hover:underline ${isCurrentlyActive ? 'text-emerald-700' : 'text-red-600'}`;

        const couponId = row.dataset.id;
        if (couponId) {
          fetch(`http://localhost:4000/api/coupons/${couponId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: !isCurrentlyActive }),
          }).catch(() => {});
        }

        updateStats();
        showToast(`Đã chuyển trạng thái voucher "${row.dataset.code}" sang: ${nextStatus}`);
      });
    };

    if (tableBody) {
      tableBody.querySelectorAll<HTMLTableRowElement>('[data-coupon-row]').forEach(attachRowActions);
    }

    // Submit form
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = codeInput.value.trim().toUpperCase();
      const discount = discountInput.value.trim();
      const minOrder = minOrderInput.value.trim();
      const maxDiscount = maxDiscountInput.value.trim() || 'Không giới hạn';
      const limit = limitInput.value.trim();
      const expiryIso = expiryInput.value;
      const expiryDisplay = formatVnDate(expiryIso);
      const status = statusSelect.value;
      const originCode = originCodeInput.value.trim();

      if (!code || !discount || !minOrder || !tableBody) return;

      const isPercentage = discount.includes('%');
      const discountVal = parseFloat(discount.replace(/[^0-9.]/g, '')) || 0;
      const minOrderVal = parseFloat(minOrder.replace(/[^0-9.]/g, '')) || 0;
      const maxDiscountVal = maxDiscount.includes('Không') ? null : (parseFloat(maxDiscount.replace(/[^0-9.]/g, '')) || null);

      let newIdFromApi = '';

      try {
        if (originCode) {
          const targetRow = tableBody.querySelector<HTMLTableRowElement>(`[data-code="${originCode}"]`);
          const couponId = targetRow?.dataset.id;
          if (couponId) {
            await fetch(`http://localhost:4000/api/coupons/${couponId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                code,
                discountType: isPercentage ? 'percentage' : 'fixed_amount',
                discountValue: discountVal,
                minOrderValue: minOrderVal,
                maxDiscountAmount: maxDiscountVal,
                endDate: expiryIso ? new Date(expiryIso) : undefined,
                usageLimit: limit ? parseInt(limit) : 100,
                status: status === 'Đang áp dụng',
              }),
            });
          }
        } else {
          const res = await fetch('http://localhost:4000/api/coupons', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              code,
              discountType: isPercentage ? 'percentage' : 'fixed_amount',
              discountValue: discountVal,
              minOrderValue: minOrderVal,
              maxDiscountAmount: maxDiscountVal,
              endDate: expiryIso ? new Date(expiryIso) : undefined,
              usageLimit: limit ? parseInt(limit) : 100,
              status: status === 'Đang áp dụng',
            }),
          });
          const json = await res.json();
          if (json.success && json.data?.id) {
            newIdFromApi = String(json.data.id);
          }
        }
      } catch {}

      const statusColor = status === 'Đang áp dụng'
        ? 'bg-emerald-100 text-emerald-800 border-emerald-300'
        : status === 'Hết lượt'
        ? 'bg-amber-100 text-amber-800 border-amber-300'
        : 'bg-slate-100 text-slate-800 border-slate-300';

      if (originCode) {
        // Edit existing
        const targetRow = tableBody.querySelector<HTMLTableRowElement>(`[data-code="${originCode}"]`);
        if (targetRow) {
          targetRow.dataset.code = code;
          targetRow.dataset.discount = discount;
          targetRow.dataset.minOrder = minOrder;
          targetRow.dataset.maxDiscount = maxDiscount;
          targetRow.dataset.limit = limit;
          targetRow.dataset.expiry = expiryIso;
          targetRow.dataset.expiryDisplay = expiryDisplay;
          targetRow.dataset.status = status;

          const colCode = targetRow.querySelector('[data-col="code"]');
          if (colCode) colCode.textContent = code;
          const colDiscount = targetRow.querySelector('[data-col="discount"]');
          if (colDiscount) colDiscount.textContent = discount;
          const colMinOrder = targetRow.querySelector('[data-col="min-order"]');
          if (colMinOrder) colMinOrder.textContent = minOrder;
          const colMaxDiscount = targetRow.querySelector('[data-col="max-discount"]');
          if (colMaxDiscount) colMaxDiscount.textContent = maxDiscount;
          const colUsed = targetRow.querySelector('[data-col="used"]');
          if (colUsed) colUsed.textContent = `${targetRow.dataset.used || '0'} / ${limit}`;
          const colExpiry = targetRow.querySelector('[data-col="expiry"]');
          if (colExpiry) colExpiry.textContent = expiryDisplay;
          const colStatus = targetRow.querySelector('[data-col="status"]');
          if (colStatus) {
            colStatus.innerHTML = `<span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${statusColor}">${status}</span>`;
          }

          const toggleBtn = targetRow.querySelector('[data-btn-toggle-coupon]') as HTMLButtonElement | null;
          if (toggleBtn) {
            toggleBtn.textContent = status === 'Đang áp dụng' ? 'Tắt' : 'Bật';
            toggleBtn.className = `text-xs font-semibold cursor-pointer hover:underline ${status === 'Đang áp dụng' ? 'text-red-600' : 'text-emerald-700'}`;
          }

          closeModal();
          updateStats();
          showToast(`Đã cập nhật mã giảm giá "${code}" thành công!`);
        }
      } else {
        // Add new
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-sand-100/50 transition-colors bg-emerald-50/30';
        tr.setAttribute('data-coupon-row', '');
        if (newIdFromApi) tr.dataset.id = newIdFromApi;
        tr.dataset.code = code;
        tr.dataset.discount = discount;
        tr.dataset.minOrder = minOrder;
        tr.dataset.maxDiscount = maxDiscount;
        tr.dataset.used = '0';
        tr.dataset.limit = limit;
        tr.dataset.expiry = expiryIso;
        tr.dataset.expiryDisplay = expiryDisplay;
        tr.dataset.status = status;

        tr.innerHTML = `
          <td class="py-3 px-4">
            <span class="font-mono font-bold text-xs bg-sand-100 border border-walnut-900/20 px-2.5 py-1 rounded text-walnut-900" data-col="code">
              ${code}
            </span>
          </td>
          <td class="py-3 px-4 font-bold text-clay-600" data-col="discount">${discount}</td>
          <td class="py-3 px-4 text-walnut-900 font-medium" data-col="min-order">${minOrder}</td>
          <td class="py-3 px-4 text-walnut-800" data-col="max-discount">${maxDiscount}</td>
          <td class="py-3 px-4 font-medium text-walnut-900" data-col="used">0 / ${limit}</td>
          <td class="py-3 px-4 text-walnut-800" data-col="expiry">${expiryDisplay}</td>
          <td class="py-3 px-4" data-col="status">
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${statusColor}">
              ${status}
            </span>
          </td>
          <td class="py-3 px-4 text-right">
            <div class="flex items-center justify-end gap-2">
              <button type="button" data-btn-edit-coupon class="text-xs font-semibold text-clay-600 hover:underline cursor-pointer">Sửa</button>
              <span class="text-walnut-800/30">|</span>
              <button type="button" data-btn-toggle-coupon class="text-xs font-semibold cursor-pointer hover:underline ${status === 'Đang áp dụng' ? 'text-red-600' : 'text-emerald-700'}">${status === 'Đang áp dụng' ? 'Tắt' : 'Bật'}</button>
            </div>
          </td>
        `;

        attachRowActions(tr);
        tableBody.prepend(tr);
        closeModal();
        updateStats();
        showToast(`Đã tạo mã giảm giá mới "${code}" thành công!`);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCouponPage);
  } else {
    initCouponPage();
  }
</script>
