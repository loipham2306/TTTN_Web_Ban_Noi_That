---
import AdminLayout from '../../layouts/AdminLayout.astro';

const kpis = [
  { label: 'Tổng doanh thu (Tháng này)', value: '485.600.000 ₫', change: '+18.4%', trend: 'up', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { label: 'Tổng số đơn hàng', value: '128 đơn', change: '+12.5%', trend: 'up', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
  { label: 'Khách hàng mới', value: '86 khách', change: '+9.2%', trend: 'up', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { label: 'Lượt tư vấn AI Phong Thủy', value: '342 lượt', change: '+34.0%', trend: 'up', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' },
];

const recentOrders = [
  { id: 'ORD-8821', customer: 'Nguyễn Văn An', phone: '0908 123 456', total: '24.500.000 ₫', status: 'Chờ xác nhận', statusColor: 'bg-amber-100 text-amber-800 border-amber-300', date: '10:30 Hôm nay' },
  { id: 'ORD-8820', customer: 'Trần Thị Mai', phone: '0912 345 678', total: '48.900.000 ₫', status: 'Đang chuẩn bị', statusColor: 'bg-blue-100 text-blue-800 border-blue-300', date: '09:15 Hôm nay' },
  { id: 'ORD-8819', customer: 'Lê Hoàng Long', phone: '0987 654 321', total: '15.200.000 ₫', status: 'Đang giao hàng', statusColor: 'bg-purple-100 text-purple-800 border-purple-300', date: 'Hôm qua' },
  { id: 'ORD-8818', customer: 'Phạm Minh Đức', phone: '0933 888 999', total: '68.000.000 ₫', status: 'Đã hoàn thành', statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300', date: '08/10/2026' },
  { id: 'ORD-8817', customer: 'Vũ Hải Yến', phone: '0901 222 333', total: '8.500.000 ₫', status: 'Đã hoàn thành', statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300', date: '07/10/2026' },
];

const topProducts = [
  { name: 'Sofa Da Ý Milano Cao Cấp', category: 'Sofa', sales: '32 chiếc', revenue: '784.000.000 ₫', stock: 8, image: 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=400&q=80' },
  { name: 'Bàn Ăn Đá Marble Carrara', category: 'Bàn Ăn', sales: '24 bộ', revenue: '456.000.000 ₫', stock: 12, image: 'https://images.unsplash.com/photo-1617806118233-18e1de247200?auto=format&fit=crop&w=400&q=80' },
  { name: 'Ghế Thư Giãn Gỗ Óc Chó', category: 'Ghế', sales: '41 chiếc', revenue: '348.500.000 ₫', stock: 15, image: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=400&q=80' },
  { name: 'Giường Ngủ Scandinavian', category: 'Giường', sales: '18 chiếc', revenue: '306.000.000 ₫', stock: 5, image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=400&q=80' },
];
---

<AdminLayout title="Trang Tổng Quan Quản Trị - Nội Thất">
  <div class="space-y-8">

    <!-- Top Banner & Quick Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl text-walnut-900">Tổng Quan Hoạt Động Doanh Nghiệp</h1>
        <p class="mt-1 text-sm text-walnut-800/80">
          Cập nhật tình hình kinh doanh, quản lý kho hàng và báo cáo đơn hàng theo thời gian thực.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 rounded bg-sand-50 border border-walnut-900/15 px-3 py-1.5 text-xs text-walnut-800">
          <svg class="h-4 w-4 text-walnut-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Tháng 10 / 2026
        </span>
        <a
          href="/admin/san-pham"
          class="inline-flex items-center gap-2 bg-walnut-900 px-4 py-2 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Thêm Sản Phẩm</span>
        </a>
      </div>
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {kpis.map((kpi) => (
        <div class="rounded border border-walnut-900/10 bg-sand-50 p-5 shadow-sm hover:border-walnut-900/30 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-walnut-800/80 uppercase tracking-wider">{kpi.label}</span>
            <div class="h-9 w-9 rounded bg-sand-100 flex items-center justify-center text-walnut-900">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={kpi.icon} />
              </svg>
            </div>
          </div>
          <p class="mt-3 text-2xl font-bold text-walnut-900">{kpi.value}</p>
          <div class="mt-2 flex items-center gap-2 text-xs">
            <span class="inline-flex items-center font-semibold text-emerald-700 bg-emerald-100/60 px-1.5 py-0.5 rounded">
              <svg class="h-3.5 w-3.5 mr-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              {kpi.change}
            </span>
            <span class="text-walnut-800/60">so với tháng trước</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Analytics Charts & Structure Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Revenue Visual Progress (2 cols) -->
      <div class="lg:col-span-2 rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-walnut-900/10">
          <div>
            <h2 class="text-base font-bold text-walnut-900">Biểu Đồ Doanh Thu 7 Ngày Gần Nhất</h2>
            <p class="text-xs text-walnut-800/70">Số liệu ghi nhận từ hệ thống đặt hàng trực tuyến</p>
          </div>
          <span class="text-xs font-semibold text-walnut-900 bg-sand-100 px-2.5 py-1 rounded">Đơn vị: Triệu VNĐ</span>
        </div>

        <!-- Simulated CSS Bar Chart -->
        <div class="mt-6 grid grid-cols-7 gap-3 sm:gap-6 items-end h-56 pt-6 border-b border-walnut-900/10 pb-2">
          {[
            { day: 'T2', val: 42, height: '55%' },
            { day: 'T3', val: 68, height: '78%' },
            { day: 'T4', val: 51, height: '62%' },
            { day: 'T5', val: 89, height: '94%' },
            { day: 'T6', val: 74, height: '82%' },
            { day: 'T7', val: 95, height: '100%' },
            { day: 'CN', val: 80, height: '88%' },
          ].map((bar) => (
            <div class="flex flex-col items-center gap-2 h-full justify-end group">
              <span class="text-[11px] font-semibold text-walnut-800 opacity-0 group-hover:opacity-100 transition-opacity">{bar.val}M</span>
              <div 
                class="w-full rounded-t bg-walnut-900 group-hover:bg-clay-600 transition-all duration-300 relative" 
                style={`height: ${bar.height};`}
              ></div>
              <span class="text-xs font-medium text-walnut-800 mt-1">{bar.day}</span>
            </div>
          ))}
        </div>

        <div class="mt-4 flex items-center justify-between text-xs text-walnut-800/80">
          <span>Trung bình: <strong>71.2 Triệu / ngày</strong></span>
          <a href="/admin/doanh-thu" class="text-clay-600 hover:underline font-medium">Xem báo cáo chi tiết &rarr;</a>
        </div>
      </div>

      <!-- Category Share (1 col) -->
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-walnut-900/10">
            <h2 class="text-base font-bold text-walnut-900">Tỷ Trọng Doanh Số</h2>
            <span class="text-xs text-walnut-800/70">Theo danh mục</span>
          </div>

          <div class="mt-5 space-y-4">
            {[
              { name: 'Sofa & Phòng Khách', percent: 45, color: 'bg-walnut-900' },
              { name: 'Bàn Ghế Ăn', percent: 25, color: 'bg-clay-600' },
              { name: 'Giường & Tủ Áo', percent: 18, color: 'bg-olive-700' },
              { name: 'Đèn & Trang Trí Decor', percent: 12, color: 'bg-amber-700' },
            ].map((cat) => (
              <div>
                <div class="flex justify-between text-xs font-medium mb-1">
                  <span class="text-walnut-900">{cat.name}</span>
                  <span class="font-bold text-walnut-900">{cat.percent}%</span>
                </div>
                <div class="w-full bg-sand-200/60 rounded-full h-2 overflow-hidden">
                  <div class={`h-2 rounded-full ${cat.color}`} style={`width: ${cat.percent}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 border-t border-walnut-900/10 pt-4">
          <a href="/admin/danh-muc" class="block text-center text-xs font-semibold uppercase tracking-wider text-walnut-900 hover:text-clay-600">
            Quản lý tất cả danh mục &rarr;
          </a>
        </div>
      </div>

    </div>

    <!-- Tables: Recent Orders & Best Selling Products -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Recent Orders Table -->
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-walnut-900/10">
          <div>
            <h2 class="text-base font-bold text-walnut-900">Đơn Hàng Mới Nhất</h2>
            <p class="text-xs text-walnut-800/70">Các đơn phát sinh trong 24 giờ qua</p>
          </div>
          <a href="/admin/don-hang" class="text-xs font-semibold text-clay-600 hover:underline">
            Tất cả đơn &rarr;
          </a>
        </div>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-walnut-900/10 text-walnut-800/70 uppercase tracking-wider">
                <th class="py-2.5 font-semibold">Mã đơn</th>
                <th class="py-2.5 font-semibold">Khách hàng</th>
                <th class="py-2.5 font-semibold">Tổng tiền</th>
                <th class="py-2.5 font-semibold">Trạng thái</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-walnut-900/10">
              {recentOrders.map((o) => (
                <tr class="hover:bg-sand-100/50">
                  <td class="py-3 font-semibold text-walnut-900">{o.id}</td>
                  <td class="py-3">
                    <p class="font-medium text-walnut-900">{o.customer}</p>
                    <p class="text-[10px] text-walnut-800/60">{o.phone}</p>
                  </td>
                  <td class="py-3 font-semibold text-clay-600">{o.total}</td>
                  <td class="py-3">
                    <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-medium border ${o.statusColor}`}>
                      {o.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Top Best Selling Products -->
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-walnut-900/10">
          <div>
            <h2 class="text-base font-bold text-walnut-900">Sản Phẩm Bán Chạy</h2>
            <p class="text-xs text-walnut-800/70">Top mặt hàng nội thất có doanh thu cao nhất</p>
          </div>
          <a href="/admin/san-pham" class="text-xs font-semibold text-clay-600 hover:underline">
            Quản lý kho &rarr;
          </a>
        </div>

        <div class="mt-4 space-y-3">
          {topProducts.map((p) => (
            <div class="flex items-center justify-between p-2 rounded hover:bg-sand-100 transition-colors">
              <div class="flex items-center gap-3">
                <img src={p.image} alt={p.name} class="h-11 w-11 rounded object-cover border border-walnut-900/10" />
                <div>
                  <p class="text-xs font-bold text-walnut-900">{p.name}</p>
                  <p class="text-[11px] text-walnut-800/70">Danh mục: {p.category} &bull; Tồn kho: <strong class="text-walnut-900">{p.stock}</strong></p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-xs font-bold text-clay-600">{p.revenue}</p>
                <p class="text-[10px] text-emerald-700 font-medium">Đã bán: {p.sales}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Quick Navigation Grid -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
      <h2 class="text-sm font-bold uppercase tracking-wider text-walnut-900 mb-4">Lối Tắt Quản Trị Hệ Thống</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <a href="/admin/san-pham" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Sản phẩm</p>
          <p class="text-[10px] opacity-70">19 mặt hàng</p>
        </a>
        <a href="/admin/don-hang" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Đơn hàng</p>
          <p class="text-[10px] opacity-70">5 đơn mới</p>
        </a>
        <a href="/admin/danh-muc" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Danh mục</p>
          <p class="text-[10px] opacity-70">7 nhóm hàng</p>
        </a>
        <a href="/admin/khach-hang" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Khách hàng</p>
          <p class="text-[10px] opacity-70">86 thành viên</p>
        </a>
        <a href="/admin/ma-giam-gia" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Mã giảm giá</p>
          <p class="text-[10px] opacity-70">4 voucher</p>
        </a>
        <a href="/admin/cai-dat" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Cài đặt</p>
          <p class="text-[10px] opacity-70">Cấu hình web</p>
        </a>
      </div>
    </div>

  </div>
</AdminLayout>
