---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { products, categories, formatVnd } from '../../data/products';

const tonKho: Record<string, string> = {
  'ghe-ngoai-troi-go-teak': 'het-hang',
  'guong-trang-tri-vien-vang': 'nhap',
  'den-ban-gom': 'het-hang',
};

const NHAN: Record<string, { label: string; cls: string }> = {
  'con-hang': { label: 'Đang bán', cls: 'bg-olive-700/20 text-walnut-900' },
  'het-hang': { label: 'Hết hàng', cls: 'bg-danger-600/10 text-danger-600' },
  'nhap': { label: 'Nháp', cls: 'bg-walnut-900/10 text-walnut-800' },
};

const rows = products.map((product) => ({
  ...product,
  status: tonKho[product.slug] ?? 'con-hang',
}));

const perPage = 10;

const stats = [
  { label: 'Tổng sản phẩm', value: String(rows.length) },
  { label: 'Đang bán', value: String(rows.filter((row) => row.status === 'con-hang').length) },
  { label: 'Hết hàng', value: String(rows.filter((row) => row.status === 'het-hang').length) },
  { label: 'Danh mục', value: String(categories.length) },
];
---

<AdminLayout title="Quản trị · Sản phẩm | Nội Thất">

  <header class="flex flex-wrap items-end justify-between gap-4 border-b border-walnut-900/10 pb-6">
    <div>
      <p class="text-[11px] uppercase tracking-[0.25em] text-walnut-800">Bảng quản trị</p>
      <h1 class="mt-2 font-display text-2xl tracking-tight sm:text-3xl">Sản phẩm</h1>
      <p class="mt-2 text-sm text-walnut-800">Quản lý danh mục sản phẩm đang bán trên cửa hàng.</p>
    </div>
    <button
      type="button"
      disabled
      title="Chưa nối API"
      class="cursor-not-allowed bg-clay-600/40 px-6 py-3 text-xs uppercase tracking-[0.2em] text-sand-50"
    >
      Thêm sản phẩm
    </button>
  </header>

  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {stats.map((item) => (
      <div class="border border-walnut-900/10 bg-sand-50 p-5">
        <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">{item.label}</p>
        <p class="mt-2 font-display text-3xl tracking-tight text-walnut-900">{item.value}</p>
      </div>
    ))}
  </section>

  <section id="danh-sach-san-pham" class="mt-10 scroll-mt-6">

    <div class="flex flex-wrap items-center gap-3">
      <input
        data-adm-search
        type="search"
        placeholder="Tìm theo tên sản phẩm"
        aria-label="Tìm theo tên sản phẩm"
        class="w-full max-w-xs border border-walnut-900/20 bg-sand-50 px-4 py-2.5 text-sm outline-none transition-colors placeholder:text-walnut-800/50 focus:border-clay-600"
      />

      <select
        data-adm-category
        aria-label="Lọc theo danh mục"
        class="border border-walnut-900/20 bg-sand-50 px-3 py-2.5 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600"
      >
        <option value="">Tất cả danh mục</option>
        {categories.map((item) => <option value={item.key}>{item.label}</option>)}
      </select>

      <select
        data-adm-status
        aria-label="Lọc theo trạng thái"
        class="border border-walnut-900/20 bg-sand-50 px-3 py-2.5 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600"
      >
        <option value="">Tất cả trạng thái</option>
        <option value="con-hang">Đang bán</option>
        <option value="het-hang">Hết hàng</option>
        <option value="nhap">Nháp</option>
      </select>

      <button
        type="button"
        data-adm-reset
        class="text-xs uppercase tracking-[0.2em] text-walnut-800 underline underline-offset-4 transition-colors hover:text-clay-600"
      >
        Xoá lọc
      </button>

      <p data-adm-count class="ml-auto text-xs uppercase tracking-[0.15em] text-walnut-800"></p>
    </div>

    <div class="mt-5 overflow-x-auto border border-walnut-900/10 bg-sand-50">
      <table class="w-full min-w-[46rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-walnut-900/15 text-[11px] uppercase tracking-[0.18em] text-walnut-800">
            <th scope="col" class="px-4 py-3 font-medium">Ảnh</th>
            <th scope="col" class="px-4 py-3 font-medium">Sản phẩm</th>
            <th scope="col" class="px-4 py-3 font-medium">Danh mục</th>
            <th scope="col" class="px-4 py-3 font-medium">Không gian</th>
            <th scope="col" class="px-4 py-3 font-medium">Giá</th>
            <th scope="col" class="px-4 py-3 font-medium">Trạng thái</th>
            <th scope="col" class="px-4 py-3 font-medium">Thao tác</th>
          </tr>
        </thead>

        <tbody data-adm-body data-page-size={perPage}>
          {rows.map((row) => (
            <tr
              data-row
              data-name={row.name}
              data-category={row.category}
              data-status={row.status}
              class="border-b border-walnut-900/10 last:border-b-0"
            >
              <td class="px-4 py-3 align-middle">
                <span class="block h-12 w-10 bg-sand-200"></span>
              </td>
              <td class="px-4 py-3 align-middle">
                <p class="text-sm text-walnut-900">{row.name}</p>
                <p class="mt-0.5 text-xs text-walnut-800">/{row.slug}</p>
              </td>
              <td class="px-4 py-3 align-middle text-sm text-walnut-800">{row.categoryLabel}</td>
              <td class="px-4 py-3 align-middle text-sm text-walnut-800">{row.spaceLabel}</td>
              <td class="whitespace-nowrap px-4 py-3 align-middle text-sm text-walnut-900">{formatVnd(row.price)}</td>
              <td class="px-4 py-3 align-middle">
                <span class={`inline-block px-2.5 py-1 text-[10px] uppercase tracking-[0.15em] ${NHAN[row.status].cls}`}>
                  {NHAN[row.status].label}
                </span>
              </td>
              <td class="px-4 py-3 align-middle">
                <div class="flex items-center gap-4 whitespace-nowrap text-xs uppercase tracking-[0.15em]">
                  <a href={`/san-pham/${row.slug}`} class="text-walnut-900 underline underline-offset-4 transition-colors hover:text-clay-600">Xem</a>
                  <button type="button" disabled title="Chưa nối API" class="cursor-not-allowed text-walnut-800/50 underline underline-offset-4">Sửa</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p data-adm-empty class="mt-10 hidden text-center text-sm text-walnut-800">Không có sản phẩm nào khớp bộ lọc.</p>

    <nav data-adm-pagination aria-label="Phân trang" class="mt-6 flex flex-wrap items-center justify-center gap-2"></nav>

    <p class="mt-8 text-xs leading-relaxed text-walnut-800">
      Bản demo giao diện — dữ liệu đọc từ <span class="text-walnut-900">src/data/products.ts</span>. Các thao tác thêm, sửa, xoá sẽ được nối API ở bước sau.
    </p>
  </section>

</AdminLayout>


<script>
  const body = document.querySelector<HTMLElement>('[data-adm-body]');

  if (body) {
    const rows = Array.from(body.querySelectorAll<HTMLTableRowElement>('[data-row]'));
    const pageSize = Number(body.dataset.pageSize) || 10;
    const searchEl = document.querySelector<HTMLInputElement>('[data-adm-search]');
    const categoryEl = document.querySelector<HTMLSelectElement>('[data-adm-category]');
    const statusEl = document.querySelector<HTMLSelectElement>('[data-adm-status]');
    const resetEl = document.querySelector<HTMLButtonElement>('[data-adm-reset]');
    const countEl = document.querySelector<HTMLElement>('[data-adm-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-adm-empty]');
    const paginationEl = document.querySelector<HTMLElement>('[data-adm-pagination]');

    const BASE_BTN = 'h-9 min-w-9 border px-3 text-sm transition-colors';
    const IDLE_BTN = BASE_BTN + ' border-walnut-900/20 bg-sand-50 text-walnut-900 hover:border-walnut-900';
    const ACTIVE_BTN = BASE_BTN + ' border-walnut-900 bg-walnut-900 text-sand-50';
    const OFF_BTN = BASE_BTN + ' border-walnut-900/10 bg-sand-50 text-walnut-900/30';

    let page = 1;

    const matches = (row: HTMLTableRowElement) => {
      const keyword = (searchEl?.value ?? '').trim().toLowerCase();
      const category = categoryEl?.value ?? '';
      const status = statusEl?.value ?? '';

      if (keyword && !String(row.dataset.name ?? '').toLowerCase().includes(keyword)) return false;
      if (category && row.dataset.category !== category) return false;
      if (status && row.dataset.status !== status) return false;
      return true;
    };

    const makeBtn = (label: string, target: number, active: boolean, disabled: boolean) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      btn.className = active ? ACTIVE_BTN : disabled ? OFF_BTN : IDLE_BTN;
      btn.disabled = active || disabled;
      btn.addEventListener('click', () => {
        page = target;
        render();
      });
      return btn;
    };

    const renderPagination = (totalPages: number) => {
      if (!paginationEl) return;
      paginationEl.textContent = '';
      if (totalPages <= 1) return;

      paginationEl.appendChild(makeBtn('Trước', page - 1, false, page === 1));
      for (let i = 1; i <= totalPages; i++) {
        paginationEl.appendChild(makeBtn(String(i), i, i === page, false));
      }
      paginationEl.appendChild(makeBtn('Sau', page + 1, false, page === totalPages));
    };

    const render = () => {
      const filtered = rows.filter(matches);
      const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
      if (page > totalPages) page = totalPages;

      const start = (page - 1) * pageSize;
      const pageRows = filtered.slice(start, start + pageSize);

      rows.forEach((row) => row.classList.add('hidden'));
      pageRows.forEach((row) => row.classList.remove('hidden'));

      if (countEl) {
        countEl.textContent = filtered.length
          ? 'Hiển thị ' + (start + 1) + '–' + (start + pageRows.length) + ' trên ' + filtered.length + ' sản phẩm'
          : 'Không có sản phẩm';
      }

      if (emptyEl) emptyEl.classList.toggle('hidden', filtered.length !== 0);

      renderPagination(totalPages);
    };

    searchEl?.addEventListener('input', () => {
      page = 1;
      render();
    });
    categoryEl?.addEventListener('change', () => {
      page = 1;
      render();
    });
    statusEl?.addEventListener('change', () => {
      page = 1;
      render();
    });

    resetEl?.addEventListener('click', () => {
      if (searchEl) searchEl.value = '';
      if (categoryEl) categoryEl.value = '';
      if (statusEl) statusEl.value = '';
      page = 1;
      render();
    });

    render();
  }
</script>
