---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatVnd } from '../../data/products';

let liveOrders: any[] = [];
let analyticsData: any = null;

try {
  const [ordersRes, analyticsRes] = await Promise.all([
    fetch('http://localhost:4000/api/orders', { signal: AbortSignal.timeout(2000) }),
    fetch('http://localhost:4000/api/orders/analytics', { signal: AbortSignal.timeout(2000) }),
  ]);

  if (ordersRes.ok) {
    const json = await ordersRes.json();
    if (json.success && Array.isArray(json.data)) {
      liveOrders = json.data;
    }
  }

  if (analyticsRes.ok) {
    const aJson = await analyticsRes.json();
    if (aJson.success) {
      analyticsData = aJson.data;
    }
  }
} catch {
  // Graceful fallback
}

const totalRevenue = analyticsData?.kpis?.totalRevenue ?? liveOrders
  .filter((o: any) => o.orderStatus !== 'da-huy' && o.orderStatus !== 'cancelled')
  .reduce((acc: number, curr: any) => acc + (curr.total || 0), 0);

const totalOrders = analyticsData?.kpis?.totalOrders ?? liveOrders.length;
const uniqueCustomers = analyticsData?.kpis?.uniqueCustomers ?? new Set(liveOrders.map((o: any) => o.phone || o.customerName)).size;
const aiConsultations = analyticsData?.kpis?.aiConsultations ?? 0;

const daily7Days = analyticsData?.daily7Days ?? [
  { day: 'T2', val: 0, revenue: 0, orders: 0, height: '0%' },
  { day: 'T3', val: 0, revenue: 0, orders: 0, height: '0%' },
  { day: 'T4', val: 0, revenue: 0, orders: 0, height: '0%' },
  { day: 'T5', val: 0, revenue: 0, orders: 0, height: '0%' },
  { day: 'T6', val: 0, revenue: 0, orders: 0, height: '0%' },
  { day: 'T7', val: 0, revenue: 0, orders: 0, height: '0%' },
  { day: 'CN', val: 0, revenue: 0, orders: 0, height: '0%' },
];

const categoryShare = (analyticsData?.categoryShare && analyticsData.categoryShare.length > 0)
  ? analyticsData.categoryShare
  : [
      { name: 'Sofa & Phòng Khách', percent: 0, color: 'bg-walnut-900' },
      { name: 'Bàn Ghế Ăn', percent: 0, color: 'bg-clay-600' },
      { name: 'Giường & Tủ Áo', percent: 0, color: 'bg-olive-700' },
      { name: 'Đèn & Trang Trí Decor', percent: 0, color: 'bg-amber-700' },
    ];

const kpis = [
  { 
    label: 'Tổng doanh thu (Tháng này)', 
    value: formatVnd(totalRevenue), 
    change: totalRevenue > 0 ? '+100%' : '0%', 
    trend: 'up', 
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' 
  },
  { 
    label: 'Tổng số đơn hàng', 
    value: `${totalOrders} đơn`, 
    change: totalOrders > 0 ? `+${totalOrders}` : '0%', 
    trend: 'up', 
    icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' 
  },
  { 
    label: 'Khách hàng mới', 
    value: `${uniqueCustomers} khách`, 
    change: uniqueCustomers > 0 ? `+${uniqueCustomers}` : '0%', 
    trend: 'up', 
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' 
  },
  { 
    label: 'Lượt tư vấn AI Phong Thủy', 
    value: `${aiConsultations} lượt`, 
    change: aiConsultations > 0 ? `+${aiConsultations}` : '0%', 
    trend: 'up', 
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' 
  },
];

const recentOrders = liveOrders.slice(0, 5);
---

<AdminLayout title="Trang Tổng Quan Quản Trị - Nội Thất">
  <div class="space-y-8">

    <!-- Top Banner & Quick Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl text-walnut-900">Tổng Quan Hoạt Động Doanh Nghiệp</h1>
        <p class="mt-1 text-sm text-walnut-800/80">
          Cập nhật tình hình kinh doanh, quản lý kho hàng và báo cáo đơn hàng theo thời gian thực.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 rounded bg-sand-50 border border-walnut-900/15 px-3 py-1.5 text-xs text-walnut-800">
          <svg class="h-4 w-4 text-walnut-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Tháng 10 / 2026
        </span>
        <a
          href="/admin/san-pham"
          class="inline-flex items-center gap-2 bg-walnut-900 px-4 py-2 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Thêm Sản Phẩm</span>
        </a>
      </div>
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {kpis.map((kpi) => (
        <div class="rounded border border-walnut-900/10 bg-sand-50 p-5 shadow-sm hover:border-walnut-900/30 transition-all">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-walnut-800/80 uppercase tracking-wider">{kpi.label}</span>
            <div class="h-9 w-9 rounded bg-sand-100 flex items-center justify-center text-walnut-900">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={kpi.icon} />
              </svg>
            </div>
          </div>
          <p class="mt-3 text-2xl font-bold text-walnut-900">{kpi.value}</p>
          <div class="mt-2 flex items-center gap-2 text-xs">
            <span class="inline-flex items-center font-semibold text-emerald-700 bg-emerald-100/60 px-1.5 py-0.5 rounded">
              <svg class="h-3.5 w-3.5 mr-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              {kpi.change}
            </span>
            <span class="text-walnut-800/60">so với tháng trước</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Analytics Charts & Structure Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Revenue Visual Progress (2 cols) -->
      <div class="lg:col-span-2 rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-walnut-900/10">
          <div>
            <h2 class="text-base font-bold text-walnut-900">Biểu Đồ Doanh Thu 7 Ngày Gần Nhất</h2>
            <p class="text-xs text-walnut-800/70">Số liệu ghi nhận từ hệ thống đặt hàng trực tuyến</p>
          </div>
          <span class="text-xs font-semibold text-walnut-900 bg-sand-100 px-2.5 py-1 rounded">Đơn vị: Triệu VNĐ</span>
        </div>

        <!-- CSS Bar Chart (Dynamic 7 Days) -->
        <div class="mt-6 flex items-center justify-center h-56 pt-6 border-b border-walnut-900/10 pb-2">
          {daily7Days.length === 0 || daily7Days.every((d: any) => d.revenue === 0) ? (
            <div class="flex flex-col items-center justify-center text-center text-xs text-walnut-800/70 py-10">
              <svg class="h-10 w-10 text-walnut-800/30 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              <span>Chưa có phát sinh giao dịch trong 7 ngày gần nhất</span>
            </div>
          ) : (
            <div class="w-full grid grid-cols-7 gap-2 sm:gap-4 items-end h-full">
              {daily7Days.map((bar: any) => (
                <div class="flex flex-col items-center gap-1.5 h-full justify-end group">
                  <div class="text-center opacity-0 group-hover:opacity-100 transition-opacity">
                    <span class="text-[11px] font-bold text-walnut-900 block leading-tight">
                      {bar.revenue > 0 ? (bar.val >= 1 ? `${bar.val}M` : `${Math.round(bar.revenue / 1000)}k`) : '0đ'}
                    </span>
                    <span class="text-[9px] text-walnut-800/60 block">{bar.orders} đơn</span>
                  </div>
                  <div 
                    class="w-full rounded-t bg-walnut-900 group-hover:bg-clay-600 transition-all duration-300 relative shadow-sm cursor-pointer" 
                    style={`height: ${bar.height};`}
                    title={`${bar.day} (${bar.date || ''}): ${formatVnd(bar.revenue)} - ${bar.orders} đơn hàng`}
                  ></div>
                  <span class="text-xs font-semibold text-walnut-800 mt-1">{bar.day}</span>
                </div>
              ))}
            </div>
          )}
        </div>

        <div class="mt-4 flex items-center justify-between text-xs text-walnut-800/80">
          <span>Trung bình: <strong>{totalRevenue > 0 ? `${(totalRevenue / 7 / 1000000).toFixed(1)} Triệu / ngày` : '0 Triệu / ngày'}</strong></span>
          <a href="/admin/doanh-thu" class="text-clay-600 hover:underline font-medium">Xem báo cáo chi tiết &rarr;</a>
        </div>
      </div>

      <!-- Category Share (1 col) -->
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-walnut-900/10">
            <h2 class="text-base font-bold text-walnut-900">Tỷ Trọng Doanh Số</h2>
            <span class="text-xs text-walnut-800/70">Theo danh mục</span>
          </div>

          <div class="mt-5 space-y-4">
            {totalRevenue === 0 || categoryShare.length === 0 ? (
              <div class="py-12 text-center text-xs text-walnut-800/70">
                Chưa có dữ liệu doanh số theo danh mục
              </div>
            ) : (
              categoryShare.map((cat: any) => (
                <div>
                  <div class="flex justify-between text-xs font-medium mb-1">
                    <span class="text-walnut-900 font-medium">{cat.name}</span>
                    <span class="font-bold text-walnut-900">{cat.percent}%</span>
                  </div>
                  <div class="w-full bg-sand-200/60 rounded-full h-2 overflow-hidden">
                    <div class={`h-2 rounded-full ${cat.color || 'bg-walnut-900'} transition-all duration-500`} style={`width: ${cat.percent}%`}></div>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>

        <div class="mt-6 border-t border-walnut-900/10 pt-4">
          <a href="/admin/danh-muc" class="block text-center text-xs font-semibold uppercase tracking-wider text-walnut-900 hover:text-clay-600">
            Quản lý tất cả danh mục &rarr;
          </a>
        </div>
      </div>

    </div>

    <!-- Tables: Recent Orders & Best Selling Products -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Recent Orders Table -->
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-walnut-900/10">
          <div>
            <h2 class="text-base font-bold text-walnut-900">Đơn Hàng Mới Nhất</h2>
            <p class="text-xs text-walnut-800/70">Các đơn phát sinh trong 24 giờ qua</p>
          </div>
          <a href="/admin/don-hang" class="text-xs font-semibold text-clay-600 hover:underline">
            Tất cả đơn &rarr;
          </a>
        </div>

        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-walnut-900/10 text-walnut-800/70 uppercase tracking-wider">
                <th class="py-2.5 font-semibold">Mã đơn</th>
                <th class="py-2.5 font-semibold">Khách hàng</th>
                <th class="py-2.5 font-semibold">Tổng tiền</th>
                <th class="py-2.5 font-semibold">Trạng thái</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-walnut-900/10">
              {recentOrders.length === 0 ? (
                <tr>
                  <td colspan="4" class="py-8 text-center text-xs text-walnut-800/70">
                    Chưa có đơn hàng nào phát sinh trong 24 giờ qua.
                  </td>
                </tr>
              ) : (
                recentOrders.map((o: any) => (
                  <tr class="hover:bg-sand-100/50">
                    <td class="py-3 font-semibold text-walnut-900">{o.orderCode}</td>
                    <td class="py-3">
                      <p class="font-medium text-walnut-900">{o.customerName}</p>
                      <p class="text-[10px] text-walnut-800/60">{o.phone}</p>
                    </td>
                    <td class="py-3 font-semibold text-clay-600">{formatVnd(o.total)}</td>
                    <td class="py-3">
                      <span class="inline-block px-2 py-0.5 rounded text-[10px] font-medium border bg-amber-100 text-amber-800 border-amber-300">
                        {o.orderStatus}
                      </span>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Top Best Selling Products -->
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-walnut-900/10">
          <div>
            <h2 class="text-base font-bold text-walnut-900">Sản Phẩm Bán Chạy</h2>
            <p class="text-xs text-walnut-800/70">Top mặt hàng nội thất có doanh thu cao nhất</p>
          </div>
          <a href="/admin/san-pham" class="text-xs font-semibold text-clay-600 hover:underline">
            Quản lý kho &rarr;
          </a>
        </div>

        <div class="mt-4 space-y-3">
          <div class="py-8 text-center text-xs text-walnut-800/70">
            Chưa có dữ liệu sản phẩm bán ra.
          </div>
        </div>
      </div>

    </div>

    <!-- Quick Navigation Grid -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm">
      <h2 class="text-sm font-bold uppercase tracking-wider text-walnut-900 mb-4">Lối Tắt Quản Trị Hệ Thống</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <a href="/admin/san-pham" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Sản phẩm</p>
          <p class="text-[10px] opacity-70">19 mặt hàng</p>
        </a>
        <a href="/admin/don-hang" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Đơn hàng</p>
          <p class="text-[10px] opacity-70">{totalOrders} đơn</p>
        </a>
        <a href="/admin/danh-muc" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Danh mục</p>
          <p class="text-[10px] opacity-70">7 nhóm hàng</p>
        </a>
        <a href="/admin/khach-hang" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Khách hàng</p>
          <p class="text-[10px] opacity-70">{uniqueCustomers} thành viên</p>
        </a>
        <a href="/admin/ma-giam-gia" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Mã giảm giá</p>
          <p class="text-[10px] opacity-70">4 voucher</p>
        </a>
        <a href="/admin/cai-dat" class="p-3 rounded border border-walnut-900/10 bg-sand-100 hover:bg-walnut-900 hover:text-sand-50 transition-all text-center group">
          <p class="text-xs font-bold">Cài đặt</p>
          <p class="text-[10px] opacity-70">Cấu hình web</p>
        </a>
      </div>
    </div>

  </div>
</AdminLayout>
