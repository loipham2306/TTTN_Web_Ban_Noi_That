---
import AdminLayout from '../../layouts/AdminLayout.astro';

const initialCustomers = [
  { id: 'KH-1001', name: 'Nguyễn Văn An', phone: '0908 123 456', email: 'an.nguyen@gmail.com', spent: '82.500.000 ₫', orders: 4, tier: 'Kim Cương', tierColor: 'bg-purple-100 text-purple-800 border-purple-300', date: '12/01/2026', status: 'Hoạt động' },
  { id: 'KH-1002', name: 'Trần Thị Mai', phone: '0912 345 678', email: 'mai.tran@gmail.com', spent: '48.900.000 ₫', orders: 2, tier: 'Vàng', tierColor: 'bg-amber-100 text-amber-800 border-amber-300', date: '04/03/2026', status: 'Hoạt động' },
  { id: 'KH-1003', name: 'Lê Hoàng Long', phone: '0987 654 321', email: 'long.le@gmail.com', spent: '35.200.000 ₫', orders: 3, tier: 'Vàng', tierColor: 'bg-amber-100 text-amber-800 border-amber-300', date: '18/05/2026', status: 'Hoạt động' },
  { id: 'KH-1004', name: 'Phạm Minh Đức', phone: '0933 888 999', email: 'duc.pham@hotmail.com', spent: '68.000.000 ₫', orders: 5, tier: 'Kim Cương', tierColor: 'bg-purple-100 text-purple-800 border-purple-300', date: '22/02/2026', status: 'Hoạt động' },
  { id: 'KH-1005', name: 'Vũ Hải Yến', phone: '0901 222 333', email: 'yen.vu@gmail.com', spent: '18.500.000 ₫', orders: 2, tier: 'Bạc', tierColor: 'bg-slate-100 text-slate-800 border-slate-300', date: '10/08/2026', status: 'Hoạt động' },
  { id: 'KH-1006', name: 'Hoàng Quốc Bảo', phone: '0966 777 888', email: 'bao.hoang@gmail.com', spent: '4.800.000 ₫', orders: 1, tier: 'Đồng', tierColor: 'bg-orange-100 text-orange-800 border-orange-300', date: '29/09/2026', status: 'Tạm khóa' },
];
---

<AdminLayout title="Quản Lý Khách Hàng - Nội Thất">
  <div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl text-walnut-900">Quản Lý Khách Hàng</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Theo dõi thông tin người mua, tài khoản đăng ký mới và xếp hạng hội viên.</p>
      </div>

      <div class="flex items-center gap-2">
        <button 
          type="button" 
          onclick="alert('Đã xuất danh sách khách hàng ra file Excel')"
          class="inline-flex items-center gap-1.5 border border-walnut-900/20 bg-sand-50 px-3.5 py-2 text-xs font-semibold text-walnut-900 hover:bg-sand-100 shadow-sm"
        >
          <svg class="h-4 w-4 text-walnut-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Xuất File Excel
        </button>
      </div>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tổng khách hàng</p>
        <p id="stat-total-customers" class="text-2xl font-bold text-walnut-900 mt-1">86 tài khoản</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Hội viên VIP (Kim Cương / Vàng)</p>
        <p class="text-2xl font-bold text-purple-700 mt-1">24 khách</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Chi tiêu trung bình</p>
        <p class="text-2xl font-bold text-clay-600 mt-1">26.500.000 ₫</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tỷ lệ quay lại mua hàng</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1">42.8%</p>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="p-4 border-b border-walnut-900/10 flex flex-col sm:flex-row gap-3 items-center justify-between">
        <input 
          id="search-customer"
          type="text" 
          placeholder="Tìm theo tên, số điện thoại, email..." 
          class="w-full sm:w-80 rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-1.5 text-xs text-walnut-900 placeholder:text-walnut-800/50 focus:border-walnut-900 focus:outline-none"
        />
        <select class="rounded border border-walnut-900/20 bg-sand-50 px-3 py-1.5 text-xs text-walnut-900">
          <option>Tất cả thứ hạng hội viên</option>
          <option>Kim Cương</option>
          <option>Vàng</option>
          <option>Bạc</option>
          <option>Đồng</option>
        </select>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Mã KH</th>
              <th class="py-3 px-4 font-semibold">Họ và tên</th>
              <th class="py-3 px-4 font-semibold">Liên hệ</th>
              <th class="py-3 px-4 font-semibold">Hạng thành viên</th>
              <th class="py-3 px-4 font-semibold">Đơn mua</th>
              <th class="py-3 px-4 font-semibold">Tổng chi tiêu</th>
              <th class="py-3 px-4 font-semibold">Ngày đăng ký</th>
              <th class="py-3 px-4 font-semibold">Trạng thái</th>
              <th class="py-3 px-4 font-semibold text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody id="customers-table-body" class="divide-y divide-walnut-900/10">
            {initialCustomers.map((c) => (
              <tr class="hover:bg-sand-100/50" data-customer-row data-name={c.name} data-email={c.email} data-phone={c.phone}>
                <td class="py-3 px-4 font-mono font-bold text-walnut-900">{c.id}</td>
                <td class="py-3 px-4">
                  <div class="flex items-center gap-2.5">
                    <div class="h-7 w-7 rounded-full bg-sand-200 text-walnut-900 flex items-center justify-center font-bold text-[10px]">
                      {c.name.split(' ').map((n: string) => n[0]).slice(-2).join('')}
                    </div>
                    <span class="font-bold text-walnut-900">{c.name}</span>
                  </div>
                </td>
                <td class="py-3 px-4">
                  <p class="font-medium text-walnut-900">{c.phone}</p>
                  <p class="text-[10px] text-walnut-800/60">{c.email}</p>
                </td>
                <td class="py-3 px-4">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${c.tierColor}`}>
                    {c.tier}
                  </span>
                </td>
                <td class="py-3 px-4 font-semibold text-walnut-900">{c.orders} đơn</td>
                <td class="py-3 px-4 font-bold text-clay-600">{c.spent}</td>
                <td class="py-3 px-4 text-walnut-800/80">{c.date}</td>
                <td class="py-3 px-4">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-medium ${c.status === 'Hoạt động' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}`}>
                    {c.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <button type="button" class="text-xs font-semibold text-clay-600 hover:underline">
                    Xem chi tiết
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tableBody = document.getElementById('customers-table-body');
    const totalEl = document.getElementById('stat-total-customers');
    const searchInput = document.getElementById('search-customer') as HTMLInputElement | null;

    // Load registered customers from localStorage and prepend to table
    const registered = JSON.parse(localStorage.getItem('registered_customers') || '[]');

    if (tableBody && registered.length > 0) {
      if (totalEl) totalEl.textContent = `${86 + registered.length} tài khoản`;

      registered.forEach((u: any, idx: number) => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-sand-100/50 bg-emerald-50/40';
        tr.dataset.customerRow = '';
        tr.dataset.name = u.name;
        tr.dataset.email = u.email;
        tr.dataset.phone = u.phone;

        tr.innerHTML = `
          <td class="py-3 px-4 font-mono font-bold text-emerald-800">
            KH-NEW${idx + 1}
            <span class="ml-1 inline-block bg-emerald-600 text-white text-[9px] px-1 py-0.2 rounded">Mới</span>
          </td>
          <td class="py-3 px-4">
            <div class="flex items-center gap-2.5">
              <div class="h-7 w-7 rounded-full bg-emerald-700 text-sand-50 flex items-center justify-center font-bold text-[10px]">
                ${(u.name || 'KH').split(' ').map((n: string) => n[0]).slice(-2).join('')}
              </div>
              <div>
                <p class="font-bold text-walnut-900">${u.name}</p>
                <p class="text-[10px] text-emerald-700 font-medium">Tài khoản vừa tạo</p>
              </div>
            </div>
          </td>
          <td class="py-3 px-4">
            <p class="font-medium text-walnut-900">${u.phone || 'Chưa cập nhật'}</p>
            <p class="text-[10px] text-walnut-800/60">${u.email}</p>
          </td>
          <td class="py-3 px-4">
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border bg-slate-100 text-slate-800 border-slate-300">
              ${u.tier || 'Bạc'}
            </span>
          </td>
          <td class="py-3 px-4 font-semibold text-walnut-900">${u.orders || 0} đơn</td>
          <td class="py-3 px-4 font-bold text-clay-600">${u.spent || '0 ₫'}</td>
          <td class="py-3 px-4 text-walnut-800/80">${u.date || new Date().toLocaleDateString('vi-VN')}</td>
          <td class="py-3 px-4">
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-100 text-emerald-800">
              Hoạt động
            </span>
          </td>
          <td class="py-3 px-4 text-right">
            <button type="button" class="text-xs font-semibold text-clay-600 hover:underline">
              Xem chi tiết
            </button>
          </td>
        `;

        tableBody.prepend(tr);
      });
    }

    // Filter by name/email/phone
    searchInput?.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      const rows = tableBody?.querySelectorAll<HTMLTableRowElement>('[data-customer-row]');
      rows?.forEach((r) => {
        const name = (r.dataset.name || '').toLowerCase();
        const email = (r.dataset.email || '').toLowerCase();
        const phone = (r.dataset.phone || '').toLowerCase();
        const match = !q || name.includes(q) || email.includes(q) || phone.includes(q);
        r.classList.toggle('hidden', !match);
      });
    });
  });
</script>
