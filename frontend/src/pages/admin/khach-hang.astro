---
import AdminLayout from '../../layouts/AdminLayout.astro';

let customersList: any[] = [];
let customerStats = {
  total: 0,
  totalText: '0 tài khoản',
  vip: 0,
  vipText: '0 khách',
  avgSpent: 0,
  avgSpentText: '0 ₫',
  returningRate: 0,
  returningRateText: '0%',
};

// Tải danh sách khách hàng và thống kê thực tế từ Backend API
try {
  const res = await fetch('http://localhost:4000/api/customers', { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data)) {
      customersList = json.data;
      if (json.stats) {
        customerStats = json.stats;
      }
    }
  }
} catch (err) {
  console.warn('Backend chưa sẵn sàng khi render SSR customers:', err);
}

// Fallback an toàn nếu backend đang khởi động
if (customersList.length === 0) {
  customersList = [
    { id: 'KH-1001', rawId: 1, name: 'Nguyễn Văn An', phone: '0908 123 456', email: 'an.nguyen@gmail.com', spent: '82.500.000 ₫', spentRaw: 82500000, orders: 4, tier: 'Kim Cương', tierColor: 'bg-purple-100 text-purple-800 border-purple-300', date: '12/01/2026', status: 'Hoạt động' },
    { id: 'KH-1002', rawId: 2, name: 'Trần Thị Mai', phone: '0912 345 678', email: 'mai.tran@gmail.com', spent: '48.900.000 ₫', spentRaw: 48900000, orders: 2, tier: 'Vàng', tierColor: 'bg-amber-100 text-amber-800 border-amber-300', date: '04/03/2026', status: 'Hoạt động' },
  ];
}
---

<AdminLayout title="Quản Lý Khách Hàng - Nội Thất">
  <div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl text-walnut-900">Quản Lý Khách Hàng</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Theo dõi thông tin người mua, tài khoản đăng ký mới và xếp hạng hội viên.</p>
      </div>

      <div class="flex items-center gap-2">
        <button 
          type="button" 
          id="btn-export-excel"
          class="inline-flex items-center gap-1.5 border border-walnut-900/20 bg-sand-50 px-3.5 py-2 text-xs font-semibold text-walnut-900 hover:bg-sand-100 shadow-sm cursor-pointer transition-colors"
        >
          <svg class="h-4 w-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Xuất File Excel (CSV)
        </button>
      </div>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tổng khách hàng</p>
        <p id="stat-total-customers" class="text-2xl font-bold text-walnut-900 mt-1">{customerStats.totalText}</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Hội viên VIP (Kim Cương / Vàng)</p>
        <p id="stat-vip-customers" class="text-2xl font-bold text-purple-700 mt-1">{customerStats.vipText}</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Chi tiêu trung bình</p>
        <p id="stat-avg-spent" class="text-2xl font-bold text-clay-600 mt-1">{customerStats.avgSpentText}</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tỷ lệ quay lại mua hàng</p>
        <p id="stat-returning-rate" class="text-2xl font-bold text-emerald-700 mt-1">{customerStats.returningRateText}</p>
      </div>
    </div>

    <!-- Table Container -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="p-4 border-b border-walnut-900/10 flex flex-col sm:flex-row gap-3 items-center justify-between">
        <input 
          id="search-customer"
          type="text" 
          placeholder="Tìm theo tên, số điện thoại, email..." 
          class="w-full sm:w-80 rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-xs text-walnut-900 placeholder:text-walnut-800/50 focus:border-clay-600 focus:outline-none"
        />
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <select id="filter-tier" class="rounded border border-walnut-900/20 bg-sand-50 px-3 py-2 text-xs text-walnut-900 outline-none focus:border-clay-600 cursor-pointer">
            <option value="">Tất cả thứ hạng hội viên</option>
            <option value="Kim Cương">Hạng Kim Cương (VIP)</option>
            <option value="Vàng">Hạng Vàng</option>
            <option value="Bạc">Hạng Bạc</option>
            <option value="Đồng">Hạng Đồng</option>
          </select>
          <button type="button" id="btn-reset-filter" class="text-xs text-walnut-800/70 hover:text-clay-600 underline whitespace-nowrap cursor-pointer">
            Xóa lọc
          </button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Mã KH</th>
              <th class="py-3 px-4 font-semibold">Họ và tên</th>
              <th class="py-3 px-4 font-semibold">Liên hệ</th>
              <th class="py-3 px-4 font-semibold">Hạng thành viên</th>
              <th class="py-3 px-4 font-semibold">Đơn mua</th>
              <th class="py-3 px-4 font-semibold">Tổng chi tiêu</th>
              <th class="py-3 px-4 font-semibold">Ngày đăng ký</th>
              <th class="py-3 px-4 font-semibold">Trạng thái</th>
              <th class="py-3 px-4 font-semibold text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody id="customers-table-body" class="divide-y divide-walnut-900/10">
            {customersList.map((c) => (
              <tr 
                class="hover:bg-sand-100/50 transition-colors" 
                data-customer-row 
                data-id={c.id}
                data-raw-id={c.rawId}
                data-name={c.name} 
                data-email={c.email} 
                data-phone={c.phone}
                data-tier={c.tier}
                data-orders={c.orders}
                data-spent={c.spent}
                data-spent-raw={c.spentRaw}
                data-date={c.date}
                data-status={c.status}
              >
                <td class="py-3 px-4 font-mono font-bold text-walnut-900" data-col="id">{c.id}</td>
                <td class="py-3 px-4">
                  <div class="flex items-center gap-2.5">
                    {c.avatar ? (
                      <img src={c.avatar} alt={c.name} class="h-7 w-7 rounded-full object-cover border border-walnut-900/10" />
                    ) : (
                      <div class="h-7 w-7 rounded-full bg-sand-200 text-walnut-900 flex items-center justify-center font-bold text-[10px]" data-col="avatar">
                        {c.name.split(' ').map((n: string) => n[0]).slice(-2).join('')}
                      </div>
                    )}
                    <span class="font-bold text-walnut-900" data-col="name">{c.name}</span>
                  </div>
                </td>
                <td class="py-3 px-4">
                  <p class="font-medium text-walnut-900" data-col="phone">{c.phone}</p>
                  <p class="text-[10px] text-walnut-800/60" data-col="email">{c.email}</p>
                </td>
                <td class="py-3 px-4" data-col="tier">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${c.tierColor}`}>
                    {c.tier}
                  </span>
                </td>
                <td class="py-3 px-4 font-semibold text-walnut-900" data-col="orders">{c.orders} đơn</td>
                <td class="py-3 px-4 font-bold text-clay-600" data-col="spent">{c.spent}</td>
                <td class="py-3 px-4 text-walnut-800/80" data-col="date">{c.date}</td>
                <td class="py-3 px-4" data-col="status">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-medium ${c.status === 'Hoạt động' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}`}>
                    {c.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="inline-flex items-center gap-2">
                    <button 
                      type="button" 
                      data-btn-view-customer
                      class="px-2.5 py-1 text-xs font-semibold text-clay-600 bg-sand-100 hover:bg-clay-600 hover:text-sand-50 rounded border border-clay-600/20 transition-colors cursor-pointer"
                    >
                      Xem chi tiết
                    </button>
                    <button 
                      type="button" 
                      data-btn-toggle-customer-status
                      class="p-1 text-walnut-800 hover:text-amber-700 transition-colors rounded hover:bg-sand-200/50 cursor-pointer"
                      title="Đổi trạng thái tài khoản"
                    >
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                      </svg>
                    </button>
                    <button 
                      type="button" 
                      data-btn-delete-customer
                      class="p-1 text-walnut-800 hover:text-danger-600 transition-colors rounded hover:bg-sand-200/50 cursor-pointer"
                      title="Xóa tài khoản"
                    >
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p id="customers-empty-msg" class="hidden py-10 text-center text-xs text-walnut-800/70 border-t border-walnut-900/10">
        Không tìm thấy khách hàng nào phù hợp với bộ lọc tìm kiếm.
      </p>
    </div>

  </div>

  <!-- MODAL: XEM CHI TIẾT & CHỈNH SỬA KHÁCH HÀNG -->
  <div id="customer-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/30 w-full max-w-lg shadow-2xl rounded-none relative my-4 max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- HEADER WALNUT XANH ĐẬM VỚI DẢI VÀNG CHAMPAGNE -->
      <div class="relative bg-[#173524] px-6 py-5 sm:px-8 border-b border-[#D8B670]/30 shrink-0">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#D8B670]/25 to-[#D8B670]/5 border border-[#D8B670]/40 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 text-[#E6CA85]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.22em] text-[#D8B670] font-semibold">HỒ SƠ KHÁCH HÀNG</p>
              <h2 id="modal-cust-code" class="text-lg sm:text-xl font-display font-bold text-white tracking-wide mt-0.5">KH-1001</h2>
            </div>
          </div>

          <button 
            type="button" 
            id="btn-close-cust-modal" 
            class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-sand-200 hover:text-white flex items-center justify-center transition-all hover:rotate-90 cursor-pointer border border-white/10"
            title="Đóng cửa sổ"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <form id="customer-detail-form" class="flex flex-col flex-1 overflow-hidden">
        <input type="hidden" id="modal-hidden-id" value="" />

        <!-- MODAL BODY (SCROLLABLE) -->
        <div class="p-6 sm:p-8 space-y-4 overflow-y-auto flex-1 bg-[#FAF8F5]">
          <!-- User header card -->
          <div class="flex items-center gap-3.5 bg-white p-4 border border-walnut-900/15 shadow-xs">
            <div id="modal-avatar" class="h-12 w-12 rounded-full bg-[#173524] text-[#E6CA85] border border-[#D8B670]/40 flex items-center justify-center font-bold text-sm shadow-inner shrink-0">
              VA
            </div>
            <div class="flex-1 min-w-0">
              <h3 id="modal-display-name" class="font-bold text-walnut-900 text-base truncate">Nguyễn Văn An</h3>
              <p id="modal-display-email" class="text-xs text-walnut-800/70 truncate">an.nguyen@gmail.com</p>
            </div>
            <span id="modal-badge-preview" class="inline-block px-2.5 py-1 text-[10px] font-semibold rounded border bg-purple-50 text-purple-800 border-purple-200 shrink-0">
              Kim Cương
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="modal-input-name" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Họ và tên *</label>
              <input 
                type="text" 
                id="modal-input-name" 
                required
                class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs"
              />
            </div>

            <div>
              <label for="modal-input-phone" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Số điện thoại</label>
              <input 
                type="text" 
                id="modal-input-phone" 
                class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="modal-display-tier" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Hạng thành viên (Tự động)</label>
              <input 
                type="text" 
                id="modal-display-tier" 
                readonly 
                class="mt-1.5 w-full border border-walnut-900/10 bg-sand-100/50 px-3.5 py-2.5 text-xs font-semibold text-walnut-900 outline-none cursor-not-allowed shadow-xs"
              />
            </div>

            <div>
              <label for="modal-select-status" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Trạng thái tài khoản</label>
              <select id="modal-select-status" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 cursor-pointer font-medium shadow-xs">
                <option value="Hoạt động">🟢 Đang hoạt động</option>
                <option value="Tạm khóa">🔴 Tạm khóa tài khoản</option>
              </select>
            </div>
          </div>

          <!-- Shopping summary stats -->
          <div class="grid grid-cols-2 gap-3 bg-white p-3.5 border border-walnut-900/15 shadow-xs">
            <div>
              <p class="text-[10px] uppercase text-walnut-800/70 font-semibold tracking-wider">Tổng đơn hàng</p>
              <p id="modal-cust-orders" class="text-sm font-bold text-walnut-900 mt-0.5">4 đơn</p>
            </div>
            <div>
              <p class="text-[10px] uppercase text-walnut-800/70 font-semibold tracking-wider">Tổng tích lũy chi tiêu</p>
              <p id="modal-cust-spent" class="text-sm font-bold text-clay-600 mt-0.5">82.500.000 ₫</p>
            </div>
          </div>

          <div>
            <p class="text-[11px] text-walnut-800/70">
              Ngày đăng ký tài khoản: <strong id="modal-cust-date" class="text-walnut-900 font-semibold">12/01/2026</strong>
            </p>
          </div>
        </div>

        <!-- MODAL FOOTER (STICKY BOTTOM) -->
        <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex items-center justify-end gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
          <button 
            type="button" 
            id="btn-cancel-cust-modal" 
            class="border border-walnut-900/20 px-5 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer"
          >
            Đóng
          </button>
          <button 
            type="submit" 
            id="btn-submit-cust-form"
            class="bg-gradient-to-r from-[#D8B670] via-[#E2C37E] to-[#C49E52] px-6 py-2.5 text-xs uppercase tracking-[0.18em] font-bold text-[#173524] hover:from-[#C49E52] hover:to-[#B58F43] hover:text-white shadow-md transition-all active:scale-95 cursor-pointer border border-[#E0C582]/50"
          >
            Lưu thay đổi vào CSDL
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: XÁC NHẬN XÓA TÀI KHOẢN KHÁCH HÀNG -->
  <div id="delete-customer-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-white border border-red-900/30 w-full max-w-md shadow-2xl rounded-none overflow-hidden relative animate-in fade-in zoom-in-95 duration-200">
      
      <!-- HEADER CẢNH BÁO ĐỎ RƯỢU VANG -->
      <div class="relative bg-[#3b1212] px-6 py-4.5 border-b border-red-500/30 flex items-center justify-between">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-red-500"></div>
        <div class="flex items-center gap-3 text-red-100">
          <div class="w-8 h-8 rounded-full bg-red-500/20 border border-red-500/40 flex items-center justify-center text-red-400 shrink-0">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <p class="text-[10px] uppercase tracking-[0.2em] text-red-300 font-semibold">CẢNH BÁO HỆ THỐNG</p>
            <h3 class="text-base font-bold text-white tracking-wide">Xóa tài khoản khách hàng</h3>
          </div>
        </div>
        <button 
          type="button" 
          id="btn-close-delete-x"
          class="h-7 w-7 rounded-full bg-white/10 hover:bg-white/20 text-red-200 hover:text-white flex items-center justify-center transition-all cursor-pointer border border-white/10"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- NỘI DUNG -->
      <div class="p-6 bg-sand-50/60">
        <p id="delete-customer-msg" class="text-xs text-walnut-800/90 leading-relaxed font-medium">Bạn có chắc chắn muốn xóa tài khoản này khỏi hệ thống không?</p>
        <p class="mt-2 text-[11px] text-walnut-800/60 leading-normal">Hành động này sẽ ẩn tài khoản khách hàng (Soft delete) an toàn mà không làm mất lịch sử đơn hàng cũ.</p>
      </div>

      <!-- FOOTER -->
      <div class="px-6 py-3.5 bg-white border-t border-walnut-900/10 flex items-center justify-end gap-3">
        <button 
          type="button" 
          id="btn-cancel-delete-cust" 
          class="border border-walnut-900/20 px-4 py-2 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 transition-colors cursor-pointer"
        >
          Hủy bỏ
        </button>
        <button 
          type="button" 
          id="btn-confirm-delete-cust" 
          class="bg-red-700 hover:bg-red-600 text-white font-bold px-5 py-2 text-xs uppercase tracking-[0.15em] shadow-md transition-all active:scale-95 cursor-pointer"
        >
          Xác nhận xóa
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST THÔNG BÁO -->
  <div id="cust-toast" class="fixed bottom-6 right-6 z-50 hidden translate-y-4 rounded bg-walnut-900 px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300 border border-emerald-500/40">
    <span id="cust-toast-msg">Đã cập nhật thông tin khách hàng thành công!</span>
  </div>

</AdminLayout>

<script>
  const initCustomerPage = () => {
    const API_BASE = 'http://localhost:4000/api/customers';

    const tableBody = document.getElementById('customers-table-body') as HTMLElement;
    const totalEl = document.getElementById('stat-total-customers') as HTMLElement;
    const vipEl = document.getElementById('stat-vip-customers') as HTMLElement;
    const searchInput = document.getElementById('search-customer') as HTMLInputElement | null;
    const filterTierSelect = document.getElementById('filter-tier') as HTMLSelectElement | null;
    const resetFilterBtn = document.getElementById('btn-reset-filter') as HTMLButtonElement | null;
    const emptyMsg = document.getElementById('customers-empty-msg') as HTMLElement;
    const btnExportExcel = document.getElementById('btn-export-excel') as HTMLButtonElement | null;

    // Modal elements
    const custModal = document.getElementById('customer-modal') as HTMLElement;
    const custModalCode = document.getElementById('modal-cust-code') as HTMLElement;
    const custForm = document.getElementById('customer-detail-form') as HTMLFormElement;
    const btnCloseCustModal = document.getElementById('btn-close-cust-modal') as HTMLButtonElement;
    const btnCancelCustModal = document.getElementById('btn-cancel-cust-modal') as HTMLButtonElement;

    // Modal inputs
    const hiddenId = document.getElementById('modal-hidden-id') as HTMLInputElement;
    const modalAvatar = document.getElementById('modal-avatar') as HTMLElement;
    const modalDisplayName = document.getElementById('modal-display-name') as HTMLElement;
    const modalDisplayEmail = document.getElementById('modal-display-email') as HTMLElement;
    const modalBadgePreview = document.getElementById('modal-badge-preview') as HTMLElement;
    const modalInputName = document.getElementById('modal-input-name') as HTMLInputElement;
    const modalInputPhone = document.getElementById('modal-input-phone') as HTMLInputElement;
    const modalDisplayTier = document.getElementById('modal-display-tier') as HTMLInputElement;
    const modalSelectStatus = document.getElementById('modal-select-status') as HTMLSelectElement;
    const modalCustOrders = document.getElementById('modal-cust-orders') as HTMLElement;
    const modalCustSpent = document.getElementById('modal-cust-spent') as HTMLElement;
    const modalCustDate = document.getElementById('modal-cust-date') as HTMLElement;

    // Delete modal
    const deleteModal = document.getElementById('delete-customer-modal') as HTMLElement;
    const deleteMsg = document.getElementById('delete-customer-msg') as HTMLElement;
    const btnCloseDeleteX = document.getElementById('btn-close-delete-x') as HTMLButtonElement;
    const btnCancelDelete = document.getElementById('btn-cancel-delete-cust') as HTMLButtonElement;
    const btnConfirmDelete = document.getElementById('btn-confirm-delete-cust') as HTMLButtonElement;
    let targetRowToDelete: HTMLTableRowElement | null = null;

    // Toast
    const toast = document.getElementById('cust-toast') as HTMLElement;
    const toastMsg = document.getElementById('cust-toast-msg') as HTMLElement;

    const showToast = (msg: string, isError = false) => {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.className = `fixed bottom-6 right-6 z-50 rounded px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300 border ${
        isError ? 'bg-red-900 border-red-500/50' : 'bg-walnut-900 border-emerald-500/40'
      }`;
      toast.classList.remove('hidden', 'translate-y-4');
      setTimeout(() => {
        toast.classList.add('translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3500);
    };

    const TIER_COLORS: Record<string, string> = {
      'Kim Cương': 'bg-purple-100 text-purple-800 border-purple-300',
      'Vàng': 'bg-amber-100 text-amber-800 border-amber-300',
      'Bạc': 'bg-slate-100 text-slate-800 border-slate-300',
      'Đồng': 'bg-orange-100 text-orange-800 border-orange-300',
    };

    const getHeaders = () => {
      const token = localStorage.getItem('token') || localStorage.getItem('admin_token') || localStorage.getItem('auth_token') || localStorage.getItem('accessToken') || '';
      const headers: Record<string, string> = {
        'Content-Type': 'application/json',
      };
      if (token) {
        headers['Authorization'] = `Bearer ${token}`;
      }
      return headers;
    };

    const updateStats = () => {
      if (!tableBody) return;
      const allRows = tableBody.querySelectorAll<HTMLTableRowElement>('[data-customer-row]');
      const total = allRows.length;
      if (totalEl) totalEl.textContent = `${total} tài khoản`;

      let vipCount = 0;
      allRows.forEach((r) => {
        const tier = r.dataset.tier;
        if (tier === 'Kim Cương' || tier === 'Vàng') vipCount++;
      });
      if (vipEl) vipEl.textContent = `${vipCount} khách`;
    };

    // Open detail modal
    const openCustomerModal = (row: HTMLTableRowElement) => {
      hiddenId.value = row.dataset.id || '';
      custModalCode.textContent = row.dataset.id || '';

      const name = row.dataset.name || '';
      const email = row.dataset.email || '';
      const phone = row.dataset.phone || '';
      const tier = row.dataset.tier || 'Đồng';
      const status = row.dataset.status || 'Hoạt động';

      modalDisplayName.textContent = name;
      modalDisplayEmail.textContent = email;
      modalAvatar.textContent = name.split(' ').map((n: string) => n[0]).slice(-2).join('');
      modalInputName.value = name;
      modalInputPhone.value = phone === 'Chưa cập nhật' ? '' : phone;
      if (modalDisplayTier) modalDisplayTier.value = tier;
      modalSelectStatus.value = status;

      modalBadgePreview.textContent = tier;
      modalBadgePreview.className = `inline-block px-2.5 py-1 text-[10px] font-semibold rounded border ${TIER_COLORS[tier] || TIER_COLORS['Đồng']}`;

      modalCustOrders.textContent = `${row.dataset.orders || 0} đơn`;
      modalCustSpent.textContent = row.dataset.spent || '0 ₫';
      modalCustDate.textContent = row.dataset.date || '';

      custModal.classList.remove('hidden');
    };

    const closeCustomerModal = () => custModal.classList.add('hidden');
    btnCloseCustModal?.addEventListener('click', closeCustomerModal);
    btnCancelCustModal?.addEventListener('click', closeCustomerModal);

    // Save Customer Form changes -> Gọi PUT /api/customers/:id
    custForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = hiddenId.value;
      const targetRow = tableBody.querySelector<HTMLTableRowElement>(`[data-id="${id}"]`);
      if (!targetRow) return;

      const rawId = targetRow.dataset.rawId || id.replace(/^KH-0*/, '');
      const newName = modalInputName.value.trim();
      const newPhone = modalInputPhone.value.trim() || 'Chưa cập nhật';
      const newStatus = modalSelectStatus.value;

      const submitBtn = document.getElementById('btn-submit-cust-form') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang lưu vào MySQL...';
      }

      try {
        const res = await fetch(`${API_BASE}/${rawId}`, {
          method: 'PUT',
          headers: getHeaders(),
          body: JSON.stringify({
            name: newName,
            phone: newPhone === 'Chưa cập nhật' ? null : newPhone,
            status: newStatus === 'Hoạt động',
          }),
        });

        const resData = await res.json();
        if (!res.ok || !resData.success) {
          throw new Error(resData.message || 'Lỗi khi cập nhật thông tin khách hàng');
        }

        const updated = resData.data;
        targetRow.dataset.name = updated.name;
        targetRow.dataset.phone = updated.phone;
        targetRow.dataset.status = updated.status;

        const nameEl = targetRow.querySelector('[data-col="name"]');
        if (nameEl) nameEl.textContent = updated.name;

        const phoneEl = targetRow.querySelector('[data-col="phone"]');
        if (phoneEl) phoneEl.textContent = updated.phone;

        const avatarEl = targetRow.querySelector('[data-col="avatar"]');
        if (avatarEl && !avatarEl.querySelector('img')) {
          avatarEl.textContent = updated.name.split(' ').map((n: string) => n[0]).slice(-2).join('');
        }

        const statusEl = targetRow.querySelector('[data-col="status"]');
        if (statusEl) {
          statusEl.innerHTML = `<span class="inline-block px-2 py-0.5 rounded text-[10px] font-medium ${
            updated.status === 'Hoạt động' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
          }">${updated.status}</span>`;
        }

        closeCustomerModal();
        updateStats();
        showToast(`Đã cập nhật tài khoản "${updated.name}" thành công!`);
      } catch (err: any) {
        showToast(err.message || 'Lỗi khi cập nhật', true);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Lưu thay đổi vào CSDL';
        }
      }
    });

    // Gắn sự kiện cho từng hàng khách hàng
    const attachRowActions = (row: HTMLTableRowElement) => {
      const viewBtn = row.querySelector('[data-btn-view-customer]');
      const toggleBtn = row.querySelector('[data-btn-toggle-customer-status]');
      const deleteBtn = row.querySelector('[data-btn-delete-customer]');

      viewBtn?.addEventListener('click', () => {
        openCustomerModal(row);
      });

      // Đổi trạng thái tài khoản -> Gọi PATCH /api/customers/:id/status
      toggleBtn?.addEventListener('click', async () => {
        const rawId = row.dataset.rawId || row.dataset.id?.replace(/^KH-0*/, '');
        if (!rawId) return;

        try {
          const res = await fetch(`${API_BASE}/${rawId}/status`, {
            method: 'PATCH',
            headers: getHeaders(),
          });

          const resData = await res.json();
          if (!res.ok || !resData.success) {
            throw new Error(resData.message || 'Không thể đổi trạng thái tài khoản');
          }

          const updated = resData.data;
          row.dataset.status = updated.status;

          const statusEl = row.querySelector('[data-col="status"]');
          if (statusEl) {
            statusEl.innerHTML = `<span class="inline-block px-2 py-0.5 rounded text-[10px] font-medium ${
              updated.status === 'Hoạt động' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
            }">${updated.status}</span>`;
          }

          showToast(`Đã chuyển tài khoản "${updated.name}" sang: ${updated.status}`);
        } catch (err: any) {
          showToast(err.message || 'Lỗi máy chủ', true);
        }
      });

      // Mở modal xác nhận xóa
      deleteBtn?.addEventListener('click', () => {
        targetRowToDelete = row;
        const name = row.dataset.name || 'tài khoản này';
        if (deleteMsg) {
          deleteMsg.textContent = `Bạn có chắc chắn muốn xóa khách hàng "${name}" khỏi hệ thống không?`;
        }
        deleteModal.classList.remove('hidden');
      });
    };

    if (tableBody) {
      tableBody.querySelectorAll<HTMLTableRowElement>('[data-customer-row]').forEach(attachRowActions);
    }

    // Đóng modal xóa
    const closeDeleteModal = () => {
      deleteModal.classList.add('hidden');
      targetRowToDelete = null;
    };
    btnCancelDelete?.addEventListener('click', closeDeleteModal);
    btnCloseDeleteX?.addEventListener('click', closeDeleteModal);

    // Xác nhận Xóa -> Gọi DELETE /api/customers/:id
    btnConfirmDelete?.addEventListener('click', async () => {
      if (!targetRowToDelete) return;
      const rawId = targetRowToDelete.dataset.rawId || targetRowToDelete.dataset.id?.replace(/^KH-0*/, '');
      const name = targetRowToDelete.dataset.name || '';

      btnConfirmDelete.disabled = true;
      btnConfirmDelete.textContent = 'Đang xóa...';

      try {
        const res = await fetch(`${API_BASE}/${rawId}`, {
          method: 'DELETE',
          headers: getHeaders(),
        });
        const resData = await res.json();
        if (!res.ok || !resData.success) {
          throw new Error(resData.message || 'Không thể xóa khách hàng');
        }

        targetRowToDelete.remove();
        closeDeleteModal();
        updateStats();
        showToast(`Đã xóa tài khoản "${name}" khỏi cơ sở dữ liệu!`);
      } catch (err: any) {
        showToast(err.message || 'Lỗi khi xóa tài khoản', true);
      } finally {
        btnConfirmDelete.disabled = false;
        btnConfirmDelete.textContent = 'Xác nhận xóa';
      }
    });

    // Realtime Search and Filter
    const applyFilter = () => {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const selectedTier = filterTierSelect?.value || '';

      let visibleCount = 0;
      const rows = tableBody.querySelectorAll<HTMLTableRowElement>('[data-customer-row]');

      rows.forEach((r) => {
        const name = (r.dataset.name || '').toLowerCase();
        const email = (r.dataset.email || '').toLowerCase();
        const phone = (r.dataset.phone || '').toLowerCase();
        const tier = r.dataset.tier || '';

        const matchQuery = !q || name.includes(q) || email.includes(q) || phone.includes(q);
        const matchTier = !selectedTier || tier === selectedTier;

        const isVisible = matchQuery && matchTier;
        r.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount++;
      });

      emptyMsg?.classList.toggle('hidden', visibleCount > 0);
    };

    searchInput?.addEventListener('input', applyFilter);
    filterTierSelect?.addEventListener('change', applyFilter);
    resetFilterBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (filterTierSelect) filterTierSelect.value = '';
      applyFilter();
    });

    // EXCEL / CSV EXPORT DỮ LIỆU THẬT TỪ BẢNG VỚI BOM UTF-8
    btnExportExcel?.addEventListener('click', () => {
      const rows = tableBody.querySelectorAll<HTMLTableRowElement>('[data-customer-row]');
      if (!rows.length) {
        alert('Không có dữ liệu khách hàng để xuất.');
        return;
      }

      let csvContent = '\uFEFF'; // UTF-8 BOM để Excel hiển thị tiếng Việt chuẩn
      csvContent += 'Mã KH,Họ và tên,Số điện thoại,Email,Hạng thành viên,Đơn mua,Tổng chi tiêu,Ngày đăng ký,Trạng thái\n';

      rows.forEach((r) => {
        const id = r.dataset.id || '';
        const name = `"${(r.dataset.name || '').replace(/"/g, '""')}"`;
        const phone = `"${r.dataset.phone || ''}"`;
        const email = `"${r.dataset.email || ''}"`;
        const tier = `"${r.dataset.tier || ''}"`;
        const orders = `"${r.dataset.orders || '0'}"`;
        const spent = `"${(r.dataset.spent || '0 ₫').replace(/"/g, '""')}"`;
        const date = `"${r.dataset.date || ''}"`;
        const status = `"${r.dataset.status || ''}"`;

        csvContent += [id, name, phone, email, tier, orders, spent, date, status].join(',') + '\n';
      });

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `danh_sach_khach_hang_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);

      showToast('Đã tải xuống file danh sách khách hàng thành công!');
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCustomerPage);
  } else {
    initCustomerPage();
  }
</script>
