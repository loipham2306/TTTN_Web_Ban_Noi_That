---
import AdminLayout from '../../layouts/AdminLayout.astro';

interface ChatMessage {
  id: string;
  senderType: 'customer' | 'ai_bot' | 'seller';
  content: string;
  createdAt: string;
}

interface ChatSessionItem {
  id: string;
  code: string;
  guestId: string;
  userName: string;
  userEmail: string;
  userPhone: string;
  status: string;
  startedAt: string;
  messageCount: number;
  previewQuestion: string;
  latestAdvice: string;
  messages: ChatMessage[];
}

let sessions: ChatSessionItem[] = [];

try {
  const res = await fetch('http://localhost:4000/api/phong-thuy/chat-sessions', {
    signal: AbortSignal.timeout(3000),
  });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data)) {
      sessions = json.data;
    }
  }
} catch (e) {
  sessions = [];
}

const fallbackSessions: ChatSessionItem[] = [
  {
    id: 'f1',
    code: 'AI-PT-0001',
    guestId: 'guest_demo_01',
    userName: 'Anh Hoàng (Mệnh Thủy)',
    userEmail: 'hoang.design@gmail.com',
    userPhone: '0912 345 678',
    status: 'bot_handling',
    startedAt: new Date(Date.now() - 3600000 * 2).toISOString(),
    messageCount: 4,
    previewQuestion: 'Tôi sinh năm 1990 mệnh Thuỷ, phòng khách nên chọn màu gì và hướng sofa như thế nào?',
    latestAdvice: 'Gia chủ mệnh Thuỷ nên đặt sofa chính hướng về Đông Nam để đón Sinh khí vượng tài. Ưu tiên tone màu Đen, Xanh dương, Xám bạc và chi tiết kim loại.',
    messages: [
      {
        id: 'm1',
        senderType: 'customer',
        content: 'Chào AI, tôi sinh năm 1990 mệnh Thuỷ, phòng khách nên chọn màu gì và hướng sofa như thế nào?',
        createdAt: new Date(Date.now() - 3600000 * 2).toISOString(),
      },
      {
        id: 'm2',
        senderType: 'ai_bot',
        content: 'Chào bạn! Gia chủ sinh năm Canh Ngọ 1990 thuộc cung Khảm, mệnh Thiên Hà Thủy.\n\n- Hướng tốt đón Sinh khí: **Đông Nam**.\n- Màu sắc tương sinh, tương hợp: **Đen, Xanh dương đậm, Xám bạc, Trắng ánh kim**.\n- Gợi ý bài trí: Bạn nên kê bộ sofa hướng Đông Nam, kết hợp bàn trà mặt kính hoặc chi tiết kim loại ánh bạc để tăng vượng khí.',
        createdAt: new Date(Date.now() - 3600000 * 2 + 15000).toISOString(),
      },
      {
        id: 'm3',
        senderType: 'customer',
        content: 'Bên mình có mẫu sofa da nào hợp với tone màu này không?',
        createdAt: new Date(Date.now() - 3600000 * 2 + 60000).toISOString(),
      },
      {
        id: 'm4',
        senderType: 'ai_bot',
        content: 'Gợi ý tuyệt vời cho bạn là mẫu **Sofa da Ý Milano** tone màu đen than sang trọng hoặc xanh navy, phối kèm bàn trà mặt kính đen. Sản phẩm này đang có sẵn tại showroom Nội Thất!',
        createdAt: new Date(Date.now() - 3600000 * 2 + 75000).toISOString(),
      }
    ]
  },
  {
    id: 'f2',
    code: 'AI-PT-0002',
    guestId: 'guest_demo_02',
    userName: 'Chị Mai (Mệnh Mộc)',
    userEmail: '',
    userPhone: '',
    status: 'closed',
    startedAt: new Date(Date.now() - 3600000 * 5).toISOString(),
    messageCount: 2,
    previewQuestion: 'Tư vấn giúp mình giường ngủ cho nữ 1988, phòng ngủ nên tránh gì?',
    latestAdvice: 'Đầu giường nên tựa vào hướng Nam vững chắc, tránh kê đối diện trực tiếp cửa ra vào hoặc gương lớn.',
    messages: [
      {
        id: 'm21',
        senderType: 'customer',
        content: 'Tư vấn giúp mình giường ngủ cho nữ 1988, phòng ngủ nên tránh gì?',
        createdAt: new Date(Date.now() - 3600000 * 5).toISOString(),
      },
      {
        id: 'm22',
        senderType: 'ai_bot',
        content: 'Chào bạn! Nữ sinh năm Mậu Thìn 1988 thuộc cung Chấn, ngũ hành Đại Lâm Mộc.\n\n- Hướng tốt: **Nam (Sinh khí)**.\n- Chất liệu & màu sắc: Ưu tiên gỗ sồi tự nhiên, nỉ màu xanh ngọc, xanh pastel hoặc nâu ấm.\n- Lưu ý kiêng kỵ: Tránh đặt đầu giường dưới dầm xà ngang hoặc đối diện gương soi bàn phấn.',
        createdAt: new Date(Date.now() - 3600000 * 5 + 20000).toISOString(),
      }
    ]
  }
];

const displaySessions = sessions.length > 0 ? sessions : fallbackSessions;
const isLiveFromDb = sessions.length > 0;

const totalSessions = displaySessions.length;
const totalMessages = displaySessions.reduce((sum, s) => sum + (s.messageCount || s.messages?.length || 0), 0);
const botHandlingCount = displaySessions.filter(s => s.status === 'bot_handling').length;
const humanRequestedCount = displaySessions.filter(s => s.status === 'human_requested').length;

const formatDateTime = (iso: string) => {
  if (!iso) return 'Vừa xong';
  try {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  } catch {
    return iso;
  }
};
---

<AdminLayout title="Quản trị · Lịch sử AI Phong thủy | Nội Thất">

  <!-- PAGE HEADER -->
  <header class="flex flex-wrap items-end justify-between gap-4 border-b border-walnut-900/10 pb-6">
    <div>
      <p class="text-[11px] uppercase tracking-[0.25em] text-walnut-800">Bảng điều khiển</p>
      <h1 class="mt-2 font-display text-2xl tracking-tight sm:text-3xl text-walnut-900">Lịch Sử Tư Vấn AI Phong Thủy</h1>
      <p class="mt-1 text-sm text-walnut-800">Quản lý và theo dõi toàn bộ các phiên hội thoại tư vấn nội thất & phong thủy giữa khách hàng và AI.</p>
    </div>

    <div class="flex items-center gap-3">
      {isLiveFromDb && (
        <span class="inline-flex items-center gap-1.5 border border-emerald-600/30 bg-emerald-50 px-3.5 py-2 text-xs font-semibold text-emerald-800">
          <span class="h-2 w-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>Đã đồng bộ CSDL MySQL ({sessions.length} phiên)</span>
        </span>
      )}
      <span class="inline-flex items-center gap-2 border border-walnut-900/20 bg-sand-50 px-4 py-2 text-xs text-walnut-900 font-medium">
        <span class="h-2 w-2 rounded-full bg-purple-600 animate-pulse"></span>
        <span>Mô hình: Gemini 1.5 Flash</span>
      </span>
      <button
        type="button"
        id="btn-refresh-sessions"
        class="inline-flex items-center gap-1.5 border border-walnut-900/20 bg-white hover:bg-sand-100 px-3 py-2 text-xs text-walnut-800 hover:text-walnut-900 transition-colors cursor-pointer"
        title="Tải lại danh sách phiên chat"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Làm mới</span>
      </button>
    </div>
  </header>

  <!-- STATS -->
  <section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Tổng phiên trò chuyện</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-walnut-900">{totalSessions} phiên</p>
      <p class="mt-1 text-xs text-walnut-800/70">Lưu trữ trên toàn hệ thống</p>
    </div>
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Đang trò chuyện (AI)</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-emerald-800">{botHandlingCount} phiên</p>
      <p class="mt-1 text-xs text-walnut-800/70">AI tự động giải đáp 24/7</p>
    </div>
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Tổng tin nhắn trao đổi</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-clay-600">{totalMessages} tin nhắn</p>
      <p class="mt-1 text-xs text-walnut-800/70">Khách & AI trao đổi trực tiếp</p>
    </div>
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Cần chuyên viên hỗ trợ</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-amber-800">{humanRequestedCount} phiên</p>
      <p class="mt-1 text-xs text-walnut-800/70">Yêu cầu nhân viên tư vấn</p>
    </div>
  </section>

  <!-- LIST TABLE -->
  <section class="mt-8">
    <div class="flex flex-wrap items-center gap-3 bg-sand-50 p-4 border border-walnut-900/10">
      <div class="relative w-full max-w-xs">
        <input
          id="pt-search"
          type="search"
          placeholder="Tìm mã phiên, khách hàng, câu hỏi..."
          class="w-full border border-walnut-900/20 bg-sand-100/50 pl-9 pr-4 py-2.5 text-sm outline-none transition-colors placeholder:text-walnut-800/50 focus:border-clay-600 focus:bg-sand-50"
        />
        <svg class="absolute left-3 top-3 h-4 w-4 text-walnut-800/50 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <select
        id="pt-status-filter"
        class="border border-walnut-900/20 bg-sand-50 px-3 py-2.5 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600 cursor-pointer"
      >
        <option value="">Tất cả trạng thái</option>
        <option value="bot_handling">Đang chat với AI</option>
        <option value="human_requested">Cần nhân viên</option>
        <option value="closed">Đã kết thúc</option>
      </select>

      <button
        type="button"
        id="btn-pt-reset"
        class="text-xs uppercase tracking-[0.18em] text-walnut-800 underline underline-offset-4 transition-colors hover:text-clay-600 cursor-pointer"
      >
        Xoá lọc
      </button>

      <p id="pt-count-label" class="ml-auto text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">
        {displaySessions.length} phiên trò chuyện
      </p>
    </div>

    <!-- TABLE -->
    <div class="mt-4 overflow-x-auto border border-walnut-900/10 bg-sand-50 shadow-sm">
      <table class="w-full min-w-[55rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-walnut-900/15 bg-sand-100/50 text-[11px] uppercase tracking-[0.18em] text-walnut-800">
            <th scope="col" class="px-4 py-3.5 font-medium">Mã phiên / Thời gian</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Khách hàng / Guest</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Nội dung trao đổi gần nhất</th>
            <th scope="col" class="px-4 py-3.5 font-medium text-center">Số tin</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Trạng thái</th>
            <th scope="col" class="px-4 py-3.5 font-medium text-right">Thao tác</th>
          </tr>
        </thead>

        <tbody id="pt-table-body">
          {displaySessions.map((session) => (
            <tr
              data-pt-row
              data-id={session.id}
              data-code={session.code}
              data-user-name={session.userName}
              data-user-email={session.userEmail}
              data-user-phone={session.userPhone}
              data-guest-id={session.guestId}
              data-status={session.status}
              data-started={session.startedAt}
              data-question={session.previewQuestion}
              data-advice={session.latestAdvice}
              data-messages={JSON.stringify(session.messages || [])}
              class="border-b border-walnut-900/10 last:border-b-0 hover:bg-sand-100/30 transition-colors"
            >
              <td class="px-4 py-3.5 align-middle">
                <span class="font-bold text-sm text-walnut-900 block">{session.code}</span>
                <span class="text-[11px] text-walnut-800/60 block mt-0.5">{formatDateTime(session.startedAt)}</span>
              </td>

              <td class="px-4 py-3.5 align-middle">
                <p class="text-sm font-semibold text-walnut-900">{session.userName}</p>
                {session.userPhone ? (
                  <p class="text-xs text-walnut-800/70">{session.userPhone}</p>
                ) : session.userEmail ? (
                  <p class="text-xs text-walnut-800/70">{session.userEmail}</p>
                ) : (
                  <p class="text-[10px] text-walnut-800/50 font-mono">ID: {session.guestId.slice(0, 16)}...</p>
                )}
              </td>

              <td class="px-4 py-3.5 align-middle max-w-md">
                <div class="space-y-1">
                  <div class="flex items-start gap-1.5 text-xs text-walnut-900">
                    <span class="font-bold text-[10px] uppercase text-walnut-800 shrink-0 bg-sand-200/60 px-1 py-0.5">Khách:</span>
                    <span class="line-clamp-1 italic font-medium">{session.previewQuestion || 'Bắt đầu cuộc trò chuyện'}</span>
                  </div>
                  <div class="flex items-start gap-1.5 text-xs text-walnut-800/80">
                    <span class="font-bold text-[10px] uppercase text-[#173524] shrink-0 bg-[#173524]/10 px-1 py-0.5">AI:</span>
                    <span class="line-clamp-1 text-walnut-800/75">{session.latestAdvice || 'Chờ phản hồi...'}</span>
                  </div>
                </div>
              </td>

              <td class="px-4 py-3.5 align-middle text-center">
                <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-sand-200/70 text-walnut-900 border border-walnut-900/10">
                  {session.messageCount || session.messages?.length || 0} tin
                </span>
              </td>

              <td class="px-4 py-3.5 align-middle">
                {session.status === 'bot_handling' && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                    Đang chat AI
                  </span>
                )}
                {session.status === 'human_requested' && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold bg-amber-100 text-amber-800 border border-amber-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                    Cần nhân viên
                  </span>
                )}
                {session.status === 'closed' && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold bg-gray-100 text-gray-700 border border-gray-300">
                    Đã kết thúc
                  </span>
                )}
              </td>

              <td class="px-4 py-3.5 align-middle text-right">
                <div class="flex items-center justify-end gap-2">
                  <button
                    type="button"
                    data-btn-view-session
                    class="bg-[#173524] text-[#E6CA85] hover:bg-[#234c34] px-3 py-1.5 text-xs uppercase tracking-[0.12em] font-semibold transition-colors cursor-pointer border border-[#D8B670]/40 flex items-center gap-1.5"
                  >
                    <svg class="w-3.5 h-3.5 text-[#E6CA85]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <span>Xem hội thoại</span>
                  </button>
                  <button
                    type="button"
                    data-btn-delete-session
                    title="Xoá phiên hội thoại này"
                    class="p-1.5 text-walnut-800/60 hover:text-red-600 hover:bg-red-50 border border-transparent hover:border-red-200 transition-colors cursor-pointer"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p id="pt-empty-label" class="mt-8 hidden text-center text-sm text-walnut-800 py-10 bg-sand-50 border border-walnut-900/10">
      Không tìm thấy dữ liệu phiên trò chuyện nào phù hợp với bộ lọc.
    </p>
  </section>

  <!-- MODAL: CHI TIẾT CUỘC TRÒ CHUYỆN AI PHONG THỦY (IDEA 1 STYLING) -->
  <div id="advice-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/30 w-full max-w-3xl shadow-2xl rounded-none relative my-4 max-h-[92vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- HEADER WALNUT XANH ĐẬM VỚI DẢI VÀNG CHAMPAGNE -->
      <div class="relative bg-[#173524] px-6 py-5 sm:px-8 border-b border-[#D8B670]/30 shrink-0">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#D8B670]/25 to-[#D8B670]/5 border border-[#D8B670]/40 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 text-[#E6CA85]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.22em] text-[#D8B670] font-semibold">LỊCH SỬ HỘI THOẠI AI PHONG THỦY</p>
              <h2 id="modal-session-title" class="text-lg sm:text-xl font-display font-bold text-white tracking-wide mt-0.5">Phiên tư vấn: AI-PT-0001</h2>
            </div>
          </div>

          <button 
            type="button" 
            id="btn-close-advice-modal" 
            class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-sand-200 hover:text-white flex items-center justify-center transition-all hover:rotate-90 cursor-pointer border border-white/10"
            title="Đóng cửa sổ"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- SUMMARY BADGES -->
      <div class="px-6 py-3.5 sm:px-8 bg-sand-100/80 border-b border-walnut-900/15 flex flex-wrap items-center justify-between gap-3 text-xs shrink-0">
        <div class="flex items-center gap-4 flex-wrap">
          <div>
            <span class="text-[10px] text-walnut-800/70 block uppercase tracking-wider font-semibold">Khách hàng</span>
            <span id="modal-session-user" class="font-bold text-walnut-900"></span>
          </div>
          <div class="border-l border-walnut-900/15 pl-4">
            <span class="text-[10px] text-walnut-800/70 block uppercase tracking-wider font-semibold">Thời gian bắt đầu</span>
            <span id="modal-session-time" class="font-medium text-walnut-800"></span>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span id="modal-session-status-badge"></span>
          <span id="modal-session-msg-badge" class="px-2.5 py-1 text-[11px] font-semibold bg-white border border-walnut-900/20 text-walnut-900"></span>
        </div>
      </div>

      <!-- MODAL BODY: CHAT TRANSCRIPT (SCROLLABLE) -->
      <div id="modal-chat-container" class="p-6 sm:p-8 space-y-4 overflow-y-auto flex-1 bg-[#FAF8F5] text-xs min-h-[300px]">
        <!-- Messages will be rendered here dynamically -->
      </div>

      <!-- MODAL FOOTER (STICKY BOTTOM) -->
      <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex items-center justify-between gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
        <div class="text-[11px] text-walnut-800/70 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Phiên tư vấn được tự động ghi nhận theo thời gian thực</span>
        </div>

        <div class="flex items-center gap-3">
          <button 
            type="button" 
            id="btn-delete-current-session" 
            class="border border-red-300 text-red-700 hover:bg-red-50 px-4 py-2 text-xs uppercase tracking-[0.12em] font-semibold transition-colors cursor-pointer"
          >
            Xoá phiên này
          </button>
          <button 
            type="button" 
            id="btn-cancel-advice-modal" 
            class="border border-walnut-900/20 px-6 py-2 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer"
          >
            Đóng
          </button>
        </div>
      </div>
    </div>
  </div>

</AdminLayout>

<script>
  const searchInput = document.getElementById('pt-search') as HTMLInputElement;
  const statusFilter = document.getElementById('pt-status-filter') as HTMLSelectElement;
  const resetBtn = document.getElementById('btn-pt-reset') as HTMLButtonElement;
  const countLabel = document.getElementById('pt-count-label') as HTMLElement;
  const emptyLabel = document.getElementById('pt-empty-label') as HTMLElement;
  const tableBody = document.getElementById('pt-table-body') as HTMLElement;
  const refreshBtn = document.getElementById('btn-refresh-sessions') as HTMLButtonElement;

  // Modal
  const modal = document.getElementById('advice-modal') as HTMLElement;
  const btnClose = document.getElementById('btn-close-advice-modal') as HTMLButtonElement;
  const btnCancel = document.getElementById('btn-cancel-advice-modal') as HTMLButtonElement;
  const btnDeleteCurrent = document.getElementById('btn-delete-current-session') as HTMLButtonElement;
  let activeSessionId = '';

  const formatTime = (iso: string) => {
    if (!iso) return '';
    try {
      const d = new Date(iso);
      if (isNaN(d.getTime())) return iso;
      const pad = (n: number) => String(n).padStart(2, '0');
      return `${pad(d.getHours())}:${pad(d.getMinutes())} - ${pad(d.getDate())}/${pad(d.getMonth() + 1)}`;
    } catch {
      return iso;
    }
  };

  if (tableBody) {
    const rows = Array.from(tableBody.querySelectorAll<HTMLTableRowElement>('[data-pt-row]'));

    const render = () => {
      const q = (searchInput?.value ?? '').trim().toLowerCase();
      const st = statusFilter?.value ?? '';

      let visible = 0;

      rows.forEach((r) => {
        const code = (r.dataset.code ?? '').toLowerCase();
        const user = (r.dataset.userName ?? '').toLowerCase();
        const quest = (r.dataset.question ?? '').toLowerCase();
        const adv = (r.dataset.advice ?? '').toLowerCase();
        const rowStatus = r.dataset.status ?? '';

        const matchQ = !q || code.includes(q) || user.includes(q) || quest.includes(q) || adv.includes(q);
        const matchStatus = !st || rowStatus === st;

        if (matchQ && matchStatus) {
          r.style.display = '';
          visible++;
        } else {
          r.style.display = 'none';
        }
      });

      if (countLabel) countLabel.textContent = `${visible} phiên trò chuyện`;
      if (emptyLabel) emptyLabel.classList.toggle('hidden', visible > 0);
    };

    searchInput?.addEventListener('input', render);
    statusFilter?.addEventListener('change', render);
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (statusFilter) statusFilter.value = '';
      render();
    });

    refreshBtn?.addEventListener('click', () => {
      window.location.reload();
    });

    // View conversation
    tableBody.addEventListener('click', (e) => {
      const viewBtn = (e.target as HTMLElement).closest('[data-btn-view-session]');
      const deleteBtn = (e.target as HTMLElement).closest('[data-btn-delete-session]');
      const row = (e.target as HTMLElement).closest<HTMLTableRowElement>('[data-pt-row]');
      if (!row) return;

      if (deleteBtn) {
        const id = row.dataset.id;
        const code = row.dataset.code;
        if (confirm(`Bạn có chắc chắn muốn xoá phiên hội thoại ${code}?`)) {
          fetch(`/api/phong-thuy/chat-sessions/${id}`, { method: 'DELETE' })
            .then(res => res.json())
            .then(res => {
              if (res.success) {
                row.remove();
                render();
              } else {
                alert('Xoá không thành công.');
              }
            })
            .catch(() => alert('Lỗi kết nối máy chủ.'));
        }
        return;
      }

      if (viewBtn) {
        activeSessionId = row.dataset.id || '';
        document.getElementById('modal-session-title')!.textContent = `Phiên tư vấn: ${row.dataset.code}`;
        document.getElementById('modal-session-user')!.textContent = row.dataset.userName || 'Khách vãng lai';
        document.getElementById('modal-session-time')!.textContent = formatTime(row.dataset.started || '');

        const status = row.dataset.status;
        const statusBadge = document.getElementById('modal-session-status-badge')!;
        if (status === 'bot_handling') {
          statusBadge.innerHTML = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>Đang chat AI</span>`;
        } else if (status === 'human_requested') {
          statusBadge.innerHTML = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold bg-amber-100 text-amber-800 border border-amber-300"><span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>Cần chuyên viên</span>`;
        } else {
          statusBadge.innerHTML = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold bg-gray-100 text-gray-700 border border-gray-300">Đã kết thúc</span>`;
        }

        const messages: any[] = JSON.parse(row.dataset.messages || '[]');
        document.getElementById('modal-session-msg-badge')!.textContent = `${messages.length} tin nhắn`;

        const chatContainer = document.getElementById('modal-chat-container')!;
        if (messages.length === 0) {
          chatContainer.innerHTML = `
            <div class="text-center py-10 text-walnut-800/60 text-xs">
              Phiên chat này chưa có tin nhắn nào.
            </div>
          `;
        } else {
          chatContainer.innerHTML = messages.map(msg => {
            const isCustomer = msg.senderType === 'customer';
            const timeStr = formatTime(msg.createdAt);

            if (isCustomer) {
              return `
                <div class="flex items-start gap-3 justify-end my-3">
                  <div class="max-w-[85%] bg-[#173524] text-white p-4 shadow-sm border border-[#173524]">
                    <div class="flex items-center justify-between gap-4 mb-1.5">
                      <span class="text-[10px] text-[#D8B670] uppercase tracking-wider font-bold">Khách hàng</span>
                      <span class="text-[10px] text-white/50">${timeStr}</span>
                    </div>
                    <p class="text-xs leading-relaxed whitespace-pre-wrap">${escapeHtml(msg.content)}</p>
                  </div>
                  <div class="w-8 h-8 rounded-full bg-walnut-800 text-[#D8B670] border border-[#D8B670]/30 flex items-center justify-center shrink-0 text-xs font-bold shadow-xs">
                    KH
                  </div>
                </div>
              `;
            } else {
              return `
                <div class="flex items-start gap-3 justify-start my-3">
                  <div class="w-8 h-8 rounded-full bg-[#173524] border border-[#D8B670]/60 text-[#E6CA85] flex items-center justify-center shrink-0 shadow-xs">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                  </div>
                  <div class="max-w-[85%] bg-white border border-walnut-900/15 p-4 shadow-xs">
                    <div class="flex items-center justify-between gap-4 mb-1.5">
                      <span class="text-[10px] text-emerald-800 uppercase tracking-wider font-bold">Chuyên gia Phong Thủy AI</span>
                      <span class="text-[10px] text-walnut-800/50">${timeStr}</span>
                    </div>
                    <div class="text-xs text-walnut-900 leading-relaxed whitespace-pre-wrap">${escapeHtml(msg.content)}</div>
                  </div>
                </div>
              `;
            }
          }).join('');
        }

        modal.classList.remove('hidden');
        // Scroll to bottom of chat
        setTimeout(() => {
          chatContainer.scrollTop = chatContainer.scrollHeight;
        }, 50);
      }
    });

    const escapeHtml = (text: string) => {
      return text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    };

    const closeModal = () => modal.classList.add('hidden');
    btnClose?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);

    btnDeleteCurrent?.addEventListener('click', () => {
      if (!activeSessionId) return;
      if (confirm('Bạn có chắc chắn muốn xoá phiên trò chuyện này?')) {
        fetch(`/api/phong-thuy/chat-sessions/${activeSessionId}`, { method: 'DELETE' })
          .then(res => res.json())
          .then(res => {
            if (res.success) {
              const targetRow = tableBody.querySelector(`[data-id="${activeSessionId}"]`);
              targetRow?.remove();
              closeModal();
              render();
            } else {
              alert('Xoá không thành công.');
            }
          })
          .catch(() => alert('Lỗi kết nối máy chủ.'));
      }
    });

    render();
  }
</script>
