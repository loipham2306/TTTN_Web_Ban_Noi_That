---

<AdminLayout title="Quản trị · Lịch sử AI Phong thủy | Nội Thất">

  <!-- PAGE HEADER -->
  <header class="flex flex-wrap items-end justify-between gap-4 border-b border-walnut-900/10 pb-6">
    <div>
      <p class="text-[11px] uppercase tracking-[0.25em] text-walnut-800">Bảng điều khiển</p>
      <h1 class="mt-2 font-display text-2xl tracking-tight sm:text-3xl text-walnut-900">Lịch Sử Tư Vấn AI Phong Thủy</h1>
      <p class="mt-1 text-sm text-walnut-800">Ghi nhận thông tin tra cứu Bát trạch và các đề xuất bài trí nội thất do AI sinh ra.</p>
    </div>

    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-2 border border-walnut-900/20 bg-sand-50 px-4 py-2.5 text-xs text-walnut-900">
        <span class="h-2 w-2 rounded-full bg-purple-600 animate-pulse"></span>
        <span>Mô hình: Gemini AI Engine v1.5</span>
      </span>
    </div>
  </header>

  <!-- STATS -->
  <section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Tổng lượt tư vấn</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-walnut-900">{mockLogs.length} lượt</p>
      <p class="mt-1 text-xs text-walnut-800/70">Khách quan tâm phong thủy</p>
    </div>
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Không gian quan tâm nhất</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-walnut-900">Phòng khách</p>
      <p class="mt-1 text-xs text-walnut-800/70">Chiếm 45% tổng số câu hỏi</p>
    </div>
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Mệnh tra cứu phổ biến</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-clay-600">Thủy & Mộc</p>
      <p class="mt-1 text-xs text-walnut-800/70">Xu hướng chọn màu trầm</p>
    </div>
    <div class="border border-walnut-900/10 bg-sand-50 p-5">
      <p class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Sản phẩm gợi ý kèm</p>
      <p class="mt-2 font-display text-2xl sm:text-3xl tracking-tight text-emerald-700">8 sản phẩm</p>
      <p class="mt-1 text-xs text-walnut-800/70">Tăng tỷ lệ chốt đơn</p>
    </div>
  </section>

  <!-- LIST TABLE -->
  <section class="mt-8">
    <div class="flex flex-wrap items-center gap-3 bg-sand-50 p-4 border border-walnut-900/10">
      <div class="relative w-full max-w-xs">
        <input
          id="pt-search"
          type="search"
          placeholder="Tìm theo năm sinh, cung mệnh..."
          class="w-full border border-walnut-900/20 bg-sand-100/50 pl-9 pr-4 py-2.5 text-sm outline-none transition-colors placeholder:text-walnut-800/50 focus:border-clay-600 focus:bg-sand-50"
        />
        <svg class="absolute left-3 top-3 h-4 w-4 text-walnut-800/50 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <select
        id="pt-room-filter"
        class="border border-walnut-900/20 bg-sand-50 px-3 py-2.5 text-sm text-walnut-900 outline-none transition-colors focus:border-clay-600 cursor-pointer"
      >
        <option value="">Tất cả loại phòng</option>
        <option value="phong-khach">Phòng khách</option>
        <option value="phong-ngu">Phòng ngủ</option>
        <option value="phong-an">Phòng ăn</option>
        <option value="lam-viec">Phòng làm việc</option>
      </select>

      <button
        type="button"
        id="btn-pt-reset"
        class="text-xs uppercase tracking-[0.18em] text-walnut-800 underline underline-offset-4 transition-colors hover:text-clay-600 cursor-pointer"
      >
        Xoá lọc
      </button>

      <p id="pt-count-label" class="ml-auto text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium"></p>
    </div>

    <!-- TABLE -->
    <div class="mt-4 overflow-x-auto border border-walnut-900/10 bg-sand-50 shadow-sm">
      <table class="w-full min-w-[50rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-walnut-900/15 bg-sand-100/50 text-[11px] uppercase tracking-[0.18em] text-walnut-800">
            <th scope="col" class="px-4 py-3.5 font-medium">Mã tra cứu</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Gia chủ</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Không gian</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Cung mệnh / Ngũ hành</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Hướng Sinh khí</th>
            <th scope="col" class="px-4 py-3.5 font-medium">Màu sắc hợp</th>
            <th scope="col" class="px-4 py-3.5 font-medium text-right">Chi tiết AI</th>
          </tr>
        </thead>

        <tbody id="pt-table-body">
          {mockLogs.map((log) => (
            <tr
              data-pt-row
              data-code={log.code}
              data-year={log.birthYear}
              data-gender={log.gender === 'nam' ? 'Nam' : 'Nữ'}
              data-room={log.roomType}
              data-room-label={log.roomLabel}
              data-cung={log.cung}
              data-quai={log.quaiSo}
              data-ngu-hanh={log.nguHanh}
              data-sinh-khi={log.sinhKhi}
              data-colors={log.colors.join(', ')}
              data-advice={log.aiAdvice}
              data-products={JSON.stringify(log.suggestedProducts)}
              data-time={log.createdAt}
              class="border-b border-walnut-900/10 last:border-b-0 hover:bg-sand-100/30 transition-colors"
            >
              <td class="px-4 py-3.5 align-middle">
                <span class="font-medium text-sm text-walnut-900 block">{log.code}</span>
                <span class="text-[11px] text-walnut-800/60 block">{log.createdAt}</span>
              </td>
              <td class="px-4 py-3.5 align-middle">
                <p class="text-sm font-medium text-walnut-900">Sinh năm {log.birthYear}</p>
                <p class="text-xs text-walnut-800/70">{log.gender === 'nam' ? 'Nam mạng' : 'Nữ mạng'}</p>
              </td>
              <td class="px-4 py-3.5 align-middle text-sm text-walnut-900">
                {log.roomLabel}
              </td>
              <td class="px-4 py-3.5 align-middle">
                <p class="text-xs font-semibold text-walnut-900">Cung {log.cung} · Quái số {log.quaiSo}</p>
                <p class="text-[11px] text-clay-600 font-medium">Mạng {log.nguHanh}</p>
              </td>
              <td class="px-4 py-3.5 align-middle text-xs font-medium text-emerald-800">
                {log.sinhKhi}
              </td>
              <td class="px-4 py-3.5 align-middle text-xs text-walnut-800">
                {log.colors.join(', ')}
              </td>
              <td class="px-4 py-3.5 align-middle text-right">
                <button
                  type="button"
                  data-btn-view-advice
                  class="bg-clay-600 text-sand-50 px-3.5 py-1.5 text-xs uppercase tracking-[0.15em] hover:bg-clay-500 transition-colors cursor-pointer"
                >
                  Xem lời khuyên AI
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p id="pt-empty-label" class="mt-8 hidden text-center text-sm text-walnut-800 py-10 bg-sand-50 border border-walnut-900/10">
      Không tìm thấy dữ liệu tra cứu nào.
    </p>
  </section>

  <!-- MODAL: CHI TIẾT LỜI KHUYÊN AI -->
  <div id="advice-modal" class="fixed inset-0 z-50 hidden bg-walnut-900/60 backdrop-blur-sm overflow-y-auto p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/20 w-full max-w-2xl p-6 sm:p-8 shadow-xl relative my-8">
      <div class="flex items-center justify-between border-b border-walnut-900/10 pb-4">
        <div>
          <p class="text-[10px] uppercase tracking-[0.2em] text-walnut-800">Trợ lý Phong Thủy AI</p>
          <h2 id="modal-advice-title" class="text-xl font-display text-walnut-900 mt-1">Lời khuyên bài trí phong thủy</h2>
        </div>
        <button type="button" id="btn-close-advice-modal" class="text-walnut-800 hover:text-danger-600 p-1 cursor-pointer">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="mt-6 space-y-4 text-xs">
        <!-- SUMMARY BADGES -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 bg-sand-100/60 p-3 border border-walnut-900/10 text-center">
          <div>
            <span class="text-[10px] text-walnut-800/70 block uppercase">Năm sinh</span>
            <strong id="modal-ad-year" class="text-sm font-semibold text-walnut-900"></strong>
          </div>
          <div>
            <span class="text-[10px] text-walnut-800/70 block uppercase">Cung mệnh</span>
            <strong id="modal-ad-cung" class="text-sm font-semibold text-clay-600"></strong>
          </div>
          <div>
            <span class="text-[10px] text-walnut-800/70 block uppercase">Hướng đón khí</span>
            <strong id="modal-ad-huong" class="text-sm font-semibold text-emerald-800"></strong>
          </div>
          <div>
            <span class="text-[10px] text-walnut-800/70 block uppercase">Màu sắc</span>
            <strong id="modal-ad-color" class="text-sm font-semibold text-walnut-900"></strong>
          </div>
        </div>

        <!-- AI ADVICE TEXT -->
        <div class="border border-walnut-900/10 bg-sand-50 p-4 leading-relaxed">
          <p class="text-[11px] uppercase tracking-[0.15em] font-semibold text-walnut-900 mb-2 flex items-center gap-1.5">
            <svg class="h-4 w-4 text-clay-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Phân tích bài trí chuyên sâu:</span>
          </p>
          <p id="modal-ad-text" class="text-sm text-walnut-800 leading-relaxed italic bg-sand-100/40 p-3 rounded"></p>
        </div>

        <!-- SUGGESTED PRODUCTS -->
        <div class="border border-walnut-900/10 bg-sand-50 p-4">
          <p class="text-[11px] uppercase tracking-[0.15em] font-semibold text-walnut-900 mb-3">
            Sản phẩm nội thất gợi ý phù hợp:
          </p>
          <div id="modal-ad-products" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
        </div>
      </div>

      <div class="mt-6 flex justify-end border-t border-walnut-900/10 pt-4">
        <button type="button" id="btn-cancel-advice-modal" class="border border-walnut-900/20 px-6 py-2.5 text-xs uppercase tracking-[0.15em] text-walnut-800 hover:border-walnut-900 cursor-pointer">
          Đóng
        </button>
      </div>
    </div>
  </div>

</AdminLayout>

<script>
  const searchInput = document.getElementById('pt-search') as HTMLInputElement;
  const roomFilter = document.getElementById('pt-room-filter') as HTMLSelectElement;
  const resetBtn = document.getElementById('btn-pt-reset') as HTMLButtonElement;
  const countLabel = document.getElementById('pt-count-label') as HTMLElement;
  const emptyLabel = document.getElementById('pt-empty-label') as HTMLElement;
  const tableBody = document.getElementById('pt-table-body') as HTMLElement;

  // Modal
  const modal = document.getElementById('advice-modal') as HTMLElement;
  const btnClose = document.getElementById('btn-close-advice-modal') as HTMLButtonElement;
  const btnCancel = document.getElementById('btn-cancel-advice-modal') as HTMLButtonElement;

  if (tableBody) {
    const rows = Array.from(tableBody.querySelectorAll<HTMLTableRowElement>('[data-pt-row]'));

    const render = () => {
      const q = (searchInput?.value ?? '').trim().toLowerCase();
      const rm = roomFilter?.value ?? '';

      let visible = 0;

      rows.forEach((r) => {
        const year = r.dataset.year ?? '';
        const cung = (r.dataset.cung ?? '').toLowerCase();
        const nguHanh = (r.dataset.nguHanh ?? '').toLowerCase();
        const rowRoom = r.dataset.room ?? '';

        const matchQ = !q || year.includes(q) || cung.includes(q) || nguHanh.includes(q);
        const matchRoom = !rm || rowRoom === rm;

        if (matchQ && matchRoom) {
          r.style.display = '';
          visible++;
        } else {
          r.style.display = 'none';
        }
      });

      if (countLabel) countLabel.textContent = `${visible} lượt tư vấn`;
      if (emptyLabel) emptyLabel.classList.toggle('hidden', visible > 0);
    };

    searchInput?.addEventListener('input', render);
    roomFilter?.addEventListener('change', render);
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (roomFilter) roomFilter.value = '';
      render();
    });

    tableBody.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-btn-view-advice]');
      if (!btn) return;
      const row = btn.closest<HTMLTableRowElement>('[data-pt-row]');
      if (!row) return;

      document.getElementById('modal-advice-title')!.textContent = `Tư vấn ${row.dataset.roomLabel} — Năm ${row.dataset.year} (${row.dataset.gender})`;
      document.getElementById('modal-ad-year')!.textContent = `${row.dataset.year} (${row.dataset.gender})`;
      document.getElementById('modal-ad-cung')!.textContent = `${row.dataset.cung} (${row.dataset.nguHanh})`;
      document.getElementById('modal-ad-huong')!.textContent = row.dataset.sinhKhi || '';
      document.getElementById('modal-ad-color')!.textContent = row.dataset.colors || '';
      document.getElementById('modal-ad-text')!.textContent = row.dataset.advice || '';

      const products = JSON.parse(row.dataset.products || '[]');
      const prodContainer = document.getElementById('modal-ad-products')!;
      prodContainer.innerHTML = products.map((p: any) => `
        <div class="flex items-center justify-between p-3 border border-walnut-900/10 bg-sand-100/50 rounded">
          <div>
            <p class="font-medium text-walnut-900">${p.name}</p>
            <p class="text-clay-600 font-semibold mt-0.5">${p.price}</p>
          </div>
          <a href="/san-pham/${p.slug}" target="_blank" class="text-xs uppercase tracking-[0.1em] text-walnut-900 underline hover:text-clay-600">
            Xem
          </a>
        </div>
      `).join('');

      modal.classList.remove('hidden');
    });

    const closeModal = () => modal.classList.add('hidden');
    btnClose?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);

    render();
  }
</script>
