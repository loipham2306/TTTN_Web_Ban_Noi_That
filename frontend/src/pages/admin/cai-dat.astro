---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Cài Đặt Hệ Thống - Nội Thất">
  <div class="space-y-8 max-w-5xl">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl text-walnut-900">Cài Đặt Hệ Thống</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Cấu hình thông tin thương hiệu, chính sách giao nhận, cổng thanh toán và CSDL.</p>
      </div>

      <button 
        type="button" 
        onclick="alert('Đã lưu mọi thay đổi cấu hình thành công!')"
        class="inline-flex items-center gap-2 bg-walnut-900 px-5 py-2.5 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Lưu Cấu Hình</span>
      </button>
    </div>

    <!-- Section 1: Thông tin Showroom & Website -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm space-y-4">
      <h2 class="text-base font-bold text-walnut-900 border-b border-walnut-900/10 pb-3 flex items-center gap-2">
        <svg class="h-5 w-5 text-clay-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        1. Thông Tin Doanh Nghiệp & Showroom
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Tên thương hiệu</label>
          <input type="text" value="Nội Thất Sang Trọng & Phong Thủy" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 focus:outline-none focus:border-walnut-900" />
        </div>
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Hotline CSKH (24/7)</label>
          <input type="text" value="1900 8888 / 0908 123 456" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 focus:outline-none focus:border-walnut-900" />
        </div>
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Email liên hệ & tiếp nhận</label>
          <input type="email" value="contact@noithat.vn" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 focus:outline-none focus:border-walnut-900" />
        </div>
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Địa chỉ Showroom chính</label>
          <input type="text" value="123 Đường Nam Kỳ Khởi Nghĩa, Quận 1, TP. Hồ Chí Minh" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 focus:outline-none focus:border-walnut-900" />
        </div>
      </div>
    </div>

    <!-- Section 2: Vận chuyển & Giao hàng -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm space-y-4">
      <h2 class="text-base font-bold text-walnut-900 border-b border-walnut-900/10 pb-3 flex items-center gap-2">
        <svg class="h-5 w-5 text-clay-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
        </svg>
        2. Chính Sách Vận Chuyển & Phí Giao Nhận
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Phí giao tiêu chuẩn</label>
          <input type="text" value="300.000 ₫" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 focus:outline-none focus:border-walnut-900" />
        </div>
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Phí giao hỏa tốc 2H (Nội thành)</label>
          <input type="text" value="500.000 ₫" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 focus:outline-none focus:border-walnut-900" />
        </div>
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Đơn hàng tối thiểu để Freeship</label>
          <input type="text" value="10.000.000 ₫" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 focus:outline-none focus:border-walnut-900" />
        </div>
      </div>
    </div>

    <!-- Section 3: Cấu hình Thanh toán VietQR & COD -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm space-y-4">
      <h2 class="text-base font-bold text-walnut-900 border-b border-walnut-900/10 pb-3 flex items-center gap-2">
        <svg class="h-5 w-5 text-clay-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
        </svg>
        3. Cổng Thanh Toán & Tài Khoản Ngân Hàng
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Ngân hàng thụ hưởng</label>
          <input type="text" value="Vietcombank - CN TP.HCM" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 focus:outline-none focus:border-walnut-900" />
        </div>
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Số tài khoản nhận tiền</label>
          <input type="text" value="999888666888" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 font-mono focus:outline-none focus:border-walnut-900" />
        </div>
        <div>
          <label class="block font-semibold text-walnut-900 mb-1">Chủ tài khoản thụ hưởng</label>
          <input type="text" value="CONG TY CP NOI THAT CAO CAP" class="w-full rounded border border-walnut-900/20 bg-sand-100/50 px-3 py-2 text-walnut-900 focus:outline-none focus:border-walnut-900" />
        </div>
      </div>
    </div>

    <!-- Section 4: Trạng thái Kết Nối Cơ Sở Dữ Liệu -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 p-6 shadow-sm space-y-4">
      <h2 class="text-base font-bold text-walnut-900 border-b border-walnut-900/10 pb-3 flex items-center gap-2">
        <svg class="h-5 w-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
        </svg>
        4. Trạng Thái Máy Chủ Cơ Sở Dữ Liệu
      </h2>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded bg-emerald-50 border border-emerald-300">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">
            ✓
          </div>
          <div>
            <p class="font-bold text-emerald-950 text-xs">MySQL Server 3306 (XAMPP Localhost) — Đã Kết Nối</p>
            <p class="text-[11px] text-emerald-800">Database: <code class="font-bold">web_ban_noi_that</code> &bull; ORM: <code class="font-bold">Prisma Client</code> (17 Tables)</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            onclick="alert('Kiểm tra kết nối CSDL: Thành công! Độ trễ phản hồi: 4ms.')"
            class="px-3 py-1.5 rounded border border-emerald-600 bg-white text-xs font-semibold text-emerald-800 hover:bg-emerald-50"
          >
            Kiểm tra kết nối
          </button>
          <button 
            type="button" 
            onclick="alert('Sao lưu CSDL thành công ra file backup_20261009.sql!')"
            class="px-3 py-1.5 rounded bg-emerald-800 text-xs font-semibold text-white hover:bg-emerald-900"
          >
            Sao lưu dữ liệu
          </button>
        </div>
      </div>
    </div>

  </div>
</AdminLayout>
