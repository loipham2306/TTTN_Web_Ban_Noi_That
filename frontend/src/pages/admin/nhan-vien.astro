---
import AdminLayout from '../../layouts/AdminLayout.astro';

let staffList: any[] = [];
let availableRoles: any[] = [];
let staffStats = {
  total: 0,
  online: 0,
  admins: 0,
  locked: 0,
  twoFactorPercentage: 100,
};

// 1. Tải danh sách nhân sự thực tế từ Backend API (kèm fallback an toàn)
try {
  const staffRes = await fetch('http://localhost:4000/api/staff', { signal: AbortSignal.timeout(3000) });
  if (staffRes.ok) {
    const json = await staffRes.json();
    if (json.success && Array.isArray(json.data)) {
      staffList = json.data;
      if (json.stats) {
        staffStats = json.stats;
      }
    }
  }
} catch (err) {
  console.warn('Backend chưa sẵn sàng khi render SSR staff:', err);
}

// 2. Tải danh mục vai trò chức vụ nhân sự từ Backend
try {
  const rolesRes = await fetch('http://localhost:4000/api/staff/roles', { signal: AbortSignal.timeout(3000) });
  if (rolesRes.ok) {
    const json = await rolesRes.json();
    if (json.success && Array.isArray(json.data)) {
      availableRoles = json.data;
    }
  }
} catch (err) {}

// Fallback roles nếu backend đang khởi động
if (availableRoles.length === 0) {
  availableRoles = [
    { id: 1, name: 'admin', display: 'Quản Trị Viên (Admin)', dept: 'Ban Giám Đốc' },
    { id: 2, name: 'seller', display: 'Quản Lý Bán Hàng', dept: 'Phòng Kinh Doanh' },
    { id: 4, name: 'consultant', display: 'Chuyên Viên Tư Vấn Phong Thủy', dept: 'Tư Vấn Khách Hàng' },
    { id: 5, name: 'warehouse', display: 'Thủ Kho & Vận Chuyển', dept: 'Kho Vận' },
    { id: 6, name: 'marketing', display: 'Marketing & Khuyến Mãi', dept: 'Truyền Thông' },
  ];
}
---

<AdminLayout title="Quản Lý Nhân Viên & Phân Quyền - Nội Thất">
  <div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-sans font-bold text-2xl sm:text-3xl text-walnut-900">Quản Lý Nhân Viên & Phân Quyền</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Hệ thống nhân sự điều hành, phân quyền vai trò (RBAC) và bảo mật tài khoản.</p>
      </div>

      <button 
        type="button" 
        id="btn-open-add-staff"
        class="inline-flex items-center gap-2 bg-walnut-900 px-4 py-2.5 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm cursor-pointer font-medium"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
        </svg>
        <span>Thêm Nhân Viên</span>
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tổng nhân sự</p>
        <p id="stat-total-staff" class="text-2xl font-bold text-walnut-900 mt-1">{staffStats.total} nhân viên</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Đang trực tuyến</p>
        <p id="stat-online-staff" class="text-2xl font-bold text-emerald-700 mt-1">{staffStats.online} người</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Quyền Quản trị viên</p>
        <p id="stat-admin-staff" class="text-2xl font-bold text-clay-600 mt-1">{staffStats.admins} tài khoản</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Xác thực 2 lớp (2FA)</p>
        <p class="text-2xl font-bold text-walnut-900 mt-1">{staffStats.twoFactorPercentage}% Bật</p>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Mã NV</th>
              <th class="py-3 px-4 font-semibold">Nhân viên</th>
              <th class="py-3 px-4 font-semibold">Chức vụ & Quyền hạn</th>
              <th class="py-3 px-4 font-semibold">Phòng ban</th>
              <th class="py-3 px-4 font-semibold">Liên hệ</th>
              <th class="py-3 px-4 font-semibold">Trạng thái</th>
              <th class="py-3 px-4 font-semibold">Lần cập nhật cuối</th>
              <th class="py-3 px-4 font-semibold text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody id="staff-table-body" class="divide-y divide-walnut-900/10">
            {staffList.map((m) => (
              <tr 
                class="hover:bg-sand-100/50 transition-colors"
                data-staff-row
                data-id={m.id}
                data-code={m.code}
                data-name={m.name}
                data-email={m.email}
                data-role={m.role}
                data-role-id={m.roleId}
                data-role-key={m.roleKey}
                data-dept={m.dept}
                data-phone={m.phone}
                data-status={m.status}
              >
                <td class="py-3 px-4 font-mono font-bold text-walnut-900">{m.code}</td>
                <td class="py-3 px-4">
                  <div class="flex items-center gap-2.5">
                    {m.avatar ? (
                      <img src={m.avatar} alt={m.name} class="h-8 w-8 rounded-full object-cover border border-walnut-900/20" />
                    ) : (
                      <div class="h-8 w-8 rounded-full bg-walnut-900 text-sand-50 flex items-center justify-center font-bold text-xs" data-col="avatar">
                        {m.name.split(' ').map((n: string) => n[0]).slice(-2).join('')}
                      </div>
                    )}
                    <div>
                      <p class="font-bold text-walnut-900" data-col="name">{m.name}</p>
                      <p class="text-[10px] text-walnut-800/60" data-col="email">{m.email}</p>
                    </div>
                  </div>
                </td>
                <td class="py-3 px-4 font-semibold text-clay-600" data-col="role">{m.role}</td>
                <td class="py-3 px-4 text-walnut-900" data-col="dept">{m.dept}</td>
                <td class="py-3 px-4 font-medium text-walnut-800" data-col="phone">{m.phone}</td>
                <td class="py-3 px-4" data-col="status">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${m.statusColor}`}>
                    {m.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-walnut-800/70" data-col="last-login">{m.lastLogin}</td>
                <td class="py-3 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button 
                      type="button" 
                      data-btn-permission
                      class="text-xs font-semibold text-clay-600 hover:underline cursor-pointer"
                    >
                      Phân quyền
                    </button>
                    <span class="text-walnut-800/30">|</span>
                    <button 
                      type="button" 
                      data-btn-toggle-lock
                      class={`text-xs font-semibold cursor-pointer hover:underline ${m.status === 'Đã khóa' ? 'text-emerald-700' : 'text-red-600'}`}
                    >
                      {m.status === 'Đã khóa' ? 'Mở khóa' : 'Khóa'}
                    </button>
                    {m.roleKey !== 'admin' && (
                      <>
                        <span class="text-walnut-800/30">|</span>
                        <button
                          type="button"
                          data-btn-delete
                          class="text-xs font-semibold text-walnut-800/60 hover:text-red-600 cursor-pointer hover:underline"
                        >
                          Xóa
                        </button>
                      </>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- MODAL: THÊM NHÂN VIÊN MỚI -->
  <div id="staff-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/30 w-full max-w-lg shadow-2xl rounded-none relative my-4 max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- HEADER WALNUT XANH ĐẬM VỚI DẢI VÀNG CHAMPAGNE -->
      <div class="relative bg-[#173524] px-6 py-5 sm:px-8 border-b border-[#D8B670]/30 shrink-0">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#D8B670]/25 to-[#D8B670]/5 border border-[#D8B670]/40 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 text-[#E6CA85]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
              </svg>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.22em] text-[#D8B670] font-semibold">QUẢN TRỊ NHÂN SỰ</p>
              <h2 class="text-lg sm:text-xl font-display font-bold text-white tracking-wide mt-0.5">Thêm nhân viên mới</h2>
            </div>
          </div>

          <button 
            type="button" 
            id="btn-close-staff-modal" 
            class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-sand-200 hover:text-white flex items-center justify-center transition-all hover:rotate-90 cursor-pointer border border-white/10"
            title="Đóng cửa sổ"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <form id="add-staff-form" class="flex flex-col flex-1 overflow-hidden">
        <!-- MODAL BODY (SCROLLABLE) -->
        <div class="p-6 sm:p-8 space-y-4 overflow-y-auto flex-1 bg-[#FAF8F5]">
          <div>
            <label for="staff-name-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Họ và tên *</label>
            <input type="text" id="staff-name-input" required placeholder="Ví dụ: Hoàng Minh Trí" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="staff-email-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Email làm việc *</label>
              <input type="email" id="staff-email-input" required placeholder="tri.hoang@noithat.vn" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs" />
            </div>
            <div>
              <label for="staff-phone-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Số điện thoại *</label>
              <input type="text" id="staff-phone-input" required placeholder="0909 112 233" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="staff-role-select" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Chức vụ & Vai trò</label>
              <select id="staff-role-select" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3 py-2.5 text-xs outline-none focus:border-clay-600 cursor-pointer shadow-xs">
                {availableRoles.map((r: any) => (
                  <option value={r.id} data-dept={r.dept}>{r.display}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="staff-dept-display" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Phòng ban phân bổ</label>
              <input 
                type="text" 
                id="staff-dept-display" 
                readonly 
                value={availableRoles[0]?.dept || 'Bộ phận Vận hành'} 
                class="mt-1.5 w-full border border-walnut-900/10 bg-sand-100/50 px-3 py-2.5 text-xs text-walnut-900 font-medium outline-none cursor-not-allowed shadow-xs" 
              />
            </div>
          </div>

          <div>
            <label for="staff-password-input" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Mật khẩu đăng nhập ban đầu</label>
            <input type="text" id="staff-password-input" value="Staff@123456" placeholder="Mặc định: Staff@123456" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 shadow-xs font-mono" />
            <p class="text-[10px] text-walnut-800/60 mt-1">Mật khẩu sẽ được mã hóa chuẩn Bcrypt trong MySQL trước khi lưu trữ.</p>
          </div>
        </div>

        <!-- MODAL FOOTER (STICKY BOTTOM) -->
        <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex items-center justify-end gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
          <button type="button" id="btn-cancel-staff-modal" class="border border-walnut-900/20 px-5 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer">
            Hủy
          </button>
          <button type="submit" id="btn-submit-add-staff" class="bg-gradient-to-r from-[#D8B670] via-[#E2C37E] to-[#C49E52] px-6 py-2.5 text-xs uppercase tracking-[0.18em] font-bold text-[#173524] hover:from-[#C49E52] hover:to-[#B58F43] hover:text-white shadow-md transition-all active:scale-95 cursor-pointer border border-[#E0C582]/50">
            Lưu vào CSDL
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: PHÂN QUYỀN NHÂN VIÊN -->
  <div id="permission-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs p-4 flex items-center justify-center">
    <div class="bg-sand-50 border border-walnut-900/30 w-full max-w-md shadow-2xl rounded-none relative my-4 max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- HEADER WALNUT XANH ĐẬM VỚI DẢI VÀNG CHAMPAGNE -->
      <div class="relative bg-[#173524] px-6 py-5 sm:px-8 border-b border-[#D8B670]/30 shrink-0">
        <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
        
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#D8B670]/25 to-[#D8B670]/5 border border-[#D8B670]/40 flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5 text-[#E6CA85]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-[0.22em] text-[#D8B670] font-semibold">CẤP QUYỀN HỆ THỐNG (RBAC)</p>
              <h2 id="perm-staff-name" class="text-lg sm:text-xl font-display font-bold text-white tracking-wide mt-0.5">Phân quyền nhân sự</h2>
            </div>
          </div>

          <button 
            type="button" 
            id="btn-close-perm-modal" 
            class="h-8 w-8 rounded-full bg-white/10 hover:bg-white/20 text-sand-200 hover:text-white flex items-center justify-center transition-all hover:rotate-90 cursor-pointer border border-white/10"
            title="Đóng cửa sổ"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <form id="permission-form" class="flex flex-col flex-1 overflow-hidden">
        <input type="hidden" id="perm-hidden-id" value="" />

        <!-- MODAL BODY (SCROLLABLE) -->
        <div class="p-6 sm:p-8 space-y-4 overflow-y-auto flex-1 bg-[#FAF8F5]">
          <div>
            <label for="perm-role-select" class="block text-xs uppercase tracking-[0.15em] text-walnut-800 font-medium">Chức vụ vai trò trong DB *</label>
            <select id="perm-role-select" class="mt-1.5 w-full border border-walnut-900/20 bg-white px-3.5 py-2.5 text-xs outline-none focus:border-clay-600 cursor-pointer font-medium shadow-xs">
              {availableRoles.map((r: any) => (
                <option value={r.id}>{r.display}</option>
              ))}
            </select>
          </div>

          <div class="border border-walnut-900/15 rounded-none p-4 bg-white space-y-2.5 text-xs shadow-xs">
            <p class="font-bold text-walnut-900 uppercase tracking-wider text-[10px] mb-2 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#173524]"></span>
              Phân quyền chức năng theo vai trò:
            </p>
            <label class="flex items-center gap-2 text-walnut-900 cursor-pointer">
              <input type="checkbox" checked class="rounded text-[#173524] focus:ring-[#173524] accent-[#173524]" />
              <span>Xem và quản lý đơn đặt hàng</span>
            </label>
            <label class="flex items-center gap-2 text-walnut-900 cursor-pointer">
              <input type="checkbox" checked class="rounded text-[#173524] focus:ring-[#173524] accent-[#173524]" />
              <span>Thêm / sửa thông tin kho sản phẩm</span>
            </label>
            <label class="flex items-center gap-2 text-walnut-900 cursor-pointer">
              <input type="checkbox" checked class="rounded text-[#173524] focus:ring-[#173524] accent-[#173524]" />
              <span>Quản lý danh sách khách hàng & hội viên</span>
            </label>
            <label class="flex items-center gap-2 text-walnut-900 cursor-pointer">
              <input type="checkbox" id="perm-check-admin" class="rounded text-[#173524] focus:ring-[#173524] accent-[#173524]" />
              <span>Toàn quyền cài đặt hệ thống & nhân sự (Admin)</span>
            </label>
          </div>
        </div>

        <!-- MODAL FOOTER (STICKY BOTTOM) -->
        <div class="px-6 py-4 sm:px-8 bg-white border-t border-walnut-900/15 flex items-center justify-end gap-3 shrink-0 shadow-[0_-4px_12px_rgba(0,0,0,0.04)]">
          <button type="button" id="btn-cancel-perm-modal" class="border border-walnut-900/20 px-5 py-2.5 text-xs uppercase tracking-[0.15em] font-semibold text-walnut-800 hover:bg-sand-100 hover:border-walnut-900 transition-colors cursor-pointer">
            Đóng
          </button>
          <button type="submit" id="btn-submit-perm" class="bg-gradient-to-r from-[#D8B670] via-[#E2C37E] to-[#C49E52] px-6 py-2.5 text-xs uppercase tracking-[0.18em] font-bold text-[#173524] hover:from-[#C49E52] hover:to-[#B58F43] hover:text-white shadow-md transition-all active:scale-95 cursor-pointer border border-[#E0C582]/50">
            Cập nhật vào CSDL
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOAST -->
  <div id="staff-toast" class="fixed bottom-6 right-6 z-50 hidden translate-y-4 rounded bg-walnut-900 px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300 border border-emerald-500/40">
    <span id="staff-toast-msg">Đã cập nhật thông tin nhân sự thành công!</span>
  </div>

</AdminLayout>

<script>
  const initStaffPage = () => {
    const API_BASE = 'http://localhost:4000/api/staff';

    const tableBody = document.getElementById('staff-table-body') as HTMLElement;
    const totalStaffEl = document.getElementById('stat-total-staff') as HTMLElement;
    const onlineStaffEl = document.getElementById('stat-online-staff') as HTMLElement;
    const adminStaffEl = document.getElementById('stat-admin-staff') as HTMLElement;

    // Modals
    const staffModal = document.getElementById('staff-modal') as HTMLElement;
    const btnOpenAdd = document.getElementById('btn-open-add-staff') as HTMLButtonElement;
    const btnCloseStaffModal = document.getElementById('btn-close-staff-modal') as HTMLButtonElement;
    const btnCancelStaffModal = document.getElementById('btn-cancel-staff-modal') as HTMLButtonElement;
    const addStaffForm = document.getElementById('add-staff-form') as HTMLFormElement;
    const staffRoleSelect = document.getElementById('staff-role-select') as HTMLSelectElement;
    const staffDeptDisplay = document.getElementById('staff-dept-display') as HTMLInputElement;

    const permModal = document.getElementById('permission-modal') as HTMLElement;
    const permStaffName = document.getElementById('perm-staff-name') as HTMLElement;
    const permHiddenId = document.getElementById('perm-hidden-id') as HTMLInputElement;
    const permRoleSelect = document.getElementById('perm-role-select') as HTMLSelectElement;
    const permCheckAdmin = document.getElementById('perm-check-admin') as HTMLInputElement;
    const btnClosePermModal = document.getElementById('btn-close-perm-modal') as HTMLButtonElement;
    const btnCancelPermModal = document.getElementById('btn-cancel-perm-modal') as HTMLButtonElement;
    const permForm = document.getElementById('permission-form') as HTMLFormElement;

    // Toast
    const toast = document.getElementById('staff-toast') as HTMLElement;
    const toastMsg = document.getElementById('staff-toast-msg') as HTMLElement;

    const showToast = (msg: string, isError = false) => {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.className = `fixed bottom-6 right-6 z-50 rounded px-5 py-3 text-xs uppercase tracking-[0.15em] text-sand-50 shadow-lg transition-all duration-300 border ${
        isError ? 'bg-red-900 border-red-500/50' : 'bg-walnut-900 border-emerald-500/40'
      }`;
      toast.classList.remove('hidden', 'translate-y-4');
      setTimeout(() => {
        toast.classList.add('translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3500);
    };

    const getHeaders = () => {
      const token = localStorage.getItem('token') || localStorage.getItem('admin_token') || localStorage.getItem('auth_token') || localStorage.getItem('accessToken') || '';
      const headers: Record<string, string> = {
        'Content-Type': 'application/json',
      };
      if (token) {
        headers['Authorization'] = `Bearer ${token}`;
      }
      return headers;
    };

    // Tự động đồng bộ phòng ban khi chọn chức vụ trong form thêm
    staffRoleSelect?.addEventListener('change', () => {
      const selectedOption = staffRoleSelect.options[staffRoleSelect.selectedIndex];
      const dept = selectedOption?.getAttribute('data-dept') || 'Bộ phận Vận hành';
      if (staffDeptDisplay) staffDeptDisplay.value = dept;
    });

    // Cập nhật lại các chỉ số thống kê
    const updateStats = () => {
      if (tableBody) {
        const rows = tableBody.querySelectorAll<HTMLTableRowElement>('[data-staff-row]');
        if (totalStaffEl) totalStaffEl.textContent = `${rows.length} nhân viên`;

        let onlineCount = 0;
        let adminCount = 0;
        rows.forEach((r) => {
          if (r.dataset.status === 'Trực tuyến') onlineCount++;
          if (r.dataset.roleKey === 'admin' || (r.dataset.role && r.dataset.role.includes('Admin'))) adminCount++;
        });
        if (onlineStaffEl) onlineStaffEl.textContent = `${onlineCount} người`;
        if (adminStaffEl) adminStaffEl.textContent = `${adminCount} tài khoản`;
      }
    };

    // Open Add Modal
    btnOpenAdd?.addEventListener('click', () => {
      addStaffForm?.reset();
      if (staffDeptDisplay && staffRoleSelect) {
        const opt = staffRoleSelect.options[staffRoleSelect.selectedIndex];
        staffDeptDisplay.value = opt?.getAttribute('data-dept') || 'Ban Giám Đốc';
      }
      staffModal?.classList.remove('hidden');
    });

    const closeStaffModal = () => staffModal?.classList.add('hidden');
    btnCloseStaffModal?.addEventListener('click', closeStaffModal);
    btnCancelStaffModal?.addEventListener('click', closeStaffModal);

    // Close Perm Modal
    const closePermModal = () => permModal?.classList.add('hidden');
    btnClosePermModal?.addEventListener('click', closePermModal);
    btnCancelPermModal?.addEventListener('click', closePermModal);

    // Close modals on overlay click
    [staffModal, permModal].forEach((modal) => {
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden');
      });
    });

    // Đổi checkbox admin tương ứng khi chọn role trong permission modal
    permRoleSelect?.addEventListener('change', () => {
      const isAdm = permRoleSelect.value === '1';
      if (permCheckAdmin) permCheckAdmin.checked = isAdm;
    });

    // Gắn sự kiện cho từng hàng nhân sự
    const attachRowActions = (row: HTMLTableRowElement) => {
      const permBtn = row.querySelector('[data-btn-permission]');
      const toggleLockBtn = row.querySelector('[data-btn-toggle-lock]') as HTMLButtonElement | null;
      const deleteBtn = row.querySelector('[data-btn-delete]') as HTMLButtonElement | null;

      // 1. Phân quyền
      permBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        const staffId = row.dataset.id || '';
        if (permHiddenId) permHiddenId.value = staffId;
        if (permStaffName) permStaffName.textContent = `Phân quyền: ${row.dataset.name}`;
        
        const currentRoleId = row.dataset.roleId;
        if (permRoleSelect && currentRoleId) {
          permRoleSelect.value = currentRoleId;
        }
        if (permCheckAdmin) {
          permCheckAdmin.checked = currentRoleId === '1' || row.dataset.roleKey === 'admin';
        }

        permModal?.classList.remove('hidden');
      });

      // 2. Khóa / Mở khóa tài khoản
      toggleLockBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        const staffId = row.dataset.id;
        if (!staffId) return;

        const originalText = toggleLockBtn.textContent;
        toggleLockBtn.textContent = '...';
        toggleLockBtn.disabled = true;

        try {
          const res = await fetch(`${API_BASE}/${staffId}/status`, {
            method: 'PATCH',
            headers: getHeaders(),
          });

          const resData = await res.json();
          if (!res.ok || !resData.success) {
            throw new Error(resData.message || 'Không thể cập nhật trạng thái');
          }

          const updated = resData.data;
          row.dataset.status = updated.status;
          const statusEl = row.querySelector('[data-col="status"]');
          if (statusEl) {
            statusEl.innerHTML = `<span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${updated.statusColor}">${updated.status}</span>`;
          }

          const isNowLocked = updated.status === 'Đã khóa';
          toggleLockBtn.textContent = isNowLocked ? 'Mở khóa' : 'Khóa';
          toggleLockBtn.className = `text-xs font-semibold cursor-pointer hover:underline ${
            isNowLocked ? 'text-emerald-700' : 'text-red-600'
          }`;

          updateStats();
          showToast(`Đã ${isNowLocked ? 'khóa' : 'mở khóa'} tài khoản "${updated.name}" thành công!`);
        } catch (err: any) {
          toggleLockBtn.textContent = originalText;
          showToast(err.message || 'Lỗi khi kết nối máy chủ', true);
        } finally {
          toggleLockBtn.disabled = false;
        }
      });

      // 3. Xóa nhân viên
      deleteBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        const staffId = row.dataset.id;
        const staffName = row.dataset.name;
        if (!staffId) return;

        if (!confirm(`Bạn có chắc chắn muốn xóa nhân sự "${staffName}" khỏi hệ thống không?`)) {
          return;
        }

        deleteBtn.textContent = 'Đang xóa...';
        try {
          const res = await fetch(`${API_BASE}/${staffId}`, {
            method: 'DELETE',
            headers: getHeaders(),
          });
          const resData = await res.json();
          if (!res.ok || !resData.success) {
            throw new Error(resData.message || 'Không thể xóa nhân viên');
          }

          row.remove();
          updateStats();
          showToast(`Đã xóa nhân sự "${staffName}" khỏi cơ sở dữ liệu!`);
        } catch (err: any) {
          deleteBtn.textContent = 'Xóa';
          showToast(err.message || 'Lỗi khi xóa nhân sự', true);
        }
      });
    };

    if (tableBody) {
      tableBody.querySelectorAll<HTMLTableRowElement>('[data-staff-row]').forEach(attachRowActions);
    }

    // Submit Phân Quyền Form -> Gọi PUT /api/staff/:id/role
    permForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const staffId = permHiddenId?.value;
      if (!staffId) return;

      const submitBtn = document.getElementById('btn-submit-perm') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang lưu CSDL...';
      }

      try {
        const newRoleId = Number(permRoleSelect.value);
        const res = await fetch(`${API_BASE}/${staffId}/role`, {
          method: 'PUT',
          headers: getHeaders(),
          body: JSON.stringify({ roleId: newRoleId }),
        });

        const resData = await res.json();
        if (!res.ok || !resData.success) {
          throw new Error(resData.message || 'Lỗi khi cập nhật vai trò');
        }

        const updated = resData.data;
        const targetRow = tableBody?.querySelector<HTMLTableRowElement>(`[data-id="${staffId}"]`);
        if (targetRow) {
          targetRow.dataset.role = updated.role;
          targetRow.dataset.roleId = String(updated.roleId);
          targetRow.dataset.roleKey = updated.roleKey;
          targetRow.dataset.dept = updated.dept;

          const roleEl = targetRow.querySelector('[data-col="role"]');
          if (roleEl) roleEl.textContent = updated.role;

          const deptEl = targetRow.querySelector('[data-col="dept"]');
          if (deptEl) deptEl.textContent = updated.dept;
        }

        closePermModal();
        updateStats();
        showToast(`Đã cập nhật phân quyền "${updated.name}" thành: ${updated.role}`);
      } catch (err: any) {
        showToast(err.message || 'Lỗi khi cập nhật vai trò', true);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Cập nhật vào CSDL';
        }
      }
    });

    // Submit Thêm Nhân Viên Mới -> Gọi POST /api/staff
    addStaffForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('staff-name-input') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('staff-email-input') as HTMLInputElement)?.value.trim();
      const phone = (document.getElementById('staff-phone-input') as HTMLInputElement)?.value.trim();
      const roleId = (document.getElementById('staff-role-select') as HTMLSelectElement)?.value;
      const password = (document.getElementById('staff-password-input') as HTMLInputElement)?.value.trim();

      if (!name || !email) {
        showToast('Vui lòng nhập đầy đủ tên và email.', true);
        return;
      }

      const submitBtn = document.getElementById('btn-submit-add-staff') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang lưu vào MySQL...';
      }

      try {
        const res = await fetch(API_BASE, {
          method: 'POST',
          headers: getHeaders(),
          body: JSON.stringify({
            name,
            email,
            phone,
            roleId: Number(roleId),
            password: password || 'Staff@123456',
          }),
        });

        const resData = await res.json();
        if (!res.ok || !resData.success) {
          throw new Error(resData.message || 'Không thể tạo nhân viên mới.');
        }

        const newStaff = resData.data;

        // Tạo dòng mới và thêm vào bảng
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-sand-100/50 transition-colors bg-emerald-50/40';
        tr.setAttribute('data-staff-row', '');
        tr.dataset.id = String(newStaff.id);
        tr.dataset.code = newStaff.code;
        tr.dataset.name = newStaff.name;
        tr.dataset.email = newStaff.email;
        tr.dataset.phone = newStaff.phone;
        tr.dataset.role = newStaff.role;
        tr.dataset.roleId = String(newStaff.roleId);
        tr.dataset.roleKey = newStaff.roleKey;
        tr.dataset.dept = newStaff.dept;
        tr.dataset.status = newStaff.status;

        tr.innerHTML = `
          <td class="py-3 px-4 font-mono font-bold text-walnut-900">${newStaff.code}</td>
          <td class="py-3 px-4">
            <div class="flex items-center gap-2.5">
              <div class="h-8 w-8 rounded-full bg-walnut-900 text-sand-50 flex items-center justify-center font-bold text-xs" data-col="avatar">
                ${newStaff.name.split(' ').map((n: string) => n[0]).slice(-2).join('')}
              </div>
              <div>
                <p class="font-bold text-walnut-900" data-col="name">${newStaff.name}</p>
                <p class="text-[10px] text-walnut-800/60" data-col="email">${newStaff.email}</p>
              </div>
            </div>
          </td>
          <td class="py-3 px-4 font-semibold text-clay-600" data-col="role">${newStaff.role}</td>
          <td class="py-3 px-4 text-walnut-900" data-col="dept">${newStaff.dept}</td>
          <td class="py-3 px-4 font-medium text-walnut-800" data-col="phone">${newStaff.phone}</td>
          <td class="py-3 px-4" data-col="status">
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${newStaff.statusColor}">
              ${newStaff.status}
            </span>
          </td>
          <td class="py-3 px-4 text-walnut-800/70" data-col="last-login">${newStaff.lastLogin}</td>
          <td class="py-3 px-4 text-right">
            <div class="flex items-center justify-end gap-2">
              <button type="button" data-btn-permission class="text-xs font-semibold text-clay-600 hover:underline cursor-pointer">Phân quyền</button>
              <span class="text-walnut-800/30">|</span>
              <button type="button" data-btn-toggle-lock class="text-xs font-semibold text-red-600 hover:underline cursor-pointer">Khóa</button>
              <span class="text-walnut-800/30">|</span>
              <button type="button" data-btn-delete class="text-xs font-semibold text-walnut-800/60 hover:text-red-600 cursor-pointer hover:underline">Xóa</button>
            </div>
          </td>
        `;

        attachRowActions(tr);
        tableBody?.prepend(tr);
        updateStats();
        closeStaffModal();
        addStaffForm.reset();
        showToast(`Đã thêm thành công nhân viên "${newStaff.name}" vào cơ sở dữ liệu!`);
      } catch (err: any) {
        showToast(err.message || 'Lỗi khi thêm nhân viên', true);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Lưu vào CSDL';
        }
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStaffPage);
  } else {
    initStaffPage();
  }
</script>
