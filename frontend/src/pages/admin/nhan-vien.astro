---
import AdminLayout from '../../layouts/AdminLayout.astro';

const staffMembers = [
  { id: 'NV-001', name: 'Trương Chí Vỹ', role: 'Quản Trị Tối Cao (Super Admin)', dept: 'Ban Giám Đốc', email: 'admin@noithat.vn', phone: '0909 001 001', status: 'Trực tuyến', statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300', lastLogin: 'Vừa xong' },
  { id: 'NV-002', name: 'Lê Hoàng Nam', role: 'Quản Lý Bán Hàng', dept: 'Phòng Kinh Doanh', email: 'nam.le@noithat.vn', phone: '0909 002 002', status: 'Trực tuyến', statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300', lastLogin: '15 phút trước' },
  { id: 'NV-003', name: 'Đặng Thảo Vy', role: 'Chuyên Viên Tư Vấn Phong Thủy', dept: 'Tư Vấn Khách Hàng', email: 'vy.dang@noithat.vn', phone: '0909 003 003', status: 'Trực tuyến', statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300', lastLogin: '1 giờ trước' },
  { id: 'NV-004', name: 'Nguyễn Tiến Dũng', role: 'Thủ Kho & Vận Chuyển', dept: 'Kho Vận', email: 'dung.nguyen@noithat.vn', phone: '0909 004 004', status: 'Vắng mặt', statusColor: 'bg-slate-100 text-slate-800 border-slate-300', lastLogin: 'Hôm qua' },
  { id: 'NV-005', name: 'Trần Bảo Ngọc', role: 'Marketing & Khuyến Mãi', dept: 'Truyền Thông', email: 'ngoc.tran@noithat.vn', phone: '0909 005 005', status: 'Trực tuyến', statusColor: 'bg-emerald-100 text-emerald-800 border-emerald-300', lastLogin: '3 giờ trước' },
];
---

<AdminLayout title="Quản Lý Nhân Viên & Phân Quyền - Nội Thất">
  <div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-walnut-900/10 pb-6">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl text-walnut-900">Quản Lý Nhân Viên & Phân Quyền</h1>
        <p class="mt-1 text-sm text-walnut-800/80">Danh sách nhân sự điều hành, phân bổ vai trò và bảo mật tài khoản.</p>
      </div>

      <button 
        type="button" 
        onclick="alert('Chức năng thêm nhân viên mới và cấp quyền truy cập')"
        class="inline-flex items-center gap-2 bg-walnut-900 px-4 py-2 text-xs uppercase tracking-[0.15em] text-sand-50 transition-colors hover:bg-clay-600 shadow-sm"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
        </svg>
        <span>Thêm Nhân Viên</span>
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Tổng nhân sự</p>
        <p class="text-2xl font-bold text-walnut-900 mt-1">5 nhân viên</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Đang trực tuyến</p>
        <p class="text-2xl font-bold text-emerald-700 mt-1">4 người</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Quyền Quản trị viên</p>
        <p class="text-2xl font-bold text-clay-600 mt-1">2 tài khoản</p>
      </div>
      <div class="rounded border border-walnut-900/10 bg-sand-50 p-4">
        <p class="text-xs uppercase text-walnut-800/70 font-medium">Xác thực 2 lớp (2FA)</p>
        <p class="text-2xl font-bold text-walnut-900 mt-1">100% Bật</p>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded border border-walnut-900/10 bg-sand-50 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-walnut-900/10 bg-sand-100/70 text-walnut-900 uppercase tracking-wider text-[11px]">
            <tr>
              <th class="py-3 px-4 font-semibold">Mã NV</th>
              <th class="py-3 px-4 font-semibold">Nhân viên</th>
              <th class="py-3 px-4 font-semibold">Chức vụ & Quyền hạn</th>
              <th class="py-3 px-4 font-semibold">Phòng ban</th>
              <th class="py-3 px-4 font-semibold">Liên hệ</th>
              <th class="py-3 px-4 font-semibold">Trạng thái</th>
              <th class="py-3 px-4 font-semibold">Lần đăng nhập cuối</th>
              <th class="py-3 px-4 font-semibold text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-walnut-900/10">
            {staffMembers.map((m) => (
              <tr class="hover:bg-sand-100/50">
                <td class="py-3 px-4 font-mono font-bold text-walnut-900">{m.id}</td>
                <td class="py-3 px-4">
                  <div class="flex items-center gap-2.5">
                    <div class="h-8 w-8 rounded-full bg-walnut-900 text-sand-50 flex items-center justify-center font-bold text-xs">
                      {m.name.split(' ').map(n => n[0]).slice(-2).join('')}
                    </div>
                    <div>
                      <p class="font-bold text-walnut-900">{m.name}</p>
                      <p class="text-[10px] text-walnut-800/60">{m.email}</p>
                    </div>
                  </div>
                </td>
                <td class="py-3 px-4 font-semibold text-clay-600">{m.role}</td>
                <td class="py-3 px-4 text-walnut-900">{m.dept}</td>
                <td class="py-3 px-4 font-medium text-walnut-800">{m.phone}</td>
                <td class="py-3 px-4">
                  <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold border ${m.statusColor}`}>
                    {m.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-walnut-800/70">{m.lastLogin}</td>
                <td class="py-3 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button type="button" class="text-xs font-semibold text-clay-600 hover:underline">Phân quyền</button>
                    <span class="text-walnut-800/30">|</span>
                    <button type="button" class="text-xs font-semibold text-red-600 hover:underline">Khóa</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
