</BaseLayout>

<style>
  /* Thanh cuộn mạ vàng kim thanh mảnh chuẩn Luxury */
  .luxury-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #D8B670 rgba(18, 43, 28, 0.6);
  }
  .luxury-scrollbar::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  .luxury-scrollbar::-webkit-scrollbar-track {
    background: rgba(18, 43, 28, 0.5);
    border-radius: 9999px;
  }
  .luxury-scrollbar::-webkit-scrollbar-thumb {
    background: #D8B670;
    border-radius: 9999px;
  }
  .luxury-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #E6CA85;
  }
  /* Entrance animations for dashboard */
  @keyframes accountFadeInUp {
    0% {
      opacity: 0;
      transform: translateY(18px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes accountFadeIn {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .account-animate-enter {
    animation: accountFadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .account-animate-enter-delay-1 {
    animation: accountFadeInUp 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  /* Smooth transition for active tab panes */
  .page-tab-pane:not(.hidden) {
    animation: accountFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .account-animate-enter,
    .account-animate-enter-delay-1,
    .page-tab-pane:not(.hidden) {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Active tab indicator in sidebar */
  .page-tab-btn.is-active {
    background-color: #173524;
    color: #F3E5AB;
    font-weight: 700;
  }
  .page-tab-btn.is-active svg {
    color: #D8B670;
  }
  .page-tab-btn.is-active svg:last-child {
    opacity: 1;
    transform: translateX(2px);
  }

  /* Order filter buttons */
  .order-filter-btn.is-active {
    background-color: #173524;
    color: #F3E5AB;
    font-weight: 700;
  }
</style>

<script>
  import { readUser } from '../../scripts/auth';
  import { addToCart, showCartToast } from '../../scripts/cart';

  const urlParams = new URLSearchParams(window.location.search);
  const requestedTab = urlParams.get('tab');
  const highlightCode = urlParams.get('highlight');
  const user = readUser();

  // Dọn dẹp khóa chung cũ bị ô nhiễm bởi các tài khoản test khác trên máy
  try {
    localStorage.removeItem('my_recent_orders');
  } catch {}

  const getScopedRecentOrdersKey = (): string => {
    try {
      const raw = localStorage.getItem('current_user');
      if (raw) {
        const u = JSON.parse(raw);
        if (u && (u.id || u.email)) {
          const uid = u.id ? String(u.id).trim() : u.email.trim().toLowerCase();
          return `noithat_recent_orders_u_${uid}`;
        }
      }
    } catch {}
    return 'noithat_recent_orders_guest';
  };

  let recentCodes: string[] = [];
  try {
    recentCodes = JSON.parse(localStorage.getItem(getScopedRecentOrdersKey()) || '[]');
  } catch {}

  const hasRecentOrders = Array.isArray(recentCodes) && recentCodes.length > 0;

  // Nếu chưa đăng nhập và không có đơn gần đây và không vào tab orders -> chuyển sang /dang-nhap
  if (!user && requestedTab !== 'orders' && !hasRecentOrders) {
    window.location.href = '/dang-nhap';
  } else {
    let fullUser: any = user || {
      name: 'Khách Mua Hàng',
      email: 'khach@noithat.vn',
      phone: 'Khách vãng lai',
      role: 'guest',
      tier: 'Khách Mua Hàng',
      spent: '0 ₫',
      orders: 0,
    };

    if (user) {
      try {
        const raw = localStorage.getItem('current_user');
        if (raw) fullUser = JSON.parse(raw);
      } catch {}

      const token = localStorage.getItem('auth_token');
      if (token) {
        try {
          const meRes = await fetch('http://localhost:4000/api/auth/me', {
            headers: { Authorization: `Bearer ${token}` },
          });
          const meData = await meRes.json();
          if (meData.success && meData.user) {
            fullUser.avatar = meData.user.avatar || null;
            if (meData.user.role) fullUser.role = meData.user.role;
            if (meData.user.full_name) fullUser.name = meData.user.full_name;
            fullUser.email = meData.user.email;
            if (meData.user.phone) fullUser.phone = meData.user.phone;
            localStorage.setItem('current_user', JSON.stringify(fullUser));
          }
        } catch {}
      }
    }

    const name = fullUser.name || user?.name || 'Khách Mua Hàng';
    const email = fullUser.email || user?.email || 'khach@noithat.vn';
    const phone = fullUser.phone && fullUser.phone !== 'Đăng nhập Google' ? fullUser.phone : ((user?.phone && user.phone !== 'Đăng nhập Google') ? user.phone : 'Chưa cập nhật');
    const isAdmin = (fullUser.role === 'admin');
    const tier = fullUser.tier || (isAdmin ? 'Quản Trị Viên' : (user ? 'Hội Viên Thân Thiết' : 'Khách Mua Hàng'));
    const spent = fullUser.spent || '0 ₫';
    const orders = typeof fullUser.orders === 'number' ? `${fullUser.orders} đơn hàng` : '0 đơn hàng';
    const avatar = fullUser.avatar || '';

    // Cập nhật DOM Header & Card
    const elName = document.getElementById('page-user-name');
    const elEmail = document.getElementById('page-user-email');
    const elTierBadge = document.getElementById('page-user-tier-badge');
    const elAvatar = document.getElementById('page-user-avatar');
    const adminBox = document.getElementById('page-admin-box');

    if (elName) elName.textContent = name;
    if (elEmail) elEmail.textContent = email;
    if (elTierBadge) elTierBadge.textContent = tier;

    if (adminBox) {
      if (isAdmin) {
        adminBox.classList.remove('hidden');
      } else {
        adminBox.classList.add('hidden');
      }
    }

    if (elAvatar) {
      if (avatar) {
        elAvatar.innerHTML = `<img src="${avatar}" alt="${name}" class="h-full w-full object-cover" referrerpolicy="no-referrer" />`;
      } else {
        const initials = name.split(' ').map((n: string) => n[0]).slice(-2).join('');
        elAvatar.textContent = initials || 'KH';
      }
    }

    const infoName = document.getElementById('page-info-name');
    const infoEmail = document.getElementById('page-info-email');
    const infoPhone = document.getElementById('page-info-phone');
    const infoTier = document.getElementById('page-info-tier');
    const infoSpent = document.getElementById('page-info-spent');
    const infoOrders = document.getElementById('page-info-orders');

    if (infoName) infoName.textContent = name;
    if (infoEmail) infoEmail.textContent = email;
    if (infoPhone) infoPhone.textContent = phone;
    if (infoTier) infoTier.textContent = tier;
    if (infoSpent) infoSpent.textContent = spent;
    if (infoOrders) infoOrders.textContent = orders;

    const addrName = document.getElementById('page-addr-name');
    const addrPhone = document.getElementById('page-addr-phone');
    if (addrName) addrName.textContent = name;
    if (addrPhone) addrPhone.textContent = phone;

    // Helper VND
    const fmtVnd = (v: number) => new Intl.NumberFormat('vi-VN').format(v || 0) + ' ₫';

    const getStatusInfo = (orderStatus: string, paymentStatus: string, paymentMethod?: string) => {
      if (orderStatus === 'cancelled') return { text: 'Đã hủy', cls: 'bg-red-100 text-red-700 border-red-300' };
      if (orderStatus === 'completed') return { text: 'Đã giao hàng', cls: 'bg-emerald-100 text-emerald-800 border-emerald-300' };
      if (orderStatus === 'shipping') return { text: 'Đang giao hàng', cls: 'bg-purple-100 text-purple-800 border-purple-300' };
      if (orderStatus === 'confirmed') return { text: 'Đang chuẩn bị', cls: 'bg-blue-100 text-blue-800 border-blue-300' };
      const isBank = (paymentMethod === 'bank' || paymentMethod === 'sepay' || paymentMethod === 'bank_transfer');
      if (isBank && paymentStatus !== 'paid') {
        return { text: 'Chờ thanh toán', cls: 'bg-amber-100 text-amber-800 border-amber-300' };
      }
      if (paymentStatus === 'paid') return { text: 'Đã thanh toán', cls: 'bg-emerald-50 text-emerald-700 border-emerald-300' };
      return { text: 'Chờ xác nhận', cls: 'bg-sand-200 text-walnut-900 border-walnut-900/20' };
    };

    // Loyalty Tier Progress calculation
    const updateLoyaltyProgress = (totalSpentNumber: number) => {
      const progressBar = document.getElementById('tier-progress-bar');
      const progressText = document.getElementById('tier-progress-text');
      const nextHint = document.getElementById('tier-next-hint');

      if (!progressBar || !progressText || !nextHint) return;

      if (totalSpentNumber >= 50000000) {
        progressBar.style.width = '100%';
        progressText.textContent = 'Hạng Kim Cương (VIP)';
        nextHint.innerHTML = 'Quý khách đang sở hữu hạng cao nhất với đặc quyền chiết khấu 15% trọn đời.';
      } else if (totalSpentNumber >= 20000000) {
        const pct = Math.min(100, (totalSpentNumber / 50000000) * 100);
        progressBar.style.width = `${pct}%`;
        progressText.textContent = 'Hạng Vàng';
        const remain = 50000000 - totalSpentNumber;
        nextHint.innerHTML = `Chi tiêu thêm <strong class="text-clay-700">${fmtVnd(remain)}</strong> để thăng hạng <strong>Kim Cương (VIP)</strong>.`;
      } else if (totalSpentNumber >= 5000000) {
        const pct = Math.min(100, (totalSpentNumber / 20000000) * 100);
        progressBar.style.width = `${pct}%`;
        progressText.textContent = 'Hạng Bạc';
        const remain = 20000000 - totalSpentNumber;
        nextHint.innerHTML = `Chi tiêu thêm <strong class="text-clay-700">${fmtVnd(remain)}</strong> để thăng hạng <strong>Vàng (VIP)</strong>.`;
      } else {
        const pct = Math.max(15, (totalSpentNumber / 5000000) * 100);
        progressBar.style.width = `${pct}%`;
        progressText.textContent = 'Hạng Đồng';
        const remain = 5000000 - totalSpentNumber;
        nextHint.innerHTML = `Chi tiêu thêm <strong class="text-clay-700">${fmtVnd(remain)}</strong> để thăng hạng <strong>Bạc</strong>.`;
      }
    };

    // =========================================================
    // ORDER DETAIL CENTERED MODAL
    // =========================================================
    const overlay = document.getElementById('order-detail-overlay')!;
    const panel = document.getElementById('order-detail-panel')!;
    const panelBody = document.getElementById('order-detail-body')!;
    const panelCode = document.getElementById('panel-order-code')!;
    const btnClose = document.getElementById('btn-close-order-detail')!;
    const btnCloseX = document.getElementById('btn-close-panel-x')!;
    const btnDetailCancelOrder = document.getElementById('btn-detail-cancel-order') as HTMLButtonElement | null;

    if (overlay && overlay.parentElement !== document.body) {
      document.body.appendChild(overlay);
    }

    const openPanel = () => {
      if (overlay && overlay.parentElement !== document.body) {
        document.body.appendChild(overlay);
      }
      overlay.scrollTop = 0;
      overlay.classList.remove('hidden');
      document.body.classList.add('order-modal-open');
      const aiFab = document.getElementById('feng-shui-fab-container');
      const contactFab = document.getElementById('contact-fab');
      if (aiFab) aiFab.style.display = 'none';
      if (contactFab) contactFab.style.display = 'none';

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          overlay.classList.remove('opacity-0');
          panel.classList.remove('scale-95', 'opacity-0');
          panel.classList.add('scale-100', 'opacity-100');
          document.body.style.overflow = 'hidden';
        });
      });
    };

    const closePanel = () => {
      overlay.classList.add('opacity-0');
      panel.classList.add('scale-95', 'opacity-0');
      panel.classList.remove('scale-100', 'opacity-100');
      document.body.style.overflow = '';
      if (btnDetailCancelOrder) {
        btnDetailCancelOrder.style.display = 'none';
        btnDetailCancelOrder.classList.add('hidden');
        btnDetailCancelOrder.classList.remove('inline-flex');
        btnDetailCancelOrder.onclick = null;
      }
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.body.classList.remove('order-modal-open');
        const aiFab = document.getElementById('feng-shui-fab-container');
        const contactFab = document.getElementById('contact-fab');
        if (aiFab) aiFab.style.display = '';
        if (contactFab) contactFab.style.display = '';
      }, 310);
    };

    if (btnClose) btnClose.addEventListener('click', closePanel);
    if (btnCloseX) btnCloseX.addEventListener('click', closePanel);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closePanel();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
        closePanel();
      }
    });

    const openOrderDetail = async (orderCode: string) => {
      panelCode.textContent = `#${orderCode}`;
      if (btnDetailCancelOrder) {
        btnDetailCancelOrder.style.display = 'none';
        btnDetailCancelOrder.classList.add('hidden');
        btnDetailCancelOrder.classList.remove('inline-flex');
        btnDetailCancelOrder.onclick = null;
      }
      panelBody.innerHTML = `
        <div class="flex items-center justify-center py-20 text-walnut-800/60 text-sm">
          <svg class="animate-spin w-7 h-7 mr-3 text-[#173524]" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          Đang tải dữ liệu đơn hàng #${orderCode}...
        </div>`;
      openPanel();

      try {
        const res = await fetch(`http://localhost:4000/api/orders/${encodeURIComponent(orderCode)}`);
        const json = await res.json();
        if (!json.success || !json.data) {
          panelBody.innerHTML = `<p class="text-center py-16 text-red-600 font-medium">Không thể tải thông tin đơn hàng #${orderCode}. Vui lòng thử lại.</p>`;
          return;
        }
        const o = json.data;
        const d = new Date(o.createdAt);
        const timeStr = d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        const dayStr = d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
        const dateStr = `${timeStr} • ${dayStr}`;
        const isBank = (o.paymentMethod === 'bank' || o.paymentMethod === 'sepay' || o.paymentMethod === 'bank_transfer');
        const { text: statusText, cls: statusCls } = getStatusInfo(o.orderStatus, o.paymentStatus, o.paymentMethod);
        const payMethod = isBank ? 'Chuyển khoản VietQR (SePay)' : 'Thanh toán COD khi nhận hàng';
        const recipientPhone = o.phone || phone;

        // Chỉ hiển thị nút hủy đơn nếu đơn hàng đang ở trạng thái chờ xác nhận / chuẩn bị và CHƯA BỊ HỦY
        const isCancelled = (o.orderStatus === 'cancelled' || o.orderStatus === 'da-huy');
        const canCancel = (o.orderStatus === 'pending' || o.orderStatus === 'confirmed' || o.orderStatus === 'cho-xac-nhan' || o.orderStatus === 'dang-chuan-bi') && !isCancelled;

        if (btnDetailCancelOrder) {
          if (canCancel) {
            btnDetailCancelOrder.classList.remove('hidden');
            btnDetailCancelOrder.classList.add('inline-flex');
            btnDetailCancelOrder.style.display = 'inline-flex';
            btnDetailCancelOrder.onclick = () => {
              openCancelOrderModal(String(o.id || o.orderCode), o.orderCode);
            };
          } else {
            btnDetailCancelOrder.classList.add('hidden');
            btnDetailCancelOrder.classList.remove('inline-flex');
            btnDetailCancelOrder.style.display = 'none';
            btnDetailCancelOrder.onclick = null;
          }
        }

        const itemsRows = (o.items || []).map((it: any) => `
          <tr class="border-b border-walnut-900/5 hover:bg-sand-50/70 transition-colors">
            <td class="px-3.5 py-3">
              <div class="flex items-center gap-3">
                ${it.imageUrl
                  ? `<img src="${it.imageUrl}" alt="${it.name}" class="w-12 h-12 object-cover rounded-none border border-walnut-900/10 shrink-0 shadow-xs bg-white" />`
                  : `<div class="w-12 h-12 bg-sand-200/80 rounded-none shrink-0 border border-walnut-900/10 flex items-center justify-center text-xl">🛋️</div>`
                }
                <div class="min-w-0 pr-1">
                  <a href="${it.slug ? `/san-pham/${it.slug}` : '#'}" class="font-bold text-walnut-900 text-xs leading-snug line-clamp-2 hover:text-[#173524] transition-colors">
                    ${it.name}
                  </a>
                  ${o.orderStatus === 'completed' && it.slug ? `
                    <a href="/san-pham/${it.slug}#danh-gia" class="inline-flex items-center gap-1 text-[10px] text-amber-700 hover:text-amber-900 font-bold mt-1 bg-amber-50 px-2 py-0.5 border border-amber-200/60">
                      ★ Đánh giá sản phẩm
                    </a>` : ''}
                </div>
              </div>
            </td>
            <td class="px-3 py-3 text-right text-xs text-walnut-800/80 font-medium whitespace-nowrap">${fmtVnd(it.price)}</td>
            <td class="px-2 py-3 text-center font-bold text-walnut-900 text-xs whitespace-nowrap">${it.qty}</td>
            <td class="px-3.5 py-3 text-right font-bold text-clay-700 text-xs whitespace-nowrap">${fmtVnd(it.total || it.price * it.qty)}</td>
          </tr>`).join('');

        panelBody.innerHTML = `
          ${o.orderStatus === 'cancelled' ? `
            <div class="mb-5 bg-red-50 border-l-4 border-red-500 p-4 text-red-900 rounded-none shadow-xs">
              <div class="flex items-start gap-3">
                <span class="text-xl">⚠️</span>
                <div>
                  <p class="font-bold text-xs uppercase tracking-wider text-red-900">Đơn hàng này đã bị hủy</p>
                  <p class="text-xs text-red-800 mt-1"><strong>Lý do:</strong> ${o.cancelReason || 'Đơn hàng đã được hủy theo quy định.'}</p>
                  <p class="text-[11px] text-red-600/80 mt-1 italic">Số lượng tồn kho sản phẩm và khuyến mãi (nếu có) đã được hoàn trả lại hệ thống.</p>
                </div>
              </div>
            </div>` : ''}

          ${isBank && o.paymentStatus !== 'paid' && o.orderStatus !== 'cancelled' ? `
            <div class="mb-5 bg-gradient-to-br from-amber-50 to-orange-50/40 border border-amber-300/80 p-4 sm:p-5 rounded-none shadow-xs">
              <div class="flex items-center gap-2 border-b border-amber-200/80 pb-2.5 mb-3.5">
                <span class="text-lg">💳</span>
                <h4 class="font-bold text-xs uppercase tracking-wider text-amber-950">Quét mã VietQR để thanh toán đơn hàng này</h4>
                <span class="ml-auto text-[10px] font-bold text-amber-900 bg-amber-200 px-2.5 py-0.5 rounded-full border border-amber-300">Chờ thanh toán</span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                <div class="md:col-span-4 flex flex-col items-center">
                  <img
                    src="https://qr.sepay.vn/img?acc=8890359180209&bank=MBBank&amount=${o.total}&des=${encodeURIComponent(o.orderCode)}&template=compact"
                    alt="Mã VietQR thanh toán đơn #${o.orderCode}"
                    class="w-40 h-40 object-contain bg-white p-1 border border-amber-300 shadow-sm"
                  />
                  <span class="text-[10px] text-amber-900/80 mt-1.5 font-medium">Mở App Ngân hàng quét mã QR</span>
                </div>
                <div class="md:col-span-8 space-y-2 text-xs text-walnut-900">
                  <div class="flex justify-between items-center py-1 border-b border-amber-200/50">
                    <span class="text-walnut-800/70">Ngân hàng thụ hưởng:</span>
                    <strong class="font-bold text-walnut-900">MBBank (Ngân hàng Quân Đội)</strong>
                  </div>
                  <div class="flex justify-between items-center py-1 border-b border-amber-200/50">
                    <span class="text-walnut-800/70">Số tài khoản:</span>
                    <div class="flex items-center gap-1.5">
                      <span class="font-mono font-bold text-sm text-walnut-900">8890359180209</span>
                      <button type="button" onclick="navigator.clipboard.writeText('8890359180209'); alert('Đã sao chép số tài khoản!');" class="text-[10px] bg-amber-200 hover:bg-amber-300 text-amber-900 px-2 py-0.5 rounded font-bold cursor-pointer transition-colors">Copy</button>
                    </div>
                  </div>
                  <div class="flex justify-between items-center py-1 border-b border-amber-200/50">
                    <span class="text-walnut-800/70">Chủ tài khoản:</span>
                    <span class="font-bold uppercase text-xs text-walnut-900">TRUONG CHI VY</span>
                  </div>
                  <div class="flex justify-between items-center py-1 border-b border-amber-200/50">
                    <span class="text-walnut-800/70">Số tiền:</span>
                    <strong class="font-mono font-bold text-base text-red-600">${fmtVnd(o.total)}</strong>
                  </div>
                  <div class="flex justify-between items-center py-1">
                    <span class="text-walnut-800/70">Nội dung chuyển khoản:</span>
                    <div class="flex items-center gap-1.5">
                      <span class="font-mono font-bold text-sm text-orange-600">${o.orderCode}</span>
                      <button type="button" onclick="navigator.clipboard.writeText('${o.orderCode}'); alert('Đã sao chép nội dung chuyển khoản!');" class="text-[10px] bg-orange-200 hover:bg-orange-300 text-orange-900 px-2 py-0.5 rounded font-bold cursor-pointer transition-colors">Copy</button>
                    </div>
                  </div>
                  <p class="text-[10px] text-amber-900/80 italic pt-1 border-t border-amber-200/50">
                    * Đơn hàng sẽ được tự động hủy sau 24 giờ nếu chưa nhận được thanh toán. Sau khi chuyển khoản, Quản trị viên sẽ xác nhận và gửi email cho bạn.
                  </p>
                </div>
              </div>
            </div>` : ''}

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

            <!-- CỘT TRÁI: Thông tin chung + Nhận hàng (5 cột) -->
            <div class="lg:col-span-5 space-y-4">

              <!-- Box: Thông tin đơn hàng -->
              <div class="bg-white rounded-none border border-walnut-900/15 overflow-hidden shadow-xs">
                <div class="bg-sand-100/90 px-4 py-2.5 border-b border-walnut-900/10 flex items-center justify-between">
                  <h3 class="font-bold text-xs text-walnut-900 uppercase tracking-wide">Thông tin đơn hàng</h3>
                  <span class="inline-block border rounded-none px-2 py-0.5 text-[10px] font-bold ${statusCls}">${statusText}</span>
                </div>
                <div class="p-4 space-y-2.5 text-xs">
                  <div class="flex justify-between items-center py-0.5 border-b border-walnut-900/5">
                    <span class="text-walnut-800/60">Mã đơn hàng:</span>
                    <span class="font-bold font-mono text-walnut-900 text-xs bg-sand-100/80 px-2 py-0.5 border border-walnut-900/10">#${o.orderCode}</span>
                  </div>
                  <div class="flex justify-between items-center py-0.5 border-b border-walnut-900/5">
                    <span class="text-walnut-800/60">Thời gian đặt:</span>
                    <span class="text-walnut-900 font-medium">${dateStr}</span>
                  </div>
                  <div class="flex justify-between items-center py-0.5 border-b border-walnut-900/5">
                    <span class="text-walnut-800/60">Hình thức thanh toán:</span>
                    <span class="text-walnut-900 font-semibold">${payMethod}</span>
                  </div>
                  <div class="flex justify-between items-center py-0.5">
                    <span class="text-walnut-800/60">Trạng thái thanh toán:</span>
                    <span class="inline-flex items-center gap-1 font-semibold ${o.paymentStatus === 'paid' ? 'text-emerald-700' : 'text-amber-700'}">
                      <span class="w-1.5 h-1.5 rounded-full ${o.paymentStatus === 'paid' ? 'bg-emerald-500' : 'bg-amber-500'}"></span>
                      ${o.paymentStatus === 'paid' ? 'Đã thanh toán' : 'Chưa thanh toán'}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Box: Thông tin giao nhận -->
              <div class="bg-white rounded-none border border-walnut-900/15 overflow-hidden shadow-xs">
                <div class="bg-sand-100/90 px-4 py-2.5 border-b border-walnut-900/10">
                  <h3 class="font-bold text-xs text-walnut-900 uppercase tracking-wide">Địa chỉ nhận hàng</h3>
                </div>
                <div class="p-4 space-y-2 text-xs text-walnut-900">
                  <div class="flex items-start gap-2">
                    <span class="text-walnut-800/60 w-24 shrink-0">Người nhận:</span>
                    <strong class="font-bold text-walnut-900 text-sm">${o.customerName || name}</strong>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="text-walnut-800/60 w-24 shrink-0">Điện thoại:</span>
                    <span class="font-semibold text-walnut-900 font-mono">${recipientPhone}</span>
                  </div>
                  ${o.email ? `
                  <div class="flex items-start gap-2">
                    <span class="text-walnut-800/60 w-24 shrink-0">Email:</span>
                    <span class="font-mono text-walnut-800">${o.email}</span>
                  </div>` : ''}
                  <div class="flex items-start gap-2 pt-1.5 border-t border-walnut-900/5">
                    <span class="text-walnut-800/60 w-24 shrink-0 pt-0.5">Địa chỉ giao:</span>
                    <div class="flex-1 bg-sand-100/60 p-2.5 border border-walnut-900/10 text-walnut-900 leading-relaxed font-medium">
                      ${o.shippingAddress || 'Chưa cung cấp địa chỉ'}
                    </div>
                  </div>
                  ${o.customerNote ? `
                  <div class="border-t border-walnut-900/10 pt-2 flex items-start gap-2">
                    <span class="text-walnut-800/60 w-24 shrink-0">Ghi chú:</span>
                    <span class="italic text-walnut-800/80 bg-amber-50/60 px-2 py-1 border border-amber-200/50 flex-1">${o.customerNote}</span>
                  </div>` : ''}
                </div>
              </div>

            </div>

            <!-- CỘT PHẢI: Danh sách sản phẩm & Thanh toán (7 cột) -->
            <div class="lg:col-span-7">
              <div class="bg-white rounded-none border border-walnut-900/15 overflow-hidden shadow-xs flex flex-col">
                <div class="bg-[#173524] text-white px-4 py-3 border-b border-[#D8B670]/20 flex items-center justify-between shrink-0">
                  <h3 class="font-bold text-xs uppercase tracking-wider">Danh sách sản phẩm</h3>
                  <span class="text-[11px] font-bold text-[#E6CA85] bg-white/10 px-2.5 py-0.5 border border-[#D8B670]/30">${(o.items || []).length} món</span>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full text-xs">
                    <thead>
                      <tr class="bg-sand-100/90 text-walnut-800/80 text-[10px] uppercase tracking-wider border-b border-walnut-900/10">
                        <th class="px-3.5 py-2.5 text-left font-bold">Sản phẩm</th>
                        <th class="px-3 py-2.5 text-right font-bold w-24 whitespace-nowrap">Đơn giá</th>
                        <th class="px-2 py-2.5 text-center font-bold w-12 whitespace-nowrap">SL</th>
                        <th class="px-3.5 py-2.5 text-right font-bold w-28 whitespace-nowrap">Thành tiền</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-walnut-900/5">
                      ${itemsRows}
                    </tbody>
                  </table>
                </div>

                <!-- Price Breakdown & Summary -->
                <div class="border-t border-walnut-900/15 px-4 py-3.5 space-y-2 text-xs bg-[#FAF8F5] shrink-0">
                  ${o.subtotal ? `
                  <div class="flex justify-between text-walnut-800/70">
                    <span>Tạm tính tiền hàng:</span>
                    <span class="font-semibold text-walnut-900">${fmtVnd(o.subtotal)}</span>
                  </div>` : ''}
                  <div class="flex justify-between text-walnut-800/70">
                    <span>Phí vận chuyển:</span>
                    <span class="${(o.shippingFee || 0) === 0 ? 'text-emerald-700 font-bold' : 'font-semibold text-walnut-900'}">
                      ${(o.shippingFee || 0) === 0 ? 'Miễn phí giao hàng' : fmtVnd(o.shippingFee)}
                    </span>
                  </div>
                  ${(o.discountAmount || 0) > 0 ? `
                  <div class="flex justify-between text-emerald-700 font-bold">
                    <span>Mã giảm giá${o.couponCode ? ` (${o.couponCode})` : ''}:</span>
                    <span>-${fmtVnd(o.discountAmount)}</span>
                  </div>` : ''}
                  <div class="flex justify-between items-center text-sm font-bold border-t border-walnut-900/15 pt-2.5 mt-1">
                    <span class="text-walnut-900 uppercase tracking-wide text-xs">Tổng cộng thanh toán:</span>
                    <span class="text-clay-700 text-lg font-bold font-mono">${fmtVnd(o.total)}</span>
                  </div>
                </div>
              </div>
            </div>

          </div>`;

      } catch (err) {
        panelBody.innerHTML = `<p class="text-center py-16 text-red-600 text-sm font-medium">Lỗi kết nối khi tải chi tiết đơn hàng. Vui lòng thử lại sau.</p>`;
        console.error('Lỗi tải chi tiết đơn hàng:', err);
      }
    };

    // =========================================================
    // RENDER ORDERS TABLE & FILTER
    // =========================================================
    let allUserOrders: any[] = [];
    let currentFilter = 'all';

    const renderOrdersTable = () => {
      const tableWrapper = document.getElementById('orders-table-wrapper')!;
      const tableBody = document.getElementById('orders-table-body')!;
      const emptyEl = document.getElementById('orders-empty')!;
      const countBadge = document.getElementById('orders-count-badge')!;
      const sidebarOrdersBadge = document.getElementById('sidebar-orders-badge');

      if (sidebarOrdersBadge) sidebarOrdersBadge.textContent = String(allUserOrders.length);

      let filtered = allUserOrders;
      if (currentFilter !== 'all') {
        filtered = allUserOrders.filter((o) => {
          if (currentFilter === 'pending') return o.orderStatus === 'pending';
          if (currentFilter === 'shipping') return o.orderStatus === 'shipping' || o.orderStatus === 'confirmed';
          if (currentFilter === 'completed') return o.orderStatus === 'completed';
          if (currentFilter === 'cancelled') return o.orderStatus === 'cancelled';
          return true;
        });
      }

      if (allUserOrders.length === 0) {
        tableWrapper.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        return;
      }

      emptyEl.classList.add('hidden');
      tableWrapper.classList.remove('hidden');
      countBadge.textContent = `${filtered.length} / ${allUserOrders.length} đơn`;

      if (filtered.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="6" class="py-12 text-center text-xs text-walnut-800/60">
              Không có đơn hàng nào thuộc trạng thái này.
            </td>
          </tr>`;
        return;
      }

      tableBody.innerHTML = filtered.map((order: any) => {
        const dateStr = new Date(order.createdAt).toLocaleDateString('vi-VN', {
          day: '2-digit', month: '2-digit', year: 'numeric',
          hour: '2-digit', minute: '2-digit',
        });
        const isBank = (order.paymentMethod === 'bank' || order.paymentMethod === 'sepay' || order.paymentMethod === 'bank_transfer');
        const isPendingBankPay = isBank && order.paymentStatus !== 'paid' && order.orderStatus !== 'cancelled';
        const { text: statusText, cls: statusCls } = getStatusInfo(order.orderStatus, order.paymentStatus, order.paymentMethod);
        const recipientName = order.customerName || name;
        const recipientPhone = order.phone || phone;
        const isHighlighted = highlightCode && order.orderCode === highlightCode;
        const canCancel = (order.orderStatus === 'pending' || order.orderStatus === 'confirmed');

        return `
          <tr id="order-row-${order.orderCode}" class="border-b border-walnut-900/8 hover:bg-[#E6CA85]/8 transition-colors ${isHighlighted ? 'ring-2 ring-inset ring-emerald-500 bg-emerald-50/30' : ''}">
            <td class="px-4 py-3.5">
              <div class="flex items-center gap-2">
                <span class="font-mono font-bold text-walnut-900 text-xs">#${order.orderCode}</span>
                ${isHighlighted ? `<span class="inline-flex items-center gap-1 text-[9px] font-bold text-emerald-700 bg-emerald-100 border border-emerald-300 px-1.5 py-0.5 rounded-none uppercase">
                  <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping"></span>Mới
                </span>` : ''}
              </div>
            </td>
            <td class="px-4 py-3.5 text-xs text-walnut-800/70 whitespace-nowrap">📅 ${dateStr}</td>
            <td class="px-4 py-3.5">
              <p class="font-semibold text-walnut-900 text-xs">${recipientName}</p>
              <p class="text-[11px] text-walnut-800/60 font-mono">${recipientPhone}</p>
            </td>
            <td class="px-4 py-3.5 text-right font-bold text-clay-700 text-sm whitespace-nowrap">${fmtVnd(order.total)}</td>
            <td class="px-4 py-3.5 text-center">
              <span class="inline-block border rounded-none px-2.5 py-1 text-[10px] font-bold whitespace-nowrap ${statusCls}">${statusText}</span>
            </td>
            <td class="px-4 py-3.5 text-center">
              <div class="flex items-center justify-center gap-2">
                <button
                  data-view-order="${order.orderCode}"
                  class="btn-view-detail inline-flex items-center gap-1 bg-[#173524] text-[#E6CA85] hover:bg-[#204932] hover:text-white px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider transition-colors rounded-none cursor-pointer shadow-xs whitespace-nowrap"
                >
                  Chi tiết
                </button>
                ${canCancel ? `
                <button
                  data-cancel-order="${order.id || order.orderCode}"
                  data-code="${order.orderCode}"
                  class="btn-cancel-order inline-flex items-center gap-1 border border-red-300 text-red-600 hover:bg-red-50 hover:border-red-500 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider transition-colors rounded-none cursor-pointer whitespace-nowrap"
                  title="Hủy đơn hàng"
                >
                  ✕ Hủy
                </button>` : ''}
              </div>
            </td>
          </tr>`;
      }).join('');

      // Bind Chi tiết
      tableBody.querySelectorAll<HTMLButtonElement>('.btn-view-detail').forEach((btn) => {
        btn.addEventListener('click', () => {
          const code = btn.dataset.viewOrder;
          if (code) openOrderDetail(code);
        });
      });

      // Bind Hủy đơn mở popup thương hiệu
      tableBody.querySelectorAll<HTMLButtonElement>('.btn-cancel-order').forEach((btn) => {
        btn.addEventListener('click', () => {
          const orderId = btn.dataset.cancelOrder;
          const orderCode = btn.dataset.code;
          if (orderId && orderCode) {
            openCancelOrderModal(orderId, orderCode);
          }
        });
      });
    };

    const loadOrdersData = async () => {
      const loadingEl = document.getElementById('orders-loading')!;
      let userOrders: any[] = [];
      const token = localStorage.getItem('auth_token');

      if (token) {
        try {
          const res = await fetch('http://localhost:4000/api/orders/my-orders', {
            headers: { Authorization: `Bearer ${token}` },
          });
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            userOrders = json.data;
            if (json.stats) {
              if (infoSpent) infoSpent.textContent = fmtVnd(json.stats.totalSpent);
              if (infoOrders) infoOrders.textContent = `${json.stats.completedCount} đơn hàng`;
              updateLoyaltyProgress(json.stats.totalSpent || 0);
            }
          }
        } catch (err) {
          console.warn('Lỗi kết nối API My Orders:', err);
        }
      }

      // Đơn gần đây từ bộ nhớ đệm: RÀNG BUỘC QUYỀN SỞ HỮU NGHIÊM NGẶT
      for (const code of recentCodes) {
        if (!userOrders.some((o: any) => o.orderCode === code)) {
          try {
            const res = await fetch(`http://localhost:4000/api/orders/${encodeURIComponent(code)}`);
            const json = await res.json();
            if (json.success && json.data) {
              const order = json.data;
              // RÀNG BUỘC BẢO MẬT: Nếu đã đăng nhập, đơn hàng bắt buộc phải thuộc về tài khoản này!
              const isMatchUser = token
                ? (
                    (order.userId && fullUser.id && Number(order.userId) === Number(fullUser.id)) ||
                    (order.email && fullUser.email && String(order.email).trim().toLowerCase() === String(fullUser.email).trim().toLowerCase()) ||
                    (order.phone && fullUser.phone && String(order.phone).trim() === String(fullUser.phone).trim())
                  )
                : true;

              if (isMatchUser) {
                userOrders.unshift(order);
              }
            }
          } catch (err) {}
        }
      }

      allUserOrders = userOrders;
      loadingEl.classList.add('hidden');
      renderOrdersTable();

      // Cập nhật thống kê Tổng chi tiêu & Đơn hoàn thành dựa trên các đơn đã giao thành công (completed)
      const completedOrders = allUserOrders.filter((o: any) => o.orderStatus === 'completed' || o.orderStatus === 'hoan-thanh');
      const calculatedTotalSpent = completedOrders.reduce((sum: number, o: any) => sum + Number(o.total || o.totalAmount || 0), 0);
      const calculatedCompletedCount = completedOrders.length;

      if (infoSpent) infoSpent.textContent = fmtVnd(calculatedTotalSpent);
      if (infoOrders) infoOrders.textContent = `${calculatedCompletedCount} đơn hàng`;
      updateLoyaltyProgress(calculatedTotalSpent);

      if (highlightCode) {
        setTimeout(() => {
          const rowEl = document.getElementById(`order-row-${highlightCode}`);
          if (rowEl) rowEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          openOrderDetail(highlightCode);
        }, 500);
      }
    };

    loadOrdersData();

    // Filter Buttons
    document.querySelectorAll<HTMLButtonElement>('.order-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.order-filter-btn').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentFilter = btn.dataset.orderFilter || 'all';
        renderOrdersTable();
      });
    });

    // =========================================================
    // VOUCHERS TAB
    // =========================================================
    const loadVouchers = async () => {
      const loading = document.getElementById('vouchers-loading');
      const grid = document.getElementById('vouchers-grid');
      if (!loading || !grid) return;

      try {
        const res = await fetch('http://localhost:4000/api/coupons');
        const json = await res.json();
        loading.classList.add('hidden');

        if (json.success && Array.isArray(json.data) && json.data.length > 0) {
          grid.classList.remove('hidden');
          grid.innerHTML = json.data.map((c: any) => {
            const isPercent = c.discountType === 'percent' || c.discountType === 'percentage';
            const isFreeShip = c.discountType === 'free_shipping';
            const valueDisplay = isFreeShip 
              ? (c.discountValue > 0 ? `Freeship ${fmtVnd(c.discountValue)}` : 'Freeship 100%')
              : (isPercent ? `${c.discountValue}%` : fmtVnd(c.discountValue));
            const minDisplay = c.minOrderValue ? `Đơn tối thiểu ${fmtVnd(c.minOrderValue)}` : 'Áp dụng cho mọi đơn';
            const iconSrc = isFreeShip ? '/images/icons/free-shipping.png' : '/images/icons/discount-voucher.png';

            return `
              <div class="rounded-none border border-walnut-900/15 bg-[#FAF8F5] p-4 flex items-center justify-between gap-3 shadow-xs hover:border-[#173524]/40 transition-colors">
                <div class="flex items-center gap-3 min-w-0">
                  <img src="${iconSrc}" alt="Icon" class="w-10 h-10 object-contain shrink-0" loading="lazy" />
                  <div class="space-y-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="font-mono font-bold text-sm bg-[#173524] text-[#E6CA85] px-2.5 py-0.5">${c.code}</span>
                      <span class="text-xs font-bold text-clay-700">Giảm ${valueDisplay}</span>
                    </div>
                    <p class="text-[11px] text-walnut-800/80">${minDisplay}</p>
                  </div>
                </div>
                <button
                  type="button"
                  data-copy-voucher="${c.code}"
                  class="btn-copy-voucher bg-white border border-walnut-900/20 hover:border-walnut-900 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-walnut-900 transition-colors cursor-pointer shrink-0"
                >
                  Sao chép
                </button>
              </div>`;
          }).join('');

          grid.querySelectorAll<HTMLButtonElement>('.btn-copy-voucher').forEach((btn) => {
            btn.addEventListener('click', () => {
              const code = btn.dataset.copyVoucher;
              if (code) {
                navigator.clipboard.writeText(code);
                const originalText = btn.textContent;
                btn.textContent = 'Đã chép! ✓';
                btn.classList.add('bg-emerald-100', 'text-emerald-800', 'border-emerald-300');
                setTimeout(() => {
                  btn.textContent = originalText;
                  btn.classList.remove('bg-emerald-100', 'text-emerald-800', 'border-emerald-300');
                }, 1800);
              }
            });
          });
        } else {
          grid.classList.remove('hidden');
          grid.innerHTML = '<p class="col-span-2 text-center py-8 text-xs text-walnut-800/70">Hiện chưa có mã giảm giá nào đang áp dụng.</p>';
        }
      } catch (e) {
        loading.textContent = 'Không thể tải danh sách ưu đãi. Vui lòng thử lại sau.';
      }
    };

    loadVouchers();

    // =========================================================
    // WISHLIST TAB: LUXURY FURNITURE WISHLIST (HORIZONTAL LIST ONLY)
    // =========================================================
    let allWishlistItems: any[] = [];
    let selectedWishlistCategory: string = 'all';
    let selectedWishlistSort: string = 'newest';
    let currentWishlistPage: number = 1;
    const WISHLIST_ITEMS_PER_PAGE = 4;
    let isWishlistSelectMode: boolean = false;
    const selectedWishlistSlugs = new Set<string>();

    const loadingEl = document.getElementById('wishlist-loading')!;
    const contentEl = document.getElementById('wishlist-content')!;
    const emptyEl = document.getElementById('wishlist-empty')!;
    const countBadge = document.getElementById('wishlist-count-badge')!;
    const sidebarBadge = document.getElementById('sidebar-wishlist-badge');
    const headerActionsEl = document.getElementById('wishlist-header-actions');
    const btnStartSelect = document.getElementById('btn-wishlist-start-select');
    const selectingActionsEl = document.getElementById('wishlist-selecting-actions');
    const btnSelectAll = document.getElementById('btn-wishlist-select-all');
    const btnSelectAllText = document.getElementById('btn-select-all-text');
    const btnAddAll = document.getElementById('btn-wishlist-add-all');
    const btnAddAllText = document.getElementById('btn-add-all-text');
    const btnClearAll = document.getElementById('btn-wishlist-clear-all');
    const btnClearAllText = document.getElementById('btn-clear-all-text');
    const btnCancelSelect = document.getElementById('btn-wishlist-cancel-select');
    const paginationContainer = document.getElementById('wishlist-pagination-container');
    const toolbarEl = document.getElementById('wishlist-toolbar');
    const pillsContainer = document.getElementById('wishlist-category-pills');
    const sortSelect = document.getElementById('wishlist-sort-select') as HTMLSelectElement | null;
    const clearModalOverlay = document.getElementById('wishlist-clear-modal-overlay');
    const clearModalPanel = document.getElementById('wishlist-clear-modal-panel');
    const clearModalTitle = document.getElementById('wishlist-clear-modal-title');
    const clearModalDesc = document.getElementById('wishlist-clear-modal-desc');
    const clearModalConfirmText = document.getElementById('wishlist-clear-modal-confirm-text');
    const btnCancelClear = document.getElementById('btn-cancel-clear-wishlist');
    const btnConfirmClear = document.getElementById('btn-confirm-clear-wishlist') as HTMLButtonElement | null;

    let itemsToDelete: string[] = []; // Empty means delete all

    // Move modal to body to break stacking context
    if (clearModalOverlay && clearModalOverlay.parentElement !== document.body) {
      document.body.appendChild(clearModalOverlay);
    }

    const openClearWishlistModal = () => {
      if (!clearModalOverlay || !clearModalPanel) return;
      clearModalOverlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        clearModalOverlay.classList.remove('opacity-0');
        clearModalOverlay.classList.add('opacity-100');
        clearModalPanel.classList.remove('scale-95', 'opacity-0');
        clearModalPanel.classList.add('scale-100', 'opacity-100');
      });
    };

    const closeClearWishlistModal = () => {
      if (!clearModalOverlay || !clearModalPanel) return;
      clearModalOverlay.classList.remove('opacity-100');
      clearModalOverlay.classList.add('opacity-0');
      clearModalPanel.classList.remove('scale-100', 'opacity-100');
      clearModalPanel.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        clearModalOverlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 250);
    };

    btnCancelClear?.addEventListener('click', closeClearWishlistModal);
    clearModalOverlay?.addEventListener('click', (e) => {
      if (e.target === clearModalOverlay) closeClearWishlistModal();
    });

    // Sort select listener
    sortSelect?.addEventListener('change', () => {
      selectedWishlistSort = sortSelect?.value || 'newest';
      currentWishlistPage = 1;
      renderWishlistContent();
    });

    const getProcessedWishlistItems = () => {
      let items = [...allWishlistItems];
      if (selectedWishlistCategory !== 'all') {
        items = items.filter(
          (i) => (i.category || '').trim().toLowerCase() === selectedWishlistCategory.trim().toLowerCase()
        );
      }
      if (selectedWishlistSort === 'price-asc') {
        items.sort((a, b) => (Number(a.price) || 0) - (Number(b.price) || 0));
      } else if (selectedWishlistSort === 'price-desc') {
        items.sort((a, b) => (Number(b.price) || 0) - (Number(a.price) || 0));
      } else if (selectedWishlistSort === 'name-asc') {
        items.sort((a, b) => (a.name || '').localeCompare(b.name || '', 'vi'));
      }
      return items;
    };

    const updateActionButtonsText = () => {
      const count = selectedWishlistSlugs.size;
      if (count === 0) {
        if (btnSelectAllText) btnSelectAllText.textContent = 'Chọn tất cả';
        if (btnAddAllText) btnAddAllText.textContent = 'Thêm tất cả vào giỏ';
        if (btnClearAllText) btnClearAllText.textContent = 'Xóa tất cả';
      } else {
        const filtered = getProcessedWishlistItems();
        const startIndex = (currentWishlistPage - 1) * WISHLIST_ITEMS_PER_PAGE;
        const pageItems = filtered.slice(startIndex, startIndex + WISHLIST_ITEMS_PER_PAGE);
        const allPageSelected = pageItems.length > 0 && pageItems.every((i) => selectedWishlistSlugs.has(i.slug));
        if (btnSelectAllText) btnSelectAllText.textContent = allPageSelected ? 'Bỏ chọn' : 'Chọn tất cả';
        if (btnAddAllText) btnAddAllText.textContent = `Thêm vào giỏ (${count})`;
        if (btnClearAllText) btnClearAllText.textContent = `Xóa đã chọn (${count})`;
      }
    };

    // Mode: Bắt đầu chọn
    btnStartSelect?.addEventListener('click', () => {
      isWishlistSelectMode = true;
      selectedWishlistSlugs.clear();
      btnStartSelect.classList.add('hidden');
      btnStartSelect.style.display = 'none';
      if (selectingActionsEl) {
        selectingActionsEl.classList.remove('hidden');
        selectingActionsEl.style.display = 'flex';
      }
      updateActionButtonsText();
      renderWishlistContent();
    });

    // Mode: Hủy chọn
    btnCancelSelect?.addEventListener('click', () => {
      isWishlistSelectMode = false;
      selectedWishlistSlugs.clear();
      if (selectingActionsEl) {
        selectingActionsEl.classList.add('hidden');
        selectingActionsEl.style.display = 'none';
      }
      if (btnStartSelect) {
        btnStartSelect.classList.remove('hidden');
        btnStartSelect.style.display = '';
      }
      renderWishlistContent();
    });

    // Nút Chọn tất cả / Bỏ chọn
    btnSelectAll?.addEventListener('click', () => {
      const filtered = getProcessedWishlistItems();
      const totalPages = Math.ceil(filtered.length / WISHLIST_ITEMS_PER_PAGE) || 1;
      if (currentWishlistPage > totalPages) currentWishlistPage = totalPages;
      const startIndex = (currentWishlistPage - 1) * WISHLIST_ITEMS_PER_PAGE;
      const pageItems = filtered.slice(startIndex, startIndex + WISHLIST_ITEMS_PER_PAGE);
      const pageSlugs = pageItems.map((i) => i.slug);
      const isAllPageSelected = pageSlugs.length > 0 && pageSlugs.every((s) => selectedWishlistSlugs.has(s));

      if (isAllPageSelected) {
        pageSlugs.forEach((s) => selectedWishlistSlugs.delete(s));
      } else {
        pageSlugs.forEach((s) => selectedWishlistSlugs.add(s));
      }
      updateActionButtonsText();
      renderWishlistContent();
    });

    const renderCategoryPills = () => {
      if (!pillsContainer) return;
      const categoriesMap: Record<string, number> = {};
      allWishlistItems.forEach((item) => {
        const cat = (item.category || '').trim();
        if (cat) {
          categoriesMap[cat] = (categoriesMap[cat] || 0) + 1;
        }
      });
      const uniqueCats = Object.keys(categoriesMap);

      let pillsHtml = `
        <button
          type="button"
          data-wishlist-filter-cat="all"
          class="shrink-0 px-3 py-1.5 text-xs font-bold uppercase tracking-wider transition-all cursor-pointer ${
            selectedWishlistCategory === 'all'
              ? 'bg-[#173524] text-[#D8B670] border border-[#173524] shadow-xs'
              : 'bg-white text-walnut-800 border border-walnut-900/15 hover:border-walnut-900/40'
          }"
        >
          Tất cả (${allWishlistItems.length})
        </button>
      `;

      uniqueCats.forEach((cat) => {
        const isActive = selectedWishlistCategory.toLowerCase() === cat.toLowerCase();
        pillsHtml += `
          <button
            type="button"
            data-wishlist-filter-cat="${cat}"
            class="shrink-0 px-3 py-1.5 text-xs font-bold uppercase tracking-wider transition-all cursor-pointer ${
              isActive
                ? 'bg-[#173524] text-[#D8B670] border border-[#173524] shadow-xs'
                : 'bg-white text-walnut-800 border border-walnut-900/15 hover:border-walnut-900/40'
            }"
          >
            ${cat} (${categoriesMap[cat]})
          </button>
        `;
      });

      pillsContainer.innerHTML = pillsHtml;

      pillsContainer.querySelectorAll<HTMLButtonElement>('[data-wishlist-filter-cat]').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedWishlistCategory = btn.dataset.wishlistFilterCat || 'all';
          currentWishlistPage = 1;
          renderCategoryPills();
          renderWishlistContent();
        });
      });
    };

    const renderWishlistContent = () => {
      if (!contentEl) return;
      const filtered = getProcessedWishlistItems();

      if (filtered.length === 0) {
        contentEl.className = 'py-12 text-center text-xs text-walnut-800/70 border border-dashed border-walnut-900/20 bg-[#FAF8F5] p-6';
        contentEl.innerHTML = `
          <p class="font-bold text-sm text-walnut-900">Không có sản phẩm nào thuộc danh mục này</p>
          <button type="button" id="btn-reset-wishlist-filter" class="mt-3 text-xs text-[#173524] font-bold underline cursor-pointer">
            Xem tất cả (${allWishlistItems.length})
          </button>
        `;
        if (paginationContainer) {
          paginationContainer.classList.add('hidden');
          paginationContainer.innerHTML = '';
        }
        document.getElementById('btn-reset-wishlist-filter')?.addEventListener('click', () => {
          selectedWishlistCategory = 'all';
          currentWishlistPage = 1;
          renderCategoryPills();
          renderWishlistContent();
        });
        return;
      }

      // Phân trang: 4 sản phẩm / trang
      const totalPages = Math.ceil(filtered.length / WISHLIST_ITEMS_PER_PAGE) || 1;
      if (currentWishlistPage > totalPages) currentWishlistPage = totalPages;
      if (currentWishlistPage < 1) currentWishlistPage = 1;
      const startIndex = (currentWishlistPage - 1) * WISHLIST_ITEMS_PER_PAGE;
      const pageItems = filtered.slice(startIndex, startIndex + WISHLIST_ITEMS_PER_PAGE);

      contentEl.className = 'space-y-3';
      contentEl.innerHTML = pageItems.map((item) => {
        const isOutOfStock = typeof item.stockQuantity === 'number' && item.stockQuantity <= 0;
        const isChecked = selectedWishlistSlugs.has(item.slug);

        return `
          <div
            data-wishlist-card="${item.slug}"
            class="rounded-none border ${isChecked ? 'border-[#173524] bg-[#F7F5F0]' : 'border-walnut-900/15 bg-white hover:border-[#173524]/50'} p-3.5 sm:p-4 shadow-xs transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4"
          >
            <div class="flex items-center gap-3 sm:gap-4 min-w-0">
              ${isWishlistSelectMode ? `
                <div class="shrink-0 flex items-center pr-1">
                  <input
                    type="checkbox"
                    data-wishlist-checkbox="${item.slug}"
                    ${isChecked ? 'checked' : ''}
                    class="w-4 h-4 text-[#173524] border-walnut-900/30 rounded-none focus:ring-0 focus:outline-none cursor-pointer accent-[#173524]"
                  />
                </div>
              ` : ''}

              <!-- Thumbnail -->
              <a href="/san-pham/${item.slug}" class="relative shrink-0 w-20 h-20 sm:w-24 sm:h-24 bg-[#FAF8F5] border border-walnut-900/10 overflow-hidden group">
                <img
                  src="${item.thumbnail || '/images/products/placeholder.jpg'}"
                  alt="${item.name}"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>

              <!-- Info -->
              <div class="min-w-0 space-y-1">
                ${item.category ? `
                  <span class="text-[9.5px] font-bold uppercase tracking-wider text-[#B88E28]">
                    ${item.category}
                  </span>
                ` : ''}
                <h3 class="font-bold text-xs sm:text-sm text-walnut-900 line-clamp-1 hover:text-[#173524]">
                  <a href="/san-pham/${item.slug}">${item.name}</a>
                </h3>
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-bold text-xs sm:text-sm text-[#B88E28]">${fmtVnd(item.price)}</span>
                  ${item.comparePrice && item.comparePrice > item.price ? `
                    <span class="text-[11px] text-neutral-400 line-through">${fmtVnd(item.comparePrice)}</span>
                  ` : ''}
                  <span class="text-[10px] font-semibold px-2 py-0.5 ${isOutOfStock ? 'bg-neutral-100 text-neutral-500' : 'bg-emerald-50 text-emerald-800 border border-emerald-200'}">
                    ${isOutOfStock ? 'Hết hàng' : 'Còn hàng'}
                  </span>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
              <button
                type="button"
                data-add-cart="${item.slug}"
                ${isOutOfStock ? 'disabled' : ''}
                class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-bold uppercase tracking-wider transition-all shadow-xs active:scale-95 cursor-pointer ${
                  isOutOfStock
                    ? 'bg-neutral-200 text-neutral-400 cursor-not-allowed border border-neutral-300'
                    : 'bg-[#D8B670] text-[#173524] hover:bg-[#F3E5AB]'
                }"
              >
                <span>${isOutOfStock ? 'Hết hàng' : 'Thêm giỏ'}</span>
              </button>
              <a
                href="/san-pham/${item.slug}"
                class="border border-walnut-900/15 bg-white hover:bg-sand-100 text-walnut-800 px-3 py-2 text-xs font-medium transition-colors"
                title="Xem chi tiết"
              >
                Xem →
              </a>
              <button
                type="button"
                data-remove-wishlist="${item.slug}"
                data-name="${item.name}"
                class="h-8 w-8 flex items-center justify-center text-neutral-400 hover:text-rose-600 hover:bg-rose-50 border border-walnut-900/10 transition-colors cursor-pointer"
                title="Xóa khỏi yêu thích"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </div>
        `;
      }).join('');

      renderPagination(filtered.length, totalPages, startIndex);
      attachWishlistCardEvents();
    };

    const renderPagination = (totalFiltered: number, totalPages: number, startIndex: number) => {
      if (!paginationContainer) return;

      if (totalFiltered <= WISHLIST_ITEMS_PER_PAGE || totalPages <= 1) {
        paginationContainer.classList.add('hidden');
        paginationContainer.innerHTML = '';
        return;
      }

      paginationContainer.classList.remove('hidden');
      const endIndex = Math.min(startIndex + WISHLIST_ITEMS_PER_PAGE, totalFiltered);

      paginationContainer.innerHTML = `
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-walnut-900/10 text-xs">
          <div class="text-walnut-800/70">
            Hiển thị <span class="font-bold text-walnut-900">${startIndex + 1}</span> - <span class="font-bold text-walnut-900">${endIndex}</span> trong số <span class="font-bold text-walnut-900">${totalFiltered}</span> sản phẩm
          </div>
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              id="btn-wishlist-prev-page"
              ${currentWishlistPage === 1 ? 'disabled' : ''}
              class="px-3 py-1.5 border border-walnut-900/15 bg-white text-walnut-800 hover:bg-sand-100 disabled:opacity-40 disabled:hover:bg-white disabled:cursor-not-allowed font-medium transition-colors cursor-pointer"
            >
              ‹ Trước
            </button>

            ${Array.from({ length: totalPages }, (_, idx) => idx + 1).map((p) => `
              <button
                type="button"
                data-wishlist-page="${p}"
                class="w-8 h-8 flex items-center justify-center font-bold text-xs border transition-colors cursor-pointer ${
                  p === currentWishlistPage
                    ? 'bg-[#173524] text-[#D8B670] border-[#173524] shadow-xs'
                    : 'bg-white hover:bg-sand-100 text-walnut-800 border-walnut-900/15'
                }"
              >
                ${p}
              </button>
            `).join('')}

            <button
              type="button"
              id="btn-wishlist-next-page"
              ${currentWishlistPage === totalPages ? 'disabled' : ''}
              class="px-3 py-1.5 border border-walnut-900/15 bg-white text-walnut-800 hover:bg-sand-100 disabled:opacity-40 disabled:hover:bg-white disabled:cursor-not-allowed font-medium transition-colors cursor-pointer"
            >
              Sau ›
            </button>
          </div>
        </div>
      `;

      document.getElementById('btn-wishlist-prev-page')?.addEventListener('click', () => {
        if (currentWishlistPage > 1) {
          currentWishlistPage--;
          renderWishlistContent();
        }
      });

      document.getElementById('btn-wishlist-next-page')?.addEventListener('click', () => {
        if (currentWishlistPage < totalPages) {
          currentWishlistPage++;
          renderWishlistContent();
        }
      });

      paginationContainer.querySelectorAll<HTMLButtonElement>('[data-wishlist-page]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const p = Number(btn.dataset.wishlistPage);
          if (p && p !== currentWishlistPage) {
            currentWishlistPage = p;
            renderWishlistContent();
          }
        });
      });
    };

    const attachWishlistCardEvents = () => {
      // 0. Checkboxes trong chế độ chọn
      contentEl.querySelectorAll<HTMLInputElement>('[data-wishlist-checkbox]').forEach((chk) => {
        chk.addEventListener('change', () => {
          const slug = chk.dataset.wishlistCheckbox;
          if (!slug) return;
          if (chk.checked) {
            selectedWishlistSlugs.add(slug);
          } else {
            selectedWishlistSlugs.delete(slug);
          }
          updateActionButtonsText();
          const card = chk.closest('[data-wishlist-card]');
          if (card) {
            if (chk.checked) {
              card.classList.add('border-[#173524]', 'bg-[#F7F5F0]');
              card.classList.remove('border-walnut-900/15', 'bg-white');
            } else {
              card.classList.remove('border-[#173524]', 'bg-[#F7F5F0]');
              card.classList.add('border-walnut-900/15', 'bg-white');
            }
          }
        });
      });

      // Click vào card để toggle chọn (nếu đang ở Select Mode)
      if (isWishlistSelectMode) {
        contentEl.querySelectorAll<HTMLDivElement>('[data-wishlist-card]').forEach((card) => {
          card.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target.closest('button') || target.closest('a') || target.closest('input')) return;
            const chk = card.querySelector<HTMLInputElement>('[data-wishlist-checkbox]');
            if (chk) {
              chk.checked = !chk.checked;
              chk.dispatchEvent(new Event('change'));
            }
          });
        });
      }

      // 1. Thêm vào giỏ trên từng thẻ
      contentEl.querySelectorAll<HTMLButtonElement>('[data-add-cart]').forEach((btn) => {
        btn.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          const slug = btn.dataset.addCart;
          const found = allWishlistItems.find((i) => i.slug === slug);
          if (!found) return;

          const res = addToCart({
            slug: found.slug,
            name: found.name,
            price: Number(found.price) || 0,
            thumbnail: found.thumbnail,
            category: found.category,
            maxStock: found.stockQuantity || 99,
          }, 1);

          if (res.success) {
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<span>Đã thêm ✓</span>';
            btn.classList.add('bg-emerald-700', 'text-white');
            btn.classList.remove('bg-[#D8B670]', 'text-[#173524]');
            setTimeout(() => {
              btn.innerHTML = originalContent;
              btn.classList.remove('bg-emerald-700', 'text-white');
              btn.classList.add('bg-[#D8B670]', 'text-[#173524]');
            }, 2000);
            showCartToast(`Đã thêm "${found.name}" vào giỏ hàng!`, 'success');
          } else {
            showCartToast(res.message, 'warning');
          }
        };
      });

      // 2. Xóa khỏi yêu thích
      contentEl.querySelectorAll<HTMLButtonElement>('[data-remove-wishlist]').forEach((btn) => {
        btn.onclick = async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const slug = btn.dataset.removeWishlist;
          const name = btn.dataset.name || 'sản phẩm';
          if (!slug) return;
          btn.disabled = true;

          const card = btn.closest('[data-wishlist-card]');
          if (card) {
            card.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          }

          const token = localStorage.getItem('auth_token');
          if (token) {
            try {
              await fetch(`http://localhost:4000/api/wishlist/${slug}`, {
                method: 'DELETE',
                headers: { Authorization: `Bearer ${token}` },
              });
            } catch (err) {}
          } else {
            let guestList: any[] = [];
            try { guestList = JSON.parse(localStorage.getItem('user_wishlist_guest') || '[]'); } catch {}
            guestList = guestList.filter((i: any) => i.slug !== slug);
            localStorage.setItem('user_wishlist_guest', JSON.stringify(guestList));
          }

          allWishlistItems = allWishlistItems.filter((i) => i.slug !== slug);
          selectedWishlistSlugs.delete(slug);
          window.dispatchEvent(new Event('wishlist:changed'));
          showCartToast(`Đã gỡ "${name}" khỏi yêu thích!`, 'success');

          // Cập nhật badges & UI
          if (sidebarBadge) sidebarBadge.textContent = String(allWishlistItems.length);
          countBadge.textContent = `${allWishlistItems.length} sản phẩm`;

          if (allWishlistItems.length === 0) {
            contentEl.classList.add('hidden');
            toolbarEl?.classList.add('hidden');
            headerActionsEl?.classList.add('hidden');
            paginationContainer?.classList.add('hidden');
            emptyEl.classList.remove('hidden');
          } else {
            updateActionButtonsText();
            renderCategoryPills();
            renderWishlistContent();
          }
        };
      });
    };

    // Bulk Action: Thêm vào giỏ hàng (Toàn bộ hoặc Các mục đã chọn)
    btnAddAll?.addEventListener('click', () => {
      let targetItems = allWishlistItems;
      if (selectedWishlistSlugs.size > 0) {
        targetItems = allWishlistItems.filter((i) => selectedWishlistSlugs.has(i.slug));
      }

      const inStockItems = targetItems.filter((i) => (Number(i.stockQuantity) || 10) > 0);
      if (inStockItems.length === 0) {
        showCartToast('Không có sản phẩm nào còn hàng để thêm vào giỏ.', 'warning');
        return;
      }

      let addedCount = 0;
      inStockItems.forEach((item) => {
        const res = addToCart({
          slug: item.slug,
          name: item.name,
          price: Number(item.price) || 0,
          thumbnail: item.thumbnail,
          category: item.category,
          maxStock: item.stockQuantity || 99,
        }, 1);
        if (res.success) addedCount++;
      });

      if (addedCount > 0) {
        showCartToast(`Đã thêm thành công ${addedCount} sản phẩm vào giỏ hàng!`, 'success');
        // Thoát chế độ chọn sau khi thêm
        if (isWishlistSelectMode) {
          isWishlistSelectMode = false;
          selectedWishlistSlugs.clear();
          if (selectingActionsEl) {
            selectingActionsEl.classList.add('hidden');
            selectingActionsEl.style.display = 'none';
          }
          if (btnStartSelect) {
            btnStartSelect.classList.remove('hidden');
            btnStartSelect.style.display = '';
          }
          renderWishlistContent();
        }
      } else {
        showCartToast('Tất cả sản phẩm đã đạt số lượng tối đa trong giỏ hàng.', 'warning');
      }
    });

    // Bulk Action: Xóa (Dọn sạch toàn bộ HOẶC Xóa các mục đã chọn)
    btnClearAll?.addEventListener('click', () => {
      if (selectedWishlistSlugs.size > 0) {
        itemsToDelete = Array.from(selectedWishlistSlugs);
        if (clearModalTitle) clearModalTitle.textContent = `Xóa ${itemsToDelete.length} sản phẩm đã chọn?`;
        if (clearModalDesc) clearModalDesc.textContent = 'Các sản phẩm đã chọn sẽ được gỡ khỏi bộ sưu tập yêu thích của bạn. Bạn có chắc chắn muốn tiếp tục?';
        if (clearModalConfirmText) clearModalConfirmText.textContent = `Xác nhận xóa (${itemsToDelete.length})`;
      } else {
        itemsToDelete = [];
        if (clearModalTitle) clearModalTitle.textContent = 'Dọn sạch bộ sưu tập yêu thích?';
        if (clearModalDesc) clearModalDesc.textContent = 'Toàn bộ tác phẩm đang được lưu trong danh sách yêu thích của bạn sẽ bị gỡ bỏ. Bạn có chắc chắn muốn tiếp tục?';
        if (clearModalConfirmText) clearModalConfirmText.textContent = 'Dọn sạch tất cả';
      }
      openClearWishlistModal();
    });

    btnConfirmClear?.addEventListener('click', async () => {
      if (btnConfirmClear) btnConfirmClear.disabled = true;
      const token = localStorage.getItem('auth_token');

      if (itemsToDelete.length === 0) {
        // Xóa toàn bộ
        if (token) {
          try {
            await fetch('http://localhost:4000/api/wishlist', {
              method: 'DELETE',
              headers: { Authorization: `Bearer ${token}` },
            });
          } catch (err) {}
        } else {
          localStorage.removeItem('user_wishlist_guest');
        }
        allWishlistItems = [];
        selectedWishlistSlugs.clear();
        isWishlistSelectMode = false;
        showCartToast('Đã dọn sạch bộ sưu tập yêu thích.', 'success');
      } else {
        // Xóa các mục đã chọn
        if (token) {
          try {
            await Promise.all(
              itemsToDelete.map((slug) =>
                fetch(`http://localhost:4000/api/wishlist/${slug}`, {
                  method: 'DELETE',
                  headers: { Authorization: `Bearer ${token}` },
                })
              )
            );
          } catch (err) {}
        } else {
          let guestList: any[] = [];
          try { guestList = JSON.parse(localStorage.getItem('user_wishlist_guest') || '[]'); } catch {}
          guestList = guestList.filter((i: any) => !itemsToDelete.includes(i.slug));
          localStorage.setItem('user_wishlist_guest', JSON.stringify(guestList));
        }

        allWishlistItems = allWishlistItems.filter((i) => !itemsToDelete.includes(i.slug));
        selectedWishlistSlugs.clear();
        showCartToast(`Đã gỡ ${itemsToDelete.length} sản phẩm khỏi yêu thích!`, 'success');
      }

      closeClearWishlistModal();
      if (btnConfirmClear) btnConfirmClear.disabled = false;

      window.dispatchEvent(new Event('wishlist:changed'));

      if (sidebarBadge) sidebarBadge.textContent = String(allWishlistItems.length);
      countBadge.textContent = `${allWishlistItems.length} sản phẩm`;

      if (allWishlistItems.length === 0) {
        isWishlistSelectMode = false;
        selectedWishlistSlugs.clear();
        if (btnStartSelect) {
          btnStartSelect.classList.remove('hidden');
          btnStartSelect.style.display = '';
        }
        if (selectingActionsEl) {
          selectingActionsEl.classList.add('hidden');
          selectingActionsEl.style.display = 'none';
        }
        contentEl.classList.add('hidden');
        toolbarEl?.classList.add('hidden');
        headerActionsEl?.classList.add('hidden');
        paginationContainer?.classList.add('hidden');
        emptyEl.classList.remove('hidden');
      } else {
        updateActionButtonsText();
        renderCategoryPills();
        renderWishlistContent();
      }
    });

    const loadWishlist = async () => {
      const token = localStorage.getItem('auth_token');

      if (token) {
        try {
          const res = await fetch('http://localhost:4000/api/wishlist', {
            headers: { Authorization: `Bearer ${token}` },
          });
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            allWishlistItems = json.data;
          }
        } catch (err) {
          console.warn('Lỗi tải wishlist từ server:', err);
        }
      } else {
        try {
          allWishlistItems = JSON.parse(localStorage.getItem('user_wishlist_guest') || '[]');
        } catch {}
      }

      loadingEl.classList.add('hidden');
      if (sidebarBadge) sidebarBadge.textContent = String(allWishlistItems.length);
      countBadge.textContent = `${allWishlistItems.length} sản phẩm`;

      if (allWishlistItems.length === 0) {
        contentEl.classList.add('hidden');
        toolbarEl?.classList.add('hidden');
        headerActionsEl?.classList.add('hidden');
        paginationContainer?.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        return;
      }

      emptyEl.classList.add('hidden');
      toolbarEl?.classList.remove('hidden');
      headerActionsEl?.classList.remove('hidden');
      contentEl.classList.remove('hidden');

      // Reset selection mode on reload
      isWishlistSelectMode = false;
      selectedWishlistSlugs.clear();
      if (btnStartSelect) {
        btnStartSelect.classList.remove('hidden');
        btnStartSelect.style.display = '';
      }
      if (selectingActionsEl) {
        selectingActionsEl.classList.add('hidden');
        selectingActionsEl.style.display = 'none';
      }

      renderCategoryPills();
      renderWishlistContent();
    };

    loadWishlist();
    window.addEventListener('wishlist:changed', loadWishlist);

    // =========================================================
    // CANCEL ORDER MODAL CONTROLLER
    // =========================================================
    const cancelModalOverlay = document.getElementById('cancel-order-modal-overlay');
    const cancelModalPanel = document.getElementById('cancel-order-modal-panel');
    const cancelModalCloseX = document.getElementById('btn-close-cancel-modal-x');
    const cancelModalDismiss = document.getElementById('btn-dismiss-cancel-modal');
    const cancelOrderForm = document.getElementById('cancel-order-form') as HTMLFormElement | null;
    const cancelOrderIdInput = document.getElementById('cancel-modal-order-id') as HTMLInputElement | null;
    const cancelOrderCodeInput = document.getElementById('cancel-modal-order-code-input') as HTMLInputElement | null;
    const cancelModalOrderCodeText = document.getElementById('cancel-modal-order-code');
    const cancelReasonSelect = document.getElementById('cancel-reason-select') as HTMLSelectElement | null;
    const cancelReasonOtherWrapper = document.getElementById('cancel-reason-other-wrapper');
    const cancelReasonOtherText = document.getElementById('cancel-reason-other-text') as HTMLTextAreaElement | null;
    const cancelModalError = document.getElementById('cancel-modal-error');
    const btnConfirmCancelOrder = document.getElementById('btn-confirm-cancel-order') as HTMLButtonElement | null;

    if (cancelModalOverlay && cancelModalOverlay.parentElement !== document.body) {
      document.body.appendChild(cancelModalOverlay);
    }

    function openCancelOrderModal(orderId: string, orderCode: string) {
      if (!cancelModalOverlay || !cancelModalPanel) return;
      if (cancelModalOverlay.parentElement !== document.body) {
        document.body.appendChild(cancelModalOverlay);
      }
      if (cancelOrderIdInput) cancelOrderIdInput.value = orderId;
      if (cancelOrderCodeInput) cancelOrderCodeInput.value = orderCode;
      if (cancelModalOrderCodeText) cancelModalOrderCodeText.textContent = `#${orderCode}`;
      if (cancelReasonSelect) cancelReasonSelect.value = '';
      if (cancelReasonOtherText) cancelReasonOtherText.value = '';
      if (cancelReasonOtherWrapper) cancelReasonOtherWrapper.classList.add('hidden');
      if (cancelModalError) {
        cancelModalError.classList.add('hidden');
        cancelModalError.textContent = '';
      }

      cancelModalOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        cancelModalOverlay.classList.remove('opacity-0');
        cancelModalOverlay.classList.add('opacity-100');
        cancelModalPanel.classList.remove('opacity-0', 'scale-95');
        cancelModalPanel.classList.add('opacity-100', 'scale-100');
      });
    }

    function closeCancelOrderModal() {
      if (!cancelModalOverlay || !cancelModalPanel) return;
      cancelModalOverlay.classList.remove('opacity-100');
      cancelModalOverlay.classList.add('opacity-0');
      cancelModalPanel.classList.remove('opacity-100', 'scale-100');
      cancelModalPanel.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        cancelModalOverlay.classList.add('hidden');
      }, 250);
    }

    cancelModalCloseX?.addEventListener('click', closeCancelOrderModal);
    cancelModalDismiss?.addEventListener('click', closeCancelOrderModal);
    cancelModalOverlay?.addEventListener('click', (e) => {
      if (e.target === cancelModalOverlay) closeCancelOrderModal();
    });

    cancelReasonSelect?.addEventListener('change', () => {
      if (cancelReasonSelect.value === 'other') {
        cancelReasonOtherWrapper?.classList.remove('hidden');
        cancelReasonOtherText?.focus();
      } else {
        cancelReasonOtherWrapper?.classList.add('hidden');
      }
    });

    cancelOrderForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!cancelOrderIdInput || !btnConfirmCancelOrder) return;

      const orderId = cancelOrderIdInput.value;
      const orderCode = cancelOrderCodeInput?.value || orderId;
      const selectedVal = cancelReasonSelect?.value || '';

      if (!selectedVal) {
        if (cancelModalError) {
          cancelModalError.textContent = 'Vui lòng chọn lý do hủy đơn hàng.';
          cancelModalError.classList.remove('hidden');
        }
        return;
      }

      let finalReason = '';
      if (selectedVal === 'other') {
        const otherText = cancelReasonOtherText?.value.trim() || '';
        if (!otherText) {
          if (cancelModalError) {
            cancelModalError.textContent = 'Vui lòng nhập chi tiết lý do khác của quý khách.';
            cancelModalError.classList.remove('hidden');
          }
          cancelReasonOtherText?.focus();
          return;
        }
        finalReason = otherText;
      } else {
        finalReason = cancelReasonSelect?.options[cancelReasonSelect.selectedIndex]?.text || selectedVal;
      }

      btnConfirmCancelOrder.disabled = true;
      btnConfirmCancelOrder.textContent = 'Đang xử lý hủy...';
      if (cancelModalError) cancelModalError.classList.add('hidden');

      try {
        const token = localStorage.getItem('auth_token');
        const res = await fetch(`http://localhost:4000/api/orders/${encodeURIComponent(orderId)}/cancel`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
          },
          body: JSON.stringify({ reason: finalReason }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          closeCancelOrderModal();
          // Đóng modal chi tiết nếu đang mở
          closePanel();
          alert(`Đã hủy thành công đơn hàng #${orderCode}.`);
          await loadOrdersData();
        } else {
          if (cancelModalError) {
            cancelModalError.textContent = data.message || 'Không thể hủy đơn hàng vào lúc này. Vui lòng thử lại sau.';
            cancelModalError.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        if (cancelModalError) {
          cancelModalError.textContent = 'Lỗi kết nối máy chủ khi gửi yêu cầu hủy đơn.';
          cancelModalError.classList.remove('hidden');
        }
      } finally {
        btnConfirmCancelOrder.disabled = false;
        btnConfirmCancelOrder.textContent = 'Xác nhận hủy đơn';
      }
    });

    // =========================================================
    // QUẢN LÝ SỔ ĐỊA CHỈ NHẬN HÀNG (CRUD USER ADDRESSES)
    // =========================================================
    const addrContainer = document.getElementById('address-list-container');
    const addrBadge = document.getElementById('sidebar-addresses-badge');
    const addrModalOverlay = document.getElementById('address-modal-overlay');
    const addrModalPanel = document.getElementById('address-modal-panel');
    const addrModalTitle = document.getElementById('address-modal-title');
    const btnOpenAddAddr = document.getElementById('btn-open-add-address');
    const btnCloseAddrModal = document.getElementById('btn-close-address-modal');
    const btnCancelAddr = document.getElementById('btn-cancel-address');
    const addrForm = document.getElementById('address-form') as HTMLFormElement | null;
    const addrInputId = document.getElementById('addr-id') as HTMLInputElement | null;
    const addrInputName = document.getElementById('addr-receiver-name') as HTMLInputElement | null;
    const addrInputPhone = document.getElementById('addr-receiver-phone') as HTMLInputElement | null;
    const addrSelectProvince = document.getElementById('addr-province') as HTMLSelectElement | null;
    const addrInputDistrict = document.getElementById('addr-district') as HTMLInputElement | null;
    const addrInputSpecific = document.getElementById('addr-specific') as HTMLInputElement | null;
    const addrInputDefault = document.getElementById('addr-is-default') as HTMLInputElement | null;
    const addrError = document.getElementById('addr-error');
    const btnSaveAddr = document.getElementById('btn-save-address') as HTMLButtonElement | null;

    let userAddresses: any[] = [];

    const openAddressModal = (mode: 'add' | 'edit', addrData?: any) => {
      if (!addrModalOverlay || !addrModalPanel) return;
      if (addrError) addrError.classList.add('hidden');

      if (mode === 'add') {
        if (addrModalTitle) addrModalTitle.textContent = 'Thêm địa chỉ nhận hàng';
        if (addrInputId) addrInputId.value = '';
        if (addrInputName) addrInputName.value = fullUser.name || name || '';
        const rawPhone = (fullUser.phone && fullUser.phone !== 'Chưa cập nhật' && fullUser.phone !== 'Đăng nhập Google') ? fullUser.phone : '';
        if (addrInputPhone) addrInputPhone.value = rawPhone;
        if (addrSelectProvince) addrSelectProvince.value = '';
        if (addrInputDistrict) addrInputDistrict.value = '';
        if (addrInputSpecific) addrInputSpecific.value = '';
        if (addrInputDefault) addrInputDefault.checked = userAddresses.length === 0;
      } else if (addrData) {
        if (addrModalTitle) addrModalTitle.textContent = 'Chỉnh sửa địa chỉ nhận hàng';
        if (addrInputId) addrInputId.value = String(addrData.id);
        if (addrInputName) addrInputName.value = addrData.receiverName || '';
        if (addrInputPhone) addrInputPhone.value = addrData.receiverPhone || '';
        if (addrSelectProvince) addrSelectProvince.value = addrData.province || '';
        if (addrInputDistrict) addrInputDistrict.value = addrData.district || '';
        if (addrInputSpecific) addrInputSpecific.value = addrData.specificAddress || '';
        if (addrInputDefault) addrInputDefault.checked = Boolean(addrData.isDefault);
      }

      addrModalOverlay.classList.remove('hidden');
      requestAnimationFrame(() => {
        addrModalOverlay.classList.remove('opacity-0');
        addrModalOverlay.classList.add('opacity-100');
        addrModalPanel.classList.remove('opacity-0', 'scale-95');
        addrModalPanel.classList.add('opacity-100', 'scale-100');
      });
      addrInputName?.focus();
    };

    const closeAddressModal = () => {
      if (!addrModalOverlay || !addrModalPanel) return;
      addrModalOverlay.classList.remove('opacity-100');
      addrModalOverlay.classList.add('opacity-0');
      addrModalPanel.classList.remove('opacity-100', 'scale-100');
      addrModalPanel.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        addrModalOverlay.classList.add('hidden');
      }, 250);
    };

    btnOpenAddAddr?.addEventListener('click', () => openAddressModal('add'));
    btnCloseAddrModal?.addEventListener('click', closeAddressModal);
    btnCancelAddr?.addEventListener('click', closeAddressModal);
    addrModalOverlay?.addEventListener('click', (e) => {
      if (e.target === addrModalOverlay) closeAddressModal();
    });

    const renderAddresses = () => {
      if (!addrContainer) return;
      if (addrBadge) addrBadge.textContent = String(userAddresses.length);

      if (userAddresses.length === 0) {
        addrContainer.innerHTML = `
          <div class="p-8 text-center border border-dashed border-walnut-900/20 bg-sand-50/50">
            <span class="text-3xl block mb-2">📍</span>
            <p class="text-xs font-bold text-walnut-900 uppercase tracking-wider">Chưa có địa chỉ nhận hàng nào</p>
            <p class="text-[11px] text-walnut-800/70 mt-1 max-w-sm mx-auto">Thêm địa chỉ giao hàng để hệ thống tự động điền khi bạn đặt mua sản phẩm nội thất.</p>
            <button type="button" class="btn-quick-add-addr mt-3.5 inline-flex items-center gap-1.5 bg-[#173524] text-[#D8B670] px-4 py-2 text-xs font-bold uppercase tracking-wider hover:bg-walnut-900 border border-[#D8B670]/40 transition-colors cursor-pointer shadow-xs">
              + Thêm địa chỉ đầu tiên
            </button>
          </div>
        `;
        addrContainer.querySelector('.btn-quick-add-addr')?.addEventListener('click', () => openAddressModal('add'));
        return;
      }

      addrContainer.innerHTML = userAddresses.map((addr) => `
        <div class="rounded-none border ${addr.isDefault ? 'border-2 border-[#173524] bg-[#FAF8F5]' : 'border border-walnut-900/15 bg-white'} p-4 sm:p-5 relative space-y-2 hover:shadow-xs transition-shadow">
          <div class="flex items-start justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-bold text-xs uppercase tracking-wider text-walnut-900 flex items-center gap-1.5">
                ${addr.isDefault ? '<span class="w-2 h-2 rounded-full bg-emerald-600 shrink-0"></span>' : ''}
                <span>${addr.receiverName}</span>
              </span>
              <span class="text-xs text-walnut-800/40">|</span>
              <span class="text-xs font-mono font-semibold text-walnut-800">${addr.receiverPhone}</span>
              ${addr.isDefault ? '<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider">Mặc định</span>' : ''}
            </div>
            <div class="flex items-center gap-2 text-xs">
              ${!addr.isDefault ? `<button type="button" data-set-default="${addr.id}" class="text-xs text-[#173524] hover:underline font-semibold cursor-pointer">Thiết lập mặc định</button><span class="text-walnut-900/20">|</span>` : ''}
              <button type="button" data-edit-addr="${addr.id}" class="text-xs text-amber-700 hover:text-amber-900 font-semibold cursor-pointer">Sửa</button>
              <span class="text-walnut-900/20">|</span>
              <button type="button" data-delete-addr="${addr.id}" class="text-xs text-rose-600 hover:text-rose-800 font-semibold cursor-pointer">Xóa</button>
            </div>
          </div>
          <p class="text-xs text-walnut-800/90 leading-relaxed font-medium">
            ${addr.fullAddress}
          </p>
        </div>
      `).join('');

      addrContainer.querySelectorAll<HTMLButtonElement>('[data-edit-addr]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = Number(btn.dataset.editAddr);
          const found = userAddresses.find((a) => a.id === id);
          if (found) openAddressModal('edit', found);
        });
      });

      addrContainer.querySelectorAll<HTMLButtonElement>('[data-delete-addr]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = Number(btn.dataset.deleteAddr);
          if (!confirm('Bạn có chắc chắn muốn xóa địa chỉ nhận hàng này?')) return;
          try {
            const token = localStorage.getItem('auth_token');
            const res = await fetch(`http://localhost:4000/api/user-addresses/${id}`, {
              method: 'DELETE',
              headers: { Authorization: `Bearer ${token}` },
            });
            const json = await res.json();
            if (json.success) {
              await loadAddresses();
            } else {
              alert(json.message || 'Không thể xóa địa chỉ.');
            }
          } catch (e: any) {
            alert('Lỗi kết nối máy chủ khi xóa địa chỉ.');
          }
        });
      });

      addrContainer.querySelectorAll<HTMLButtonElement>('[data-set-default]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = Number(btn.dataset.setDefault);
          try {
            const token = localStorage.getItem('auth_token');
            const res = await fetch(`http://localhost:4000/api/user-addresses/${id}/default`, {
              method: 'PATCH',
              headers: { Authorization: `Bearer ${token}` },
            });
            const json = await res.json();
            if (json.success) {
              await loadAddresses();
            } else {
              alert(json.message || 'Không thể đặt địa chỉ mặc định.');
            }
          } catch (e: any) {
            alert('Lỗi kết nối máy chủ.');
          }
        });
      });
    };

    const loadAddresses = async () => {
      const token = localStorage.getItem('auth_token');
      if (!token) return;
      try {
        const res = await fetch('http://localhost:4000/api/user-addresses', {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (res.ok) {
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            userAddresses = json.data;
            renderAddresses();
          }
        }
      } catch (err) {
        console.warn('Lỗi tải danh sách địa chỉ:', err);
      }
    };

    addrForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = localStorage.getItem('auth_token');
      if (!token) return;

      const id = addrInputId?.value ? Number(addrInputId.value) : null;
      const payload = {
        receiver_name: addrInputName?.value?.trim() || '',
        receiver_phone: addrInputPhone?.value?.trim() || '',
        province: addrSelectProvince?.value || '',
        district: addrInputDistrict?.value?.trim() || '',
        specific_address: addrInputSpecific?.value?.trim() || '',
        is_default: addrInputDefault?.checked || false,
      };

      if (btnSaveAddr) {
        btnSaveAddr.disabled = true;
        btnSaveAddr.textContent = 'Đang lưu...';
      }
      if (addrError) addrError.classList.add('hidden');

      try {
        const url = id
          ? `http://localhost:4000/api/user-addresses/${id}`
          : 'http://localhost:4000/api/user-addresses';
        const method = id ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify(payload),
        });

        const json = await res.json();
        if (json.success) {
          closeAddressModal();
          await loadAddresses();
        } else {
          if (addrError) {
            addrError.textContent = json.message || 'Không thể lưu địa chỉ.';
            addrError.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        if (addrError) {
          addrError.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
          addrError.classList.remove('hidden');
        }
      } finally {
        if (btnSaveAddr) {
          btnSaveAddr.disabled = false;
          btnSaveAddr.textContent = 'Lưu địa chỉ';
        }
      }
    });

    loadAddresses();


    // =========================================================
    // XỬ LÝ CHỈNH SỬA THÔNG TIN CÁ NHÂN & LƯU LÊN DATABASE
    // =========================================================
    const btnToggleEdit = document.getElementById('btn-toggle-edit-profile') as HTMLButtonElement | null;
    const btnCancelEdit = document.getElementById('btn-cancel-edit-profile') as HTMLButtonElement | null;
    const btnEditText = document.getElementById('btn-edit-text');
    const viewMode = document.getElementById('profile-view-mode');
    const formEdit = document.getElementById('form-edit-profile') as HTMLFormElement | null;
    const inputEditName = document.getElementById('input-edit-name') as HTMLInputElement | null;
    const inputEditPhone = document.getElementById('input-edit-phone') as HTMLInputElement | null;
    const inputEditEmail = document.getElementById('input-edit-email') as HTMLInputElement | null;
    const inputEditTier = document.getElementById('input-edit-tier') as HTMLInputElement | null;
    const profileEditMsg = document.getElementById('profile-edit-msg');
    const btnSaveProfile = document.getElementById('btn-save-profile') as HTMLButtonElement | null;

    let isEditingProfile = false;

    const setEditMode = (editing: boolean) => {
      isEditingProfile = editing;
      if (viewMode && formEdit) {
        viewMode.classList.toggle('hidden', editing);
        formEdit.classList.toggle('hidden', !editing);
      }
      if (btnEditText) {
        btnEditText.textContent = editing ? 'Đang sửa...' : 'Chỉnh sửa';
      }
      if (profileEditMsg) profileEditMsg.classList.add('hidden');

      if (editing) {
        if (inputEditName) inputEditName.value = fullUser.name || name || '';
        const rawPhone = (fullUser.phone && fullUser.phone !== 'Chưa cập nhật' && fullUser.phone !== 'Đăng nhập Google') ? fullUser.phone : '';
        if (inputEditPhone) inputEditPhone.value = rawPhone;
        if (inputEditEmail) inputEditEmail.value = fullUser.email || email || '';
        if (inputEditTier) inputEditTier.value = fullUser.tier || tier || '';
        inputEditName?.focus();
      }
    };

    btnToggleEdit?.addEventListener('click', () => {
      setEditMode(!isEditingProfile);
    });

    btnCancelEdit?.addEventListener('click', () => {
      setEditMode(false);
    });

    if (formEdit) {
      formEdit.addEventListener('submit', async (e) => {
        e.preventDefault();
        const newName = inputEditName?.value?.trim() || '';
        const newPhone = inputEditPhone?.value?.trim() || '';

        const showProfileMsg = (text: string, isError: boolean) => {
          if (!profileEditMsg) return;
          profileEditMsg.textContent = text;
          profileEditMsg.className = isError
            ? 'text-xs py-2.5 px-3.5 rounded-none font-medium bg-red-50 text-red-700 border border-red-200'
            : 'text-xs py-2.5 px-3.5 rounded-none font-medium bg-emerald-50 text-emerald-700 border border-emerald-200';
          profileEditMsg.classList.remove('hidden');
        };

        if (!newName) {
          showProfileMsg('Vui lòng nhập họ và tên của quý khách.', true);
          return;
        }

        const token = localStorage.getItem('auth_token');
        if (!token) {
          showProfileMsg('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại để cập nhật.', true);
          return;
        }

        if (btnSaveProfile) {
          btnSaveProfile.disabled = true;
          btnSaveProfile.innerHTML = `
            <svg class="animate-spin w-3.5 h-3.5 mr-1" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
            <span>Đang lưu lên hệ thống...</span>
          `;
        }

        try {
          const res = await fetch('http://localhost:4000/api/auth/profile', {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({
              full_name: newName,
              phone: newPhone
            })
          });

          const data = await res.json();
          if (res.ok && data.success && data.user) {
            showProfileMsg('Đã cập nhật thông tin cá nhân lên cơ sở dữ liệu thành công!', false);

            // Cập nhật fullUser & localStorage
            fullUser.name = data.user.full_name;
            fullUser.phone = data.user.phone;
            localStorage.setItem('current_user', JSON.stringify(fullUser));

            // Đồng bộ luôn vào admin_user nếu tài khoản có quyền quản trị
            try {
              const adminRaw = localStorage.getItem('admin_user');
              if (adminRaw) {
                const au = JSON.parse(adminRaw);
                au.name = data.user.full_name;
                au.phone = data.user.phone;
                localStorage.setItem('admin_user', JSON.stringify(au));
              }
            } catch {}

            // Cập nhật DOM View Mode
            if (infoName) infoName.textContent = data.user.full_name;
            if (infoPhone) infoPhone.textContent = data.user.phone;

            // Cập nhật DOM Sidebar
            if (elName) elName.textContent = data.user.full_name;
            if (elAvatar && !fullUser.avatar) {
              const initials = data.user.full_name.split(' ').map((n: string) => n[0]).slice(-2).join('');
              elAvatar.textContent = initials || 'KH';
            }

            // Cập nhật DOM Tab Địa chỉ
            if (addrName) addrName.textContent = data.user.full_name;
            if (addrPhone) addrPhone.textContent = data.user.phone;

            // Phát event auth:changed để Header đồng bộ ngay lập tức
            window.dispatchEvent(new Event('auth:changed'));

            // Tự động đóng edit mode sau 1 giây
            setTimeout(() => {
              setEditMode(false);
            }, 1000);
          } else {
            showProfileMsg(data.message || 'Không thể lưu thông tin. Vui lòng thử lại.', true);
          }
        } catch (err: any) {
          showProfileMsg('Lỗi kết nối máy chủ khi lưu thông tin. Vui lòng kiểm tra lại.', true);
        } finally {
          if (btnSaveProfile) {
            btnSaveProfile.disabled = false;
            btnSaveProfile.innerHTML = `
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <span>Lưu thay đổi</span>
            `;
          }
        }
      });
    }

    // =========================================================
    // XỬ LÝ ĐỔI MẬT KHẨU
    // =========================================================
    const formChangePass = document.getElementById('form-change-password') as HTMLFormElement | null;
    const msgEl = document.getElementById('change-pass-msg');
    const btnSubmitPass = document.getElementById('btn-submit-change-pass') as HTMLButtonElement | null;

    // Toggle password eye
    document.querySelectorAll<HTMLButtonElement>('[data-toggle-password]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.dataset.togglePassword;
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement | null;
        if (input) {
          if (input.type === 'password') {
            input.type = 'text';
            btn.textContent = '🙈';
          } else {
            input.type = 'password';
            btn.textContent = '👁️';
          }
        }
      });
    });

    if (formChangePass) {
      formChangePass.addEventListener('submit', async (e) => {
        e.preventDefault();
        const oldPass = (document.getElementById('input-old-password') as HTMLInputElement | null)?.value || '';
        const newPass = (document.getElementById('input-new-password') as HTMLInputElement | null)?.value || '';
        const confirmPass = (document.getElementById('input-confirm-password') as HTMLInputElement | null)?.value || '';

        const showMsg = (text: string, isError: boolean) => {
          if (!msgEl) return;
          msgEl.textContent = text;
          msgEl.className = isError 
            ? 'text-xs py-2.5 px-3.5 rounded-none font-medium bg-red-50 text-red-700 border border-red-200' 
            : 'text-xs py-2.5 px-3.5 rounded-none font-medium bg-emerald-50 text-emerald-700 border border-emerald-200';
          msgEl.classList.remove('hidden');
        };

        if (!newPass || newPass.length < 6) {
          showMsg('Mật khẩu mới phải có ít nhất 6 ký tự.', true);
          return;
        }

        if (newPass !== confirmPass) {
          showMsg('Xác nhận mật khẩu mới không khớp, vui lòng nhập lại chính xác.', true);
          return;
        }

        const token = localStorage.getItem('auth_token');
        if (!token) {
          showMsg('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.', true);
          return;
        }

        if (btnSubmitPass) {
          btnSubmitPass.disabled = true;
          btnSubmitPass.textContent = 'Đang xử lý...';
        }

        try {
          const res = await fetch('http://localhost:4000/api/auth/change-password', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({
              oldPassword: oldPass,
              newPassword: newPass
            })
          });

          const data = await res.json();
          if (res.ok && data.success) {
            showMsg(data.message || 'Đổi mật khẩu thành công! Bạn có thể sử dụng mật khẩu mới.', false);
            formChangePass.reset();
          } else {
            showMsg(data.message || 'Mật khẩu hiện tại không chính xác.', true);
          }
        } catch (err: any) {
          showMsg('Không thể kết nối đến máy chủ. Vui lòng thử lại sau ít phút.', true);
        } finally {
          if (btnSubmitPass) {
            btnSubmitPass.disabled = false;
            btnSubmitPass.innerHTML = `
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Lưu mật khẩu mới</span>
            `;
          }
        }
      });
    }

    // =========================================================
    // TAB SWITCHING
    // =========================================================
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-page-tab]');
    const switchTab = (tabName: string) => {
      tabBtns.forEach((b) => {
        const isMatch = b.dataset.pageTab === tabName;
        b.classList.toggle('is-active', isMatch);
        if (!isMatch) {
          b.className = 'page-tab-btn w-full flex items-center justify-between px-4 py-3 text-xs font-semibold uppercase tracking-wider rounded-none transition-all duration-150 cursor-pointer text-left text-walnut-800/80 hover:bg-sand-100';
        } else {
          b.className = 'page-tab-btn w-full flex items-center justify-between px-4 py-3 text-xs font-semibold uppercase tracking-wider rounded-none transition-all duration-150 cursor-pointer text-left is-active';
        }
      });

      document.querySelectorAll<HTMLElement>('.page-tab-pane').forEach((pane) => {
        pane.classList.toggle('hidden', pane.id !== `page-pane-${tabName}`);
      });
    };

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.pageTab;
        if (tab) switchTab(tab);
      });
    });

    // Logout
    document.querySelectorAll<HTMLElement>('[data-logout]').forEach((btn) => {
      btn.addEventListener('click', () => {
        import('../../scripts/auth').then(({ clearUser }) => {
          clearUser();
          window.location.href = '/';
        });
      });
    });

    // Tự động tải lại trang nếu tài khoản đăng nhập thay đổi ở tab khác để tránh nhầm lẫn phiên
    window.addEventListener('storage', (e: StorageEvent) => {
      if (e.key === 'current_user' || e.key === 'auth_token') {
        const currentUserRaw = localStorage.getItem('current_user');
        if (!currentUserRaw) {
          window.location.href = '/dang-nhap';
          return;
        }
        try {
          const newUser = JSON.parse(currentUserRaw);
          if (newUser.email && newUser.email !== fullUser.email) {
            window.location.reload();
          }
        } catch {}
      }
    });

    let activeTabTarget = requestedTab || (!user ? 'orders' : 'profile');
    if (activeTabTarget === 'address' || activeTabTarget === 'addresses' || activeTabTarget === 'dia-chi') {
      activeTabTarget = 'addresses';
    }
    if (activeTabTarget === 'voucher' || activeTabTarget === 'vouchers' || activeTabTarget === 'kho-voucher') {
      activeTabTarget = 'vouchers';
    }
    if (activeTabTarget === 'order' || activeTabTarget === 'orders' || activeTabTarget === 'don-hang') {
      activeTabTarget = 'orders';
    }
    switchTab(activeTabTarget);

    if (requestedTab) {
      const targetPane = document.getElementById(`page-pane-${activeTabTarget}`);
      if (targetPane && window.innerWidth < 1024) {
        targetPane.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }
</script>
