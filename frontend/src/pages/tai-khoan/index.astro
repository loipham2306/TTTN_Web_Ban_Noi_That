          <p class="font-display italic text-xs text-walnut-800/80 mt-0.5 leading-relaxed">
            Thông tin tư gia dùng để điều phối kỹ thuật viên giao hàng & lắp đặt tận nơi.
          </p>
        </div>

        <!-- Form -->
        <form id="address-form" class="space-y-3.5">
          <input type="hidden" id="addr-id" value="" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label class="block text-[10.5px] font-bold uppercase tracking-wider text-walnut-800 mb-1">
