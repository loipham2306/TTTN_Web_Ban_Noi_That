              </label>
              <select
                id="addr-province"
                required
                class="w-full border border-walnut-900/20 bg-white/95 px-3 py-2 text-xs text-walnut-900 outline-none focus:border-[#173524] shadow-2xs rounded-none transition-colors"
              >
                <option value="">-- Chọn tỉnh/thành --</option>
                {provinces.map((p) => <option value={p}>{p}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-[10.5px] font-bold uppercase tracking-wider text-walnut-800 mb-1">
                Quận / Huyện <span class="text-rose-600">*</span>
              </label>
              <input
                type="text"
                id="addr-district"
                required
                class="w-full border border-walnut-900/20 bg-white/95 px-3 py-2 text-xs text-walnut-900 outline-none focus:border-[#173524] shadow-2xs rounded-none transition-colors"
              />
            </div>
          </div>

          <div>
            <label class="block text-[10.5px] font-bold uppercase tracking-wider text-walnut-800 mb-1">
              Địa chỉ cụ thể <span class="text-rose-600">*</span>
            </label>
            <input
              type="text"
              id="addr-specific"
              required
              placeholder="Số nhà, tên đường, phường/xã"
              class="w-full border border-walnut-900/20 bg-white/95 px-3 py-2 text-xs text-walnut-900 outline-none focus:border-[#173524] shadow-2xs rounded-none transition-colors"
            />
          </div>

          <div class="pt-0.5">
            <label class="inline-flex items-center gap-2 cursor-pointer select-none">
              <input
                type="checkbox"
                id="addr-is-default"
                class="h-4 w-4 rounded-none border-walnut-900/30 text-[#173524] focus:ring-0 cursor-pointer"
              />
              <span class="text-xs text-walnut-900 font-medium">Đặt làm địa chỉ nhận hàng mặc định</span>
            </label>
          </div>

          <div id="addr-error" class="hidden text-xs text-rose-600 font-medium"></div>

          <!-- Action bar trên nền xanh (Thoáng đãng, gọn gàng, không vướng dòng bảo mật) -->
          <div class="mt-5 -mx-4 -mb-4 sm:-mx-6 sm:-mb-6 md:-mx-7 md:-mb-6 px-4 sm:px-6 md:px-7 py-3.5 sm:py-4 bg-[#173524] border-t border-[#D8B670]/40">
            <div class="flex items-center gap-2.5 sm:gap-3">
              <button
                type="button"
                id="btn-cancel-address"
