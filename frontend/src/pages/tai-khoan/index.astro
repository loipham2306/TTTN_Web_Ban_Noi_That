              >
                <span>Hủy bỏ</span>
              </button>

              <button
                type="submit"
                id="btn-save-address"
                class="flex-1 flex items-center justify-center gap-1 sm:gap-1.5 rounded-none bg-gradient-to-r from-[#D8B670] via-[#E2C37E] to-[#C49E52] py-2.5 px-3 text-[11px] sm:text-xs uppercase tracking-normal text-[#173524] font-bold shadow-md hover:from-[#C49E52] hover:to-[#B58F43] hover:text-white transition-all cursor-pointer border border-[#E0C582]/50 text-center"
              >
                <span>Lưu địa chỉ</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
