---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
---

<BaseLayout 
  title="Tài Khoản & Trung Tâm Khách Hàng | Nội Thất Cao Cấp"
  description="Quản lý hồ sơ cá nhân, theo dõi trạng thái đơn hàng, kho voucher ưu đãi và danh sách sản phẩm yêu thích của bạn."
>

  <!-- =====================================================
       BANNER ĐẦU TRANG ĐỒNG NHẤT (PAGE BANNER)
       ===================================================== -->
  <PageBanner
    position="tai-khoan"
    fallbackTitle="Trung Tâm Khách Hàng & Quản Lý Tài Khoản"
    fallbackSubtitle="Đặc quyền hội viên & Quản lý đơn hàng tiện lợi"
    fallbackDescription="Theo dõi tiến độ giao nhận đơn hàng, xem lịch sử mua sắm, tích lũy điểm thưởng thăng hạng thành viên và quản lý thông tin bảo mật an toàn 24/7."
    fallbackImage="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1920&q=80"
    breadcrumbs={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Tài khoản cá nhân' }
    ]}
    badgeText="Hội Viên Thân Thiết"
    badgePulse={false}
  />

  <!-- =====================================================
       MAIN CONTENT: 2-COLUMN BENTO DASHBOARD
       ===================================================== -->
  <section class="mx-auto max-w-7xl px-4 py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">

      <!-- ===================================================
           CỘT TRÁI: SIDEBAR THÔNG TIN & MENU ĐIỀU HƯỚNG (4 CỘT)
           =================================================== -->
      <aside class="lg:col-span-4 flex flex-col justify-between h-full space-y-6 lg:space-y-0">

        <!-- Card Khách Hàng Tóm Tắt (Walnut & Gold Accent) -->
        <div class="rounded-none border border-walnut-900/15 bg-white shadow-md overflow-hidden text-walnut-900 flex-shrink-0">
          
          <!-- Header Banner của Card -->
          <div class="relative bg-[#173524] p-6 text-sand-50 border-b border-[#D8B670]/30 overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-[#D8B670] via-[#F3E5AB] to-[#C49E52]"></div>
            <div class="absolute -right-6 -bottom-6 w-32 h-32 rounded-full bg-[#D8B670]/10 pointer-events-none"></div>

            <div class="flex items-center gap-4 relative z-10">
              <!-- Avatar -->
              <div 
                id="page-user-avatar" 
                class="h-16 w-16 rounded-full bg-[#173524] text-[#E6CA85] font-bold text-2xl flex items-center justify-center border-2 border-[#D8B670] shadow-md overflow-hidden shrink-0"
              >
                KH
              </div>

              <!-- Tên & Email -->
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <h1 id="page-user-name" class="text-lg sm:text-xl font-display font-bold tracking-tight text-white truncate">
                    Khách Hàng
                  </h1>
                </div>
                <p id="page-user-email" class="text-xs text-[#E6CA85]/90 mt-0.5 font-mono truncate">
                  khach@noithat.vn
                </p>
                <div class="mt-2">
                  <span 
                    id="page-user-tier-badge" 
                    class="inline-block bg-[#D8B670]/20 text-[#F3E5AB] border border-[#D8B670]/50 px-2.5 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded-none"
                  >
                    Hội Viên Thân Thiết
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Loyalty Tier Bar (Thanh tiến độ hạng hội viên) -->
          <div class="p-4 bg-[#FAF8F5] border-b border-walnut-900/10 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="font-semibold text-walnut-800">Cấp bậc tích lũy:</span>
              <span id="tier-progress-text" class="font-bold text-[#173524]">Hạng Bạc</span>
            </div>
            <!-- Progress Track -->
            <div class="w-full h-2 bg-sand-200/80 rounded-full overflow-hidden">
              <div id="tier-progress-bar" class="h-full bg-gradient-to-r from-[#173524] to-[#D8B670] transition-all duration-700 w-[20%]"></div>
            </div>
            <p id="tier-next-hint" class="text-[11px] text-walnut-800/70">
              Tích lũy thêm chi tiêu để nâng hạng <strong class="text-clay-700">Vàng (VIP)</strong> nhận voucher 10%.
            </p>
          </div>

          <!-- Nút Admin (Chỉ hiện khi là Admin/Staff) -->
          <div id="page-admin-box" class="hidden p-3 bg-amber-50/80 border-b border-amber-200/60">
            <a 
              href="/admin" 
              class="w-full flex items-center justify-center gap-2 text-xs font-bold text-amber-900 bg-amber-200/60 hover:bg-amber-200 border border-amber-400/50 py-2 transition-colors uppercase tracking-wider"
            >
              <svg class="w-4 h-4 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>Vào trang quản trị (Admin)</span>
            </a>
          </div>

          <!-- Menu Danh Mục Điều Hướng Dọc -->
          <nav class="p-2 space-y-1">
            <button 
              type="button" 
              data-page-tab="profile" 
              class="page-tab-btn w-full flex items-center justify-between px-4 py-3 text-xs font-semibold uppercase tracking-wider rounded-none transition-all duration-150 cursor-pointer text-left is-active"
            >
              <span class="flex items-center gap-3">
                <svg class="w-4 h-4 text-inherit" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <span>Hồ sơ & Đổi mật khẩu</span>
              </span>
              <svg class="w-3.5 h-3.5 opacity-40 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>

            <button 
              type="button" 
              data-page-tab="orders" 
              class="page-tab-btn w-full flex items-center justify-between px-4 py-3 text-xs font-semibold uppercase tracking-wider rounded-none transition-all duration-150 cursor-pointer text-left text-walnut-800/80 hover:bg-sand-100"
            >
              <span class="flex items-center gap-3">
                <svg class="w-4 h-4 text-inherit" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
                <span>Đơn hàng của tôi</span>
              </span>
              <span id="sidebar-orders-badge" class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-[#173524]/10 text-[#173524]">0</span>
            </button>

            <button 
              type="button" 
              data-page-tab="vouchers" 
              class="page-tab-btn w-full flex items-center justify-between px-4 py-3 text-xs font-semibold uppercase tracking-wider rounded-none transition-all duration-150 cursor-pointer text-left text-walnut-800/80 hover:bg-sand-100"
            >
              <span class="flex items-center gap-3">
                <svg class="w-4 h-4 text-inherit" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                </svg>
                <span>Ví Voucher & Ưu đãi</span>
              </span>
              <span class="px-2 py-0.5 text-[10px] font-bold rounded-none bg-amber-100 text-amber-800 uppercase">Hot</span>
            </button>

            <button 
              type="button" 
              data-page-tab="wishlist" 
              class="page-tab-btn w-full flex items-center justify-between px-4 py-3 text-xs font-semibold uppercase tracking-wider rounded-none transition-all duration-150 cursor-pointer text-left text-walnut-800/80 hover:bg-sand-100"
            >
              <span class="flex items-center gap-3">
                <svg class="w-4 h-4 text-inherit" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                <span>Sản phẩm yêu thích</span>
              </span>
              <span id="sidebar-wishlist-badge" class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-sand-200 text-walnut-900">0</span>
            </button>

            <button 
              type="button" 
              data-page-tab="addresses" 
              class="page-tab-btn w-full flex items-center justify-between px-4 py-3 text-xs font-semibold uppercase tracking-wider rounded-none transition-all duration-150 cursor-pointer text-left text-walnut-800/80 hover:bg-sand-100"
            >
              <span class="flex items-center gap-3">
                <svg class="w-4 h-4 text-inherit" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span>Sổ địa chỉ nhận hàng</span>
              </span>
              <svg class="w-3.5 h-3.5 opacity-40 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </nav>

          <!-- Nút Đăng Xuất -->
          <div class="p-3 border-t border-walnut-900/10 bg-sand-50/50">
            <button 
              type="button" 
              data-logout 
              class="w-full flex items-center justify-center gap-2 px-4 py-2.5 text-xs uppercase tracking-wider font-bold text-red-600 hover:text-white bg-red-50 hover:bg-red-600 border border-red-200 hover:border-red-600 transition-all duration-200 cursor-pointer rounded-none"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              <span>Đăng xuất tài khoản</span>
            </button>
          </div>

        </div>

        <!-- Trợ Giúp & Chăm Sóc Khách Hàng (Tự động mở rộng chiều cao bằng card bên phải) -->
        <div class="rounded-none border border-walnut-900/10 bg-[#FAF8F5] p-5 flex flex-col justify-between shadow-xs lg:mt-6 flex-1">
          <div class="space-y-3">
            <h4 class="font-bold text-xs uppercase tracking-wider text-walnut-900 flex items-center gap-2">
              <svg class="w-4 h-4 text-[#173524]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
              <span>Hỗ trợ quý khách</span>
            </h4>
            <p class="text-xs text-walnut-800/80 leading-relaxed">
              Cần hỗ trợ tra cứu đơn hoặc thay đổi địa chỉ nhận hàng? Liên hệ chuyên viên tư vấn cao cấp:
            </p>
          </div>
          <div class="pt-3 border-t border-walnut-900/10 mt-4">
            <a href="tel:1900636884" class="text-xs font-bold text-[#173524] hover:text-[#D8B670] transition-colors flex items-center gap-2">
              <span>📞 Hotline: 1900 636 884</span>
            </a>
            <p class="text-[11px] text-walnut-800/60 mt-0.5">Thời gian: 08:30 - 21:00 (Cả T7 & CN)</p>
          </div>
        </div>

      </aside>

      <!-- ===================================================
           CỘT PHẢI: KHỐI NỘI DUNG CHÍNH THEO TAB (8 CỘT)
           =================================================== -->
      <main class="lg:col-span-8 space-y-6 flex flex-col justify-between h-full">

        <!-- =================================================
             TAB 1: HỒ SƠ CÁ NHÂN & ĐỔI MẬT KHẨU
             ================================================= -->
        <div id="page-pane-profile" class="page-tab-pane space-y-6 flex-1 flex flex-col justify-between">
          
          <!-- Thống Kê Nhanh (3 Bento Cards) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="rounded-none border border-walnut-900/15 bg-white p-5 shadow-xs hover:border-[#173524]/50 transition-colors">
              <span class="text-[10px] font-bold uppercase tracking-wider text-walnut-800/60 block">Tổng chi tiêu</span>
              <p id="page-info-spent" class="text-xl font-bold font-mono text-[#173524] mt-1">0 ₫</p>
              <span class="text-[11px] text-emerald-700 font-medium mt-1 inline-flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                Tích lũy trọn đời
              </span>
            </div>

            <div class="rounded-none border border-walnut-900/15 bg-white p-5 shadow-xs hover:border-[#173524]/50 transition-colors">
              <span class="text-[10px] font-bold uppercase tracking-wider text-walnut-800/60 block">Đơn hoàn thành</span>
              <p id="page-info-orders" class="text-xl font-bold font-mono text-clay-700 mt-1">0 đơn hàng</p>
              <span class="text-[11px] text-walnut-800/70 mt-1 block">Giao thành công</span>
            </div>

            <div class="rounded-none border border-walnut-900/15 bg-white p-5 shadow-xs hover:border-[#173524]/50 transition-colors">
              <span class="text-[10px] font-bold uppercase tracking-wider text-walnut-800/60 block">Bảo mật tài khoản</span>
              <p class="text-base font-bold text-emerald-700 mt-1 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                Đã xác thực
              </p>
              <span class="text-[11px] text-walnut-800/70 mt-1 block">Mã hóa mật khẩu Bcrypt</span>
            </div>
          </div>

          <!-- Card Chi Tiết Hồ Sơ -->
          <div class="rounded-none border border-walnut-900/15 bg-white shadow-sm overflow-hidden">
            <div class="bg-[#F0EBE3] px-6 py-4 border-b border-walnut-900/10 flex items-center justify-between flex-wrap gap-2">
              <h2 class="font-bold text-sm uppercase tracking-wide text-walnut-900 flex items-center gap-2">
                <svg class="w-4 h-4 text-[#173524]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/>
                </svg>
                <span>Thông tin tài khoản</span>
              </h2>

              <!-- Nút Sửa Đổi Thông Tin Cá Nhân -->
              <button 
                type="button" 
                id="btn-toggle-edit-profile" 
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider bg-white hover:bg-[#173524] text-[#173524] hover:text-[#E6CA85] border border-walnut-900/20 hover:border-[#173524] transition-all cursor-pointer shadow-xs rounded-none"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                <span id="btn-edit-text">Chỉnh sửa</span>
              </button>
            </div>

            <!-- CHẾ ĐỘ XEM (VIEW MODE) -->
            <div id="profile-view-mode" class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="space-y-1">
                <label class="text-[11px] font-bold uppercase tracking-wider text-walnut-800/60 block">Họ và tên</label>
                <div class="p-3 bg-sand-50/70 border border-walnut-900/10 text-sm font-bold text-walnut-900" id="page-info-name">
                  --
                </div>
              </div>

              <div class="space-y-1">
                <label class="text-[11px] font-bold uppercase tracking-wider text-walnut-800/60 block">Địa chỉ Email</label>
                <div class="p-3 bg-sand-50/70 border border-walnut-900/10 text-sm font-semibold font-mono text-walnut-900 truncate" id="page-info-email">
                  Chưa cập nhật
                </div>
              </div>

              <div class="space-y-1">
                <label class="text-[11px] font-bold uppercase tracking-wider text-walnut-800/60 block">Số điện thoại</label>
                <div class="p-3 bg-sand-50/70 border border-walnut-900/10 text-sm font-semibold font-mono text-walnut-900" id="page-info-phone">
                  Chưa cập nhật
                </div>
              </div>

              <div class="space-y-1">
                <label class="text-[11px] font-bold uppercase tracking-wider text-walnut-800/60 block">Cấp bậc khách hàng</label>
                <div class="p-3 bg-sand-50/70 border border-walnut-900/10 text-sm font-bold text-clay-700" id="page-info-tier">
                  Hội Viên Thân Thiết
                </div>
              </div>
            </div>

            <!-- CHẾ ĐỘ CHỈNH SỬA (EDIT MODE - Ban đầu ẩn) -->
            <form id="form-edit-profile" class="hidden p-6 space-y-4 bg-sand-50/40 border-t border-walnut-900/5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="input-edit-name" class="block text-xs font-bold text-walnut-900 mb-1.5">
                    Họ và tên <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="input-edit-name" 
                    required 
                    placeholder="Nhập họ và tên đầy đủ..." 
                    class="w-full border border-walnut-900/25 bg-white px-3.5 py-2.5 text-xs text-walnut-900 font-semibold outline-none transition-colors focus:border-[#173524] focus:ring-1 focus:ring-[#173524]"
                  />
                </div>

                <div>
                  <label for="input-edit-phone" class="block text-xs font-bold text-walnut-900 mb-1.5">
                    Số điện thoại
                  </label>
                  <input 
                    type="tel" 
                    id="input-edit-phone" 
                    placeholder="Ví dụ: 0912345678..." 
                    class="w-full border border-walnut-900/25 bg-white px-3.5 py-2.5 text-xs text-walnut-900 font-mono outline-none transition-colors focus:border-[#173524] focus:ring-1 focus:ring-[#173524]"
                  />
                </div>

                <div>
                  <label class="block text-xs font-bold text-walnut-800/60 mb-1.5">
                    Email đăng nhập <span class="text-[10px] text-walnut-800/50 font-normal">(Cố định không sửa)</span>
                  </label>
                  <input 
                    type="email" 
                    id="input-edit-email" 
                    disabled 
                    class="w-full border border-walnut-900/10 bg-sand-200/50 px-3.5 py-2.5 text-xs text-walnut-800/70 font-mono cursor-not-allowed select-none"
                  />
                </div>

                <div>
                  <label class="block text-xs font-bold text-walnut-800/60 mb-1.5">
                    Cấp bậc thành viên <span class="text-[10px] text-walnut-800/50 font-normal">(Tự động theo chi tiêu)</span>
                  </label>
                  <input 
                    type="text" 
                    id="input-edit-tier" 
                    disabled 
                    class="w-full border border-walnut-900/10 bg-sand-200/50 px-3.5 py-2.5 text-xs text-clay-700 font-bold cursor-not-allowed select-none"
                  />
                </div>
              </div>

              <!-- Thông báo kết quả lưu -->
              <div id="profile-edit-msg" class="hidden text-xs py-2.5 px-3.5 rounded-none font-medium"></div>

              <!-- Hàng nút Lưu & Hủy -->
              <div class="flex items-center gap-3 pt-2">
                <button 
                  type="submit" 
                  id="btn-save-profile" 
                  class="bg-[#173524] text-[#E6CA85] border border-[#D8B670]/50 hover:bg-[#204932] hover:text-white px-5 py-2 text-xs uppercase tracking-wider font-bold transition-all shadow-xs cursor-pointer inline-flex items-center gap-2 rounded-none"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
