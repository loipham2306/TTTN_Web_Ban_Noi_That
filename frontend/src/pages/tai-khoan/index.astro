        type="button"
        id="btn-close-cancel-modal-x"
        class="absolute right-3 top-3 sm:right-4 sm:top-4 z-20 flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-sand-200/90 text-walnut-800 border border-walnut-900/10 shadow-sm hover:bg-walnut-900 hover:text-amber-300 hover:rotate-90 transition-all duration-300 cursor-pointer"
        aria-label="Đóng hủy đơn hàng"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="h-4 w-4 pointer-events-none">
          <path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div class="relative z-10 flex flex-col">
        <!-- Header -->
        <div class="pr-10 mb-3.5">
          <span class="inline-block px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.25em] bg-[#173524]/90 text-amber-300 border border-amber-300/30 backdrop-blur-xs shadow-sm mb-1.5">
