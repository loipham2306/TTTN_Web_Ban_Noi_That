    role="dialog"
    aria-modal="true"
  >
    <div
      id="address-modal-panel"
      class="relative my-4 sm:my-8 w-full max-w-xl overflow-hidden rounded-none bg-sand-50 p-4 sm:p-6 md:px-7 md:py-6 shadow-2xl border border-walnut-900/15 transition-all duration-300 scale-95 opacity-0 max-h-[92vh] overflow-y-auto luxury-scrollbar"
