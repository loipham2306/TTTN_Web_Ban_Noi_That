---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Đăng nhập tài khoản | Nội Thất" description="Đăng nhập vào tài khoản Nội Thất để quản lý đơn hàng và nhận ưu đãi độc quyền.">

  <section class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">

      <div class="hidden bg-walnut-900 p-10 text-sand-50 lg:flex lg:flex-col lg:justify-between rounded shadow-sm">
        <p class="text-lg uppercase tracking-[0.32em]">NỘI THẤT CAO CẤP</p>
        <div>
          <p class="font-display text-3xl leading-snug">Không gian sống đẳng cấp bắt đầu từ những lựa chọn chỉn chu.</p>
          <p class="mt-6 text-sm text-sand-200/80 leading-relaxed">Lưu sản phẩm yêu thích, theo dõi đơn hàng vận chuyển và nhận ưu đãi giảm giá dành riêng cho thành viên.</p>
        </div>
        <div class="pt-6 border-t border-sand-50/15 text-xs text-sand-200/60">
          Hệ thống bảo mật dữ liệu khách hàng theo chuẩn Enterprise.
        </div>
      </div>

      <div class="max-w-md">
        <h1 class="font-display text-3xl tracking-tight sm:text-4xl text-walnut-900">Đăng nhập</h1>
        <p class="mt-2 text-sm text-walnut-800/80">Nhập email và mật khẩu của bạn để tiếp tục.</p>

        <!-- Nút Đăng nhập nhanh bằng Gmail -->
        <div class="mt-6 flex flex-col items-center gap-2">
          <!-- Vùng hiển thị nút chính thức của Google SDK khi có Client ID -->
          <div id="google-btn-official" class="w-full flex justify-center"></div>

          <!-- Nút bấm hiển thị mặc định hoặc dự phòng -->
          <button
            type="button"
            id="btn-google-login"
            class="flex w-full items-center justify-center gap-3 border border-walnut-900/20 bg-sand-50 py-3 text-xs uppercase tracking-[0.15em] font-medium text-walnut-900 transition-all hover:bg-sand-100 hover:border-walnut-900 shadow-sm cursor-pointer"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
            </svg>
            <span>Đăng nhập nhanh bằng Gmail</span>
          </button>
        </div>

        <div class="my-6 flex items-center gap-3">
          <div class="h-px flex-1 bg-walnut-900/15"></div>
          <span class="text-[10px] uppercase tracking-widest text-walnut-800/60">HOẶC DÙNG TÀI KHOẢN</span>
          <div class="h-px flex-1 bg-walnut-900/15"></div>
        </div>

        <!-- CẢNH BÁO NỔI BẬT TRỰC TIẾP TRÊN FORM (RÕ NÉT, KHÔNG BỊ CHE BỞI CÁC NÚT NỔI) -->
        <div id="login-alert-banner" class="hidden mb-5 rounded-lg border border-red-300 bg-red-50 p-4 text-xs text-red-900 shadow-sm transition-all duration-300">
          <div class="flex items-start gap-3">
            <svg class="h-5 w-5 text-red-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div class="flex-1">
              <p id="alert-banner-title" class="font-bold text-red-950 uppercase tracking-wider text-[11px]">Yêu cầu quyền Quản trị viên</p>
              <p id="alert-banner-desc" class="mt-1 text-red-800 leading-relaxed text-xs">Khu vực Quản trị yêu cầu đăng nhập tài khoản Quản trị viên (Admin).</p>
            </div>
          </div>
        </div>

        <form id="login-form" novalidate class="flex flex-col gap-4">
          <div>
            <label for="login-email" class="block text-[11px] uppercase tracking-[0.2em] text-walnut-800">Email *</label>
            <input id="login-email" name="email" type="email" required placeholder="an.nguyen@gmail.com" autocomplete="email" class="mt-1.5 w-full border border-walnut-900/20 bg-sand-50 px-4 py-2.5 text-sm outline-none transition-colors focus:border-clay-600 focus:bg-sand-100/30" />
          </div>

          <div>
            <div class="flex items-center justify-between">
              <label for="login-password" class="block text-[11px] uppercase tracking-[0.2em] text-walnut-800">Mật khẩu *</label>
              <a href="#" class="text-[11px] text-walnut-800/70 hover:underline">Quên mật khẩu?</a>
            </div>
            <input id="login-password" name="password" type="password" required autocomplete="current-password" placeholder="Nhập mật khẩu" class="mt-1.5 w-full border border-walnut-900/20 bg-sand-50 px-4 py-2.5 text-sm outline-none transition-colors focus:border-clay-600 focus:bg-sand-100/30" />
          </div>

          <button 
            type="submit" 
            class="mt-3 bg-clay-600 px-8 py-3.5 text-xs uppercase tracking-[0.2em] font-semibold text-sand-50 transition-colors hover:bg-clay-500 shadow-sm cursor-pointer"
          >
            Đăng nhập
          </button>
        </form>


        <p class="mt-6 text-xs text-walnut-800 text-center">
          Chưa có tài khoản?
          <a href="/dang-ky" class="font-bold text-walnut-900 underline underline-offset-4 transition-colors hover:text-clay-600">Đăng ký ngay</a>
        </p>
      </div>

    </div>
  </section>

  <!-- TOAST THÔNG BÁO NỔI Ở PHÍA TRÊN BÊN PHẢI (TRÁNH BỊ CÁC NÚT ZALO / AI Ở GÓC DƯỚI CHE) -->
  <div id="auth-toast" class="fixed top-6 right-6 z-[9999] hidden -translate-y-4 rounded-lg bg-walnut-900 px-6 py-4 text-xs font-medium text-sand-50 shadow-2xl transition-all duration-300 border border-sand-50/20 max-w-sm">
    <div class="flex items-start gap-3">
      <div id="toast-icon-wrap" class="shrink-0 mt-0.5">
        <svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p id="toast-title" class="font-bold uppercase tracking-wider text-sand-50 mb-0.5">Thông báo</p>
        <p id="toast-body" class="text-sand-200 leading-relaxed">Đăng nhập thành công! Đang chuyển về Trang chủ...</p>
      </div>
    </div>
  </div>

</BaseLayout>

<!-- Tải thư viện Google Identity Services (GSI) -->
<script is:inline src="https://accounts.google.com/gsi/client" async defer></script>

<script>
  import { mergeGuestCartOnLogin } from '../../scripts/cart';
  // =========================================================================
  // 1. CẤU HÌNH GOOGLE CLIENT ID
  // 👉 DÁN MÃ CÓ ĐUÔI ".apps.googleusercontent.com" VÀO GIỮA 2 DẤU "" DƯỚI ĐÂY:
  // =========================================================================
  const MANUAL_CLIENT_ID = "288589640244-4uhsc02mcfqitebqct2nhpgghpu70cv9.apps.googleusercontent.com"; // <-- DÁN CLIENT ID VÀO ĐÂY (KHÔNG DÙNG GOCSPX)

  const ENV_CLIENT_ID = (import.meta as any).env?.PUBLIC_GOOGLE_CLIENT_ID;
  const GOOGLE_CLIENT_ID = 
    MANUAL_CLIENT_ID && MANUAL_CLIENT_ID.trim() !== ""
      ? MANUAL_CLIENT_ID.trim()
      : (ENV_CLIENT_ID && !ENV_CLIENT_ID.includes("DÁN_") ? ENV_CLIENT_ID.trim() : "");

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('login-form') as HTMLFormElement;
    const emailInput = document.getElementById('login-email') as HTMLInputElement;
    const passInput = document.getElementById('login-password') as HTMLInputElement;
    const btnGoogle = document.getElementById('btn-google-login') as HTMLButtonElement;
    const googleOfficialContainer = document.getElementById('google-btn-official') as HTMLElement;

    const alertBanner = document.getElementById('login-alert-banner') as HTMLElement;
    const alertTitle = document.getElementById('alert-banner-title') as HTMLElement;
    const alertDesc = document.getElementById('alert-banner-desc') as HTMLElement;

    const toast = document.getElementById('auth-toast') as HTMLElement;
    const toastBody = document.getElementById('toast-body') as HTMLElement;
    const toastTitle = document.getElementById('toast-title') as HTMLElement;
    const iconWrap = document.getElementById('toast-icon-wrap') as HTMLElement;

    const showAlertBanner = (title: string, desc: string) => {
      if (alertBanner && alertTitle && alertDesc) {
        alertTitle.textContent = title;
        alertDesc.textContent = desc;
        alertBanner.classList.remove('hidden');
      }
    };

    const showToast = (msg: string, isError = false) => {
      if (toastBody) toastBody.textContent = msg;

      if (toastTitle) {
        toastTitle.textContent = isError ? 'Cảnh báo bảo mật' : 'Thông báo';
      }

      if (iconWrap) {
        iconWrap.innerHTML = isError
          ? `<svg class="h-4 w-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`
          : `<svg class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>`;
      }

      if (toast) {
        toast.className = `fixed top-6 right-6 z-[9999] rounded-lg px-6 py-4 text-xs font-medium shadow-2xl transition-all duration-300 border max-w-sm ${
          isError ? 'bg-red-950 border-red-500 shadow-red-950/50 text-red-50' : 'bg-walnut-900 border-emerald-500/50 shadow-walnut-950/50 text-sand-50'
        }`;
        toast.classList.remove('hidden');
        requestAnimationFrame(() => toast.classList.remove('-translate-y-4'));

        setTimeout(() => {
          toast.classList.add('-translate-y-4');
          setTimeout(() => toast.classList.add('hidden'), 300);
        }, 5000);
      }
    };

    // Hàm giải mã JWT Token từ Google gửi về để lấy họ tên, email, ảnh avatar
    function parseJwt(token: string) {
      try {
        const base64Url = token.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        const jsonPayload = decodeURIComponent(
          atob(base64)
            .split('')
            .map((c) => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2))
            .join('')
        );
        return JSON.parse(jsonPayload);
      } catch (err) {
        console.error('Lỗi giải mã token Google:', err);
        return null;
      }
    }

    // Xử lý sau khi người dùng chọn tài khoản Google đăng nhập thành công
    async function handleGoogleLoginSuccess(response: any) {
      if (!response || !response.credential) {
        showToast('Không nhận được dữ liệu xác thực từ Google.', true);
        return;
      }

      const payload = parseJwt(response.credential);
      if (!payload || !payload.email) {
        showToast('Lỗi đọc thông tin từ tài khoản Google.', true);
        return;
      }

      // Thông tin lấy trực tiếp từ Google thực tế
      const googleUser = {
        name: payload.name || payload.email.split('@')[0],
        email: payload.email,
        avatar: payload.picture || '',
        phone: 'Đăng nhập Google',
        tier: 'Vàng',
        spent: '0 ₫',
        orders: 0,
        date: new Date().toLocaleDateString('vi-VN'),
        status: 'Hoạt động',
      };

      // 1. Gửi lên Backend để xác thực và lấy Token an toàn
      try {
        const res = await fetch('http://localhost:4000/api/auth/google', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: googleUser.email,
            fullname: googleUser.name,
            avatar_url: googleUser.avatar,
          }),
        });

        const data = await res.json();
        if (data.success && data.token) {
          localStorage.setItem('auth_token', data.token);
          if (data.user) {
            googleUser.role = data.user.role;
          }
        }
      } catch (e) {
        console.warn('Lỗi kết nối Backend Google Auth:', e);
      }

      // 2. Lưu phiên người dùng hiện tại đang đăng nhập
      localStorage.setItem('current_user', JSON.stringify(googleUser));
      try { mergeGuestCartOnLogin(); } catch {}
      window.dispatchEvent(new Event('auth:changed'));

      showToast(`Xin chào ${googleUser.name}! Đăng nhập Google thành công.`);
      setTimeout(() => {
        const urlParams = new URLSearchParams(window.location.search);
        const redirect = urlParams.get('redirect');
        if (redirect) {
          window.location.href = redirect;
        } else if (googleUser.role === 'admin' || googleUser.role === 'seller') {
          window.location.href = '/admin';
        } else {
          window.location.href = '/';
        }
      }, 1000);
    }

    // Khởi tạo thư viện Google Identity Services
    function setupGoogleButton() {
      const google = (window as any).google;
      if (!google || !google.accounts) return;

      if (GOOGLE_CLIENT_ID && GOOGLE_CLIENT_ID.trim() !== '') {
        // Cấu hình Google Client
        google.accounts.id.initialize({
          client_id: GOOGLE_CLIENT_ID.trim(),
          callback: handleGoogleLoginSuccess,
          auto_select: false,
          cancel_on_tap_outside: true,
        });

        // Tạo nút đăng nhập Google chuẩn giao diện
        if (googleOfficialContainer) {
          google.accounts.id.renderButton(googleOfficialContainer, {
            theme: 'outline',
            size: 'large',
            width: 380,
            text: 'continue_with',
            locale: 'vi',
            shape: 'rectangular',
          });
          // Ẩn nút dự phòng khi đã nạp được nút Google chính thức
          if (btnGoogle) {
            btnGoogle.style.display = 'none';
          }
        }
      }
    }

    // Kiểm tra thông báo từ URL (Ví dụ chuyển hướng do chưa có quyền Admin)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('error') === 'admin_required') {
      showAlertBanner(
        'Yêu cầu quyền Quản trị viên',
        'Khu vực Quản trị yêu cầu đăng nhập tài khoản Quản trị viên (Admin).'
      );
      showToast('Khu vực Quản trị yêu cầu đăng nhập tài khoản Quản trị viên (Admin).', true);
    } else if (urlParams.get('registered') === '1') {
      showToast('Đăng ký tài khoản thành công! Vui lòng đăng nhập.');
    }

    // Kiểm tra định kỳ để tải SDK Google
    let attempts = 0;
    const interval = setInterval(() => {
      attempts++;
      if ((window as any).google?.accounts?.id) {
        clearInterval(interval);
        setupGoogleButton();
      } else if (attempts >= 25) {
        clearInterval(interval);
      }
    }, 200);

    // Xử lý nút bấm dự phòng Google
    btnGoogle?.addEventListener('click', () => {
      const google = (window as any).google;
      if (GOOGLE_CLIENT_ID && GOOGLE_CLIENT_ID.trim() !== '' && google?.accounts?.id) {
        google.accounts.id.prompt();
      } else {
        showToast('Vui lòng sử dụng biểu mẫu đăng nhập bên dưới.');
      }
    });

    // SUBMIT LOGIN THÔNG THƯỜNG (EMAIL & MẬT KHẨU) - XÁC THỰC BẢO MẬT BACKEND
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = emailInput.value.trim();
      const password = passInput.value;

      if (!email || !password) {
        showAlertBanner('Thiếu thông tin đăng nhập', 'Vui lòng nhập đầy đủ email và mật khẩu.');
        showToast('Vui lòng nhập đầy đủ email và mật khẩu.', true);
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang xác thực...';
      }

      try {
        const res = await fetch('http://localhost:4000/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          const errMsg = data.message || 'Email hoặc mật khẩu không chính xác.';
          showAlertBanner('Đăng nhập không thành công', errMsg);
          showToast(errMsg, true);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Đăng nhập';
          }
          return;
        }

        // Lưu JWT Token và thông tin User an toàn vào Client
        if (data.token) {
          localStorage.setItem('auth_token', data.token);
        }

        const loggedInUser = {
          id: data.user.id,
          name: data.user.full_name || email.split('@')[0],
          email: data.user.email,
          phone: data.user.phone || 'Chưa cập nhật',
          role: data.user.role || 'customer',
        };

        localStorage.setItem('current_user', JSON.stringify(loggedInUser));
        try { mergeGuestCartOnLogin(); } catch {}
        window.dispatchEvent(new Event('auth:changed'));

        showToast(`Đăng nhập thành công! Xin chào ${loggedInUser.name}`);

        setTimeout(() => {
          const redirect = urlParams.get('redirect');
          if (redirect) {
            window.location.href = redirect;
          } else if (loggedInUser.role === 'admin' || loggedInUser.role === 'seller') {
            window.location.href = '/admin';
          } else {
            window.location.href = '/';
          }
        }, 800);
      } catch (err: any) {
        console.error('Lỗi khi đăng nhập:', err);
        showToast('Không thể kết nối đến máy chủ Backend. Vui lòng thử lại sau.', true);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Đăng nhập';
        }
      }
    });
  });
</script>
