---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Đăng nhập | Nội Thất" description="Đăng nhập vào tài khoản Nội Thất.">

  <section class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">

      <div class="hidden bg-walnut-900 p-10 text-sand-50 lg:flex lg:flex-col lg:justify-between">
        <p class="text-lg uppercase tracking-[0.32em]">Nội Thất</p>
        <div>
          <p class="font-display text-2xl leading-snug">Không gian sống đẳng cấp bắt đầu từ những lựa chọn chỉn chu.</p>
          <p class="mt-6 text-sm text-sand-200">Lưu sản phẩm yêu thích, theo dõi đơn hàng và nhận ưu đãi dành riêng cho thành viên.</p>
        </div>
      </div>

      <div class="max-w-md">
        <h1 class="font-display text-3xl tracking-tight sm:text-4xl">Đăng nhập</h1>
        <p class="mt-3 text-sm text-walnut-800">Nhập email và mật khẩu để tiếp tục.</p>

        <form data-auth-form novalidate class="mt-8 flex flex-col gap-5">
          <div>
            <label for="login-email" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Email</label>
            <input id="login-email" name="email" type="email" autocomplete="email" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
            <p data-error-for="email" class="mt-2 hidden text-xs text-danger-600"></p>
          </div>

          <div>
            <label for="login-password" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Mật khẩu</label>
            <input id="login-password" name="password" type="password" autocomplete="current-password" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
            <p data-error-for="password" class="mt-2 hidden text-xs text-danger-600"></p>
          </div>

          <button type="submit" class="mt-2 bg-clay-600 px-8 py-4 text-xs uppercase tracking-[0.2em] text-sand-50 transition-colors hover:bg-clay-500">
            Đăng nhập
          </button>
        </form>

        <div data-auth-success class="mt-8 hidden border border-walnut-900/15 p-8">
          <p class="font-display text-xl">Đăng nhập thành công</p>
          <p class="mt-3 text-sm leading-relaxed text-walnut-800">Biểu mẫu đã hợp lệ. Phần xác thực thật sẽ được nối khi có API máy chủ.</p>
          <a href="/san-pham" class="mt-6 inline-block border border-walnut-900 px-6 py-3 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:bg-walnut-900 hover:text-sand-50">Tiếp tục mua sắm</a>
        </div>

        <p class="mt-8 text-sm text-walnut-800">
          Chưa có tài khoản?
          <a href="/dang-ky" class="text-walnut-900 underline underline-offset-4 transition-colors hover:text-clay-600">Đăng ký ngay</a>
        </p>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  import { initAuthForm, required, email, minLength } from '../../scripts/validate';

  const form = document.querySelector<HTMLFormElement>('[data-auth-form]');
  const success = document.querySelector<HTMLElement>('[data-auth-success]');

  if (form) {
    initAuthForm(
      form,
      {
        email: [required('Vui lòng nhập email.'), email('Email chưa đúng định dạng.')],
        password: [required('Vui lòng nhập mật khẩu.'), minLength(8, 'Mật khẩu cần ít nhất 8 ký tự.')],
      },
      () => {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      }
    );
  }
</script>
