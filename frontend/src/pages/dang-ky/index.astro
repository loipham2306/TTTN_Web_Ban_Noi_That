---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Đăng ký | Nội Thất" description="Tạo tài khoản Nội Thất để theo dõi đơn hàng và nhận ưu đãi.">

  <section class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">

      <div class="hidden bg-walnut-900 p-10 text-sand-50 lg:flex lg:flex-col lg:justify-between">
        <p class="text-lg uppercase tracking-[0.32em]">Nội Thất</p>
        <div>
          <p class="font-display text-2xl leading-snug">Trở thành thành viên để nhận bộ sưu tập mới sớm nhất.</p>
          <p class="mt-6 text-sm text-sand-200">Ưu đãi riêng, tư vấn theo không gian và hỗ trợ đổi trả thuận tiện.</p>
        </div>
      </div>

      <div class="max-w-md">
        <h1 class="font-display text-3xl tracking-tight sm:text-4xl">Đăng ký</h1>
        <p class="mt-3 text-sm text-walnut-800">Điền thông tin bên dưới để tạo tài khoản.</p>

        <form data-auth-form novalidate class="mt-8 flex flex-col gap-5">
          <div>
            <label for="reg-name" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Họ và tên</label>
            <input id="reg-name" name="fullname" type="text" autocomplete="name" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
            <p data-error-for="fullname" class="mt-2 hidden text-xs text-danger-600"></p>
          </div>

          <div>
            <label for="reg-email" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Email</label>
            <input id="reg-email" name="email" type="email" autocomplete="email" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
            <p data-error-for="email" class="mt-2 hidden text-xs text-danger-600"></p>
          </div>

          <div>
            <label for="reg-phone" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Số điện thoại</label>
            <input id="reg-phone" name="phone" type="tel" autocomplete="tel" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
            <p data-error-for="phone" class="mt-2 hidden text-xs text-danger-600"></p>
          </div>

          <div>
            <label for="reg-password" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Mật khẩu</label>
            <input id="reg-password" name="password" type="password" autocomplete="new-password" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
            <p data-error-for="password" class="mt-2 hidden text-xs text-danger-600"></p>
          </div>

          <div>
            <label for="reg-confirm" class="text-[11px] uppercase tracking-[0.2em] text-walnut-800">Xác nhận mật khẩu</label>
            <input id="reg-confirm" name="confirm" type="password" autocomplete="new-password" class="mt-2 w-full border border-walnut-900/20 bg-transparent px-4 py-3 text-sm outline-none transition-colors focus:border-clay-600" />
            <p data-error-for="confirm" class="mt-2 hidden text-xs text-danger-600"></p>
          </div>

          <div class="flex items-start gap-3">
            <input id="reg-terms" name="terms" type="checkbox" class="mt-0.5 h-4 w-4 accent-[#333333]" />
            <label for="reg-terms" class="text-sm text-walnut-800">
              Tôi đồng ý với điều khoản sử dụng và chính sách bảo mật.
            </label>
          </div>
          <p data-error-for="terms" class="hidden text-xs text-danger-600"></p>

          <button type="submit" class="mt-2 bg-clay-600 px-8 py-4 text-xs uppercase tracking-[0.2em] text-sand-50 transition-colors hover:bg-clay-500">
            Tạo tài khoản
          </button>
        </form>

        <div data-auth-success class="mt-8 hidden border border-walnut-900/15 p-8">
          <p class="font-display text-xl">Đăng ký thành công</p>
          <p class="mt-3 text-sm leading-relaxed text-walnut-800">Biểu mẫu đã hợp lệ. Phần tạo tài khoản thật sẽ được nối khi có API máy chủ.</p>
          <a href="/dang-nhap" class="mt-6 inline-block border border-walnut-900 px-6 py-3 text-xs uppercase tracking-[0.2em] text-walnut-900 transition-colors hover:bg-walnut-900 hover:text-sand-50">Đi tới đăng nhập</a>
        </div>

        <p class="mt-8 text-sm text-walnut-800">
          Đã có tài khoản?
          <a href="/dang-nhap" class="text-walnut-900 underline underline-offset-4 transition-colors hover:text-clay-600">Đăng nhập</a>
        </p>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  import { initAuthForm, required, email, phone, minLength, matches, accepted } from '../../scripts/validate';

  const form = document.querySelector<HTMLFormElement>('[data-auth-form]');
  const success = document.querySelector<HTMLElement>('[data-auth-success]');

  if (form) {
    initAuthForm(
      form,
      {
        fullname: [required('Vui lòng nhập họ và tên.'), minLength(2, 'Họ và tên cần ít nhất 2 ký tự.')],
        email: [required('Vui lòng nhập email.'), email('Email chưa đúng định dạng.')],
        phone: [required('Vui lòng nhập số điện thoại.'), phone('Số điện thoại chưa hợp lệ (ví dụ 0912345678).')],
        password: [required('Vui lòng nhập mật khẩu.'), minLength(8, 'Mật khẩu cần ít nhất 8 ký tự.')],
        confirm: [required('Vui lòng xác nhận mật khẩu.'), matches('password', 'Mật khẩu xác nhận không khớp.')],
        terms: [accepted('terms', 'Bạn cần đồng ý điều khoản để tiếp tục.')],
      },
      () => {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      }
    );
  }
</script>
