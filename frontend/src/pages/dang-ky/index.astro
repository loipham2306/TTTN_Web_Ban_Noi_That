---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Đăng ký tài khoản | Nội Thất" description="Tạo tài khoản Nội Thất để theo dõi đơn hàng và nhận ưu đãi độc quyền.">

  <section class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">

      <div class="hidden bg-walnut-900 p-10 text-sand-50 lg:flex lg:flex-col lg:justify-between rounded shadow-sm">
        <p class="text-lg uppercase tracking-[0.32em]">NỘI THẤT CAO CẤP</p>
        <div>
          <p class="font-display text-3xl leading-snug">Trở thành thành viên để nhận bộ sưu tập nội thất mới nhất.</p>
          <p class="mt-6 text-sm text-sand-200/80 leading-relaxed">Ưu đãi độc quyền theo hạng hội viên, lưu lịch sử xem Phong Thủy và nhận thông báo trạng thái giao hàng theo thời gian thực.</p>
        </div>
        <div class="pt-6 border-t border-sand-50/15 text-xs text-sand-200/60">
          Hệ thống bảo mật dữ liệu khách hàng theo chuẩn Enterprise.
        </div>
      </div>

      <div class="max-w-md">
        <h1 class="font-display text-3xl tracking-tight sm:text-4xl text-walnut-900">Đăng ký thành viên</h1>
        <p class="mt-2 text-sm text-walnut-800/80">Điền thông tin bên dưới để tạo tài khoản mới.</p>

        <!-- Nút Đăng ký nhanh bằng Gmail (Google OAuth) -->
        <div class="mt-6 flex flex-col items-center gap-2">
          <!-- Vùng hiển thị nút chính thức của Google SDK khi có Client ID -->
          <div id="google-btn-official" class="w-full flex justify-center"></div>

          <!-- Nút bấm hiển thị mặc định hoặc dự phòng -->
          <button
            type="button"
            id="btn-google-signup"
            class="flex w-full items-center justify-center gap-3 border border-walnut-900/20 bg-sand-50 py-3 text-xs uppercase tracking-[0.15em] font-medium text-walnut-900 transition-all hover:bg-sand-100 hover:border-walnut-900 shadow-sm cursor-pointer"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
            </svg>
            <span>Đăng ký nhanh bằng Gmail</span>
          </button>
        </div>

        <div class="my-6 flex items-center gap-3">
          <div class="h-px flex-1 bg-walnut-900/15"></div>
          <span class="text-[10px] uppercase tracking-widest text-walnut-800/60">HOẶC DÙNG EMAIL</span>
          <div class="h-px flex-1 bg-walnut-900/15"></div>
        </div>

                <!-- CẢNH BÁO NỔI BẬT TRỰC TIẾP TRÊN FORM (RÕ NÉT, KHÔNG BỊ CHE BỞI HEADER HAY CÁC NÚT NỔI) -->
        <div id="register-alert-banner" class="hidden mb-5 rounded-lg border border-red-300 bg-red-50 p-4 text-xs text-red-900 shadow-sm transition-all duration-300">
          <div class="flex items-start gap-3">
            <svg id="alert-banner-icon" class="h-5 w-5 text-red-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div class="flex-1">
              <p id="alert-banner-title" class="font-bold text-red-950 uppercase tracking-wider text-[11px]">Cảnh báo</p>
              <div id="alert-banner-desc" class="mt-1 text-red-800 leading-relaxed text-xs"></div>
            </div>
            <button type="button" id="btn-close-alert" class="text-red-400 hover:text-red-700 transition-colors p-0.5" aria-label="Đóng cảnh báo">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <form id="register-form" novalidate class="flex flex-col gap-4">
          <div>
            <label for="reg-name" class="block text-[11px] uppercase tracking-[0.2em] text-walnut-800">Họ và tên *</label>
            <input id="reg-name" name="fullname" type="text" required placeholder="Ví dụ: Nguyễn Văn An" autocomplete="name" class="mt-1.5 w-full border border-walnut-900/20 bg-sand-50 px-4 py-2.5 text-sm outline-none transition-colors focus:border-clay-600 focus:bg-sand-100/30" />
            <p id="err-fullname" class="mt-1 hidden text-xs text-red-600 font-medium"></p>
          </div>

          <div>
            <label for="reg-email" class="block text-[11px] uppercase tracking-[0.2em] text-walnut-800">Email *</label>
            <input id="reg-email" name="email" type="email" required placeholder="an.nguyen@gmail.com" autocomplete="email" class="mt-1.5 w-full border border-walnut-900/20 bg-sand-50 px-4 py-2.5 text-sm outline-none transition-colors focus:border-clay-600 focus:bg-sand-100/30" />
            <p id="err-email" class="mt-1 hidden text-xs text-red-600 font-medium"></p>
          </div>

          <div>
            <label for="reg-phone" class="block text-[11px] uppercase tracking-[0.2em] text-walnut-800">Số điện thoại *</label>
            <input id="reg-phone" name="phone" type="tel" required placeholder="0908 123 456" autocomplete="tel" class="mt-1.5 w-full border border-walnut-900/20 bg-sand-50 px-4 py-2.5 text-sm outline-none transition-colors focus:border-clay-600 focus:bg-sand-100/30" />
            <p id="err-phone" class="mt-1 hidden text-xs text-red-600 font-medium"></p>
          </div>

          <!-- Mật khẩu kèm thanh đo độ mạnh (Yếu / Trung bình / Mạnh) -->
          <div>
            <label for="reg-password" class="block text-[11px] uppercase tracking-[0.2em] text-walnut-800">Mật khẩu *</label>
            <div class="relative mt-1.5">
              <input id="reg-password" name="password" type="password" required autocomplete="new-password" placeholder="Nhập ít nhất 6 ký tự" class="w-full border border-walnut-900/20 bg-sand-50 pl-4 pr-11 py-2.5 text-sm outline-none transition-colors focus:border-clay-600 focus:bg-sand-100/30" />
              <button
                type="button"
                id="toggle-reg-password"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-walnut-800/50 hover:text-walnut-900 transition-colors p-1 cursor-pointer focus:outline-none"
                aria-label="Xem mật khẩu"
                title="Xem hoặc ẩn mật khẩu"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
              </button>
            </div>
            
            <!-- THANH ĐO ĐỘ MẠNH MẬT KHẨU (YÊU CẦU ĐẶC TẢ) -->
            <div id="password-strength-container" class="mt-2 hidden">
              <div class="flex items-center justify-between text-[11px] mb-1">
                <span class="text-walnut-800/70">Độ an toàn:</span>
                <span id="password-strength-text" class="font-bold text-red-600">Yếu</span>
              </div>
              <div class="h-1.5 w-full bg-sand-200 rounded-full overflow-hidden">
                <div id="password-strength-bar" class="h-full w-1/3 bg-red-500 transition-all duration-300"></div>
              </div>
            </div>
            <p id="err-password" class="mt-1 hidden text-xs text-red-600 font-medium"></p>
          </div>

          <div>
            <label for="reg-confirm" class="block text-[11px] uppercase tracking-[0.2em] text-walnut-800">Xác nhận mật khẩu *</label>
            <div class="relative mt-1.5">
              <input id="reg-confirm" name="confirm" type="password" required autocomplete="new-password" placeholder="Nhập lại mật khẩu" class="w-full border border-walnut-900/20 bg-sand-50 pl-4 pr-11 py-2.5 text-sm outline-none transition-colors focus:border-clay-600 focus:bg-sand-100/30" />
              <button
                type="button"
                id="toggle-reg-confirm"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-walnut-800/50 hover:text-walnut-900 transition-colors p-1 cursor-pointer focus:outline-none"
                aria-label="Xem mật khẩu xác nhận"
                title="Xem hoặc ẩn mật khẩu"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
              </button>
            </div>
            <p id="err-confirm" class="mt-1 hidden text-xs text-red-600 font-medium"></p>
          </div>

          <div class="flex items-start gap-2.5 mt-1">
            <input id="reg-terms" name="terms" type="checkbox" checked class="mt-1 h-4 w-4 accent-walnut-900 cursor-pointer" />
            <label for="reg-terms" class="text-xs text-walnut-800 leading-normal cursor-pointer">
              Tôi đồng ý với <a href="#" class="underline hover:text-clay-600">Điều khoản dịch vụ</a> và <a href="#" class="underline hover:text-clay-600">Chính sách bảo mật</a> của Nội Thất.
            </label>
          </div>

          <button 
            type="submit" 
            id="btn-submit"
            class="mt-3 bg-clay-600 px-8 py-3.5 text-xs uppercase tracking-[0.2em] font-semibold text-sand-50 transition-colors hover:bg-clay-500 shadow-sm cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Đăng ký tài khoản</span>
          </button>
        </form>

        <p class="mt-6 text-xs text-walnut-800 text-center">
          Đã có tài khoản?
          <a href="/dang-nhap" class="font-bold text-walnut-900 underline underline-offset-4 transition-colors hover:text-clay-600">Đăng nhập ngay</a>
        </p>
      </div>

    </div>
  </section>

  <!-- TOAST THÔNG BÁO (GÓC TRÊN BÊN PHẢI) -->
  <div id="auth-toast" class="fixed top-6 right-6 z-[9999] hidden -translate-y-4 rounded-xl bg-walnut-900 px-6 py-4 text-xs font-medium text-sand-50 shadow-2xl transition-all duration-300 border border-sand-50/20 max-w-sm">
    <p id="toast-title" class="font-bold uppercase tracking-wider text-sand-50 mb-0.5">Thông báo</p>
    <p id="toast-body" class="text-sand-200">Đăng ký thành công! Đang chuyển sang trang Đăng nhập...</p>
  </div>

</BaseLayout>

<!-- Tải thư viện Google Identity Services (GSI) -->
<script is:inline src="https://accounts.google.com/gsi/client" async defer></script>

<script>
  import { mergeGuestCartOnLogin } from '../../scripts/cart';

  // =========================================================================
  // 1. CẤU HÌNH GOOGLE CLIENT ID
  // =========================================================================
  const MANUAL_CLIENT_ID = "288589640244-4uhsc02mcfqitebqct2nhpgghpu70cv9.apps.googleusercontent.com";

  const ENV_CLIENT_ID = (import.meta as any).env?.PUBLIC_GOOGLE_CLIENT_ID;
  const GOOGLE_CLIENT_ID = 
    MANUAL_CLIENT_ID && MANUAL_CLIENT_ID.trim() !== ""
      ? MANUAL_CLIENT_ID.trim()
      : (ENV_CLIENT_ID && !ENV_CLIENT_ID.includes("DÁN_") ? ENV_CLIENT_ID.trim() : "");

  document.addEventListener('DOMContentLoaded', () => {
    // Bật/tắt xem mật khẩu cho trang Đăng ký
    const toggleRegPass = document.getElementById('toggle-reg-password') as HTMLButtonElement;
    const toggleRegConfirm = document.getElementById('toggle-reg-confirm') as HTMLButtonElement;

    toggleRegPass?.addEventListener('click', () => {
      if (passInput.type === 'password') {
        passInput.type = 'text';
        toggleRegPass.innerHTML = `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>`;
        toggleRegPass.setAttribute('aria-label', 'Ẩn mật khẩu');
      } else {
        passInput.type = 'password';
        toggleRegPass.innerHTML = `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`;
        toggleRegPass.setAttribute('aria-label', 'Xem mật khẩu');
      }
    });

    toggleRegConfirm?.addEventListener('click', () => {
      if (confirmInput.type === 'password') {
        confirmInput.type = 'text';
        toggleRegConfirm.innerHTML = `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" /></svg>`;
        toggleRegConfirm.setAttribute('aria-label', 'Ẩn mật khẩu');
      } else {
        confirmInput.type = 'password';
        toggleRegConfirm.innerHTML = `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`;
        toggleRegConfirm.setAttribute('aria-label', 'Xem mật khẩu');
      }
    });

    const form = document.getElementById('register-form') as HTMLFormElement;
    const nameInput = document.getElementById('reg-name') as HTMLInputElement;
    const emailInput = document.getElementById('reg-email') as HTMLInputElement;
    const phoneInput = document.getElementById('reg-phone') as HTMLInputElement;
    const passInput = document.getElementById('reg-password') as HTMLInputElement;
    const confirmInput = document.getElementById('reg-confirm') as HTMLInputElement;
    const termsInput = document.getElementById('reg-terms') as HTMLInputElement;
    const btnGoogle = document.getElementById('btn-google-signup') as HTMLButtonElement;
    const googleOfficialContainer = document.getElementById('google-btn-official') as HTMLElement;

    // Error elements
    const errFullname = document.getElementById('err-fullname') as HTMLElement;
    const errEmail = document.getElementById('err-email') as HTMLElement;
    const errPhone = document.getElementById('err-phone') as HTMLElement;
    const errPassword = document.getElementById('err-password') as HTMLElement;
    const errConfirm = document.getElementById('err-confirm') as HTMLElement;

    // Clear all inline errors
    const clearFieldErrors = () => {
      [errFullname, errEmail, errPhone, errPassword, errConfirm].forEach((el) => {
        if (el) {
          el.textContent = '';
          el.classList.add('hidden');
        }
      });
      [nameInput, emailInput, phoneInput, passInput, confirmInput].forEach((inp) => {
        if (inp) {
          inp.classList.remove('border-red-500', 'bg-red-50/20');
          inp.classList.add('border-walnut-900/20');
        }
      });
    };

    // Set error on a specific field
    const setFieldError = (field: string, msg: string, isHtml = false) => {
      let targetErr: HTMLElement | null = null;
      let targetInput: HTMLInputElement | null = null;

      if (field === 'fullname') {
        targetErr = errFullname;
        targetInput = nameInput;
      } else if (field === 'email') {
        targetErr = errEmail;
        targetInput = emailInput;
      } else if (field === 'phone') {
        targetErr = errPhone;
        targetInput = phoneInput;
      } else if (field === 'password') {
        targetErr = errPassword;
        targetInput = passInput;
      } else if (field === 'confirm') {
        targetErr = errConfirm;
        targetInput = confirmInput;
      }

      if (targetErr) {
        if (isHtml) {
          targetErr.innerHTML = msg;
        } else {
          targetErr.textContent = msg;
        }
        targetErr.classList.remove('hidden');
      }

      if (targetInput) {
        targetInput.classList.remove('border-walnut-900/20');
        targetInput.classList.add('border-red-500', 'bg-red-50/20');
        targetInput.focus();
      }
    };

    // Tự động xóa lỗi khi người dùng chỉnh sửa trường thông tin
    [
      { input: nameInput, err: errFullname },
      { input: emailInput, err: errEmail },
      { input: phoneInput, err: errPhone },
      { input: passInput, err: errPassword },
      { input: confirmInput, err: errConfirm },
    ].forEach(({ input, err }) => {
      input?.addEventListener('input', () => {
        if (err) {
          err.textContent = '';
          err.classList.add('hidden');
        }
        input.classList.remove('border-red-500', 'bg-red-50/20');
        input.classList.add('border-walnut-900/20');
      });
    });

    // Password strength elements
    const strengthContainer = document.getElementById('password-strength-container') as HTMLElement;
    const strengthText = document.getElementById('password-strength-text') as HTMLElement;
    const strengthBar = document.getElementById('password-strength-bar') as HTMLElement;

    // Toast
    const toast = document.getElementById('auth-toast') as HTMLElement;
    const toastBody = document.getElementById('toast-body') as HTMLElement;

    const showToast = (msg: string, isError = false) => {
      toastBody.textContent = msg;
      toast.className = `fixed top-6 right-6 z-[9999] rounded-xl px-6 py-4 text-xs font-medium text-sand-50 shadow-2xl transition-all duration-300 border max-w-sm backdrop-blur-sm ${
        isError ? 'bg-red-950/95 border-red-500 text-red-50' : 'bg-walnut-900/95 border-emerald-500/50 text-sand-50'
      }`;
      toast.classList.remove('hidden');
      requestAnimationFrame(() => toast.classList.remove('-translate-y-4'));
      setTimeout(() => {
        toast.classList.add('-translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 4500);
    };

    // LIVE PASSWORD STRENGTH METER (YẾU / TRUNG BÌNH / MẠNH)
    passInput?.addEventListener('input', () => {
      const val = passInput.value;
      if (!val) {
        strengthContainer.classList.add('hidden');
        return;
      }

      strengthContainer.classList.remove('hidden');

      const hasLetters = /[a-zA-Z]/.test(val);
      const hasNumbers = /[0-9]/.test(val);
      const hasSpecial = /[^a-zA-Z0-9]/.test(val);
      const isLongEnough = val.length >= 8;

      if (val.length < 6) {
        strengthText.textContent = 'Mật khẩu yếu (Cần ít nhất 6 ký tự)';
        strengthText.className = 'font-bold text-red-600';
        strengthBar.className = 'h-full w-1/4 bg-red-500 transition-all duration-300';
      } else if (isLongEnough && hasLetters && hasNumbers && hasSpecial) {
        strengthText.textContent = 'Mật khẩu mạnh (An toàn cao)';
        strengthText.className = 'font-bold text-emerald-600';
        strengthBar.className = 'h-full w-full bg-emerald-500 transition-all duration-300';
      } else if (hasLetters && hasNumbers) {
        strengthText.textContent = 'Mật khẩu trung bình';
        strengthText.className = 'font-bold text-amber-600';
        strengthBar.className = 'h-full w-2/3 bg-amber-500 transition-all duration-300';
      } else {
        strengthText.textContent = 'Mật khẩu yếu';
        strengthText.className = 'font-bold text-red-600';
        strengthBar.className = 'h-full w-1/3 bg-red-500 transition-all duration-300';
      }
    });

    // Hàm giải mã JWT Token từ Google gửi về để lấy họ tên, email, ảnh avatar thật
    function parseJwt(token: string) {
      try {
        const base64Url = token.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        const jsonPayload = decodeURIComponent(
          atob(base64)
            .split('')
            .map((c) => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2))
            .join('')
        );
        return JSON.parse(jsonPayload);
      } catch (err) {
        console.error('Lỗi giải mã token Google:', err);
        return null;
      }
    }

    // Xử lý sau khi người dùng chọn tài khoản Google thành công
    async function handleGoogleSignupSuccess(response: any) {
      if (!response || !response.credential) {
        showToast('Không nhận được dữ liệu xác thực từ Google.', true);
        return;
      }

      const payload = parseJwt(response.credential);
      if (!payload || !payload.email) {
        showToast('Lỗi đọc thông tin từ tài khoản Google.', true);
        return;
      }

      const googleUser: any = {
        name: payload.name || payload.email.split('@')[0],
        email: payload.email,
        avatar: payload.picture || '',
        phone: 'Đăng ký Google',
        role: 'customer',
        tier: 'Vàng',
        spent: '0 ₫',
        orders: 0,
        date: new Date().toLocaleDateString('vi-VN'),
        status: 'Hoạt động',
      };

      // 1. Gửi lên Backend để lưu vào database MySQL và cấp JWT Token
      localStorage.removeItem('auth_token'); // Xoá token cũ để tránh rò rỉ phiên
      try {
        const res = await fetch('http://localhost:4000/api/auth/google', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: googleUser.email,
            fullname: googleUser.name,
            avatar_url: googleUser.avatar,
          }),
        });

        const data = await res.json();
        if (data.success && data.token) {
          localStorage.setItem('auth_token', data.token);
          if (data.user) {
            googleUser.id = data.user.id;
            googleUser.role = data.user.role || 'customer';
            if (data.user.full_name) googleUser.name = data.user.full_name;
            if (data.user.phone) googleUser.phone = data.user.phone;
            if (data.user.avatar) googleUser.avatar = data.user.avatar;
          }
        }
      } catch (e) {
        console.warn('Lỗi kết nối Backend Google Auth:', e);
      }

      // 2. Lưu phiên người dùng hiện tại
      localStorage.setItem('current_user', JSON.stringify(googleUser));
      try { mergeGuestCartOnLogin(); } catch {}
      window.dispatchEvent(new Event('auth:changed'));

      showToast(`Xin chào ${googleUser.name}! Đăng ký thành công bằng Google.`);
      setTimeout(() => {
        window.location.href = '/';
      }, 1000);
    }

    // Khởi tạo thư viện Google Identity Services
    function setupGoogleButton() {
      const google = (window as any).google;
      if (!google || !google.accounts) return;

      if (GOOGLE_CLIENT_ID && GOOGLE_CLIENT_ID.trim() !== '') {
        google.accounts.id.initialize({
          client_id: GOOGLE_CLIENT_ID.trim(),
          callback: handleGoogleSignupSuccess,
          auto_select: false,
          cancel_on_tap_outside: true,
        });

        if (googleOfficialContainer) {
          google.accounts.id.renderButton(googleOfficialContainer, {
            theme: 'outline',
            size: 'large',
            width: 380,
            text: 'signup_with',
            locale: 'vi',
            shape: 'rectangular',
          });
          if (btnGoogle) {
            btnGoogle.style.display = 'none';
          }
        }
      }
    }

    // Kiểm tra định kỳ để tải SDK Google
    let attempts = 0;
    const interval = setInterval(() => {
      attempts++;
      if ((window as any).google?.accounts?.id) {
        clearInterval(interval);
        setupGoogleButton();
      } else if (attempts >= 25) {
        clearInterval(interval);
      }
    }, 200);

    // Xử lý nút bấm dự phòng Google
    btnGoogle?.addEventListener('click', () => {
      const google = (window as any).google;
      if (GOOGLE_CLIENT_ID && GOOGLE_CLIENT_ID.trim() !== '' && google?.accounts?.id) {
        google.accounts.id.prompt();
      } else {
        showToast('Vui lòng sử dụng biểu mẫu đăng ký bên dưới.');
      }
    });

    // SUBMIT FORM REGISTER
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearFieldErrors();

      const fullname = nameInput.value.trim();
      const email = emailInput.value.trim();
      const phone = phoneInput.value.trim();
      const password = passInput.value;
      const confirm = confirmInput.value;

      if (!fullname) {
        setFieldError('fullname', 'Vui lòng nhập họ và tên của bạn.');
        showToast('Vui lòng điền họ và tên.', true);
        return;
      }

      if (!email) {
        setFieldError('email', 'Vui lòng nhập địa chỉ email.');
        showToast('Vui lòng điền email.', true);
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        setFieldError('email', 'Địa chỉ email không đúng định dạng.');
        showToast('Địa chỉ email không đúng định dạng.', true);
        return;
      }

      const cleanPhone = phone.replace(/\s+/g, '');
      if (cleanPhone && !/^(0|\+84)[1-9][0-9]{8}$/.test(cleanPhone)) {
        setFieldError('phone', 'Số điện thoại không hợp lệ (cần 10 chữ số, bắt đầu bằng 0 hoặc +84).');
        showToast('Số điện thoại không hợp lệ.', true);
        return;
      }

      if (!password) {
        setFieldError('password', 'Vui lòng nhập mật khẩu.');
        showToast('Vui lòng nhập mật khẩu.', true);
        return;
      }

      if (password.length < 6) {
        setFieldError('password', 'Mật khẩu phải chứa ít nhất 6 ký tự để bảo mật.');
        showToast('Mật khẩu phải chứa ít nhất 6 ký tự.', true);
        return;
      }

      if (password !== confirm) {
        setFieldError('confirm', 'Mật khẩu xác nhận không khớp.');
        showToast('Mật khẩu xác nhận không khớp.', true);
        return;
      }

      if (!termsInput.checked) {
        showToast('Bạn cần đồng ý với điều khoản sử dụng.', true);
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang xử lý đăng ký...';
      }

      // GỬI LÊN BACKEND MYSQL (Băm Bcrypt & Kiểm tra trùng lặp an toàn)
      try {
        const res = await fetch('http://localhost:4000/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fullname, email, phone: cleanPhone, password }),
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          // Gắn lỗi inline cụ thể theo trường phản hồi từ backend
          if (data.field === 'email' || (data.message && data.message.toLowerCase().includes('email'))) {
            setFieldError(
              'email',
              `<span>${data.message || 'Email này đã được sử dụng.'}</span> <a href="/dang-nhap" class="ml-1 font-bold underline text-clay-700 hover:text-clay-900 inline-flex items-center gap-0.5">Đăng nhập ngay &rarr;</a>`,
              true
            );
          } else if (data.field === 'phone' || (data.message && data.message.toLowerCase().includes('điện thoại'))) {
            setFieldError('phone', data.message || 'Số điện thoại này đã được đăng ký.');
          } else if (data.field === 'password') {
            setFieldError('password', data.message);
          }

          showToast(data.message || 'Đăng ký tài khoản không thành công.', true);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Đăng ký tài khoản';
          }
          return;
        }

        // Đăng ký thành công
        showToast('Đăng ký tài khoản thành công! Đang chuyển sang trang Đăng nhập...');
        setTimeout(() => {
          window.location.href = '/dang-nhap?registered=1';
        }, 1000);
      } catch (err) {
        showToast('Không thể kết nối đến máy chủ Backend. Vui lòng thử lại sau.', true);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Đăng ký tài khoản';
        }
      }
    });
  });
</script>
